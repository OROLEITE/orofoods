{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=orofoods;Username=orofoods;Password=CHANGE_ME"
  },
  "WmcFileDrop": {
    "Enabled": false,
    "AutoRetryEnabled": false,
    "OutputDirectory": ""
  },
  "WmcFirebird": {
    "Enabled": false,
    "Host": "",
    "Port": 3050,
    "Database": "",
    "User": "",
    "Password": "",
    "Charset": "UTF8",
    "ConnectionTimeoutSeconds": 15,
    "CommandTimeoutSeconds": 30
  },
  "WmcSync": {
    "Enabled": false,
    "IntervalMinutes": 120
  },
  "MercadoPago": {
    "BaseAddress": "https://api.mercadopago.com/"
  },
