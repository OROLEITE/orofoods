  },
  "Crm": {
    "NoPurchaseDays": 30,
    "RepurchaseToleranceDays": 3,
    "RepurchaseHistorySize": 6
  },
  "DataProtection": {
    "KeyDirectory": ""
  },
  "FileLogging": {
    "Enabled": true,
    "Directory": "Logs",
    "MinimumLevel": "Information"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
