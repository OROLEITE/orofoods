@model ErrorViewModel
@{
    ViewData["Title"] = "Erro";
}

<h1 class="text-danger">Não foi possível concluir sua solicitação.</h1>
<h2 class="text-danger">Nossa equipe foi avisada e pode localizar o ocorrido pela referência abaixo.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Referência de atendimento:</strong> <code>@Model.RequestId</code>
    </p>
}

<p>Se o problema continuar, informe esta referência ao suporte Orofoods.</p>
