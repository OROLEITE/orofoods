@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var customerName = ViewData["PortalCustomerName"] as string;
    var accountName = "Minha conta";
    var isAdministrator = User.IsInRole("Administrador");
    var isCommercialManager = User.IsInRole("GerenteComercial");
    var isSalesRepresentative = User.IsInRole("Vendedor");
    var accountContext = customerName ?? (isAdministrator ? "Administrador" : isCommercialManager ? "Gerente comercial" : isSalesRepresentative ? "Vendedor" : "Cliente");
    var panelUrl = isAdministrator
        ? Url.Action("Index", "Dashboard", new { area = "Admin" })
        : isCommercialManager || isSalesRepresentative
            ? Url.Action("Index", "Commercial", new { area = "Admin" })
            : Url.Action("Dashboard", "Portal", new { area = "" });
}
<header class="site-header-modern">
    <nav class="navbar navbar-expand-lg navbar-light bg-white">
        <div class="container-fluid site-header-container">
            <a class="navbar-brand site-brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="Orofoods - in&#237;cio"><img class="site-logo" src="~/images/logo-orofoods.png" asp-append-version="true" alt="Orofoods" /></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Abrir navega&#231;&#227;o"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav mx-lg-auto align-items-lg-center main-nav">
                    <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">In&#237;cio</a></li><li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Products">Produtos</a></li><li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="About">Sobre n&#243;s</a></li><li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="HowItWorks">Como funciona</a></li><li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Contact">Contato</a></li>
                </ul>
                <div class="header-account ms-lg-4">
                    @if (isAuthenticated)
                    {
                        <div class="dropdown account-dropdown"><button class="btn account-trigger dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-haspopup="menu" aria-label="Abrir menu da conta"><span class="account-avatar" aria-hidden="true">M</span><span class="account-copy"><strong class="account-name">@accountName</strong><small class="account-context">@accountContext</small></span></button><ul class="dropdown-menu dropdown-menu-end account-menu"><li><a class="dropdown-item" href="@panelUrl"><i class="fa-solid fa-gauge-high" aria-hidden="true"></i> Meu painel</a></li>@if (isAdministrator) { <li><a class="dropdown-item" asp-area="" asp-controller="Portal" asp-action="SelectCustomer"><i class="fa-solid fa-building-user" aria-hidden="true"></i> Acessar portal de cliente</a></li> }<li><hr class="dropdown-divider" /></li><li><form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/"><button class="dropdown-item account-logout" type="submit"><i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i> Sair</button></form></li></ul></div>
                    }
                    else
                    {
                        <a class="btn btn-outline-dark" asp-area="Identity" asp-page="/Account/Login">Entrar</a>
                    }
                </div>
            </div>
        </div>
    </nav>
</header>