@using Orofoods.Web.Services.Commercial
@inject UserNotificationService NotificationService
@{
    var notificationUserId = NotificationService.CurrentUserId(User);
    var isWhatsAppRoute = string.Equals(ViewContext.RouteData.Values["area"]?.ToString(), "Admin", StringComparison.OrdinalIgnoreCase)
        && string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "WhatsApp", StringComparison.OrdinalIgnoreCase);
    var unreadCount = 0;
    var notifications = new List<Orofoods.Web.Models.Commercial.UserNotification>();
    if (!string.IsNullOrWhiteSpace(notificationUserId))
    {
        try
        {
            unreadCount = await NotificationService.UnreadCountAsync(notificationUserId);
            notifications = await NotificationService.RecentAsync(notificationUserId);
        }
        catch
        {
            unreadCount = 0;
            notifications = [];
        }
    }
}
@if (notificationUserId is not null)
{
    <link rel="stylesheet" href="~/css/notification-bell.css" asp-append-version="true" />
    <script src="~/js/notification-bell.js" asp-append-version="true" defer></script>
    <details class="global-notification-menu" data-notification-bell
             data-updates-url="@Url.Action("Index", "Notifications", new { area = "Admin" })"
             data-read-url="@Url.Action("Read", "Notifications", new { area = "Admin" })"
             data-read-all-url="@Url.Action("ReadAll", "Notifications", new { area = "Admin" })"
             data-fallback-url="@Url.Action("Index", "Notifications", new { area = "Admin" })">
        <summary class="global-notification-trigger" aria-label="Notificações" aria-controls="globalNotificationPanel">
            <i class="fa-solid fa-bell" aria-hidden="true"></i>
            <span class="global-notification-badge" data-notification-count hidden="@(unreadCount == 0)" aria-live="polite" aria-atomic="true">@(unreadCount > 99 ? "99+" : unreadCount.ToString())</span>
        </summary>
        <div id="globalNotificationPanel" class="global-notification-panel">
            <header><strong>Notificações</strong><a asp-area="Admin" asp-controller="Notifications" asp-action="Index">Ver todas</a></header>
            <form asp-area="Admin" asp-controller="Notifications" asp-action="ReadAll" method="post" data-notification-read-all>
                <button class="global-notification-read-all" type="submit">Marcar todas como lidas</button>
            </form>
            <p class="global-notification-empty" data-notification-empty hidden="@(notifications.Count > 0)">Nenhuma notificação nova.</p>
            <div class="global-notification-items" data-notification-items>
                    @foreach (var notification in notifications)
                    {
                        <form asp-area="Admin" asp-controller="Notifications" asp-action="Read" method="post" data-notification-id="@notification.Id">
                            <input type="hidden" name="id" value="@notification.Id" />
                            <input type="hidden" name="navigate" value="true" />
                            <button type="submit" class="global-notification-item @(notification.ReadAt is null ? "is-unread" : "")">
                                <i class="fa-solid fa-circle-info" aria-hidden="true"></i><span><strong>@notification.Title</strong><small>@notification.Message</small><time datetime="@notification.CreatedAt.ToString("O")">@notification.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</time></span>
                            </button>
                        </form>
                    }
            </div>
            <p class="global-notification-status" data-notification-status role="status" hidden></p>
            <footer>
                @if (isWhatsAppRoute)
                {
                    <div class="global-notification-sound" data-notification-sound>
                        <button type="button" class="whatsapp-sound-toggle" aria-pressed="true" aria-label="Som ligado" title="Som ligado"><i class="fa-solid fa-bell" aria-hidden="true"></i><span>Som ligado</span></button>
                    </div>
                }
                <a asp-area="Admin" asp-controller="Notifications" asp-action="Index">Ver todas as notificações</a>
            </footer>
        </div>
    </details>
}
