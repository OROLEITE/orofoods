@using Microsoft.AspNetCore.Mvc.ViewFeatures
@{
    Layout = "_Layout";
    ViewData["BodyClass"] = "admin-authenticated";
    var desktopNavigationData = new ViewDataDictionary(ViewData) { ["AdminNavPrefix"] = "desktop" };
    var mobileNavigationData = new ViewDataDictionary(ViewData) { ["AdminNavPrefix"] = "mobile" };
}

<div class="admin-shell" data-admin-shell>
    <aside id="adminSidebar" class="admin-sidebar d-none d-xl-flex" aria-label="Navegação administrativa">
        <button class="admin-sidebar-toggle" type="button" data-admin-sidebar-toggle aria-controls="adminSidebar" aria-expanded="true" aria-label="Recolher menu lateral" title="Recolher menu lateral">
            <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
        </button>
        @await Html.PartialAsync("_AdminNavigation", viewData: desktopNavigationData)
    </aside>
    <div class="admin-content">
        <div class="admin-mobile-toolbar d-xl-none">
            <button class="btn admin-mobile-trigger" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminNavigation" aria-controls="adminNavigation"><i class="fa-solid fa-bars" aria-hidden="true"></i> Administração</button>
        </div>
        <main class="admin-main"><div class="admin-main-inner">@RenderBody()</div></main>
    </div>
</div>

<div class="offcanvas offcanvas-start admin-offcanvas" tabindex="-1" id="adminNavigation" aria-labelledby="adminNavigationLabel">
    <div class="offcanvas-header"><h2 id="adminNavigationLabel">Administração</h2><button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Fechar"></button></div>
    <div class="offcanvas-body">@await Html.PartialAsync("_AdminNavigation", viewData: mobileNavigationData)</div>
</div>

@section Head {
    <link rel="stylesheet" href="~/css/admin-shell.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-navigation.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-orders.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-integrations.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-customers.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-customer-actions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-products.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-products-mobile.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-products-light.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-registrations.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
}

@section Scripts {
    <script src="~/js/admin-navigation.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
}
