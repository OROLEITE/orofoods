@{
    var currentArea = ViewContext.RouteData.Values["area"]?.ToString();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var isPortalExperience = (ViewData["BodyClass"]?.ToString() ?? string.Empty)
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Contains("portal-authenticated", StringComparer.Ordinal);
    var isCustomerExperience = isPortalExperience || currentArea == "Identity" ||
        (string.IsNullOrEmpty(currentArea) && (currentController == "Home" || currentController == "CustomerRegistration" || (currentController == "Portal" && currentAction != "SelectCustomer")));
    var bodyClass = string.Join(" ", new[] { ViewData["BodyClass"]?.ToString(), isCustomerExperience ? "customer-experience" : null }.Where(value => !string.IsNullOrWhiteSpace(value)));
    var layoutBodyHasMain = ViewData["LayoutBodyHasMain"] is true;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Orofoods - distribui&#231;&#227;o B2B para food service." /><title>@ViewData["Title"] | Orofoods</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" /><link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /><link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/home-showcase.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/seller-area.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/commercial.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/portal-density.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/portal-actions.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/header.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/portal-shell.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/admin-shell.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/admin-navigation.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/admin-orders.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/admin-integrations.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/admin-customers.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/admin-customer-actions.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/admin-products.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/admin-products-mobile.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/admin-products-light.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/customer-experience.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="@bodyClass">
    @await Html.PartialAsync("_SiteHeader")
    @if (User.Identity?.IsAuthenticated == true)
    {
        var identityName = User.Identity.Name;
        var accountName = string.IsNullOrWhiteSpace(identityName) ? "Minha conta" : identityName.Split('@')[0].Replace('.', ' ').Replace('_', ' ');
        var accountContext = ViewData["PortalCustomerName"] as string ?? (User.IsInRole("Administrador") ? "Administrador" : User.IsInRole("Vendedor") ? "Vendedor" : User.IsInRole("GerenteComercial") ? "Gerente comercial" : "Cliente");
        var initial = char.ToUpperInvariant(accountName[0]);
        @if (!isCustomerExperience)
    {
    <div class="dropdown auth-user-menu">
            <button class="auth-user-trigger" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-haspopup="menu" aria-label="Abrir menu da conta">
                <span class="auth-user-avatar" aria-hidden="true">@initial</span>
                <span class="auth-user-summary"><strong>@accountName</strong><small>@accountContext</small></span>
                <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end auth-user-dropdown">
                <li><a class="dropdown-item" asp-area="" asp-controller="Portal" asp-action="Dashboard"><i class="fa-solid fa-gauge-high" aria-hidden="true"></i> Meu painel</a></li>
                <li><hr class="dropdown-divider" /></li>
                <li><form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/"><button class="dropdown-item" type="submit"><i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i> Sair</button></form></li>
            </ul>
        </div>
    }
    }
    <div class="page-context-bar" hidden><div class="container"><a id="siteBackButton" class="site-back-button" href="/" data-fallback-url="/" hidden aria-label="Voltar para a p&#225;gina anterior"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i><span>Voltar</span></a><span class="page-context-label">Navega&#231;&#227;o segura</span></div></div>
    @if (User.Identity?.IsAuthenticated == true && (User.IsInRole("Vendedor") || User.IsInRole("GerenteComercial") || User.IsInRole("Administrador")))
    {
        <div class="global-notification-shell"><div class="container">@await Html.PartialAsync("_NotificationBell")</div></div>
    }
    @if (layoutBodyHasMain)
    {
        @RenderBody()
    }
    else
    {
        <main class="site-main">@RenderBody()</main>
    }
    <footer class="site-footer"><div class="container site-footer-grid"><div class="footer-brand"><a asp-area="" asp-controller="Home" asp-action="Index" aria-label="Orofoods - in&#237;cio"><img class="footer-logo" src="~/images/logo-orofoods-transparent.png" asp-append-version="true" alt="Orofoods" /></a><p>Distribui&#231;&#227;o B2B para food service.</p></div><nav class="footer-links" aria-label="Links institucionais"><a asp-area="" asp-controller="Home" asp-action="Privacy">Privacidade</a><a asp-area="" asp-controller="Home" asp-action="Terms">Termos de uso</a></nav><div class="footer-legal"><p><i class="fa-solid fa-building" aria-hidden="true"></i><span>Orofoods<br />CNPJ 51.735.297/0001-74</span></p><small><i class="fa-regular fa-copyright" aria-hidden="true"></i> 2026 Orofoods. Todos os direitos reservados.</small></div></div></footer>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/site.js" asp-append-version="true"></script><script src="~/js/customer-experience.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
