<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Orofoods - distribui&#231;&#227;o B2B para food service." /><title>@ViewData["Title"] | Orofoods</title>
    <link rel="icon" type="image/png" href="~/images/logo-orofoods.png" /><link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /><link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/home-showcase.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/seller-area.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/commercial.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/portal-density.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/portal-actions.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/header.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/portal-shell.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/admin-shell.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/admin-navigation.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/admin-orders.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/admin-integrations.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/admin-customers.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/admin-customer-actions.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/admin-products.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/admin-products-mobile.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/admin-products-light.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="@(ViewData["BodyClass"] ?? string.Empty)">
    <header class="site-header"><nav class="navbar navbar-expand-lg"><div class="container"><a class="brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="Orofoods - in&#237;cio"><img class="brand-logo" src="~/images/logo-orofoods.png" asp-append-version="true" alt="Orofoods" /></a><button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-label="Abrir menu"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="mainNav"><ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2"><li><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">In&#237;cio</a></li><li><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Products">Produtos</a></li><li><a class="nav-link" asp-area="" asp-controller="Home" asp-action="About">Sobre n&#243;s</a></li><li><a class="nav-link" asp-area="" asp-controller="Home" asp-action="HowItWorks">Como funciona</a></li><li><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Contact">Contato</a></li>@if (User.Identity?.IsAuthenticated == true) { @if (User.IsInRole("Administrador")) { <li><a class="btn btn-gold" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="fa-solid fa-gauge-high" aria-hidden="true"></i> Administra&#231;&#227;o</a></li><li><a class="nav-link" asp-area="Admin" asp-controller="Commercial" asp-action="Index">CRM comercial</a></li><li><a class="nav-link" asp-controller="Portal" asp-action="SelectCustomer">Portal do cliente</a></li> } else if (User.IsInRole("Vendedor") || User.IsInRole("GerenteComercial")) { <li><a class="btn btn-gold" asp-area="Admin" asp-controller="Commercial" asp-action="Index">CRM comercial</a></li><li><a class="nav-link" asp-area="Admin" asp-controller="Customers" asp-action="Index">Clientes</a></li> } else { <li><a class="btn btn-gold" asp-controller="Portal" asp-action="Dashboard">Meu painel</a></li> } <li><form class="nav-logout" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/"><button class="btn btn-outline-dark" type="submit">Sair</button></form></li> } else { <li><a class="btn btn-outline-dark ms-lg-2" asp-area="Identity" asp-page="/Account/Login">Entrar</a></li><li><a class="btn btn-gold" asp-controller="Portal" asp-action="Dashboard">Portal do cliente</a></li> }</ul></div></div></nav></header>
    @await Html.PartialAsync("_SiteHeader")
    @if (User.Identity?.IsAuthenticated == true)
    {
        var identityName = User.Identity.Name;
        var accountName = string.IsNullOrWhiteSpace(identityName) ? "Minha conta" : identityName.Split('@')[0].Replace('.', ' ').Replace('_', ' ');
        var accountContext = ViewData["PortalCustomerName"] as string ?? (User.IsInRole("Administrador") ? "Administrador" : User.IsInRole("Vendedor") ? "Vendedor" : User.IsInRole("GerenteComercial") ? "Gerente comercial" : "Cliente");
        var initial = char.ToUpperInvariant(accountName[0]);
        <div class="dropdown auth-user-menu">
            <button class="auth-user-trigger" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-haspopup="menu" aria-label="Abrir menu da conta">
                <span class="auth-user-avatar" aria-hidden="true">@initial</span>
                <span class="auth-user-summary"><strong>@accountName</strong><small>@accountContext</small></span>
                <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end auth-user-dropdown">
                <li><a class="dropdown-item" asp-area="" asp-controller="Portal" asp-action="Dashboard"><i class="fa-solid fa-gauge-high" aria-hidden="true"></i> Meu painel</a></li>
                <li><hr class="dropdown-divider" /></li>
                <li><form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/"><button class="dropdown-item" type="submit"><i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i> Sair</button></form></li>
            </ul>
        </div>
    }
    <div class="page-context-bar" hidden><div class="container"><a id="siteBackButton" class="site-back-button" href="/" data-fallback-url="/" hidden aria-label="Voltar para a p&#225;gina anterior"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i><span>Voltar</span></a><span class="page-context-label">Navega&#231;&#227;o segura</span></div></div>
    @if (User.Identity?.IsAuthenticated == true && (User.IsInRole("Vendedor") || User.IsInRole("GerenteComercial") || User.IsInRole("Administrador")))
    {
        <div class="global-notification-shell"><div class="container">@await Html.PartialAsync("_NotificationBell")</div></div>
    }
    <main class="site-main">@RenderBody()</main>
    <footer class="site-footer"><div class="container site-footer-grid"><div class="footer-brand"><a asp-area="" asp-controller="Home" asp-action="Index" aria-label="Orofoods - in&#237;cio"><img class="footer-logo" src="~/images/logo-orofoods.png" asp-append-version="true" alt="Orofoods" /></a><p>Distribui&#231;&#227;o B2B para food service.</p></div><nav class="footer-links" aria-label="Links institucionais"><a asp-area="" asp-controller="Home" asp-action="Privacy">Privacidade</a><a asp-area="" asp-controller="Home" asp-action="Terms">Termos de uso</a></nav><div class="footer-legal"><p><i class="fa-solid fa-building" aria-hidden="true"></i><span>Orofoods<br />CNPJ 51.735.297/0001-74</span></p><small><i class="fa-regular fa-copyright" aria-hidden="true"></i> 2026 Orofoods. Todos os direitos reservados.</small></div></div></footer>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
