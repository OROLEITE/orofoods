@using Orofoods.Web.Services.Pricing
@model Orofoods.Web.Models.Catalog.Product
@{
    ViewData["Title"] = Model.Name;
    var resolvedPrice = ViewBag.Price as ResolvedPrice;
    var hasValidPrice = resolvedPrice?.EffectivePrice is > 0m;
    var catalogImage = Orofoods.Web.Services.Catalog.BimboProductImageCatalog.Find(Model.WmcCode);
    var primaryImage = catalogImage?.UseCatalogImage == true ? null : Model.Images.OrderByDescending(image => image.IsPrimary).ThenBy(image => image.SortOrder).FirstOrDefault();
    var cartQuantity = (int?)ViewBag.CartQuantity ?? 0;
    var cartProductQuantities = ViewBag.CartProductQuantities as Dictionary<int, int> ?? [];
    var quantity = cartProductQuantities.GetValueOrDefault(Model.Id, Model.MinimumSalesQuantity);
}

<section class="page-hero portal-page-hero portal-product-hero">
    <div class="container">
        <a class="back-link" asp-action="Catalog">&larr; Cat&aacute;logo</a>
        <a class="btn btn-outline-light portal-product-cart-link" asp-action="Cart" aria-label="Ver carrinho com @cartQuantity unidades">
            <i class="fa-solid fa-cart-shopping" aria-hidden="true"></i> Ver carrinho <span>(@cartQuantity)</span>
        </a>
        <div class="eyebrow light mt-4"><span></span> @Model.Category</div>
        <h1>@Model.Name</h1>
        <p>@Model.Sku <span aria-hidden="true">&middot;</span> @Model.Brand</p>
    </div>
</section>

<section class="section portal-page portal-product-page">
    <div class="container product-detail portal-product-detail">
        <figure class="product-detail-media" style="--accent:@Model.Accent">
            @if (primaryImage is not null || catalogImage is not null)
            {
                <img data-product-image="true"
                     data-fallback-stage="@(primaryImage is null ? "catalog" : "manual")"
                     data-catalog-fallback="@(catalogImage?.ImageUrl ?? string.Empty)"
                     data-placeholder-src="@Url.Content("~/images/products/product-photo-unavailable.svg")"
                     src="@(primaryImage is not null ? Url.RouteUrl("ProductMedia", new { imageId = primaryImage.Id }) : catalogImage!.ImageUrl)"
                     alt="@(primaryImage is not null && !string.IsNullOrWhiteSpace(primaryImage.AltText) ? primaryImage.AltText : catalogImage?.ModelName ?? Model.Name)" />
            }
            else
            {
                <img src="~/images/products/product-photo-unavailable.svg" alt="Foto do produto indispon&iacute;vel" />
            }
            <figcaption>Foto do produto</figcaption>
        </figure>

        <div class="product-detail-copy portal-product-copy">
            <p class="product-detail-kicker">@Model.Brand <span aria-hidden="true">&middot;</span> @Model.Sku</p>
            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <h2>@Model.Name</h2>
                <p class="product-detail-description">@Model.Description</p>
            }
            else
            {
                <h2>@Model.Name</h2>
            }

            <dl class="product-detail-facts">
                <div class="product-detail-fact">
                    <dt>Venda e embalagem</dt>
                    <dd>@Model.UnitDescription</dd>
                </div>
                @if (Model.HasPackageSalesConfiguration)
                {
                    <div class="product-detail-fact">
                        <dt>Convers&atilde;o da caixa</dt>
                        <dd>@Model.PackagesPerCase PCT por CX</dd>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.StorageInformation))
                {
                    <div class="product-detail-fact">
                        <dt>Armazenamento</dt>
                        <dd>@Model.StorageInformation</dd>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Ingredients))
                {
                    <div class="product-detail-fact product-detail-fact--wide">
                        <dt>Ingredientes</dt>
                        <dd>@Model.Ingredients</dd>
                    </div>
                }
            </dl>

            @if (hasValidPrice)
            {
                <div class="catalog-price portal-product-price"><strong>@resolvedPrice!.EffectivePrice.ToString("C")</strong><span>/ @Model.PriceUnitLabel</span></div>
            }
            else
            {
                <p class="alert alert-warning" role="status">Pre&ccedil;o indispon&iacute;vel para este cliente. N&atilde;o &eacute; poss&iacute;vel adicionar este produto ao carrinho agora.</p>
            }

            @if (!Model.IsCommerciallyAvailable)
            {
                <p class="product-detail-availability is-unavailable" role="status">Indispon&iacute;vel no estoque atual.</p>
            }
            else if (hasValidPrice)
            {
                <p class="product-detail-availability is-available">Dispon&iacute;vel para pedido</p>
            }

            @if (TempData["CartSuccess"] is string success)
            {
                <div class="alert alert-success portal-product-cart-feedback" role="status">
                    <p class="mb-2">@success</p>
                    <div class="d-flex flex-wrap gap-2">
                        <a class="btn btn-outline-dark" asp-action="Catalog">Continuar comprando</a>
                        <a class="btn btn-gold" asp-action="Cart">Ver carrinho</a>
                    </div>
                </div>
            }
            @if (TempData["CartError"] is string error)
            {
                <p class="alert alert-warning" role="alert">@error</p>
            }

            @if (Model.IsCommerciallyAvailable && hasValidPrice)
            {
                <form asp-action="AddToCart" method="post" class="product-detail-purchase-form">
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <input type="hidden" name="returnToProduct" value="true" />
                    <label for="portal-product-quantity">Quantidade (@Model.PriceUnitLabel)</label>
                    <input id="portal-product-quantity" class="form-control" type="number" name="quantity" min="@Model.MinimumSalesQuantity" step="1" value="@quantity" inputmode="numeric" />
                    <button class="btn btn-gold" type="submit">Adicionar ao carrinho</button>
                </form>
            }

            <div class="product-detail-actions d-flex flex-wrap gap-2 mt-3">
                <a class="btn btn-outline-dark" asp-action="Catalog">Continuar comprando</a>
                <a class="btn btn-outline-dark" asp-action="Cart">Ver carrinho</a>
            </div>
        </div>
    </div>
</section>

@section Head {
    <link rel="stylesheet" href="~/css/catalog.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/product-detail.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/product-image-fallback.js" asp-append-version="true"></script>
}
