@model IReadOnlyList<Orofoods.Web.Models.Product>
@{ ViewData["Title"] = "Catálogo B2B"; var prices=(Dictionary<int,decimal>)ViewBag.Prices; }
<section class="page-hero"><div class="container"><div class="eyebrow light"><span></span> Catálogo personalizado</div><h1>Produtos para a sua operação.</h1><p>Os preços abaixo já consideram sua tabela comercial.</p></div></section>
<section class="section"><div class="container"><form class="catalog-tools"><input name="q" value="@Context.Request.Query["q"]" placeholder="Pesquisar brioche, barbecue, maionese..."/><select name="category"><option value="">Todas as categorias</option><option>Pães</option><option>Molhos</option><option>Condimentos</option></select><button class="btn btn-dark">Buscar</button></form><div class="product-grid">@foreach(var p in Model){var price=prices.GetValueOrDefault(p.Id,p.BasePrice);<article class="product-card @(p.IsAvailable?"":"unavailable")"><div class="product-visual" style="--accent:@p.Accent"><span>@(p.Category == "Pães" ? "◒" : "●")</span><small>@p.Category</small>@if(!p.IsAvailable){<b>INDISPONÍVEL</b>}</div><div class="p-4"><small>@p.Sku · mínimo @p.MinimumCases cx.</small><h3>@p.Name</h3><p>@p.UnitDescription</p><div class="catalog-price"><strong>@price.ToString("C")</strong><span>/ caixa</span></div><button class="btn @(p.IsAvailable?"btn-gold":"btn-light") w-100" disabled="@(!p.IsAvailable)">@(p.IsAvailable?"Adicionar ao pedido":"Consulte um substituto")</button></div></article>}</div></div></section>
