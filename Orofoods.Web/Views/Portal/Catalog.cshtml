@model IReadOnlyList<Orofoods.Web.Models.Catalog.Product>
@{
    ViewData["Title"] = "Cat&aacute;logo B2B";
    var prices = (Dictionary<int, decimal>)ViewBag.Prices;
    var brands = (IEnumerable<string>)ViewBag.Brands;
    var cartQuantity = (int)ViewBag.CartQuantity;
    var cartProductQuantities = (Dictionary<int, int>)ViewBag.CartProductQuantities;
}
<section class="page-hero portal-catalog-hero">
    <div class="container">
        <div class="portal-catalog-heading">
            <div>
                <div class="eyebrow light"><span></span> Cat&aacute;logo</div>
                <h1>Cat&aacute;logo de produtos</h1>
                <p>Encontre os produtos dispon&iacute;veis e adicione o que precisa ao carrinho.</p>
            </div>
            <a class="btn btn-gold catalog-cart-link" asp-action="Cart" aria-label="Ver carrinho com @cartQuantity unidades">
                <i class="fa-solid fa-cart-shopping" aria-hidden="true"></i> Ver carrinho
                @if (cartQuantity > 0)
                {
                    <span class="catalog-cart-count" aria-hidden="true">@cartQuantity</span>
                }
            </a>
        </div>
    </div>
</section>
<section class="section portal-catalog-page">
    <div class="container">
        <form class="catalog-tools" data-portal-catalog-search autocomplete="off">
            <input name="q" value="@Context.Request.Query["q"]" placeholder="Pesquisar por nome, SKU, marca, código WMC ou EAN" aria-label="Pesquisar por nome, SKU, marca, código WMC ou EAN" autocomplete="off" />
            <select name="category" aria-label="Categoria">
                <option value="">Todas as categorias</option>
                @foreach (var category in Model.Select(x => x.ProductCategory).OfType<ProductCategory>().DistinctBy(x => x.Id).OrderBy(x => x.SortOrder))
                {
                    <option value="@category.Name" selected="@(Context.Request.Query["category"] == category.Name)">@category.Name</option>
                }
            </select>
            <select name="brand" aria-label="Marca">
                <option value="">Todas as marcas</option>
                @foreach (var brand in brands)
                {
                    <option value="@brand" selected="@(Context.Request.Query["brand"] == brand)">@brand</option>
                }
            </select>
            <button class="btn btn-gold btn-search" type="submit">Buscar</button>
        </form>
        <p class="visually-hidden" data-portal-catalog-results-status role="status" aria-live="polite"></p>
        <div class="product-grid" data-portal-catalog-grid>
            @foreach (var product in Model)
            {
                var price = prices.GetValueOrDefault(product.Id, product.BasePrice);
                var hasValidPrice = price > 0m;
                var officialImage = Orofoods.Web.Services.Catalog.BimboProductImageCatalog.Find(product.WmcCode);
                var image = officialImage?.UseCatalogImage == true ? null : product.Images.OrderByDescending(item => item.IsPrimary).ThenBy(item => item.SortOrder).FirstOrDefault();
                var catalogImageUrl = officialImage?.ImageUrl;
                var isInCart = cartProductQuantities.TryGetValue(product.Id, out var cartProductQuantity);
                var packageDescription = product.HasPackageSalesConfiguration
                    ? $"CX com {product.PackagesPerCase} PCT"
                    : product.UnitDescription;
                <article class="product-card @(product.IsCommerciallyAvailable ? "" : "unavailable")">
                    <div class="product-visual" style="--accent:@product.Accent;--bimbo-image-scale:@(Orofoods.Web.Services.Catalog.BimboProductImageCatalog.FormatVisualScale(image is null ? officialImage?.VisualScale ?? 1m : 1m))">
                        @if (officialImage is not null || image is not null)
                        {
                            <img data-product-image="true" data-fallback-stage="@(image is null ? "catalog" : "manual")" data-catalog-fallback="@(catalogImageUrl ?? string.Empty)" data-catalog-scale="@(Orofoods.Web.Services.Catalog.BimboProductImageCatalog.FormatVisualScale(officialImage?.VisualScale ?? 1m))" data-placeholder-src="@Url.Content("~/images/products/product-photo-unavailable.svg")" src="@(image is not null ? Url.RouteUrl("ProductMedia", new { imageId = image.Id }) : catalogImageUrl)" alt="@(image is not null && !string.IsNullOrWhiteSpace(image.AltText) ? image.AltText : officialImage?.ModelName ?? product.Name)" />
                        }
                        else
                        {
                            <img src="~/images/products/product-photo-unavailable.svg" alt="Foto do produto indispon&iacute;vel" loading="lazy" />
                        }
                        @if (officialImage?.IsIllustrative == true)
                        {
                            <small class="catalog-image-disclaimer">Imagem ilustrativa</small>
                        }
                        <small>@product.Category</small>
                        @if (!product.IsCommerciallyAvailable)
                        {
                            <b>INDISPON&Iacute;VEL</b>
                        }
                    </div>
                    <div class="p-4 catalog-card-body">
                        <small>@product.Sku | m&iacute;nimo @product.MinimumSalesQuantity @product.PriceUnitLabel</small>
                        <h3>@product.Name</h3>
                        <p class="catalog-packaging"><i class="fa-solid fa-box" aria-hidden="true"></i><span>@packageDescription</span></p>
                        @if (hasValidPrice)
                        {
                            <div class="catalog-price"><strong>@price.ToString("C")</strong><span>/ @product.PriceUnitLabel</span></div>
                            <form asp-action="AddToCart" method="post" class="catalog-add-form" data-catalog-add-form>
                                <input type="hidden" name="productId" value="@product.Id" />
                                <label for="quantity-@product.Id">Quantidade (@product.PriceUnitLabel)</label>
                                <div class="catalog-add-controls">
                                    <div class="catalog-quantity-stepper" data-catalog-quantity-stepper>
                                        <button class="catalog-quantity-button" type="button" data-catalog-quantity-decrease aria-label="Diminuir quantidade de @product.Name" disabled="@isInCart">&minus;</button>
                                        <input id="quantity-@product.Id" class="form-control" type="number" name="quantity" min="@product.MinimumSalesQuantity" step="1" value="@(isInCart ? cartProductQuantity : product.MinimumSalesQuantity)" inputmode="numeric" aria-label="Quantidade de @product.Name" disabled="@isInCart" />
                                        <button class="catalog-quantity-button" type="button" data-catalog-quantity-increase aria-label="Aumentar quantidade de @product.Name" disabled="@isInCart">+</button>
                                    </div>
                                    <button class="btn btn-gold @(isInCart ? "is-in-cart" : null)" type="submit" disabled="@(isInCart || !product.IsCommerciallyAvailable)">
                                        @if (isInCart)
                                        {
                                            <i class="fa-solid fa-check" aria-hidden="true"></i><span>No carrinho</span>
                                        }
                                        else
                                        {
                                            <span>Comprar</span>
                                        }
                                    </button>
                                </div>
                                <p class="catalog-add-status" aria-live="polite"></p>
                            </form>
                        }
                        else
                        {
                            <p class="alert alert-warning" role="status">Pre&ccedil;o indispon&iacute;vel para este cliente.</p>
                        }
                    </div>
                </article>
            }
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/product-image-fallback.js" asp-append-version="true"></script>
    <script src="~/js/catalog.js" asp-append-version="true"></script>
    <script src="~/js/portal-catalog-search.js" asp-append-version="true"></script>
}

@section Head {
    <link rel="stylesheet" href="~/css/catalog.css" asp-append-version="true" />
}
