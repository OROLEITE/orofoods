@model Orofoods.Web.ViewModels.RepeatOrderVm
@{ ViewData["Title"] = "Repetir pedido"; }
<section class="order-page"><div class="container"><a class="back-link" asp-action="Dashboard">← Voltar ao painel</a><div class="order-heading"><div><div class="eyebrow"><span></span> PEDIDO EM 30 SEGUNDOS</div><h1>Repita. Ajuste. Pronto.</h1><p>Baseado no pedido <b>@Model.SourceOrder.Number</b> de @Model.SourceOrder.CreatedAt.ToString("dd/MM/yyyy").</p></div><div class="timer"><span>◷</span><div><b>Leva menos de 30s</b><small>Se nada mudou, é só confirmar.</small></div></div></div>
@if(Context.Request.Query.ContainsKey("error")){<div class="alert alert-danger">@Context.Request.Query["error"]</div>}
<form asp-action="Confirm" method="post" id="repeatForm"><input type="hidden" name="SourceOrderId" value="@Model.SourceOrder.Id"/><div class="order-layout"><div class="order-items"><div class="order-list-head"><span>PRODUTO</span><span>QUANTIDADE</span><span>SUBTOTAL</span></div>@for(var i=0;i<Model.Items.Count;i++){var item=Model.Items[i];<div class="order-row @(item.Available?"":"disabled")" data-price="@item.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-min="@item.Minimum"><input type="hidden" name="ProductIds" value="@item.ProductId"/><div class="order-product"><div class="mini-product" style="--accent:#d99624">@(item.Name.Contains("Pão")?"◒":"●")</div><div><small>@item.Sku</small><h3>@item.Name</h3><span>@item.Unit</span>@if(!item.Available){<b class="stock-warning">Indisponível · substituto: @item.Substitute</b>}</div></div><div class="qty-control"><button type="button" class="qty-minus">−</button><input name="Quantities" value="@item.Quantity" inputmode="numeric" @(item.Available?null:"readonly")/><button type="button" class="qty-plus">+</button><small>Mín. @item.Minimum cx.</small></div><div class="line-price"><strong>@((item.Price*item.Quantity).ToString("C"))</strong><small>@item.Price.ToString("C")/cx.</small></div></div>}</div>
<aside class="order-summary"><div class="summary-card"><span class="summary-label">RESUMO DO PEDIDO</span><div class="summary-line"><span>Subtotal</span><b id="subtotal">—</b></div><div class="summary-line"><span>Frete</span><b class="free">Grátis</b></div><div class="minimum"><div><span>Pedido mínimo</span><b>@Model.Customer.MinimumOrder.ToString("C")</b></div><div class="progress"><div id="minimumProgress"></div></div><small id="minimumText"></small></div><div class="summary-total"><span>Total</span><strong id="total">—</strong></div><label>Endereço de entrega</label><select name="AddressId">@foreach(var a in Model.Addresses){<option value="@a.Id">@a.Label · @a.DeliveryDay</option>}</select><label>Data desejada</label><input name="RequestedDate" type="date" value="@DateTime.Today.AddDays(7).ToString("yyyy-MM-dd")"/><label>Pagamento</label><select name="PaymentMethod"><option>PIX</option><option>Prazo 14 dias</option></select><label>Observações</label><textarea name="Notes" rows="2" placeholder="Ex.: entregar após as 10h"></textarea><button class="btn btn-gold btn-lg w-100" id="confirmButton">Confirmar pedido →</button><small class="secure">✓ Valores conforme sua tabela · limite validado</small></div><div class="credit-box"><span>Crédito após este pedido</span><strong id="remainingCredit" data-credit="@(Model.Customer.CreditLimit-Model.Customer.CreditUsed)">—</strong></div></aside></div></form></div></section>
