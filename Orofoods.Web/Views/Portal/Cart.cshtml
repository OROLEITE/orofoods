@model Orofoods.Web.ViewModels.CartViewModel
@{ ViewData["Title"] = "Carrinho"; }
<section class="page-hero page-hero--compact"><div class="container"><div class="eyebrow light"><span></span> Pedido rapido</div><h1>Seu carrinho</h1><p>Revise as quantidades antes de seguir para o pedido.</p></div></section>
<section class="order-page"><div class="container">@if (TempData["ModelError"] is string error) { <div class="alert alert-warning">@error</div> } @if (!Model.Items.Any()) { <div class="empty-state"><h2>Seu carrinho est&aacute; vazio.</h2><a class="btn btn-gold" asp-action="Catalog">Ver cat&aacute;logo</a></div> } else { <div class="order-layout"><div class="order-items"><div class="order-list-head"><span>Produto</span><span>Quantidade</span><span>Subtotal</span></div>@foreach (var item in Model.Items) { <div class="order-row @(item.IsAvailable ? "" : "disabled")"><div class="order-product"><div><small>@item.Sku | @item.UnitDescription</small><h3>@item.Name</h3></div></div><form asp-action="UpdateCart" method="post" class="qty-control"><input type="hidden" name="productId" value="@item.ProductId" /><input name="quantity" type="number" min="0" value="@item.Quantity" aria-label="Quantidade de @item.Name" /><button class="btn btn-dark qty-update" type="submit">Atualizar</button></form><div class="line-price"><strong>@item.Subtotal.ToString("C")</strong><small>@item.UnitPrice.ToString("C") / caixa</small><form asp-action="RemoveFromCart" method="post"><input type="hidden" name="productId" value="@item.ProductId" /><button class="btn btn-link p-0" type="submit">Remover</button></form></div></div> }</div><aside class="summary-card"><div class="summary-label">RESUMO</div><div class="summary-line"><span>Subtotal</span><strong>@Model.Subtotal.ToString("C")</strong></div><div class="minimum"><div><span>Pedido m&iacute;nimo</span><strong>@Model.MinimumOrder.ToString("C")</strong></div><div class="progress"><div style="width:@(Model.MinimumOrder == 0 ? 100 : Math.Min(100, Model.Subtotal / Model.MinimumOrder * 100))%"></div></div><small>@(Model.RemainingForMinimum > 0 ? $"Faltam {Model.RemainingForMinimum:C} para atingir o mínimo." : "Pedido mínimo atingido.")</small></div><div class="summary-total"><span>Total</span><strong>@Model.Total.ToString("C")</strong></div><a class="btn btn-gold w-100" asp-action="Checkout">Ir para checkout</a><form asp-action="SaveCartAsModel" method="post" class="mt-3"><label for="name">Salvar como modelo</label><input id="name" name="name" class="form-control" maxlength="100" placeholder="Ex.: Pedido semanal" required /><button class="btn btn-outline-dark w-100 mt-2" type="submit">Salvar modelo</button></form><a class="d-block text-center mt-3" asp-action="SavedOrders">Meus pedidos modelo</a></aside></div> }</div></section>
