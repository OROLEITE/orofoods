@model Orofoods.Web.Models.Order
@{ ViewData["Title"] = "Pedido confirmado"; }
<section class="success-page"><div class="success-card"><div class="success-icon">✓</div><div class="eyebrow"><span></span> PEDIDO RECEBIDO</div><h1>Tudo certo!</h1><p>Seu pedido <strong>@Model.Number</strong> foi recebido e já entrou na nossa operação.</p><div class="success-details"><div><small>TOTAL</small><strong>@Model.Total.ToString("C")</strong></div><div><small>ENTREGA SOLICITADA</small><strong>@Model.RequestedDeliveryDate?.ToString("dd/MM/yyyy")</strong></div><div><small>DESTINO</small><strong>@Model.DeliveryAddress?.Label</strong></div></div><div class="status-track"><i class="done"></i><i></i><i></i><i></i></div><div class="status-labels"><span>Recebido</span><span>Análise</span><span>Separação</span><span>Entrega</span></div><div class="d-flex justify-content-center gap-3 mt-5"><a class="btn btn-dark" asp-action="Dashboard">Voltar ao painel</a><a class="btn btn-gold" href="https://wa.me/5519999999999?text=Olá!%20Quero%20acompanhar%20o%20pedido%20@Model.Number">Enviar pelo WhatsApp</a></div></div></section>
