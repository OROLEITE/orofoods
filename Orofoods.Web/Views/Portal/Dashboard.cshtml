@model Orofoods.Web.ViewModels.DashboardVm
@{ ViewData["Title"] = "Painel do cliente"; }
<div class="portal-dashboard">
        <div class="portal-top">
            <div><div class="eyebrow"><span></span> Compra recorrente</div><h1>Ol&aacute;, @Model.Customer.TradeName!</h1><p>Seu pr&oacute;ximo abastecimento est&aacute; a poucos cliques.</p></div>
            <a class="btn btn-dark portal-primary-action" asp-action="Catalog">Novo pedido</a>
        </div>
        <div class="commercial-bar">
            <div><small>SUA TABELA</small><strong>@Model.Customer.PriceTableName</strong></div>
            <div><small>PEDIDO M&Iacute;NIMO</small><strong>@Model.Customer.MinimumOrder.ToString("C")</strong></div>
            <div><small>CR&Eacute;DITO DISPON&Iacute;VEL</small><strong>@((Model.Customer.CreditLimit - Model.Customer.CreditUsed).ToString("C"))</strong></div>
        </div>
        @if (Model.LastOrder is not null)
        {
            <section class="repeat-hero">
                <div><div class="eyebrow light"><span></span> PEDIDO EM 30 SEGUNDOS</div><h2>Seu &uacute;ltimo pedido,<br/>pronto para repetir.</h2><p>Recalculamos pre&ccedil;os e disponibilidade antes da confirma&ccedil;&atilde;o.</p><a class="btn btn-gold btn-lg" asp-action="Repeat" asp-route-id="@Model.LastOrder.Id">Repetir &uacute;ltimo pedido</a></div>
                <div class="last-order-card"><small>&Uacute;LTIMO PEDIDO</small><h3>@Model.LastOrder.Number</h3><ul>@foreach (var item in Model.LastOrder.Items.Take(3)) { <li><span>@item.Quantity x @item.ProductNameSnapshot</span><b>@item.Subtotal.ToString("C")</b></li> }</ul><div class="order-total"><span>Total</span><strong>@Model.LastOrder.Total.ToString("C")</strong></div></div>
            </section>
        }
        else
        {
            <section class="repeat-hero">
                <div><div class="eyebrow light"><span></span> PRIMEIRO PEDIDO</div><h2>Monte seu primeiro<br/>abastecimento.</h2><p>Explore o cat&aacute;logo com os pre&ccedil;os da sua empresa.</p><a class="btn btn-gold btn-lg" asp-action="Catalog">Come&ccedil;ar pedido</a></div>
                <div class="last-order-card"><small>HIST&Oacute;RICO</small><h3>Nenhum pedido ainda</h3><p>Seus pedidos confirmados aparecer&atilde;o aqui para compra recorrente.</p></div>
            </section>
        }
        @if (Model.FrequentProducts.Any())
        {
            <section class="mt-5">
                <div class="portal-top"><div><div class="eyebrow"><span></span> Reposi&ccedil;&atilde;o inteligente</div><h2>Produtos frequentes</h2></div><a class="btn btn-outline-dark" asp-action="Catalog"><i class="fa-solid fa-book-open"></i> Ver cat&aacute;logo</a></div>
                <div class="metric-grid">
                    @foreach (var item in Model.FrequentProducts)
                    {
                        <article><small>@item.Product.Sku</small><h3>@item.Product.Name</h3><p>@item.OrderedQuantity unidades compradas</p><strong>@item.CurrentPrice.ToString("C")</strong><br/><a asp-action="Product" asp-route-id="@item.Product.Id">Ver produto</a></article>
                    }
                </div>
            </section>
        }
        <div class="metric-grid"><article><small>PEDIDOS EM ABERTO</small><strong>@Model.OpenOrders</strong></article><article><small>COMPRAS NO M&Ecirc;S</small><strong>@Model.MonthTotal.ToString("C")</strong></article></div>
</div>
