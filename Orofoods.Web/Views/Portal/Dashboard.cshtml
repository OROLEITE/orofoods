@model Orofoods.Web.ViewModels.DashboardVm
@{ ViewData["Title"] = "Painel do cliente"; }
<div class="portal-shell"><aside class="portal-side"><div><small>ÁREA DO CLIENTE</small><h3>@Model.Customer.TradeName</h3></div><nav><a class="active">⌂ <span>Visão geral</span></a><a asp-action="Catalog">▦ <span>Catálogo</span></a><a>▤ <span>Meus pedidos</span></a><a>♡ <span>Favoritos</span></a><a>⌖ <span>Endereços</span></a></nav><div class="side-help"><b>Precisa de ajuda?</b><span>Fale com seu consultor</span><a href="https://wa.me/5519999999999">Chamar no WhatsApp →</a></div></aside>
<div class="portal-main"><div class="portal-top"><div><div class="eyebrow"><span></span> Quarta-feira, @DateTime.Now.ToString("dd 'de' MMMM")</div><h1>Olá, @Model.Customer.TradeName! <span>👋</span></h1><p>Seu próximo abastecimento está a poucos cliques.</p></div><a class="btn btn-dark btn-lg" asp-action="Repeat" asp-route-id="@Model.LastOrder.Id">+ Novo pedido</a></div>
<div class="commercial-bar"><div><small>SUA TABELA</small><strong>@Model.Customer.PriceTableName</strong></div><div><small>PEDIDO MÍNIMO</small><strong>@Model.Customer.MinimumOrder.ToString("C")</strong></div><div><small>CRÉDITO DISPONÍVEL</small><strong>@((Model.Customer.CreditLimit-Model.Customer.CreditUsed).ToString("C"))</strong></div><div><small>PRÓXIMA ENTREGA</small><strong>@Model.Customer.Addresses.First().DeliveryDay</strong></div></div>
<section class="repeat-hero"><div><div class="eyebrow light"><span></span> PEDIDO EM 30 SEGUNDOS</div><h2>Seu último pedido,<br/>pronto para repetir.</h2><p>Já deixamos tudo preenchido. Revise as quantidades, altere o que mudou e confirme.</p><a class="btn btn-gold btn-lg" asp-action="Repeat" asp-route-id="@Model.LastOrder.Id">↻ Repetir pedido</a></div><div class="last-order-card"><div class="d-flex justify-content-between"><span>ÚLTIMO PEDIDO</span><b>Entregue ✓</b></div><h3>@Model.LastOrder.Number</h3><small>@Model.LastOrder.CreatedAt.ToString("dd/MM/yyyy") · @Model.LastOrder.Items.Count produtos</small><ul>@foreach(var item in Model.LastOrder.Items.Take(3)){<li><span>@item.Quantity× @item.Product!.Name</span><b>@((item.Quantity*item.UnitPrice).ToString("C"))</b></li>}</ul><div class="order-total"><span>Total</span><strong>@Model.LastOrder.Total.ToString("C")</strong></div></div></section>
<div class="metric-grid"><article><small>PEDIDOS EM ABERTO</small><strong>@Model.OpenOrders</strong><span>Tudo sob controle</span></article><article><small>COMPRAS NO MÊS</small><strong>@Model.MonthTotal.ToString("C")</strong><span>Condição @Model.Customer.PaymentTerms</span></article><article><small>ENDEREÇOS ATIVOS</small><strong>@Model.Customer.Addresses.Count</strong><span>Entrega por região configurada</span></article></div>
</div></div>
