@model IReadOnlyList<Orofoods.Web.Models.Catalog.Product>
@{ ViewData["Title"] = "Meus favoritos"; var prices = (Dictionary<int, decimal>)ViewBag.Prices; }
<section class="page-hero portal-page-hero"><div class="container"><div class="eyebrow light"><span></span> Seus favoritos</div><h1>Produtos favoritos</h1><p>Acesse rapidamente os produtos que voc&ecirc; compra com mais frequ&ecirc;ncia.</p></div></section>
<section class="section portal-page"><div class="container">@if (!Model.Any()){<div class="empty-state"><h2>Você ainda não tem favoritos.</h2><p>Salve produtos no catálogo para montar sua reposição mais rápido.</p><a class="btn btn-gold" asp-action="Catalog">Ir para o catálogo</a></div>}else{<div class="product-grid">@foreach(var product in Model){var price = prices.GetValueOrDefault(product.Id, product.BasePrice);<article class="product-card"><div class="product-visual" style="--accent:@product.Accent"><span>●</span><small>@product.Category</small></div><div class="p-4"><small>@product.Sku · @product.UnitDescription</small><h3>@product.Name</h3><div class="catalog-price"><strong>@price.ToString("C")</strong><span>/ caixa</span></div><form asp-action="ToggleFavorite" method="post"><input type="hidden" name="productId" value="@product.Id"/><button class="btn btn-outline-dark w-100" type="submit">Remover dos favoritos</button></form></div></article>}</div>}</div></section>
