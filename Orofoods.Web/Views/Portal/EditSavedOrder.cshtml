@model Orofoods.Web.ViewModels.SavedOrderEditViewModel
@{ ViewData["Title"] = "Editar pedido modelo"; }
<section class="page-hero portal-page-hero"><div class="container"><a class="back-link" asp-action="SavedOrders">&larr; Pedidos modelo</a><h1>Editar modelo</h1></div></section>
<section class="section portal-page"><div class="container"><form asp-action="EditSavedOrder" method="post"><input asp-for="Id" type="hidden"/><div class="mb-4"><label asp-for="Name">Nome do modelo</label><input asp-for="Name" class="form-control"/><span asp-validation-for="Name" class="text-danger"></span></div><div class="order-items">@for (var i = 0; i < Model.Items.Count; i++) { <div class="order-row"><div><input type="hidden" asp-for="Items[i].ProductId"/><h3>Produto #@Model.Items[i].ProductId</h3></div><div><label>Quantidade</label><input asp-for="Items[i].Quantity" type="number" min="1" class="form-control"/></div></div> }</div><button class="btn btn-gold mt-4" type="submit">Salvar alteracoes</button></form></div></section>
