@model IEnumerable<Orofoods.Web.Models.Orders.SavedOrder>
@{ ViewData["Title"] = "Pedidos modelo"; }
<section class="page-hero portal-page-hero"><div class="container"><div class="eyebrow light"><span></span> Reposi&ccedil;&atilde;o r&aacute;pida</div><h1>Pedidos modelo</h1><p>Carregue um modelo e os pre&ccedil;os ser&atilde;o recalculados para sua tabela atual.</p></div></section>
<section class="section portal-page"><div class="container">@if (TempData["ModelError"] is string error) { <div class="alert alert-warning">@error</div> } @if (!Model.Any()) { <div class="empty-state"><h2>Nenhum modelo salvo.</h2><p>Monte um carrinho e salve-o para repetir sua reposi&ccedil;&atilde;o.</p><a class="btn btn-gold" asp-action="Catalog">Ir para o cat&aacute;logo</a></div> } else { <div class="product-grid">@foreach (var item in Model) { <article class="product-card"><div class="p-4"><small>@item.Items.Count itens</small><h2>@item.Name</h2><p>Atualizado em @item.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy")</p><form asp-action="LoadSavedOrder" method="post"><input type="hidden" name="id" value="@item.Id"/><button class="btn btn-gold w-100" type="submit">Carregar no carrinho</button></form><a class="btn btn-outline-dark w-100 mt-2" asp-action="EditSavedOrder" asp-route-id="@item.Id">Editar</a><form asp-action="DeactivateSavedOrder" method="post" class="mt-2"><input type="hidden" name="id" value="@item.Id"/><button class="btn btn-link text-danger w-100" type="submit">Excluir modelo</button></form></div></article> }</div> }</div></section>
