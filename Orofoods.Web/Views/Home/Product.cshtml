@model Orofoods.Web.Models.Catalog.Product
@{ ViewData["Title"] = Model.Name; var primaryImage = Model.Images.OrderByDescending(image => image.IsPrimary).ThenBy(image => image.SortOrder).FirstOrDefault(); }
<section class="page-hero"><div class="container"><a class="back-link" asp-action="Products"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Produtos</a><div class="eyebrow light mt-4"><span></span> @Model.Category</div><h1>@Model.Name</h1><p>@Model.Sku &middot; @Model.Brand</p></div></section>
<section class="section">
    <div class="container product-detail">
        <figure class="product-detail-media" style="--accent:@Model.Accent">
            @if (primaryImage is not null) { <img src="@primaryImage.Url" alt="@primaryImage.AltText" /> }
            <figcaption>Imagem ilustrativa do produto.</figcaption>
        </figure>
        <div class="product-detail-copy">
            <p class="product-detail-kicker">@Model.Brand &middot; @Model.UnitDescription</p>
            <h2>Descri&#231;&#227;o do produto</h2>
            <p>@Model.Description</p>
            <dl>
                <dt>Disponibilidade</dt><dd>@(Model.IsAvailable ? "Disponível" : "Indisponível no momento")</dd>
                @if (!string.IsNullOrWhiteSpace(Model.StorageInformation)) { <dt>Armazenamento</dt><dd>@Model.StorageInformation</dd> }
                @if (!string.IsNullOrWhiteSpace(Model.Ingredients)) { <dt>Ingredientes</dt><dd>@Model.Ingredients</dd> }
            </dl>
            <div class="product-detail-actions d-flex flex-wrap gap-2">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    if (User.IsInRole("Administrador"))
                    {
                        <a class="btn btn-gold" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="fa-solid fa-gauge-high"></i> Administra&#231;&#227;o</a>
                    }
                    else
                    {
                        <a class="btn btn-gold" asp-controller="Portal" asp-action="Catalog">Ver cat&aacute;logo</a>
                    }
                }
                else
                {
                    <a class="btn btn-gold" asp-controller="CustomerRegistration" asp-action="Register">Cadastre sua empresa</a>
                    <a class="btn btn-outline-dark" asp-area="Identity" asp-page="/Account/Login">Entrar</a>
                }
            </div>
        </div>
    </div>
</section>
