@model Orofoods.Web.ViewModels.PublicHomeViewModel
@{
    ViewData["Title"] = "Orofoods | Distribuição para food service";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isAdministrator = User.IsInRole("Administrador");
    var isSalesRepresentative = User.IsInRole("Vendedor");
    var isCommercialManager = User.IsInRole("GerenteComercial");
    var customerDashboardUrl = Url.Action("Dashboard", "Portal", new { area = "" }) ?? "/Portal/Dashboard";
    var loginDashboardUrl = Url.Page("/Account/Login", values: new { area = "Identity", returnUrl = customerDashboardUrl }) ?? "/Identity/Account/Login?returnUrl=%2FPortal%2FDashboard";
    var customerCatalogUrl = Url.Action("Catalog", "Portal", new { area = "" }) ?? "/Portal/Catalog";
    var loginCatalogUrl = Url.Page("/Account/Login", values: new { area = "Identity", returnUrl = customerCatalogUrl }) ?? "/Identity/Account/Login?returnUrl=%2FPortal%2FCatalog";
    var adminDashboardUrl = Url.Action("Index", "Dashboard", new { area = "Admin" }) ?? "/Admin/Dashboard";
    var sellerDashboardUrl = Url.Action("Index", "Dashboard", new { area = "Vendedor" }) ?? "/Vendedor";
    var commercialDashboardUrl = Url.Action("Index", "Commercial", new { area = "Admin" }) ?? "/Admin/Commercial";
    var portalUrl = !isAuthenticated ? loginDashboardUrl
        : isAdministrator ? adminDashboardUrl
        : isSalesRepresentative ? sellerDashboardUrl
        : isCommercialManager ? commercialDashboardUrl
        : customerDashboardUrl;
}

<div class="public-home">
    @if (TempData["RegistrationSuccess"] is string registrationSuccess)
    {
        <div class="container pt-3"><div class="alert alert-success mb-0" role="status">@registrationSuccess</div></div>
    }

    <section class="public-home-hero" aria-labelledby="public-home-title">
        <div class="container public-home-hero-grid">
            <div class="public-home-hero-copy">
                <p class="public-home-eyebrow"><span aria-hidden="true"></span> Orofoods</p>
                <h1 id="public-home-title">Soluções para o seu Food Service</h1>
                <p class="public-home-hero-description">Pães e produtos para hamburguerias, restaurantes e lanchonetes.</p>
                <div class="public-home-hero-actions">
                    @if (isAuthenticated)
                    {
                        <a class="btn public-home-primary-action" href="@portalUrl">Acessar meu portal</a>
                    }
                    else
                    {
                        <a class="btn public-home-primary-action" asp-controller="Home" asp-action="Products">Conheça nossos produtos</a>
                    }
                    @if (isAuthenticated)
                    {
                        <a class="btn public-home-secondary-action" asp-controller="Home" asp-action="Products">Conheça nossos produtos</a>
                    }
                    else
                    {
                        <a class="btn public-home-secondary-action" asp-controller="CustomerRegistration" asp-action="Register">Cadastre sua empresa</a>
                    }
                </div>
                @if (!isAuthenticated)
                {
                    <p class="public-home-login-note">Já é cliente? <a href="@loginCatalogUrl">Entrar no portal</a></p>
                }
            </div>
            <div class="public-home-hero-image">
                <img src="~/images/orofoods-hero.png" asp-append-version="true" alt="Hambúrguer artesanal e pães em uma cozinha profissional" width="1672" height="941" fetchpriority="high" decoding="async" />
                <div class="public-home-hero-caption"><i class="fa-solid fa-circle-check" aria-hidden="true"></i><span>Inspiração para cozinhas profissionais</span></div>
            </div>
        </div>
    </section>

    @if (Model.Categories.Count > 0)
    {
        <section class="public-home-category-section" aria-labelledby="public-home-categories-title">
            <div class="container">
                <div class="public-home-section-heading public-home-category-heading">
                    <div>
                        <p class="public-home-eyebrow"><span aria-hidden="true"></span> Navegue pelo catálogo</p>
                        <h2 id="public-home-categories-title">Categorias disponíveis</h2>
                    </div>
                    <a class="public-home-text-link" asp-controller="Home" asp-action="Products">Ver todos os produtos <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
                </div>
                <div class="public-home-categories">
                    @foreach (var category in Model.Categories)
                    {
                        <a class="public-home-category-card" asp-controller="Home" asp-action="Products" asp-route-category="@category.Slug">
                            <span class="public-home-category-icon"><i class="fa-solid fa-layer-group" aria-hidden="true"></i></span>
                            <span>@category.Name</span>
                            <i class="fa-solid fa-arrow-up-right-from-square public-home-category-arrow" aria-hidden="true"></i>
                        </a>
                    }
                </div>
            </div>
        </section>
    }

    <section class="public-home-featured" id="produtos" aria-labelledby="public-home-featured-title">
        <div class="container">
            <div class="public-home-section-heading">
                <div>
                    <p class="public-home-eyebrow"><span aria-hidden="true"></span> Seleção Orofoods</p>
                    <h2 id="public-home-featured-title">Produtos para sua operação</h2>
                    <p class="public-home-section-description">Conheça os itens disponíveis no catálogo público e encontre opções para o dia a dia da sua cozinha.</p>
                </div>
                <a class="public-home-text-link" asp-controller="Home" asp-action="Products">Explorar catálogo <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
            </div>

            @if (Model.Products.Count == 0)
            {
                <div class="public-home-empty" role="status">
                    <i class="fa-regular fa-rectangle-list" aria-hidden="true"></i>
                    <p>Estamos preparando a seleção de produtos. Consulte o catálogo completo em breve.</p>
                    <a class="public-home-text-link" asp-controller="Home" asp-action="Products">Abrir catálogo</a>
                </div>
            }
            else
            {
                <div class="public-home-product-grid">
                    @foreach (var product in Model.Products)
                    {
                        var image = product.Images.OrderByDescending(item => item.IsPrimary).ThenBy(item => item.SortOrder).FirstOrDefault();
                        var officialImage = Orofoods.Web.Services.Catalog.BimboProductImageCatalog.Find(product.WmcCode);
                        <article class="public-home-product-card">
                            <a class="public-home-product-media" asp-controller="Home" asp-action="Product" asp-route-id="@product.Id" aria-label="Conhecer @product.Name">
                                @if (officialImage is not null || image is not null)
                                {
                                    <img data-product-image="true" data-fallback-stage="@(image is null ? "catalog" : "manual")" data-catalog-fallback="@(officialImage?.ImageUrl ?? string.Empty)" data-placeholder-src="@Url.Content("~/images/products/product-photo-unavailable.svg")" src="@(image is not null ? Url.RouteUrl("ProductMedia", new { imageId = image.Id }) : officialImage!.ImageUrl)" alt="@(image is not null && !string.IsNullOrWhiteSpace(image.AltText) ? image.AltText : officialImage?.ModelName ?? product.Name)" loading="lazy" decoding="async" />
                                }
                                else
                                {
                                    <span class="public-home-product-placeholder"><i class="fa-regular fa-image" aria-hidden="true"></i><span>Imagem indisponível</span></span>
                                }
                            </a>
                            <div class="public-home-product-body">
                                <p class="public-home-product-brand">@product.Brand</p>
                                <h3><a asp-controller="Home" asp-action="Product" asp-route-id="@product.Id">@product.Name</a></h3>
                                <p class="public-home-product-unit">@product.UnitDescription</p>
                                <a class="public-home-product-action" asp-controller="Home" asp-action="Product" asp-route-id="@product.Id">Conhecer produto <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
                            </div>
                        </article>
                    }
                </div>
            }

        </div>
    </section>

@section Scripts {
    <script src="~/js/product-image-fallback.js" asp-append-version="true"></script>
}
</div>
