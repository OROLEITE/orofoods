@model IReadOnlyList<Orofoods.Web.Models.Product>
@{ ViewData["Title"] = "Distribuição B2B para food service"; }
<section class="hero"><div class="container hero-content"><div class="eyebrow light"><span></span> Distribuição B2B · Campinas e região</div><h1>O pedido da sua<br/>hamburgueria em<br/><em>30 segundos.</em></h1><p>Entre, repita seu último pedido, altere só o que mudou e pronto. Pães, molhos e congelados com a condição comercial da sua empresa.</p><div class="d-flex flex-wrap gap-3"><a class="btn btn-gold btn-lg" asp-controller="Portal" asp-action="Dashboard">Repetir meu pedido →</a><a class="btn btn-ghost btn-lg" asp-controller="Portal" asp-action="Catalog">Ver catálogo</a></div><div class="hero-proof"><strong>4,9</strong><span class="stars">★★★★★</span><span>Operação confiável para<br/>mais de 180 negócios</span></div></div></section>
<section class="trust-strip"><div class="container"><span>FEITO PARA O FOOD SERVICE</span><span>Preço por cliente</span><span>Entrega programada</span><span>Reposição sem atrito</span><span>Atendimento humano</span></div></section>
<section class="section" id="como-funciona"><div class="container"><div class="section-heading"><div><div class="eyebrow"><span></span> Menos cliques, mais operação</div><h2>Seu estoque resolvido<br/>antes do café esfriar.</h2></div><p>A plataforma já conhece sua rotina, condição comercial e dia de entrega. Você só confere o que mudou.</p></div><div class="steps-grid"><article><b>01</b><div class="step-icon">↗</div><h3>Entre na sua conta</h3><p>Seu catálogo, preços e condições já aparecem personalizados.</p></article><article class="featured"><b>02</b><div class="step-icon">↻</div><h3>Repita o último pedido</h3><p>Quantidades vêm preenchidas. Ajuste só o necessário.</p></article><article><b>03</b><div class="step-icon">✓</div><h3>Confira e confirme</h3><p>Veja mínimos, crédito e próxima entrega antes de enviar.</p></article></div><div class="text-center mt-5"><a class="text-link" asp-controller="Portal" asp-action="Dashboard">Experimentar o pedido em 30 segundos →</a></div></div></section>
<section class="section products-section"><div class="container"><div class="section-heading"><div><div class="eyebrow"><span></span> Seleção Orofoods</div><h2>Os essenciais da<br/>sua chapa.</h2></div><a class="text-link" asp-controller="Portal" asp-action="Catalog">Ver catálogo completo →</a></div><div class="product-grid">@foreach(var p in Model){<article class="product-card"><div class="product-visual" style="--accent:@p.Accent"><span>@(p.Category == "Pães" ? "◒" : "●")</span><small>@p.Category</small></div><div class="p-4"><small>@p.Sku · @p.UnitDescription</small><h3>@p.Name</h3><p>@p.Description</p><a asp-controller="Portal" asp-action="Catalog">Ver no catálogo →</a></div></article>}</div></div></section>
<section class="section about" id="sobre"><div class="container about-grid"><div><div class="eyebrow light"><span></span> Parceiro de verdade</div><h2>Não entregamos caixas.<br/>Entregamos constância.</h2></div><div><p>A Orofoods entende que produto padronizado, entrega previsível e reposição rápida mantêm sua cozinha girando. Por isso unimos curadoria, distribuição e tecnologia em uma relação feita para durar.</p><div class="stats"><div><strong>98%</strong><span>entregas no prazo</span></div><div><strong>180+</strong><span>operações atendidas</span></div><div><strong>12h</strong><span>resposta comercial</span></div></div></div></div></section>
