@model Orofoods.Web.ViewModels.PublicHomeViewModel
@{
    ViewData["Title"] = "Orofoods | Distribuição para food service";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isAdministrator = User.IsInRole("Administrador");
    var isSalesRepresentative = User.IsInRole("Vendedor");
    var isCommercialManager = User.IsInRole("GerenteComercial");
    var isCustomer = ViewBag.CustomerPurchaseAuthorized as bool? == true && !isSalesRepresentative;
    var selectedCustomerId = ViewBag.CustomerId as int?;
    var customerDashboardUrl = Url.Action("Dashboard", "Portal", new { area = "" }) ?? "/Portal/Dashboard";
    var customerCatalogUrl = Url.Action("Catalog", "Portal", new { area = "" }) ?? "/Portal/Catalog";
    var publicCatalogUrl = Url.Action("Products", "Home", new { area = "" }) ?? "/produtos";
    var loginCatalogUrl = Url.Page("/Account/Login", values: new { area = "Identity", returnUrl = publicCatalogUrl }) ?? "/Identity/Account/Login?returnUrl=%2Fprodutos";
    var adminDashboardUrl = Url.Action("Index", "Dashboard", new { area = "Admin" }) ?? "/Admin/Dashboard";
    var sellerDashboardUrl = Url.Action("Index", "Dashboard", new { area = "Vendedor" }) ?? "/Vendedor";
    var commercialDashboardUrl = Url.Action("Index", "Commercial", new { area = "Admin" }) ?? "/Admin/Commercial";
    var sellerOrderEntryUrl = Url.Action("New", "OrderDrafts", new { area = "Vendedor", customerId = selectedCustomerId }) ?? "/Vendedor/Rascunhos/Novo";
    var portalUrl = !isAuthenticated ? loginCatalogUrl
        : isAdministrator ? adminDashboardUrl
        : isSalesRepresentative ? sellerDashboardUrl
        : isCommercialManager ? commercialDashboardUrl
        : customerDashboardUrl;
    var orderUrl = !isAuthenticated ? loginCatalogUrl
        : isAdministrator ? adminDashboardUrl
        : isSalesRepresentative ? sellerOrderEntryUrl
        : isCommercialManager ? commercialDashboardUrl
        : isCustomer ? customerCatalogUrl
        : portalUrl;
    ViewData["LoginReturnUrl"] = Url.Action("Products", "Home", new { area = "" });
}

<div class="public-home">
    @if (TempData["RegistrationSuccess"] is string registrationSuccess)
    {
        <div class="container pt-3"><div class="alert alert-success mb-0" role="status">@registrationSuccess</div></div>
    }

    <div class="container public-home-shell">
        <section class="public-home-hero" aria-labelledby="public-home-title">
            <div class="public-home-hero-copy">
                <p class="public-home-eyebrow">Orofoods &middot; Food service</p>
                <h1 id="public-home-title">Seu pr&oacute;ximo pedido come&ccedil;a aqui.</h1>
                <p class="public-home-hero-description">P&atilde;es e produtos para hamburguerias, restaurantes e lanchonetes.</p>
                <div class="public-home-hero-actions">
                    <a class="btn public-home-primary-action" href="@orderUrl"><i class="fa-solid fa-cart-shopping" aria-hidden="true"></i> Fazer pedido</a>
                    @if (isCustomer)
                    {
                        <a class="btn public-home-secondary-action" href="@portalUrl">Meu portal</a>
                    }
                    else if (!isAuthenticated)
                    {
                        <a class="btn public-home-secondary-action" asp-area="" asp-controller="CustomerRegistration" asp-action="Register">Criar minha conta</a>
                    }
                </div>
            </div>
            <figure class="public-home-hero-media">
                <img src="~/images/home/banner-hamburguer.webp" alt="Hamb&uacute;rguer artesanal servido com batatas" fetchpriority="high" />
            </figure>
        </section>

        <section class="public-home-search-panel" aria-label="Buscar produtos">
            <form method="get" asp-controller="Home" asp-action="Products" class="public-home-search" role="search">
                <label class="public-home-search-field">
                    <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                    <input type="search" name="search" placeholder="O que voc&ecirc; procura para seu neg&oacute;cio?" aria-label="Buscar produtos no cat&aacute;logo" autocomplete="off" />
                </label>
                <button class="btn public-home-primary-action" type="submit">Buscar</button>
            </form>
            <nav class="public-home-chips" aria-label="Atalhos de categorias">
                <a asp-controller="Home" asp-action="Products" asp-route-search="brioche">Brioche</a>
                <a asp-controller="Home" asp-action="Products" asp-route-search="gergelim">Gergelim</a>
                <a asp-controller="Home" asp-action="Products" asp-route-search="australiano">Australiano</a>
                <a asp-controller="Home" asp-action="Products" asp-route-search="congel">Congelados</a>
            </nav>
        </section>

        <section class="public-home-featured public-products-section" id="produtos" aria-labelledby="public-home-featured-title">
            <div class="public-home-section-heading">
                <h2 id="public-home-featured-title">Produtos em destaque</h2>
                <a class="public-home-text-link" asp-controller="Home" asp-action="Products">Ver cat&aacute;logo <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
            </div>

            @if (Model.Products.Count == 0)
            {
                <div class="public-home-empty" role="status">
                    <i class="fa-regular fa-rectangle-list" aria-hidden="true"></i>
                    <p>Estamos preparando a sele&ccedil;&atilde;o de produtos. Consulte o cat&aacute;logo completo em breve.</p>
                    <a class="public-home-text-link" asp-controller="Home" asp-action="Products">Abrir cat&aacute;logo</a>
                </div>
            }
            else
            {
                <div class="product-grid public-quick-buy-grid">
                    @foreach (var product in Model.Products)
                    {
                        <partial name="_PublicProductCard" model="product" />
                    }
                </div>
            }
        </section>
    </div>
</div>

@section Head {
    <link rel="stylesheet" href="~/css/catalog.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/product-image-fallback.js" asp-append-version="true"></script>
    @if (isCustomer) { <script src="~/js/catalog.js" asp-append-version="true"></script> }
}
