@model Orofoods.Web.ViewModels.PublicProductCatalogViewModel
@{ ViewData["Title"] = "Produtos"; }
<section class="page-hero institutional-hero"><div class="container"><div class="eyebrow light"><span></span> Sele&ccedil;&atilde;o Orofoods</div><h1>Produtos para sua opera&ccedil;&atilde;o.</h1><p>Conhe&ccedil;a nossa linha para hamburguerias, lanchonetes e food service.</p></div></section>
<section class="section products-section"><div class="container"><form method="get" class="catalog-tools"><input name="search" value="@Model.Search" placeholder="Buscar por nome, SKU ou marca"/><select name="category"><option value="">Todas as categorias</option>@foreach(var category in Model.Categories){<option value="@category.Slug" selected="@(Model.Category == category.Slug)">@category.Name</option>}</select><button class="btn btn-gold" type="submit">Buscar</button></form>@if (!Model.Products.Any()){<div class="empty-state"><h2>Nenhum produto encontrado.</h2><p>Tente ajustar sua busca ou categoria.</p></div>}else{<div class="product-grid">@foreach(var product in Model.Products){var image = product.Images.OrderByDescending(item => item.IsPrimary).ThenBy(item => item.SortOrder).FirstOrDefault();<article class="product-card"><div class="product-visual" style="--accent:@product.Accent">@if(image is not null){<img src="@Url.RouteUrl("ProductMedia", new { imageId = image.Id })" alt="@image.AltText"/>}else{<span>&bull;</span>}<small>@product.Category</small></div><div class="p-4"><small>@product.Sku &middot; @product.UnitDescription</small><h3>@product.Name</h3><p>@product.Description</p><a asp-action="Product" asp-route-id="@product.Id">Conhecer produto &rarr;</a></div></article>}</div>}</div></section>
