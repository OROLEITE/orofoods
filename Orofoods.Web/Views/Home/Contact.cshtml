@model Orofoods.Web.ViewModels.ContactViewModel
@{ ViewData["Title"] = "Contato"; }
<section class="page-hero institutional-hero"><div class="container"><div class="eyebrow light"><span></span> Atendimento Orofoods</div><h1>Vamos conversar.</h1><p>Conte sobre sua opera&ccedil;&atilde;o. Nossa equipe retorna para entender sua necessidade e orientar o pr&oacute;ximo passo.</p></div></section>
<section class="section institutional-section"><div class="container"><div class="row g-5 align-items-start"><div class="col-lg-4"><div class="eyebrow"><span></span> Fale com a equipe</div><h2 class="contact-title">Seu abastecimento come&ccedil;a por uma boa conversa.</h2><p class="contact-copy">Informe os dados da sua empresa. O contato &eacute; comercial e voltado a opera&ccedil;&otilde;es de food service.</p><div class="contact-highlights"><div><i class="fa-solid fa-clock" aria-hidden="true"></i><span>Retorno comercial personalizado</span></div><div><i class="fa-solid fa-shield-halved" aria-hidden="true"></i><span>Dados tratados com seguran&ccedil;a</span></div></div></div><div class="col-lg-8"><form asp-action="Contact" method="post" asp-antiforgery="true" class="contact-form contact-form--enhanced"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>@if (TempData["ContactSuccess"] is string success){<div class="alert alert-success">@success</div>}<div class="row g-3"><div class="col-md-6"><label asp-for="Name">Nome</label><input asp-for="Name"/><span asp-validation-for="Name" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Company">Empresa</label><input asp-for="Company"/></div><div class="col-md-6"><label asp-for="Email">E-mail</label><input asp-for="Email"/><span asp-validation-for="Email" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Phone">Telefone</label><input asp-for="Phone"/><span asp-validation-for="Phone" class="text-danger"></span></div><div class="col-md-6"><label asp-for="WhatsApp">WhatsApp</label><input asp-for="WhatsApp"/></div><div class="col-md-6"><label asp-for="City">Cidade</label><input asp-for="City"/><span asp-validation-for="City" class="text-danger"></span></div><div class="col-12"><label asp-for="Message">Mensagem</label><textarea asp-for="Message" rows="5"></textarea><span asp-validation-for="Message" class="text-danger"></span></div><div class="col-12"><label class="consent"><input asp-for="AcceptPrivacyPolicy"/> Li e concordo com a <a asp-action="Privacy">Pol&iacute;tica de Privacidade</a>.</label><span asp-validation-for="AcceptPrivacyPolicy" class="text-danger"></span></div><div class="col-12"><button class="btn btn-gold" type="submit"><i class="fa-solid fa-paper-plane me-2" aria-hidden="true"></i>Enviar mensagem</button></div></div></form></div></div></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
