@{ ViewData["Title"] = "Como funciona"; ViewData["BodyClass"] = "public-sticky-footer"; }
<section class="page-hero institutional-hero public-page-hero">
    <div class="container">
        <div class="eyebrow light"><span></span> Simples para operar</div>
        <h1>Reposi&ccedil;&atilde;o sem atrito.</h1>
        <p>Do cadastro ao pedido confirmado, cada etapa foi organizada para ganhar tempo na sua opera&ccedil;&atilde;o.</p>
    </div>
</section>

<section class="section institutional-section public-institutional-section">
    <div class="container">
        <div class="section-heading institutional-heading">
            <div><div class="eyebrow"><span></span> Pedido B2B</div><h2>Um fluxo direto, com acompanhamento.</h2></div>
            <p>Voc&ecirc; acessa apenas o cat&aacute;logo e as condi&ccedil;&otilde;es comerciais liberadas para a sua empresa.</p>
        </div>
        <div class="process-flow">
            <article class="process-step">
                <div class="process-step-top"><span class="process-number">01</span><span class="process-label">Cadastro</span></div>
                <div class="process-icon"><i class="fa-solid fa-building" aria-hidden="true"></i></div>
                <h3>Cadastre sua empresa</h3>
                <p>Envie os dados da sua opera&ccedil;&atilde;o para iniciar a an&aacute;lise comercial.</p>
                <span class="process-status"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i> An&aacute;lise comercial</span>
            </article>
            <article class="process-step process-step--active">
                <div class="process-step-top"><span class="process-number">02</span><span class="process-label">Acesso</span></div>
                <div class="process-icon"><i class="fa-solid fa-basket-shopping" aria-hidden="true"></i></div>
                <h3>Acesse seu cat&aacute;logo</h3>
                <p>Consulte produtos, pre&ccedil;os e condi&ccedil;&otilde;es liberadas para sua empresa.</p>
                <span class="process-status"><i class="fa-solid fa-lock" aria-hidden="true"></i> Condi&ccedil;&otilde;es personalizadas</span>
            </article>
            <article class="process-step">
                <div class="process-step-top"><span class="process-number">03</span><span class="process-label">Entrega</span></div>
                <div class="process-icon"><i class="fa-solid fa-truck-ramp-box" aria-hidden="true"></i></div>
                <h3>Confirme o pedido</h3>
                <p>A Orofoods separa os itens e programa sua entrega com acompanhamento.</p>
                <span class="process-status"><i class="fa-solid fa-route" aria-hidden="true"></i> Entrega programada</span>
            </article>
        </div>
    </div>
</section>
