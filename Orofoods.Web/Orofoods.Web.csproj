<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-Orofoods.Web-86bd5ef3-4ca2-495a-896c-bab45dc8c6a0</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.13.2" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" Version="1.5.0" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Keys" Version="1.5.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.24.0" />
    <PackageReference Include="FirebirdSql.Data.FirebirdClient" Version="10.3.4" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.11" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\tools\OrofoodsProductionDbReadOnlyCrm\OrofoodsProductionDbReadOnlyCrm.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="PublishProductionReadOnlyDiagnostic" AfterTargets="Publish">
    <PropertyGroup>
      <ProductionReadOnlyDiagnosticPublishDir>$(PublishDir)tools</ProductionReadOnlyDiagnosticPublishDir>
      <ProductionReadOnlyDiagnosticProject>$(MSBuildProjectDirectory)\..\tools\OrofoodsProductionDbReadOnlyCrm\OrofoodsProductionDbReadOnlyCrm.csproj</ProductionReadOnlyDiagnosticProject>
    </PropertyGroup>
    <MakeDir Directories="$(ProductionReadOnlyDiagnosticPublishDir)" />
    <Exec Command="dotnet publish &quot;$(ProductionReadOnlyDiagnosticProject)&quot; --configuration $(Configuration) --runtime linux-x64 --self-contained false --no-restore --output &quot;$(ProductionReadOnlyDiagnosticPublishDir)&quot; -p:UseAppHost=false -p:DebugType=None" />
  </Target>

</Project>
