@page
@model Microsoft.AspNetCore.Identity.UI.V5.Pages.Account.Internal.ForgotPasswordModel
@{
    ViewData["Title"] = "Recuperar senha";
    ViewData["BodyClass"] = "identity-recovery-page";
}

<section class="auth-page identity-recovery-content">
    <div class="auth-layout container identity-recovery-layout">
        <div class="auth-card identity-recovery-card">
            <div class="auth-card-heading">
                <p class="auth-kicker">RECUPERA&Ccedil;&Atilde;O DE ACESSO</p>
                <h2>Recuperar senha</h2>
                <p>Informe o e-mail cadastrado para receber as instru&ccedil;&otilde;es de recupera&ccedil;&atilde;o.</p>
            </div>
            <form method="post" class="auth-form">
                <div asp-validation-summary="ModelOnly" class="auth-validation" role="alert"></div>
                <div class="auth-field">
                    <label asp-for="Input.Email">E-mail cadastrado</label>
                    <input asp-for="Input.Email" autocomplete="email" placeholder="nome@empresa.com.br" />
                    <span asp-validation-for="Input.Email"></span>
                </div>
                <button type="submit" class="btn identity-recovery-submit">Enviar instru&ccedil;&otilde;es</button>
            </form>
            <a class="identity-recovery-login" asp-page="./Login">Voltar ao login</a>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
}
