@model IReadOnlyList<Orofoods.Web.Models.Orders.Order>
@using Orofoods.Web.Api
@using Orofoods.Web.Models.Integrations
@using Orofoods.Web.Models.Orders
@section Head { <link rel="stylesheet" href="~/css/admin-orders-list.css" asp-append-version="true" /> }
@{
    ViewData["Title"] = "Pedidos";
    var paged = (PagedResult<Order>)ViewBag.PagedResult;
    var sort = (string)ViewBag.Sort;
    var direction = (string)ViewBag.Direction;
    string NextDirection(string column) => sort == column && direction == "asc" ? "desc" : "asc";
}
<section class="section admin-orders-page orders-index-compact">
    <div class="container">
        <header class="admin-page-header d-flex align-items-center justify-content-between gap-3 flex-wrap">
            <div><div class="eyebrow"><span></span> OPERA&Ccedil;&Atilde;O</div><h1>Pedidos</h1><p>Acompanhe e gerencie os pedidos da opera&ccedil;&atilde;o.</p></div>
            <a class="btn admin-primary-action text-nowrap" asp-controller="Customers" asp-action="Index" asp-route-context="new-order"><i class="fa-solid fa-plus" aria-hidden="true"></i> Novo pedido</a>
        </header>
        @if (TempData["WmcManualExportMessage"] is string message) { <div class="alert alert-success" role="status">@message</div> }
        @if (TempData["WmcManualExportError"] is string error) { <div class="alert alert-warning" role="alert">@error</div> }
        <form class="orders-filter-card">
            <div class="orders-filter-grid">
                <input type="hidden" name="sort" value="@sort" /><input type="hidden" name="direction" value="@direction" />
                <div><label for="orderQuery">N&uacute;mero ou cliente</label><div class="orders-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input id="orderQuery" name="q" value="@ViewBag.Query" class="form-control" placeholder="N&uacute;mero ou cliente" /></div></div>
                <div><label for="orderStatus">Status</label><select id="orderStatus" name="status" class="form-select"><option value="">Todos os status</option>@foreach (var status in Enum.GetValues<OrderStatus>()) { <option value="@status" selected="@(ViewBag.Status == status.ToString())">@status.ToDisplayName()</option> }</select></div>
                <button class="btn admin-primary-action orders-filter-submit">Filtrar</button>
            </div>
            <div class="orders-list-meta"><small>@paged.TotalItems pedido@(paged.TotalItems == 1 ? "" : "s") encontrado@(paged.TotalItems == 1 ? "" : "s")</small><small>P&aacute;gina @paged.Page de @paged.TotalPages</small></div>
        </form>
        <div class="orders-table-card"><div class="table-responsive"><table class="table orders-table">
            <thead><tr>
                <th><a asp-route-q="@ViewBag.Query" asp-route-status="@ViewBag.Status" asp-route-sort="number" asp-route-direction="@NextDirection("number")">N&uacute;mero</a></th>
                <th><a asp-route-q="@ViewBag.Query" asp-route-status="@ViewBag.Status" asp-route-sort="customer" asp-route-direction="@NextDirection("customer")">Cliente</a></th>
                <th><a asp-route-q="@ViewBag.Query" asp-route-status="@ViewBag.Status" asp-route-sort="date" asp-route-direction="@NextDirection("date")">Data</a></th>
                <th class="text-center">Itens</th>
                <th><a asp-route-q="@ViewBag.Query" asp-route-status="@ViewBag.Status" asp-route-sort="status" asp-route-direction="@NextDirection("status")">Status</a></th>
                <th class="text-end"><a asp-route-q="@ViewBag.Query" asp-route-status="@ViewBag.Status" asp-route-sort="total" asp-route-direction="@NextDirection("total")">Total</a></th>
                <th>WMC</th><th></th>
            </tr></thead>
            <tbody>
            @foreach (var order in Model)
            {
                var statusClass = order.Status.ToString().ToLowerInvariant();
                var state = order.WmcOrderExportState;
                var latestAudit = order.WmcExportAudits.OrderByDescending(audit => audit.ExportedAt).FirstOrDefault();
                var uncertainHistory = state?.RequiresManualReview == true || (state is null && latestAudit is not null);
                var (wmcLabel, wmcClass) = uncertainHistory
                    ? ("Pendente", "review")
                    : state?.Status switch
                    {
                        WmcOrderExportStatus.Exported => ("TXT gerado", "exported"),
                        WmcOrderExportStatus.Rejected => ("Rejeitado", "rejected"),
                        WmcOrderExportStatus.Imported => ("Importado", "imported"),
                        WmcOrderExportStatus.Error => ("Erro", "rejected"),
                        _ => ("Pendente", "pending")
                    };
                var wmcTitle = uncertainHistory ? "Revisar histórico de exportações na página do pedido"
                    : latestAudit is null ? "Nenhuma exportação registrada"
                    : $"{latestAudit.ExportedAt.ToLocalTime():dd/MM/yyyy HH:mm}" + (latestAudit.FileName is null ? "" : $" · {latestAudit.FileName}");
                <tr>
                    <td data-label="N&uacute;mero"><strong class="orders-number">@order.Number</strong></td>
                    <td data-label="Cliente"><span class="orders-customer" title="@order.Customer?.TradeName">@order.Customer?.TradeName</span></td>
                    <td data-label="Data" class="orders-nowrap">@order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                    <td data-label="Itens" class="text-center orders-nowrap">@order.Items.Count</td>
                    <td data-label="Status"><span class="order-status-badge order-status-badge--@statusClass">@order.Status.ToDisplayName()</span></td>
                    <td data-label="Total" class="text-end orders-nowrap"><strong>@order.Total.ToString("C")</strong></td>
                    <td data-label="WMC"><span class="wmc-status-badge wmc-status-badge--@wmcClass" title="@wmcTitle">@wmcLabel</span></td>
                    <td data-label="Ação" class="text-end"><a class="btn btn-sm btn-order-open" asp-action="Details" asp-route-id="@order.Id">Ver pedido <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a></td>
                </tr>
            }
            </tbody>
        </table></div></div>
        @if (paged.TotalPages > 1)
        {
            <nav class="orders-pagination" aria-label="Pagina&ccedil;&atilde;o dos pedidos"><ul class="pagination justify-content-center mb-0">
                <li class="page-item @(paged.Page == 1 ? "disabled" : "")"><a class="page-link" asp-route-q="@ViewBag.Query" asp-route-status="@ViewBag.Status" asp-route-sort="@sort" asp-route-direction="@direction" asp-route-page="@(paged.Page - 1)">Anterior</a></li>
                @for (var currentPage = Math.Max(1, paged.Page - 2); currentPage <= Math.Min(paged.TotalPages, paged.Page + 2); currentPage++) { <li class="page-item @(currentPage == paged.Page ? "active" : "")"><a class="page-link" asp-route-q="@ViewBag.Query" asp-route-status="@ViewBag.Status" asp-route-sort="@sort" asp-route-direction="@direction" asp-route-page="@currentPage">@currentPage</a></li> }
                <li class="page-item @(paged.Page == paged.TotalPages ? "disabled" : "")"><a class="page-link" asp-route-q="@ViewBag.Query" asp-route-status="@ViewBag.Status" asp-route-sort="@sort" asp-route-direction="@direction" asp-route-page="@(paged.Page + 1)">Pr&oacute;xima</a></li>
            </ul></nav>
        }
    </div>
</section>
