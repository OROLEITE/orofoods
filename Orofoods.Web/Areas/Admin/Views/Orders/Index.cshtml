@model IReadOnlyList<Orofoods.Web.Models.Orders.Order>
@{ ViewData["Title"] = "Pedidos"; }
<section class="section"><div class="container"><h1>Pedidos</h1><form class="catalog-tools mt-4"><input name="q" value="@ViewBag.Query" placeholder="N&uacute;mero ou cliente"/><select name="status"><option value="">Todos os status</option>@foreach (var status in Enum.GetValues<OrderStatus>()) { <option value="@status" selected="@(ViewBag.Status == status.ToString())">@status.ToDisplayName()</option> }</select><button class="btn btn-dark">Filtrar</button></form>
<div class="table-responsive"><table class="table table-dark table-striped"><thead><tr><th>N&uacute;mero</th><th>Cliente</th><th>Data</th><th>Itens</th><th>Status</th><th>Total</th><th></th></tr></thead><tbody>@foreach (var order in Model) { <tr><td>@order.Number</td><td>@order.Customer?.TradeName</td><td>@order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td><td>@order.Items.Count</td><td>@order.Status.ToDisplayName()</td><td>@order.Total.ToString("C")</td><td><a class="btn btn-sm btn-gold" asp-action="Details" asp-route-id="@order.Id">Abrir</a></td></tr> }</tbody></table></div></div></section>
