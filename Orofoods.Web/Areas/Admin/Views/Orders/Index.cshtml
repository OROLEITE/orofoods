@model IReadOnlyList<Orofoods.Web.Models.Orders.Order>
@using Orofoods.Web.Api
@{ ViewData["Title"] = "Pedidos"; var paged = (PagedResult<Orofoods.Web.Models.Orders.Order>)ViewBag.PagedResult; var sort = (string)ViewBag.Sort; var direction = (string)ViewBag.Direction; string NextDirection(string column) => sort == column && direction == "asc" ? "desc" : "asc"; }
<section class="section"><div class="container"><h1>Pedidos</h1><form class="catalog-tools mt-4"><input type="hidden" name="sort" value="@sort" /><input type="hidden" name="direction" value="@direction" /><input name="q" value="@ViewBag.Query" placeholder="N&uacute;mero ou cliente"/><select name="status"><option value="">Todos os status</option>@foreach (var status in Enum.GetValues<OrderStatus>()) { <option value="@status" selected="@(ViewBag.Status == status.ToString())">@status.ToDisplayName()</option> }</select><button class="btn btn-dark">Filtrar</button></form>
<div class="d-flex justify-content-between align-items-center gap-3 mb-3"><small class="text-muted">@paged.TotalItems pedido@(paged.TotalItems == 1 ? "" : "s") encontrado@(paged.TotalItems == 1 ? "" : "s")</small><small class="text-muted">Página @paged.Page de @paged.TotalPages</small></div>
<div class="table-responsive"><table class="table table-dark table-striped order-admin-table"><thead><tr><th><a asp-route-q="@ViewBag.Query" asp-route-status="@ViewBag.Status" asp-route-sort="number" asp-route-direction="@NextDirection("number")">Número</a></th><th><a asp-route-q="@ViewBag.Query" asp-route-status="@ViewBag.Status" asp-route-sort="customer" asp-route-direction="@NextDirection("customer")">Cliente</a></th><th><a asp-route-q="@ViewBag.Query" asp-route-status="@ViewBag.Status" asp-route-sort="date" asp-route-direction="@NextDirection("date")">Data</a></th><th>Itens</th><th><a asp-route-q="@ViewBag.Query" asp-route-status="@ViewBag.Status" asp-route-sort="status" asp-route-direction="@NextDirection("status")">Status</a></th><th><a asp-route-q="@ViewBag.Query" asp-route-status="@ViewBag.Status" asp-route-sort="total" asp-route-direction="@NextDirection("total")">Total</a></th><th></th></tr></thead><tbody>@foreach (var order in Model) { <tr><td data-label="Número">@order.Number</td><td data-label="Cliente">@order.Customer?.TradeName</td><td data-label="Data">@order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td><td data-label="Itens">@order.Items.Count</td><td data-label="Status">@order.Status.ToDisplayName()</td><td data-label="Total">@order.Total.ToString("C")</td><td data-label="Ação"><a class="btn btn-sm btn-gold" asp-action="Details" asp-route-id="@order.Id">Abrir</a></td></tr> }</tbody></table></div>
@if (paged.TotalPages > 1) { <nav aria-label="Paginação dos pedidos"><ul class="pagination justify-content-center mb-0"><li class="page-item @(paged.Page == 1 ? "disabled" : "")"><a class="page-link" asp-route-q="@ViewBag.Query" asp-route-status="@ViewBag.Status" asp-route-sort="@sort" asp-route-direction="@direction" asp-route-page="@(paged.Page - 1)">Anterior</a></li>@for (var currentPage = Math.Max(1, paged.Page - 2); currentPage <= Math.Min(paged.TotalPages, paged.Page + 2); currentPage++) { <li class="page-item @(currentPage == paged.Page ? "active" : "")"><a class="page-link" asp-route-q="@ViewBag.Query" asp-route-status="@ViewBag.Status" asp-route-sort="@sort" asp-route-direction="@direction" asp-route-page="@currentPage">@currentPage</a></li> }<li class="page-item @(paged.Page == paged.TotalPages ? "disabled" : "")"><a class="page-link" asp-route-q="@ViewBag.Query" asp-route-status="@ViewBag.Status" asp-route-sort="@sort" asp-route-direction="@direction" asp-route-page="@(paged.Page + 1)">Próxima</a></li></ul></nav> }
</div></section>
