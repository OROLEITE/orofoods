@model IReadOnlyList<Orofoods.Web.Models.Orders.Order>
@using Orofoods.Web.Api
@{ ViewData["Title"] = "Pedidos"; var paged = (PagedResult<Orofoods.Web.Models.Orders.Order>)ViewBag.PagedResult; var sort = (string)ViewBag.Sort; var direction = (string)ViewBag.Direction; string NextDirection(string column) => sort == column && direction == "asc" ? "desc" : "asc"; }
<section class="section admin-orders-page"><div class="container"><header class="admin-page-header"><div><div class="eyebrow"><span></span> OPERA&Ccedil;&Atilde;O</div><h1>Pedidos</h1><p>Acompanhe e gerencie os pedidos da opera&ccedil;&atilde;o.</p></div></header><form class="orders-filter-card"><div class="orders-filter-grid"><input type="hidden" name="sort" value="@sort" /><input type="hidden" name="direction" value="@direction" /><div><label for="orderQuery">N&uacute;mero ou cliente</label><div class="orders-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input id="orderQuery" name="q" value="@ViewBag.Query" class="form-control" placeholder="N&uacute;mero ou cliente"/></div></div><div><label for="orderStatus">Status</label><select id="orderStatus" name="status" class="form-select"><option value="">Todos os status</option>@foreach (var status in Enum.GetValues<OrderStatus>()) { <option value="@status" selected="@(ViewBag.Status == status.ToString())">@status.ToDisplayName()</option> }</select></div><button class="btn admin-primary-action orders-filter-submit">Filtrar</button></div>
<div class="orders-list-meta"><small>@paged.TotalItems pedido@(paged.TotalItems == 1 ? "" : "s") encontrado@(paged.TotalItems == 1 ? "" : "s")</small><small>P&aacute;gina @paged.Page de @paged.TotalPages</small></div></form>
<div class="orders-table-card"><div class="table-responsive"><table class="table orders-table"><thead><tr><th><a asp-route-q="@ViewBag.Query" asp-route-status="@ViewBag.Status" asp-route-sort="number" asp-route-direction="@NextDirection("number")">Número</a></th><th><a asp-route-q="@ViewBag.Query" asp-route-status="@ViewBag.Status" asp-route-sort="customer" asp-route-direction="@NextDirection("customer")">Cliente</a></th><th><a asp-route-q="@ViewBag.Query" asp-route-status="@ViewBag.Status" asp-route-sort="date" asp-route-direction="@NextDirection("date")">Data</a></th><th class="text-center">Itens</th><th><a asp-route-q="@ViewBag.Query" asp-route-status="@ViewBag.Status" asp-route-sort="status" asp-route-direction="@NextDirection("status")">Status</a></th><th class="text-end"><a asp-route-q="@ViewBag.Query" asp-route-status="@ViewBag.Status" asp-route-sort="total" asp-route-direction="@NextDirection("total")">Total</a></th><th></th></tr></thead><tbody>@foreach (var order in Model) { var statusClass = order.Status.ToString().ToLowerInvariant(); <tr><td data-label="Número"><strong class="orders-number">@order.Number</strong></td><td data-label="Cliente"><span class="orders-customer" title="@order.Customer?.TradeName">@order.Customer?.TradeName</span></td><td data-label="Data" class="orders-nowrap">@order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td><td data-label="Itens" class="text-center orders-nowrap">@order.Items.Count</td><td data-label="Status"><span class="order-status-badge order-status-badge--@statusClass">@order.Status.ToDisplayName()</span></td><td data-label="Total" class="text-end orders-nowrap"><strong>@order.Total.ToString("C")</strong></td><td data-label="Ação" class="text-end"><a class="btn btn-sm btn-order-open" asp-action="Details" asp-route-id="@order.Id">Ver pedido <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a></td></tr> }</tbody></table></div></div>
@if (paged.TotalPages > 1) { <nav aria-label="Paginação dos pedidos"><ul class="pagination justify-content-center mb-0"><li class="page-item @(paged.Page == 1 ? "disabled" : "")"><a class="page-link" asp-route-q="@ViewBag.Query" asp-route-status="@ViewBag.Status" asp-route-sort="@sort" asp-route-direction="@direction" asp-route-page="@(paged.Page - 1)">Anterior</a></li>@for (var currentPage = Math.Max(1, paged.Page - 2); currentPage <= Math.Min(paged.TotalPages, paged.Page + 2); currentPage++) { <li class="page-item @(currentPage == paged.Page ? "active" : "")"><a class="page-link" asp-route-q="@ViewBag.Query" asp-route-status="@ViewBag.Status" asp-route-sort="@sort" asp-route-direction="@direction" asp-route-page="@currentPage">@currentPage</a></li> }<li class="page-item @(paged.Page == paged.TotalPages ? "disabled" : "")"><a class="page-link" asp-route-q="@ViewBag.Query" asp-route-status="@ViewBag.Status" asp-route-sort="@sort" asp-route-direction="@direction" asp-route-page="@(paged.Page + 1)">Próxima</a></li></ul></nav> }
</div></section>
