@model Orofoods.Web.Models.Orders.Order
@{
    ViewData["Title"] = Model.Number;
    var cardOnDelivery = Model.PaymentTerm?.Code == "CARD_ON_DELIVERY";
    var cardOnDeliveryPayment = Model.Payments
        .Where(payment => payment.Method == Orofoods.Web.Models.Payments.PaymentMethodType.CardOnDelivery)
        .OrderByDescending(payment => payment.CreatedAt)
        .ThenByDescending(payment => payment.Id)
        .FirstOrDefault();
    var paymentApproved = cardOnDeliveryPayment?.Status is Orofoods.Web.Models.Payments.PaymentStatus.Approved
        or Orofoods.Web.Models.Payments.PaymentStatus.Paid;
    var pointPaymentEnabled = ViewBag.PointPaymentEnabled is bool pointEnabled && pointEnabled;
    var pointAssignments = ViewBag.PointEligibleAssignments as IReadOnlyList<Orofoods.Web.Models.Payments.DriverPaymentTerminalAssignment> ?? [];
    var pointChargeBlockReason = ViewBag.PointChargeBlockReason as string;
    var pointAttemptActive = cardOnDeliveryPayment?.Gateway == "MercadoPagoPoint" && cardOnDeliveryPayment.Status is Orofoods.Web.Models.Payments.PaymentStatus.Pending
        or Orofoods.Web.Models.Payments.PaymentStatus.Processing
        or Orofoods.Web.Models.Payments.PaymentStatus.ActionRequired;
    var pointAuditEvents = ViewBag.PointAuditEvents as IReadOnlyList<Orofoods.Web.Models.Payments.PointPaymentAuditEvent> ?? [];
    var paymentAssignment = cardOnDeliveryPayment?.DriverPaymentTerminalAssignment;
    var paymentStatusLabel = cardOnDeliveryPayment?.Status switch
    {
        Orofoods.Web.Models.Payments.PaymentStatus.Approved or Orofoods.Web.Models.Payments.PaymentStatus.Paid => "Pagamento aprovado",
        Orofoods.Web.Models.Payments.PaymentStatus.Processing => "Aguardando terminal",
        Orofoods.Web.Models.Payments.PaymentStatus.ActionRequired => "Ação necessária no terminal",
        Orofoods.Web.Models.Payments.PaymentStatus.Rejected => "Pagamento recusado",
        Orofoods.Web.Models.Payments.PaymentStatus.Cancelled => "Pagamento cancelado",
        Orofoods.Web.Models.Payments.PaymentStatus.Refunded => "Pagamento estornado",
        Orofoods.Web.Models.Payments.PaymentStatus.Expired => "Cobrança expirada",
        Orofoods.Web.Models.Payments.PaymentStatus.Failed => "Erro de comunicação",
        _ => "Aguardando pagamento"
    };
}

<section class="section admin-order-details-page">
    <div class="container">
        <div class="portal-top order-details-header">
            <div><small>@Model.Customer?.TradeName</small><h1>@Model.Number</h1></div>
            <a asp-action="Index" class="btn btn-outline-dark"><i class="fa-solid fa-arrow-left"></i> Voltar</a>
        </div>

        <div class="commercial-bar order-details-summary">
            <div class="order-details-summary-item"><small>STATUS</small><strong><span class="order-detail-chip">@Model.Status.ToDisplayName()</span></strong></div>
            <div class="order-details-summary-item"><small>INTEGRA&#199;&#195;O ERP</small><strong>@Model.IntegrationStatus.ToDisplayName()</strong></div>
            <div class="order-details-summary-item"><small>ERP</small><strong>@(Model.ErpOrderNumber ?? "Pendente")</strong></div>
            <div class="order-details-summary-item order-details-summary-item--total"><small>TOTAL</small><strong>@Model.Total.ToString("C")</strong></div>
        </div>
        @if (TempData["OrderStatusError"] is string statusError)
        {
            <div class="alert alert-warning mt-3" role="alert">@statusError</div>
        }
        @if (TempData["PointPaymentError"] is string pointError)
        {
            <div class="alert alert-warning mt-3" role="alert">@pointError</div>
        }
        @if (TempData["PointPaymentMessage"] is string pointMessage)
        {
            <div class="alert alert-success mt-3" role="status">@pointMessage</div>
        }
        <div class="order-details-layout">
        @if (cardOnDelivery)
        {
            <section class="order-payment-card" data-payment-status="@(paymentApproved ? "approved" : "pending")" aria-labelledby="order-payment-title">
                <header class="order-detail-section-heading">
                    <div><small>PAGAMENTO</small><h2 id="order-payment-title">Cartão na entrega</h2></div>
                    <span class="order-payment-status @(paymentApproved ? "order-payment-status--approved" : "order-payment-status--pending")">@paymentStatusLabel</span>
                </header>
                <dl class="order-payment-details" data-card-on-delivery-details>
                    <div><dt>Forma de pagamento</dt><dd>Cartão na entrega</dd></div>
                    <div><dt>Status do pagamento</dt><dd>@paymentStatusLabel</dd></div>
                    <div><dt>Motorista da cobrança</dt><dd>@(paymentAssignment?.Driver?.Name ?? "Não associado")</dd></div>
                    <div><dt>Terminal</dt><dd>@(paymentAssignment?.PaymentTerminal?.DeviceId ?? "Não associado")</dd></div>
                    <div><dt>Última tentativa Point</dt><dd>@(cardOnDeliveryPayment?.Gateway == "MercadoPagoPoint" ? paymentStatusLabel : "Ainda não iniciada")</dd></div>
                    <div><dt>External Order ID</dt><dd><code>@(cardOnDeliveryPayment?.GatewayOrderId ?? "Não informado")</code></dd></div>
                    <div><dt>Última atualização</dt><dd>@if (cardOnDeliveryPayment is null) { <span>Sem tentativa</span> } else { <time>@cardOnDeliveryPayment.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</time> }</dd></div>
                </dl>
            </section>
        }

        @if (pointPaymentEnabled)
        {
            <section class="card order-point-charge-card" aria-labelledby="point-charge-title">
                <div class="card-body">
                    <h2 id="point-charge-title" class="h5">Cobrança no terminal Point</h2>
                    @if (cardOnDeliveryPayment?.Gateway == "MercadoPagoPoint")
                    {
                        <p data-point-payment-status="@cardOnDeliveryPayment.Status.ToString().ToLowerInvariant()" data-point-payment-label="@paymentStatusLabel">
                            <strong>Status Point:</strong> <span data-point-status-label>@paymentStatusLabel</span>
                        </p>
                        @if (pointAttemptActive && !string.IsNullOrWhiteSpace(cardOnDeliveryPayment.GatewayOrderId))
                        {
                            <form asp-action="PollPointCharge" method="post" class="d-inline" data-point-payment-poll data-order-id="@Model.Id" data-payment-id="@cardOnDeliveryPayment.Id">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="paymentId" value="@cardOnDeliveryPayment.Id" />
                                <span class="visually-hidden" data-point-poll-message aria-live="polite"></span>
                            </form>
                            <form asp-action="RefreshPointCharge" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="paymentId" value="@cardOnDeliveryPayment.Id" />
                                <button class="btn btn-outline-dark">Consultar status</button>
                            </form>
                            <form asp-action="CancelPointCharge" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="paymentId" value="@cardOnDeliveryPayment.Id" />
                                <button class="btn btn-outline-danger">Cancelar cobrança</button>
                            </form>
                        }
                        else if (pointAttemptActive)
                        {
                            var retryAssignment = pointAssignments.FirstOrDefault(x => x.Id == cardOnDeliveryPayment.DriverPaymentTerminalAssignmentId);
                            <p class="text-muted">A comunicação expirou antes da confirmação da order. Reenviar reutiliza a tentativa persistida e sua chave de idempotência.</p>
                            @if (retryAssignment is not null)
                            {
                                <form asp-action="StartPointCharge" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@Model.Id" />
                                    <input type="hidden" name="assignmentId" value="@retryAssignment.Id" />
                                    <input type="hidden" name="requestKey" value="@ViewBag.PointRequestKey" />
                                <button class="btn btn-outline-dark" type="submit">Reenviar tentativa segura</button>
                                </form>
                            }
                            else
                            {
                                <button class="btn btn-outline-dark" type="button" disabled>Reenviar tentativa segura</button>
                                <p class="text-muted">O motorista/terminal original não está mais ativo. Reative o vínculo antes de reenviar.</p>
                            }
                        }
                    }
                    @if (!paymentApproved && !pointAttemptActive && pointChargeBlockReason is null && pointAssignments.Count > 0)
                    {
                        <form asp-action="StartPointCharge" method="post" class="d-flex flex-wrap gap-2">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="requestKey" value="@ViewBag.PointRequestKey" />
                            <label for="point-assignment" class="visually-hidden">Motorista e terminal</label>
                            <select id="point-assignment" name="assignmentId" class="form-select" required>
                                <option value="">Selecione motorista e terminal associado</option>
                                @foreach (var assignment in pointAssignments)
                                {
                                    <option value="@assignment.Id">@assignment.Driver?.Name — @assignment.PaymentTerminal?.DeviceId</option>
                                }
                            </select>
                            <button class="btn btn-gold" type="submit">COBRAR NA MAQUININHA</button>
                        </form>
                    }
                    else if (!paymentApproved && !pointAttemptActive && pointChargeBlockReason is not null)
                    {
                        <button class="btn btn-gold" type="button" disabled>COBRAR NA MAQUININHA</button>
                        <p class="text-muted mb-0 mt-2">@pointChargeBlockReason</p>
                    }
                </div>
            </section>
        }

        @if (pointAuditEvents.Count > 0)
        {
            <section class="order-detail-section order-point-audit" aria-labelledby="point-audit-title">
                <header class="order-detail-section-heading"><div><small>RASTREABILIDADE</small><h2 id="point-audit-title">Auditoria da cobrança Point</h2></div></header>
                <ol class="order-point-audit-list">
                    @foreach (var audit in pointAuditEvents)
                    {
                        <li class="order-point-audit-entry">
                            <div class="order-point-audit-main"><strong>@audit.ResultSummary</strong><span class="order-point-audit-transition @(audit.PreviousStatus == Orofoods.Web.Models.Payments.PaymentStatus.Processing && audit.NewStatus == Orofoods.Web.Models.Payments.PaymentStatus.Approved ? "order-point-audit-transition--success" : audit.PreviousStatus == Orofoods.Web.Models.Payments.PaymentStatus.Pending && audit.NewStatus == Orofoods.Web.Models.Payments.PaymentStatus.Processing ? "order-point-audit-transition--info" : audit.PreviousStatus == Orofoods.Web.Models.Payments.PaymentStatus.Pending && audit.NewStatus == Orofoods.Web.Models.Payments.PaymentStatus.Pending ? "order-point-audit-transition--neutral" : "")">@audit.PreviousStatus?.ToDisplayName() → @audit.NewStatus.ToDisplayName()</span></div>
                            <div class="order-point-audit-meta"><span>tentativa @audit.AttemptNumber</span><span>@(audit.AdminUser?.Email ?? "Sistema")</span>@if (!string.IsNullOrWhiteSpace(audit.ExternalOrderId)) { <code>Order: @audit.ExternalOrderId</code> }<time>@audit.OccurredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</time></div>
                        </li>
                    }
                </ol>
            </section>
        }

        <section class="order-actions-card" aria-labelledby="order-actions-title">
            <header class="order-detail-section-heading"><div><small>OPERAÇÃO</small><h2 id="order-actions-title">Ações do pedido</h2></div></header>
            <div class="order-actions-grid">
                <form asp-action="UpdateStatus" method="post" class="order-details-status-form">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <label for="order-status">Status do pedido</label>
                    <div class="order-action-controls">
                        <select id="order-status" name="status" class="form-select">
                            @foreach (var status in Enum.GetValues<OrderStatus>())
                            {
                                if (status == OrderStatus.Delivered && cardOnDelivery && !paymentApproved)
                                {
                                    <option value="@status" selected="@(status == Model.Status)" disabled>@status.ToDisplayName()</option>
                                }
                                else
                                {
                                    <option value="@status" selected="@(status == Model.Status)">@status.ToDisplayName()</option>
                                }
                            }
                        </select>
                        <button class="btn btn-primary">Atualizar status</button>
                    </div>
                </form>
                @if (Model.Status == OrderStatus.Approved && Model.IntegrationStatus != IntegrationStatus.Processing)
                {
                    <form asp-action="ReprocessIntegration" method="post" class="order-details-wmc-form">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <label>Integração ERP</label>
                        <button class="btn btn-outline-dark">Reprocessar integra&#231;&#227;o</button>
                    </form>
                }
                @if (!string.IsNullOrWhiteSpace(Model.IntegrationError))
                {
                    <small class="order-action-feedback text-danger">@Model.IntegrationError</small>
                }
            </div>
            @if (cardOnDelivery && !paymentApproved)
            {
                <p class="alert alert-warning order-action-warning" data-delivered-payment-guard>Pagamento na entrega ainda não foi aprovado.</p>
            }
        </section>

        <div class="order-history-grid">
            <section class="order-detail-section" aria-labelledby="order-status-history-title">
                <header class="order-detail-section-heading"><div><small>RASTREABILIDADE</small><h2 id="order-status-history-title">Hist&oacute;rico de status</h2></div></header>
                <ol class="list-group order-history-list">
                    @foreach (var entry in Model.StatusHistory.OrderByDescending(x => x.ChangedAt))
                    {
                        <li class="list-group-item order-history-entry"><div><strong>@entry.Status.ToDisplayName()</strong><small>@(entry.ChangedByUser?.Email ?? "Sistema")</small></div><time>@entry.ChangedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</time></li>
                    }
                </ol>
            </section>

            <section class="order-detail-section" aria-labelledby="order-wmc-history-title">
                <header class="order-detail-section-heading"><div><small>INTEGRAÇÃO ERP</small><h2 id="order-wmc-history-title">Hist&oacute;rico de exporta&#231;&otilde;es WMC</h2></div></header>
                @if (!Model.WmcExportAudits.Any())
                {
                    <p class="order-empty-state text-muted"><i class="fa-regular fa-file-lines" aria-hidden="true"></i><span>Nenhuma exporta&#231;&#227;o WMC registrada para este pedido.</span></p>
                }
                else
                {
                    <ol class="list-group order-history-list">
                        @foreach (var entry in Model.WmcExportAudits.OrderByDescending(x => x.ExportedAt).ThenByDescending(x => x.Id))
                        {
                            <li class="list-group-item order-history-entry">
                                <div><strong>@(entry.Outcome switch { Orofoods.Web.Models.Integrations.WmcExportOutcome.Generated => "TXT gerado", Orofoods.Web.Models.Integrations.WmcExportOutcome.Available => "Arquivo disponibilizado", Orofoods.Web.Models.Integrations.WmcExportOutcome.Failed => "Falha na exportação", _ => entry.Succeeded ? "TXT gerado" : "Falha na exportação" })</strong><small>@(entry.Source == Orofoods.Web.Models.Integrations.WmcExportSource.Automatic ? "Automática" : "Manual")</small>@if (!string.IsNullOrWhiteSpace(entry.ExportedByEmail)) { <small>@entry.ExportedByEmail</small> }@if (!string.IsNullOrWhiteSpace(entry.FileName)) { <small>@entry.FileName</small> }@if (entry.GeneratedAt is not null) { <small>TXT gerado @entry.GeneratedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small> }@if (!string.IsNullOrWhiteSpace(entry.Error)) { <small class="text-danger">@entry.Error</small> }</div>
                                <time>@entry.ExportedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</time>
                            </li>
                        }
                    </ol>
                }
            </section>
        </div>

        <section class="order-detail-section order-items-section" aria-labelledby="order-items-title">
            <header class="order-detail-section-heading"><div><small>COMPOSIÇÃO</small><h2 id="order-items-title">Itens do pedido</h2></div></header>
            <div class="order-items">
                <div class="order-items-heading" aria-hidden="true"><span>SKU / produto</span><span>Quantidade</span><span>Preço unitário</span><span>Total</span></div>
                @foreach (var item in Model.Items)
                {
                    <div class="order-row"><div class="order-item-product"><small>@item.SkuSnapshot</small><h3>@item.ProductNameSnapshot</h3></div><span data-label="Quantidade">@item.Quantity</span><span data-label="Preço unitário">@item.UnitPrice.ToString("C")</span><strong data-label="Total">@item.Subtotal.ToString("C")</strong></div>
                }
            </div>
        </section>
        </div>
    </div>
</section>
<script src="~/js/admin-point-payment.js" asp-append-version="true" defer></script>

@section Head {
    <link rel="stylesheet" href="~/css/admin-order-details.css" asp-append-version="true" />
}
