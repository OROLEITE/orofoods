@model Orofoods.Web.Models.Orders.Order
@using Orofoods.Web.Services.Integrations
@{
    ViewData["Title"] = Model.Number;
    var cardOnDelivery = Model.PaymentTerm?.Code == "CARD_ON_DELIVERY";
    var cardOnDeliveryPayment = Model.Payments
        .Where(payment => payment.Method == Orofoods.Web.Models.Payments.PaymentMethodType.CardOnDelivery)
        .OrderByDescending(payment => payment.CreatedAt)
        .ThenByDescending(payment => payment.Id)
        .FirstOrDefault();
    var paymentApproved = cardOnDeliveryPayment?.Status is Orofoods.Web.Models.Payments.PaymentStatus.Approved
        or Orofoods.Web.Models.Payments.PaymentStatus.Paid;
    var pointPaymentEnabled = ViewBag.PointPaymentEnabled is bool pointEnabled && pointEnabled;
    var pointAssignments = ViewBag.PointEligibleAssignments as IReadOnlyList<Orofoods.Web.Models.Payments.DriverPaymentTerminalAssignment> ?? [];
    var pointChargeBlockReason = ViewBag.PointChargeBlockReason as string;
    var pointAttemptActive = cardOnDeliveryPayment?.Gateway == "MercadoPagoPoint" && cardOnDeliveryPayment.Status is Orofoods.Web.Models.Payments.PaymentStatus.Pending
        or Orofoods.Web.Models.Payments.PaymentStatus.Processing
        or Orofoods.Web.Models.Payments.PaymentStatus.ActionRequired;
    var pointAuditEvents = ViewBag.PointAuditEvents as IReadOnlyList<Orofoods.Web.Models.Payments.PointPaymentAuditEvent> ?? [];
    var paymentAssignment = cardOnDeliveryPayment?.DriverPaymentTerminalAssignment;
    var paymentStatusLabel = cardOnDeliveryPayment?.Status switch
    {
        Orofoods.Web.Models.Payments.PaymentStatus.Approved or Orofoods.Web.Models.Payments.PaymentStatus.Paid => "Pagamento aprovado",
        Orofoods.Web.Models.Payments.PaymentStatus.Processing => "Aguardando terminal",
        Orofoods.Web.Models.Payments.PaymentStatus.ActionRequired => "Ação necessária no terminal",
        Orofoods.Web.Models.Payments.PaymentStatus.Rejected => "Pagamento recusado",
        Orofoods.Web.Models.Payments.PaymentStatus.Cancelled => "Pagamento cancelado",
        Orofoods.Web.Models.Payments.PaymentStatus.Refunded => "Pagamento estornado",
        Orofoods.Web.Models.Payments.PaymentStatus.Expired => "Cobrança expirada",
        Orofoods.Web.Models.Payments.PaymentStatus.Failed => "Erro de comunicação",
        _ => "Aguardando pagamento"
    };
    var wmcManualExportDiagnostic = (WmcManualExportDiagnostic)ViewBag.WmcManualExportDiagnostic;
    var wmcState = Model.WmcOrderExportState;
    var wmcImportConfirmed = wmcState?.Status == Orofoods.Web.Models.Integrations.WmcOrderExportStatus.Imported;
    var wmcAwaitingImportConfirmation = wmcState?.Status == Orofoods.Web.Models.Integrations.WmcOrderExportStatus.Exported
        && wmcState.RequiresManualReview != true;
    const int historyPreviewCount = 3;
    void RenderStatusEntry(Orofoods.Web.Models.Orders.OrderStatusHistory entry)
    {
        <li class="list-group-item order-history-entry"><div><strong>@entry.Status.ToDisplayName()</strong><small>@(entry.ChangedByUser?.Email ?? "Sistema")</small></div><time>@entry.ChangedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</time></li>
    }
    void RenderWmcEntry(Orofoods.Web.Models.Integrations.WmcExportAudit entry)
    {
        <li class="list-group-item order-history-entry">
            <div><strong>@(entry.Outcome switch { Orofoods.Web.Models.Integrations.WmcExportOutcome.Generated => "TXT gerado", Orofoods.Web.Models.Integrations.WmcExportOutcome.Available => "Arquivo disponibilizado", Orofoods.Web.Models.Integrations.WmcExportOutcome.Failed => "Falha na exportação", Orofoods.Web.Models.Integrations.WmcExportOutcome.Imported => "Importação confirmada", _ => entry.Succeeded ? "TXT gerado" : "Falha na exportação" })</strong><small>@(entry.Source == Orofoods.Web.Models.Integrations.WmcExportSource.Automatic ? "Automática" : "Manual")</small>@if (!string.IsNullOrWhiteSpace(entry.ExportedByEmail)) { <small>@entry.ExportedByEmail</small> }@if (!string.IsNullOrWhiteSpace(entry.FileName)) { <small>@entry.FileName</small> }@if (entry.GeneratedAt is not null) { <small>TXT gerado @entry.GeneratedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small> }@if (!string.IsNullOrWhiteSpace(entry.Error)) { <small class="text-danger">@entry.Error</small> }</div>
            <time>@entry.ExportedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</time>
        </li>
    }
}

<section class="section admin-order-details-page">
    <div class="container">
        <div class="order-details-hero">
        <div class="portal-top order-details-header">
            <div class="order-details-title-group">
                <small>CLIENTE</small>
                <h1>@Model.Customer?.TradeName</h1>
                <div class="order-details-order-meta">
                    <span class="order-details-order-number">Pedido @Model.Number</span>
                    <span class="order-detail-chip">@Model.Status.ToDisplayName()</span>
                </div>
            </div>
            <a asp-action="Index" class="btn btn-outline-dark"><i class="fa-solid fa-arrow-left"></i> Voltar</a>
            <div class="order-details-total"><small>TOTAL DO PEDIDO</small><strong>@Model.Total.ToString("C")</strong></div>
        </div>

        <div class="commercial-bar order-details-summary">
            <div class="order-details-summary-item"><small>INTEGRA&#199;&#195;O ERP</small><strong>@Model.IntegrationStatus.ToDisplayName()</strong></div>
            <div class="order-details-summary-item"><small>PEDIDO ERP</small><strong>@(Model.ErpOrderNumber ?? "Pendente")</strong></div>
            <div class="order-details-summary-item"><small>EXPORTA&#199;&#195;O WMC</small><strong>@(wmcImportConfirmed ? "Importa\u00e7\u00e3o WMC confirmada" : wmcState?.Status == Orofoods.Web.Models.Integrations.WmcOrderExportStatus.Exported ? "TXT gerado" : wmcState?.Status.ToString() ?? "Sem tentativa")</strong></div>
        </div>
        </div>
        @if (TempData["OrderStatusError"] is string statusError)
        {
            <div class="alert alert-warning mt-3" role="alert">@statusError</div>
        }
        @if (TempData["PointPaymentError"] is string pointError)
        {
            <div class="alert alert-warning mt-3" role="alert">@pointError</div>
        }
        @if (TempData["PointPaymentMessage"] is string pointMessage)
        {
            <div class="alert alert-success mt-3" role="status">@pointMessage</div>
        }
        <div class="order-details-layout">
        <section class="order-detail-section order-wmc-diagnostic" aria-labelledby="order-wmc-diagnostic-title" data-wmc-diagnostic-read-only>
            <header class="order-detail-section-heading">
                <div><small>INTEGRA&Ccedil;&Atilde;O ERP</small><h2 id="order-wmc-diagnostic-title">Diagn&oacute;stico WMC</h2></div>
                <span class="order-wmc-eligibility order-wmc-eligibility--@(wmcManualExportDiagnostic.CanExport ? "eligible" : wmcImportConfirmed ? "imported" : wmcAwaitingImportConfirmation ? "pending-import" : "blocked")" data-wmc-export-eligibility="@(wmcManualExportDiagnostic.CanExport ? "eligible" : wmcImportConfirmed ? "imported" : "blocked")">@(wmcManualExportDiagnostic.CanExport ? "Elegível para exportação manual" : wmcImportConfirmed ? "Importa\u00e7\u00e3o WMC confirmada" : wmcAwaitingImportConfirmation ? "Nova exporta\u00e7\u00e3o bloqueada" : "Bloqueado")</span>
            </header>
            @if (!wmcManualExportDiagnostic.CanExport && !wmcImportConfirmed)
            {
                <p class="order-wmc-block-reason" role="status" data-wmc-export-block-reason>
                    @if (wmcAwaitingImportConfirmation)
                    {
                        <text>TXT gerado &mdash; aguardando confirma&ccedil;&atilde;o de importa&ccedil;&atilde;o</text>
                    }
                    else
                    {
                        @wmcManualExportDiagnostic.BlockReason
                    }
                </p>
            }
            @if (!string.IsNullOrWhiteSpace(Model.WmcOrderExportState?.LastError))
            {
                <p class="text-danger order-wmc-last-error"><strong>Último erro registrado:</strong> @Model.WmcOrderExportState.LastError</p>
            }
            <dl class="order-wmc-facts">
                <div><dt>Estado da exportação manual</dt><dd>@(wmcImportConfirmed ? "Importa\u00e7\u00e3o WMC confirmada" : wmcState?.Status == Orofoods.Web.Models.Integrations.WmcOrderExportStatus.Exported ? "TXT gerado" : wmcState?.Status.ToString() ?? "Sem tentativa registrada")</dd></div>
                <div><dt>Revisão manual</dt><dd>@(Model.WmcOrderExportState?.RequiresManualReview == true ? "Necessária" : "Não necessária")</dd></div>
                <div><dt>CNPJ do cliente</dt><dd><code>@(Model.Customer?.Cnpj ?? "Não informado")</code></dd></div>
                <div><dt>WMC do cliente (informativo)</dt><dd><code>@(Model.Customer?.WmcCode ?? "Não informado")</code></dd></div>
                <div><dt>Auditorias WMC</dt><dd>@Model.WmcExportAudits.Count registro(s)</dd></div>
            </dl>
            <details class="order-wmc-technical">
                <summary>Informações técnicas</summary>
                <p class="order-wmc-payment-term"><strong>Condição de pagamento:</strong> <code>@(Model.PaymentTerm?.Code ?? "Não informada")</code> &middot; @(Model.PaymentTerm?.Name ?? "Descrição indisponível") &middot; prazo @(Model.PaymentTerm?.DaysUntilDue.ToString() ?? "não informado") dias</p>
                <ul class="list-group list-group-flush order-wmc-products" aria-label="Produtos para exporta&ccedil;&atilde;o WMC">
                    @foreach (var item in Model.Items)
                    {
                        <li class="list-group-item"><span>@item.ProductNameSnapshot</span><span>C&oacute;digo WMC: <code>@(item.Product?.WmcCode ?? "Não informado")</code></span><span>Unidade: @(item.Product?.Unit ?? "Não informada")</span></li>
                    }
                </ul>
            </details>
        </section>
        @{
            var wmcLatestAudit = Model.WmcExportAudits.OrderByDescending(audit => audit.ExportedAt).ThenByDescending(audit => audit.Id).FirstOrDefault();
            var wmcUncertainHistory = wmcState?.RequiresManualReview == true || (wmcState is null && wmcLatestAudit is not null);
            var wmcCanManuallyExport = wmcManualExportDiagnostic.CanExport;
            var wmcHasActions = wmcUncertainHistory || wmcCanManuallyExport
                || (wmcState?.Status is Orofoods.Web.Models.Integrations.WmcOrderExportStatus.Exported or Orofoods.Web.Models.Integrations.WmcOrderExportStatus.Rejected && !wmcState.RequiresManualReview);
        }
        @if (wmcHasActions)
        {
            <section class="order-detail-section order-wmc-actions" aria-labelledby="order-wmc-actions-title">
                <header class="order-detail-section-heading"><div><small>INTEGRA&Ccedil;&Atilde;O ERP</small><h2 id="order-wmc-actions-title">A&ccedil;&otilde;es WMC</h2></div></header>
                <div class="order-wmc-actions-layout">
                <div class="order-wmc-action-context">
                @if (wmcLatestAudit is not null)
                {
                    <div class="order-wmc-last-audit" aria-label="Última exportação WMC">
                        @if (!string.IsNullOrWhiteSpace(wmcLatestAudit.FileName)) { <strong>@wmcLatestAudit.FileName</strong> }
                        <time>@wmcLatestAudit.ExportedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</time>
                        <span>@(wmcLatestAudit.ExportedByEmail ?? "Usuário desconhecido")</span>
                    </div>
                }
                @if (wmcState?.Status == Orofoods.Web.Models.Integrations.WmcOrderExportStatus.Rejected && !wmcState.RequiresManualReview && !string.IsNullOrWhiteSpace(wmcState.LastError))
                {
                    <small class="text-danger">@wmcState.LastError</small>
                }
                @if (wmcUncertainHistory && wmcState is not null)
                {
                    <small>Confirme o resultado anterior antes de qualquer novo envio.</small>
                }
                </div>
                <div class="order-wmc-actions-bar">
                @if (wmcState?.Status == Orofoods.Web.Models.Integrations.WmcOrderExportStatus.Exported && !wmcState.RequiresManualReview)
                {
                    @if (wmcState.CurrentArtifactId is not null)
                    {
                        <a class="btn btn-sm btn-outline-secondary" asp-action="DownloadWmcTxt" asp-route-id="@Model.Id">Baixar TXT novamente</a>
                    }
                    <button class="btn btn-sm btn-outline-danger" type="button" data-bs-toggle="modal" data-bs-target="#reject-wmc-modal" aria-haspopup="dialog" aria-controls="reject-wmc-modal">Registrar rejeição</button>
                    <button class="btn btn-sm btn-success" type="button" data-bs-toggle="modal" data-bs-target="#confirm-wmc-import-modal" aria-haspopup="dialog" aria-controls="confirm-wmc-import-modal">Confirmar importação</button>
                }
                @if (wmcState?.Status == Orofoods.Web.Models.Integrations.WmcOrderExportStatus.Rejected && !wmcState.RequiresManualReview)
                {
                    <form asp-action="RegenerateWmcTxt" method="post" class="wmc-regeneration-form">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <label class="visually-hidden" for="wmc-regenerate-@Model.Id">Motivo da regeneração</label>
                        <input id="wmc-regenerate-@Model.Id" name="reason" class="form-control form-control-sm" maxlength="1000" required placeholder="Motivo da regeneração" />
                        <button class="btn btn-sm btn-warning" type="submit">Regenerar TXT</button>
                    </form>
                }
                @if (wmcUncertainHistory)
                {
                    @if (wmcState is null)
                    {
                        <form asp-action="SendToWmc" method="post"><input type="hidden" name="id" value="@Model.Id" /><button class="btn btn-sm btn-outline-warning" type="submit">Iniciar conferência do histórico</button></form>
                    }
                    else
                    {
                        <form asp-action="ConfirmPriorWmcExport" method="post">
                            <input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="exported" value="true" />
                            <button class="btn btn-sm btn-outline-secondary" type="submit">Confirmar exportado</button>
                        </form>
                        <form asp-action="ConfirmPriorWmcExport" method="post">
                            <input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="exported" value="false" />
                            <button class="btn btn-sm btn-outline-warning" type="submit">Confirmar que não chegou ao WMC</button>
                        </form>
                    }
                }
                else if (wmcCanManuallyExport)
                {
                    <form asp-action="SendToWmc" method="post"><input type="hidden" name="id" value="@Model.Id" /><button class="btn btn-success wmc-send-button" type="submit">Enviar ao WMC</button></form>
                }
                </div>
                </div>
            </section>
        }
        @if (cardOnDelivery)
        {
            <section class="order-payment-card" data-payment-status="@(paymentApproved ? "approved" : "pending")" aria-labelledby="order-payment-title">
                <header class="order-detail-section-heading">
                    <div><small>PAGAMENTO</small><h2 id="order-payment-title">Cartão na entrega</h2></div>
                    <span class="order-payment-status @(paymentApproved ? "order-payment-status--approved" : "order-payment-status--pending")">@paymentStatusLabel</span>
                </header>
                <dl class="order-payment-details" data-card-on-delivery-details>
                    <div><dt>Forma de pagamento</dt><dd>Cartão na entrega</dd></div>
                    <div><dt>Status do pagamento</dt><dd>@paymentStatusLabel</dd></div>
                    <div><dt>Motorista da cobrança</dt><dd>@(paymentAssignment?.Driver?.Name ?? "Não associado")</dd></div>
                    <div><dt>Terminal</dt><dd>@(paymentAssignment?.PaymentTerminal?.DeviceId ?? "Não associado")</dd></div>
                    <div><dt>Última tentativa Point</dt><dd>@(cardOnDeliveryPayment?.Gateway == "MercadoPagoPoint" ? paymentStatusLabel : "Ainda não iniciada")</dd></div>
                    <div><dt>External Order ID</dt><dd><code>@(cardOnDeliveryPayment?.GatewayOrderId ?? "Não informado")</code></dd></div>
                    <div><dt>Última atualização</dt><dd>@if (cardOnDeliveryPayment is null) { <span>Sem tentativa</span> } else { <time>@cardOnDeliveryPayment.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</time> }</dd></div>
                </dl>
            </section>
        }

        @if (pointPaymentEnabled)
        {
            <section class="card order-point-charge-card" aria-labelledby="point-charge-title">
                <div class="card-body">
                    <h2 id="point-charge-title" class="h5">Cobrança no terminal Point</h2>
                    @if (cardOnDeliveryPayment?.Gateway == "MercadoPagoPoint")
                    {
                        <p data-point-payment-status="@cardOnDeliveryPayment.Status.ToString().ToLowerInvariant()" data-point-payment-label="@paymentStatusLabel">
                            <strong>Status Point:</strong> <span data-point-status-label>@paymentStatusLabel</span>
                        </p>
                        @if (pointAttemptActive && !string.IsNullOrWhiteSpace(cardOnDeliveryPayment.GatewayOrderId))
                        {
                            <form asp-action="PollPointCharge" method="post" class="d-inline" data-point-payment-poll data-order-id="@Model.Id" data-payment-id="@cardOnDeliveryPayment.Id">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="paymentId" value="@cardOnDeliveryPayment.Id" />
                                <span class="visually-hidden" data-point-poll-message aria-live="polite"></span>
                            </form>
                            <form asp-action="RefreshPointCharge" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="paymentId" value="@cardOnDeliveryPayment.Id" />
                                <button class="btn btn-outline-dark">Consultar status</button>
                            </form>
                            <form asp-action="CancelPointCharge" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="paymentId" value="@cardOnDeliveryPayment.Id" />
                                <button class="btn btn-outline-danger">Cancelar cobrança</button>
                            </form>
                        }
                        else if (pointAttemptActive)
                        {
                            var retryAssignment = pointAssignments.FirstOrDefault(x => x.Id == cardOnDeliveryPayment.DriverPaymentTerminalAssignmentId);
                            <p class="text-muted">A comunicação expirou antes da confirmação da order. Reenviar reutiliza a tentativa persistida e sua chave de idempotência.</p>
                            @if (retryAssignment is not null)
                            {
                                <form asp-action="StartPointCharge" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@Model.Id" />
                                    <input type="hidden" name="assignmentId" value="@retryAssignment.Id" />
                                    <input type="hidden" name="requestKey" value="@ViewBag.PointRequestKey" />
                                <button class="btn btn-outline-dark" type="submit">Reenviar tentativa segura</button>
                                </form>
                            }
                            else
                            {
                                <button class="btn btn-outline-dark" type="button" disabled>Reenviar tentativa segura</button>
                                <p class="text-muted">O motorista/terminal original não está mais ativo. Reative o vínculo antes de reenviar.</p>
                            }
                        }
                    }
                    @if (!paymentApproved && !pointAttemptActive && pointChargeBlockReason is null && pointAssignments.Count > 0)
                    {
                        <form asp-action="StartPointCharge" method="post" class="d-flex flex-wrap gap-2">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="requestKey" value="@ViewBag.PointRequestKey" />
                            <label for="point-assignment" class="visually-hidden">Motorista e terminal</label>
                            <select id="point-assignment" name="assignmentId" class="form-select" required>
                                <option value="">Selecione motorista e terminal associado</option>
                                @foreach (var assignment in pointAssignments)
                                {
                                    <option value="@assignment.Id">@assignment.Driver?.Name — @assignment.PaymentTerminal?.DeviceId</option>
                                }
                            </select>
                            <button class="btn btn-gold" type="submit">COBRAR NA MAQUININHA</button>
                        </form>
                    }
                    else if (!paymentApproved && !pointAttemptActive && pointChargeBlockReason is not null)
                    {
                        <button class="btn btn-gold" type="button" disabled>COBRAR NA MAQUININHA</button>
                        <p class="text-muted mb-0 mt-2">@pointChargeBlockReason</p>
                    }
                </div>
            </section>
        }

        @if (pointAuditEvents.Count > 0)
        {
            <section class="order-detail-section order-point-audit" aria-labelledby="point-audit-title">
                <header class="order-detail-section-heading"><div><small>RASTREABILIDADE</small><h2 id="point-audit-title">Auditoria da cobrança Point</h2></div></header>
                <ol class="order-point-audit-list">
                    @foreach (var audit in pointAuditEvents)
                    {
                        <li class="order-point-audit-entry">
                            <div class="order-point-audit-main"><strong>@audit.ResultSummary</strong><span class="order-point-audit-transition @(audit.PreviousStatus == Orofoods.Web.Models.Payments.PaymentStatus.Processing && audit.NewStatus == Orofoods.Web.Models.Payments.PaymentStatus.Approved ? "order-point-audit-transition--success" : audit.PreviousStatus == Orofoods.Web.Models.Payments.PaymentStatus.Pending && audit.NewStatus == Orofoods.Web.Models.Payments.PaymentStatus.Processing ? "order-point-audit-transition--info" : audit.PreviousStatus == Orofoods.Web.Models.Payments.PaymentStatus.Pending && audit.NewStatus == Orofoods.Web.Models.Payments.PaymentStatus.Pending ? "order-point-audit-transition--neutral" : "")">@audit.PreviousStatus?.ToDisplayName() → @audit.NewStatus.ToDisplayName()</span></div>
                            <div class="order-point-audit-meta"><span>tentativa @audit.AttemptNumber</span><span>@(audit.AdminUser?.Email ?? "Sistema")</span>@if (!string.IsNullOrWhiteSpace(audit.ExternalOrderId)) { <code>Order: @audit.ExternalOrderId</code> }<time>@audit.OccurredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</time></div>
                        </li>
                    }
                </ol>
            </section>
        }

        <section class="order-actions-card" aria-labelledby="order-actions-title">
            <header class="order-detail-section-heading"><div><small>OPERAÇÃO</small><h2 id="order-actions-title">Ações do pedido</h2></div></header>
            <div class="order-actions-grid">
                <form asp-action="UpdateStatus" method="post" class="order-details-status-form">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <label for="order-status">Status do pedido</label>
                    <div class="order-action-controls">
                        <select id="order-status" name="status" class="form-select">
                            @foreach (var status in Enum.GetValues<OrderStatus>())
                            {
                                if (status == OrderStatus.Delivered && cardOnDelivery && !paymentApproved)
                                {
                                    <option value="@status" selected="@(status == Model.Status)" disabled>@status.ToDisplayName()</option>
                                }
                                else
                                {
                                    <option value="@status" selected="@(status == Model.Status)">@status.ToDisplayName()</option>
                                }
                            }
                        </select>
                        <button class="btn btn-primary">Atualizar status</button>
                    </div>
                </form>
                @if (Model.Status == OrderStatus.Approved && Model.IntegrationStatus != IntegrationStatus.Processing && !wmcImportConfirmed)
                {
                    <form asp-action="ReprocessIntegration" method="post" class="order-details-wmc-form">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <label>Integração ERP</label>
                        <button class="btn btn-outline-dark">Reprocessar integra&#231;&#227;o</button>
                    </form>
                }
                @if (!string.IsNullOrWhiteSpace(Model.IntegrationError))
                {
                    <small class="order-action-feedback text-danger">@Model.IntegrationError</small>
                }
            </div>
            @if (cardOnDelivery && !paymentApproved)
            {
                <p class="alert alert-warning order-action-warning" data-delivered-payment-guard>Pagamento na entrega ainda não foi aprovado.</p>
            }
        </section>

        <div class="order-history-grid">
            <section class="order-detail-section" aria-labelledby="order-status-history-title">
                <header class="order-detail-section-heading"><div><small>RASTREABILIDADE</small><h2 id="order-status-history-title">Hist&oacute;rico de status</h2></div><span class="order-count-badge">@Model.StatusHistory.Count</span></header>
                @{ var statusHistory = Model.StatusHistory.OrderByDescending(x => x.ChangedAt).ToList(); }
                <ol class="list-group order-history-list">
                    @foreach (var entry in statusHistory.Take(historyPreviewCount))
                    {
                        RenderStatusEntry(entry);
                    }
                </ol>
                @if (statusHistory.Count > historyPreviewCount)
                {
                    <details class="order-history-more">
                        <summary>Ver todos os @statusHistory.Count registros</summary>
                        <ol class="list-group order-history-list">
                            @foreach (var entry in statusHistory.Skip(historyPreviewCount))
                            {
                                RenderStatusEntry(entry);
                            }
                        </ol>
                    </details>
                }
            </section>

            <section class="order-detail-section" aria-labelledby="order-wmc-history-title">
                <header class="order-detail-section-heading"><div><small>INTEGRAÇÃO ERP</small><h2 id="order-wmc-history-title">Hist&oacute;rico de exporta&#231;&otilde;es WMC</h2></div><span class="order-count-badge">@Model.WmcExportAudits.Count</span></header>
                @if (!Model.WmcExportAudits.Any())
                {
                    <p class="order-empty-state text-muted"><i class="fa-regular fa-file-lines" aria-hidden="true"></i><span>Nenhuma exporta&#231;&#227;o WMC registrada para este pedido.</span></p>
                }
                else
                {
                    var wmcAudits = Model.WmcExportAudits.OrderByDescending(x => x.ExportedAt).ThenByDescending(x => x.Id).ToList();
                    <ol class="list-group order-history-list">
                        @foreach (var entry in wmcAudits.Take(historyPreviewCount))
                        {
                            RenderWmcEntry(entry);
                        }
                    </ol>
                    @if (wmcAudits.Count > historyPreviewCount)
                    {
                        <details class="order-history-more">
                            <summary>Ver todos os @wmcAudits.Count registros</summary>
                            <ol class="list-group order-history-list">
                                @foreach (var entry in wmcAudits.Skip(historyPreviewCount))
                                {
                                    RenderWmcEntry(entry);
                                }
                            </ol>
                        </details>
                    }
                }
            </section>
        </div>

        <section class="order-detail-section order-items-section" aria-labelledby="order-items-title">
            <header class="order-detail-section-heading"><div><small>COMPOSIÇÃO</small><h2 id="order-items-title">Itens do pedido</h2></div><span class="order-count-badge">@Model.Items.Count</span></header>
            <div class="order-items" role="table" aria-labelledby="order-items-title">
                <div class="order-items-heading" role="row"><span role="columnheader">SKU</span><span role="columnheader">Produto</span><span role="columnheader">Quantidade</span><span role="columnheader">Preço unitário</span><span role="columnheader">Total</span></div>
                @foreach (var item in Model.Items)
                {
                    <div class="order-row" role="row"><small class="order-item-sku" role="cell">@item.SkuSnapshot</small><span class="order-item-product" role="cell"><h3>@item.ProductNameSnapshot</h3></span><span role="cell" data-label="Quantidade">@item.Quantity</span><span role="cell" data-label="Preço unitário">@item.UnitPrice.ToString("C")</span><strong role="cell" data-label="Total">@item.Subtotal.ToString("C")</strong></div>
                }
            </div>
        </section>
        </div>
    </div>
    @if (wmcState?.Status == Orofoods.Web.Models.Integrations.WmcOrderExportStatus.Exported && !wmcState.RequiresManualReview)
    {
        <div class="modal fade wmc-rejection-modal" id="reject-wmc-modal" tabindex="-1" aria-labelledby="reject-wmc-modal-title" aria-describedby="reject-wmc-modal-message" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title fs-5" id="reject-wmc-modal-title">Registrar rejei&ccedil;&atilde;o do TXT</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                    </div>
                    <form asp-action="RejectWmcTxt" method="post" class="wmc-rejection-modal-form">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="modal-body">
                            <p id="reject-wmc-modal-message" class="wmc-import-confirm-lead">Informe o motivo da rejei&ccedil;&atilde;o. O registro ser&aacute; inclu&iacute;do na auditoria do pedido.</p>
                            <label for="wmc-reject-reason-@Model.Id" class="form-label">Motivo da rejei&ccedil;&atilde;o</label>
                            <textarea id="wmc-reject-reason-@Model.Id" name="reason" class="form-control" rows="4" maxlength="1000" required aria-required="true" aria-describedby="reject-wmc-modal-message"></textarea>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-danger">Confirmar rejei&ccedil;&atilde;o</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <div class="modal fade wmc-import-confirm-modal" id="confirm-wmc-import-modal" tabindex="-1" aria-labelledby="confirm-wmc-import-modal-title" aria-describedby="confirm-wmc-import-modal-message" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title fs-5" id="confirm-wmc-import-modal-title">Confirmar importação no WMC</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                    </div>
                    <div class="modal-body">
                        <p class="wmc-import-confirm-lead">Confirme somente se você verificou que este pedido foi importado no WMC.</p>
                        <dl class="wmc-import-confirm-summary">
                            <div><dt>Pedido Orofoods</dt><dd>@Model.Number</dd></div>
                            <div><dt>Estado WMC atual</dt><dd><span class="wmc-import-confirm-status">TXT gerado — aguardando importação</span></dd></div>
                        </dl>
                        <p id="confirm-wmc-import-modal-message" class="wmc-import-confirm-message">Esta confirmação registra o estado informado no Orofoods. Ela não envia nem importa o pedido novamente.</p>
                    </div>
                    <div class="modal-footer">
                        <form asp-action="ConfirmWmcImported" method="post" data-wmc-confirmation-form>
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-success" data-wmc-confirmation-submit><span data-wmc-confirmation-label>Confirmar importação</span></button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</section>
<script src="~/js/admin-point-payment.js" asp-append-version="true" defer></script>

@section Scripts {
    <script>
        (() => {
            const form = document.querySelector("[data-wmc-confirmation-form]");
            if (!form) return;

            form.addEventListener("submit", event => {
                if (form.dataset.wmcSubmitting === "true") {
                    event.preventDefault();
                    return;
                }

                form.dataset.wmcSubmitting = "true";
                const submitButton = form.querySelector("[data-wmc-confirmation-submit]");
                if (!submitButton) return;

                submitButton.disabled = true;
                submitButton.setAttribute("aria-disabled", "true");
                const label = submitButton.querySelector("[data-wmc-confirmation-label]");
                if (label) label.textContent = "Confirmando...";
            });
        })();
    </script>
}

@section Head {
    <link rel="stylesheet" href="~/css/admin-order-details.css" asp-append-version="true" />
}
