@model Orofoods.Web.Models.Pricing.PriceTable
@{ ViewData["Title"] = Model.Id == 0 ? "Nova tabela" : "Editar tabela"; }
<section class="admin-form-page"><div class="container admin-form-container"><nav class="customer-approval-breadcrumb"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Administra&ccedil;&atilde;o</a><i class="fa-solid fa-chevron-right"></i><a asp-action="Index">Tabelas de pre&ccedil;o</a></nav><header class="admin-form-hero"><div><div class="eyebrow"><span></span> Comercial</div><h1>@ViewData["Title"]</h1><p>Crie a tabela que ser&aacute; aplicada aos produtos de cada cliente.</p></div><i class="fa-solid fa-tags"></i></header><form method="post" class="admin-form-card row g-3"><input asp-for="Id" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="col-12"><label asp-for="Name">Nome da tabela</label><input asp-for="Name" class="form-control" placeholder="Ex.: Tabela hamburgueria"/></div><div class="col-12 admin-check"><label><input asp-for="IsActive"/> Tabela ativa</label></div><footer class="col-12 admin-form-actions"><a asp-action="Index" class="btn btn-outline-dark"><i class="fa-solid fa-arrow-left"></i> Voltar</a><button class="btn btn-gold"><i class="fa-solid fa-floppy-disk"></i> Salvar tabela</button></footer></form></div></section>
