@model IReadOnlyList<Orofoods.Web.Models.Pricing.PriceTable>
@{ ViewData["Title"] = "Tabelas de pre&#231;o"; }
<section class="admin-registration-page"><header class="admin-page-header"><div><p class="eyebrow"><span></span> Comercial</p><h1>Tabelas de pre&#231;o</h1><p>Organize as condi&#231;&otilde;es comerciais aplicadas aos clientes.</p></div><a class="btn admin-primary-action" asp-action="Edit"><i class="fa-solid fa-plus" aria-hidden="true"></i> Nova tabela</a></header><div class="admin-table-card"><div class="table-responsive"><table class="table admin-table align-middle"><thead><tr><th>Nome</th><th>Clientes</th><th>Pre&#231;os</th><th>Status</th><th>A&#231;&otilde;es</th></tr></thead><tbody>@foreach(var item in Model){<tr><td class="admin-table-name" data-label="Nome"><strong>@item.Name</strong></td><td class="admin-table-products" data-label="Clientes"><span class="admin-count-badge">@item.Customers.Count</span></td><td class="admin-table-products" data-label="Pre&#231;os"><span class="admin-count-badge">@item.Items.Count</span></td><td class="admin-table-status" data-label="Status"><span class="status-badge @(item.IsActive ? "status-badge--active" : "status-badge--inactive")"><i aria-hidden="true"></i>@(item.IsActive ? "Ativa" : "Inativa")</span></td><td class="admin-table-actions" data-label="A&#231;&otilde;es"><a class="btn admin-secondary-action" asp-action="Items" asp-route-id="@item.Id"><i class="fa-solid fa-tags" aria-hidden="true"></i> Pre&#231;os</a><a class="btn admin-edit-action" asp-action="Edit" asp-route-id="@item.Id"><i class="fa-solid fa-pen" aria-hidden="true"></i> Editar</a></td></tr>}</tbody></table></div></div></section>
