@model IReadOnlyList<Orofoods.Web.Models.Pricing.PriceTable>
@{ ViewData["Title"] = "Tabelas de pre&#231;o"; }
<section class="section"><div class="container"><div class="portal-top"><h1>Tabelas de pre&#231;o</h1><a class="btn btn-gold" asp-action="Edit">Nova tabela</a></div><div class="table-responsive mt-4"><table class="table table-dark table-striped"><thead><tr><th>Nome</th><th>Clientes</th><th>Pre&#231;os</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.Name</td><td>@item.Customers.Count</td><td>@item.Items.Count</td><td>@(item.IsActive ? "Ativa" : "Inativa")</td><td><a class="btn btn-sm btn-gold" asp-action="Items" asp-route-id="@item.Id">Pre&#231;os</a> <a class="btn btn-sm btn-outline-light" asp-action="Edit" asp-route-id="@item.Id">Editar</a></td></tr>}</tbody></table></div></div></section>
