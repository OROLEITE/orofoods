@model IReadOnlyList<Orofoods.Web.Models.Delivery.Driver>
@{
    ViewData["Title"] = "Motoristas";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div><h1>Motoristas</h1><p>Cadastro operacional para associação de terminais.</p></div>
    <a class="btn btn-primary" asp-action="Edit">Novo motorista</a>
</div>
@if (TempData["Error"] is string error) { <div class="alert alert-warning">@error</div> }
<div class="table-responsive"><table class="table align-middle">
    <thead><tr><th>Nome</th><th>Status</th><th></th></tr></thead>
    <tbody>
    @foreach (var driver in Model)
    {
        <tr>
            <td>@driver.Name</td>
            <td>@(driver.IsActive ? "Ativo" : "Inativo")</td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@driver.Id">Editar</a>
                @if (driver.IsActive)
                {
                    <form asp-action="Deactivate" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@driver.Id" />
                        <button class="btn btn-sm btn-outline-danger" type="submit">Desativar</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table></div>
