@model Orofoods.Web.ViewModels.AdminUserEditViewModel
@{ ViewData["Title"] = "Editar usu&aacute;rio"; }
<section class="admin-form-page"><div class="container admin-form-container"><nav class="customer-approval-breadcrumb"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Administra&ccedil;&atilde;o</a><i class="fa-solid fa-chevron-right"></i><a asp-action="Index">Usu&aacute;rios</a></nav><header class="admin-form-hero"><div><div class="eyebrow"><span></span> Acesso ao sistema</div><h1>Configurar usu&aacute;rio</h1><p>@Model.Email</p></div><i class="fa-solid fa-user-gear"></i></header><form method="post" class="admin-form-card row g-3"><input asp-for="Id" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="col-md-6"><label asp-for="Role">Perfil de acesso</label><select asp-for="Role" asp-items="Model.Roles" class="form-select"></select></div><div class="col-md-6 admin-check"><label><input asp-for="IsActive"/> Usu&aacute;rio ativo</label></div><div class="col-md-6"><label asp-for="CustomerId">Cliente vinculado</label><select asp-for="CustomerId" asp-items="Model.Customers" class="form-select"><option value="">Nenhum cliente</option></select></div><div class="col-md-6"><label asp-for="SalesRepresentativeId">Vendedor vinculado</label><select asp-for="SalesRepresentativeId" asp-items="Model.SalesRepresentatives" class="form-select"><option value="">Nenhum vendedor</option></select></div><footer class="col-12 admin-form-actions"><a asp-action="Index" class="btn btn-outline-dark"><i class="fa-solid fa-arrow-left"></i> Voltar</a><button class="btn btn-gold"><i class="fa-solid fa-floppy-disk"></i> Salvar acesso</button></footer></form></div></section>
