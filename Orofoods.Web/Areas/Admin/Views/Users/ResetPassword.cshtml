@model Orofoods.Web.ViewModels.AdminUserResetPasswordViewModel
@{ ViewData["Title"] = "Redefinir senha"; }
<section class="admin-users-page admin-users-form-page">
    <nav class="admin-users-breadcrumb"><a asp-action="Index">Usuários</a><span aria-hidden="true">/</span> Redefinir senha</nav>
    <header class="admin-users-header"><div><p class="admin-users-eyebrow">Segurança da conta</p><h1>Redefinir senha</h1><p>Conta: <strong>@Model.Name</strong> · @Model.Email</p></div></header>
    <form asp-action="ResetPassword" method="post" class="admin-users-form">
        @Html.AntiForgeryToken()<input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <fieldset><legend>SEGURANÇA</legend><div class="admin-users-form-grid">
            <div><label asp-for="Password">Nova senha</label><input asp-for="Password" class="form-control" autocomplete="new-password" /><span asp-validation-for="Password" class="text-danger"></span></div>
            <div><label asp-for="ConfirmPassword">Confirmar nova senha</label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div>
        </div><p>A senha será processada pelo Identity. Ela não será exibida depois de salva.</p></fieldset>
        <div class="admin-users-confirm"><input asp-for="ConfirmReset" /><label asp-for="ConfirmReset">Confirmo a redefinição da senha desta conta.</label><span asp-validation-for="ConfirmReset" class="text-danger"></span></div>
        <footer class="admin-users-form-actions"><a asp-action="Index" class="btn admin-users-secondary">Cancelar</a><button class="btn admin-users-primary" type="submit">Confirmar redefinição</button></footer>
    </form>
</section>
@section Head { <link rel="stylesheet" href="~/css/admin-users.css" asp-append-version="true" /> }
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
