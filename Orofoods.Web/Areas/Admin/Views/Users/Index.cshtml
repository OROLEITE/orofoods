@model IReadOnlyList<Orofoods.Web.ViewModels.AdminUserRow>
@{ ViewData["Title"] = "Usu&aacute;rios"; }
<section class="section"><div class="container"><h1>Usu&aacute;rios</h1><div class="table-responsive mt-4"><table class="table table-dark table-striped"><thead><tr><th>E-mail</th><th>Perfil</th><th>Cliente</th><th>Vendedor</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var row in Model){<tr><td>@row.User.Email</td><td>@row.Role</td><td>@row.Customer</td><td>@row.SalesRepresentative</td><td>@(row.User.IsActive ? "Ativo" : "Inativo")</td><td><a class="btn btn-sm btn-gold" asp-action="Edit" asp-route-id="@row.User.Id">Editar acesso</a></td></tr>}</tbody></table></div></div></section>
