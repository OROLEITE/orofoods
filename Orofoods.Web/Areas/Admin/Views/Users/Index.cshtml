@model IReadOnlyList<Orofoods.Web.ViewModels.AdminUserRow>
@{ ViewData["Title"] = "Usu&aacute;rios"; }
<section class="admin-registration-page"><header class="admin-page-header"><div><p class="eyebrow"><span></span> Equipe</p><h1>Usu&aacute;rios</h1><p>Administre perfis, v&iacute;nculos e acesso ao sistema.</p></div></header><div class="admin-table-card"><div class="table-responsive"><table class="table admin-table align-middle"><thead><tr><th>E-mail</th><th>Perfil</th><th>Cliente</th><th>Vendedor</th><th>Status</th><th>A&#231;&otilde;es</th></tr></thead><tbody>@foreach(var row in Model){<tr><td class="admin-table-name" data-label="E-mail"><strong>@row.User.Email</strong></td><td data-label="Perfil">@row.Role</td><td data-label="Cliente">@row.Customer</td><td data-label="Vendedor">@row.SalesRepresentative</td><td class="admin-table-status" data-label="Status"><span class="status-badge @(row.User.IsActive ? "status-badge--active" : "status-badge--inactive")"><i aria-hidden="true"></i>@(row.User.IsActive ? "Ativo" : "Inativo")</span></td><td class="admin-table-actions" data-label="A&#231;&otilde;es"><a class="btn admin-edit-action" asp-action="Edit" asp-route-id="@row.User.Id"><i class="fa-solid fa-user-pen" aria-hidden="true"></i> Editar acesso</a></td></tr>}</tbody></table></div></div></section>
