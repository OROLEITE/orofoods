@using Orofoods.Web.Integrations.Erp.Wmc
@using Orofoods.Web.Models.Integrations
@model WmcPreviewPageModel
@{
    ViewData["Title"] = "Sincroniza\u00e7\u00e3o WMC";
    var isRunning = (bool)ViewBag.IsRunning;
    var lastRun = ViewBag.LastRun as WmcSyncRunResult;
    var bimboProducts = ViewBag.BimboProducts as IReadOnlyList<WmcBimboAdminProductRow> ?? [];
    var canManageBimbo = ViewBag.CanManageBimbo == true;
    var canActivateBimbo = ViewBag.CanActivateBimbo == true;
}

<section class="section admin-wmc-page">
    <div class="container">
        <header class="wmc-page-header wmc-hero-card">
            <div class="wmc-hero-main">
                <span class="wmc-hero-icon" aria-hidden="true">
                    <svg data-icon="refresh-cw" viewBox="0 0 24 24" focusable="false"><path d="M21 12a9 9 0 0 0-15.3-6.4L3 8m0-5v5h5M3 12a9 9 0 0 0 15.3 6.4L21 16m0 5v-5h-5" /></svg>
                </span>
                <div>
                    <div class="eyebrow"><span></span> Opera&ccedil;&atilde;o</div>
                    <h1>Sincroniza&ccedil;&atilde;o WMC</h1>
                    <p>Integra&ccedil;&atilde;o Firebird &middot; Somente leitura</p>
                </div>
            </div>
            <div class="wmc-hero-meta">
                <span class="wmc-status-badge @(isRunning ? "wmc-status-badge--running" : "wmc-status-badge--idle")">@(isRunning ? "Sincronizando..." : "Ocioso")</span>
                @if (lastRun is not null)
                {
                    <span class="wmc-last-sync">&Uacute;ltima sincroniza&ccedil;&atilde;o: @lastRun.FinishedAt.ToString("u") UTC</span>
                }
                else
                {
                    <span class="wmc-last-sync">Nenhuma sincroniza&ccedil;&atilde;o executada</span>
                }
                <a class="btn btn-outline-dark" asp-action="Index">Voltar &agrave;s integra&ccedil;&otilde;es</a>
            </div>
        </header>

        @if (TempData["WmcSyncMessage"] is string message)
        {
            <div class="alert alert-info mt-4" role="alert">@message</div>
        }

        @if (lastRun is not null)
        {
            <table class="table mt-3">
                <thead>
                    <tr>
                        <th>Entidade</th>
                        <th>Lidos</th>
                        <th>Criados</th>
                        <th>Atualizados</th>
                        <th>Ignorados</th>
                        <th>Erro</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td>Clientes</td><td>@lastRun.Customers.RecordsRead</td><td>@lastRun.Customers.RecordsCreated</td><td>@lastRun.Customers.RecordsUpdated</td><td>@lastRun.Customers.RecordsSkipped</td><td>@lastRun.Customers.ErrorMessage</td></tr>
                    <tr><td>Produtos</td><td>@lastRun.Products.RecordsRead</td><td>@lastRun.Products.RecordsCreated</td><td>@lastRun.Products.RecordsUpdated</td><td>@lastRun.Products.RecordsSkipped</td><td>@lastRun.Products.ErrorMessage</td></tr>
                    <tr><td>Vendedores</td><td>@lastRun.Sellers.RecordsRead</td><td>@lastRun.Sellers.RecordsCreated</td><td>@lastRun.Sellers.RecordsUpdated</td><td>@lastRun.Sellers.RecordsSkipped</td><td>@lastRun.Sellers.ErrorMessage</td></tr>
                    <tr><td>Estoque</td><td>@lastRun.Stock.RecordsRead</td><td>@lastRun.Stock.RecordsCreated</td><td>@lastRun.Stock.RecordsUpdated</td><td>@lastRun.Stock.RecordsSkipped</td><td>@lastRun.Stock.ErrorMessage</td></tr>
                </tbody>
            </table>
        }
        else
        {
            <p class="mt-3">Nenhuma sincroniza&ccedil;&atilde;o executada ainda nesta inst&acirc;ncia.</p>
        }

        <section class="mt-5" aria-labelledby="wmc-preview-title">
            <h2 id="wmc-preview-title" class="wmc-preview-heading"><svg data-icon="package" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m21 8-9-5-9 5 9 5 9-5Zm-18 0v8l9 5 9-5V8m-9 5v8" /></svg> Pr&eacute;via de produtos por marca</h2>
            <p>Consulta somente leitura. Nenhum produto, estoque, categoria ou execu&ccedil;&atilde;o ser&aacute; gravado.</p>

            <section class="wmc-import-wizard mt-3" aria-labelledby="wmc-import-title">
                <h3 id="wmc-import-title">Importar produtos e unidades oficiais</h3>
                <p class="text-muted">Etapa: @(Model.Step == "Brands" ? "1 · Marca" : Model.Step == "Products" ? "2 · Produtos" : Model.Step == "Confirmation" ? "3 · Confirmação" : "Resultado") · Espelho WMC somente leitura.</p>
                @if (Model.LastProductSyncAt is DateTime lastProductSync)
                {
                    <small class="text-muted d-block mb-2">Última importação: @lastProductSync.ToLocalTime().ToString("g")</small>
                }
                @if (Model.Step == "Brands")
                {
                    <form method="post" asp-action="WmcProducts" class="wmc-import-brand-form">
                        @Html.AntiForgeryToken()
                        <label class="form-label" for="wmcImportBrand">Marca WMC</label>
                        <select class="form-select" name="brandCode" id="wmcImportBrand" required>
                            @foreach (var brand in Model.Brands.OrderBy(item => item.Description))
                            {
                                <option value="@brand.Code">@brand.Description (@brand.ProductCount)</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-primary mt-2">Carregar produtos</button>
                    </form>
                }
                else if (Model.Step == "Products" && Model.Candidates is not null)
                {
                    <h4>@Model.SelectedBrandDescription</h4>
                    <form method="post" asp-action="WmcConfirmSelection" id="wmcImportSelectionForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="brandCode" value="@Model.SelectedBrandCode" />
                        <div class="table-responsive"><table class="table table-sm align-middle wmc-import-table">
                            <thead><tr><th>Selecionar</th><th>Produto</th><th>Unidade</th><th>Unidades oficiais</th><th>Status</th></tr></thead>
                            <tbody>
                            @foreach (var item in Model.Candidates)
                            {
                                <tr>
                                    <td><input type="checkbox" name="selectedProductCodes" value="@item.WmcCode" @(item.Selectable ? null : "disabled") /></td>
                                    <td><strong>@item.WmcCode</strong><br />@item.Name@if (!string.IsNullOrWhiteSpace(item.Ean)) { <small class="text-muted d-block">EAN @item.Ean</small> }</td>
                                    <td>@(item.Unit ?? "-")</td>
                                    <td>@foreach (var unit in item.Units) { <span class="d-block">@unit.UnitCode · fator @(unit.Factor?.ToString() ?? "-") · @(unit.Barcode ?? "-")@(unit.IsMaster ? " · master" : "")</span> }</td>
                                    <td>@item.Status</td>
                                </tr>
                            }
                            </tbody>
                        </table></div>
                        <button type="submit" class="btn btn-primary">Continuar</button>
                    </form>
                }
                else if (Model.Step == "Confirmation" && Model.Confirmation is not null)
                {
                    <h4>Confirmar importação · @Model.SelectedBrandDescription</h4>
                    <p>@Model.Confirmation.NewProducts novos, @Model.Confirmation.ExistingProducts existentes e @Model.Confirmation.ChangedProducts com alterações.</p>
                    <form method="post" asp-action="WmcImportProducts">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="brandCode" value="@Model.SelectedBrandCode" />
                        @foreach (var code in Model.SelectedProductCodes ?? []) { <input type="hidden" name="selectedProductCodes" value="@code" /> }
                        <button class="btn btn-primary" type="submit" name="reimportExisting" value="true">Importar e atualizar</button>
                        <button class="btn btn-outline-secondary" type="submit" name="reimportExisting" value="false">Somente novos</button>
                        <button class="btn btn-link" type="submit" name="reimportExisting" value="cancel">Cancelar</button>
                    </form>
                }
                else if (Model.Step == "Result" && Model.ImportResult is not null)
                {
                    <h4>Resultado: @(Model.ImportResult.Status == "Succeeded" ? "Concluído" : "Não concluído")</h4>
                    <p>@Model.ImportResult.Created criados · @Model.ImportResult.Updated atualizados · @Model.ImportResult.Unchanged inalterados · @Model.ImportResult.Errors erros</p>
                    @if (Model.ImportResult.ErrorMessage is not null) { <div class="alert alert-warning" role="alert">@Model.ImportResult.ErrorMessage</div> }
                    <a asp-action="Wmc" class="btn btn-primary">Nova importação</a>
                }
            </section>

            @if (canManageBimbo)
            {
            <section class="wmc-bimbo-card" aria-labelledby="wmc-bimbo-title">
                <div class="wmc-bimbo-heading">
                    <div>
                        <h3 id="wmc-bimbo-title">Importa&ccedil;&atilde;o BIMBO &middot; marca 104</h3>
                        <p>Simule a valida&ccedil;&atilde;o dos 10 produtos. A importa&ccedil;&atilde;o &eacute; restrita ao Staging e mant&eacute;m os produtos pendentes de cadastro comercial.</p>
                    </div>
                    @if (canManageBimbo)
                    {
                        <form id="wmcBimboSimulateForm" asp-action="WmcBimboSimulate" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-primary" id="wmcBimboSimulateButton">Simular importa&ccedil;&atilde;o</button>
                        </form>
                    }
                </div>
                <div id="wmcBimboFeedback" class="alert alert-info" role="status" aria-live="polite" hidden></div>

                <h4 class="wmc-bimbo-subtitle">Status comercial dos produtos</h4>
                <div class="table-responsive wmc-bimbo-status-scroll">
                    <table class="wmc-product-table wmc-bimbo-status-table">
                        <thead><tr><th>C&oacute;digo WMC</th><th>Produto</th><th>EAN-13</th><th>DUN-14</th><th>Pre&ccedil;o/PCT</th><th>Estoque</th><th>Status</th><th>A&ccedil;&atilde;o</th></tr></thead>
                        <tbody>
                            @foreach (var product in bimboProducts)
                            {
                                <tr data-bimbo-code="@product.WmcCode">
                                    <td>@product.WmcCode</td>
                                    <td class="wmc-bimbo-product-name" title="@(product.Name ?? "N&atilde;o importado")">@(product.Name ?? "N&atilde;o importado")</td>
                                    <td>@(product.Ean13 ?? "—")</td>
                                    <td>@(product.Dun14 ?? "—")</td>
                                    <td>@(product.BasePrice?.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("pt-BR")) ?? "—")</td>
                                    <td>@(product.AvailableStock?.ToString("0.###") ?? "—")</td>
                                    <td><span class="wmc-product-status wmc-product-status--@product.CommercialStatus.ToLowerInvariant()" data-commercial-status="@product.CommercialStatus">@product.CommercialStatus</span></td>
                                    <td>
                                        @if (canActivateBimbo && product.CanActivate && product.ProductId.HasValue)
                                        {
                                            <form class="wmc-bimbo-activate-form" asp-action="WmcBimboActivate" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="productId" value="@product.ProductId" />
                                                <label class="visually-hidden" for="bimbo-reason-@product.WmcCode">Motivo da ativa&ccedil;&atilde;o @product.WmcCode</label>
                                                <input id="bimbo-reason-@product.WmcCode" type="text" name="reason" maxlength="300" required placeholder="Motivo da libera&ccedil;&atilde;o" />
                                                <button type="submit" class="btn btn-sm btn-primary">Ativar</button>
                                            </form>
                                        }
                                        else if (product.Reasons.Count > 0)
                                        {
                                            <details class="wmc-bimbo-reason-details">
                                                <summary aria-label="Ver motivos de bloqueio do produto @product.WmcCode"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i> Motivos (@product.Reasons.Count)</summary>
                                                <ul class="wmc-bimbo-reason-list">
                                                    @foreach (var reason in product.Reasons)
                                                    {
                                                        <li>@reason</li>
                                                    }
                                                </ul>
                                            </details>
                                        }
                                        else
                                        {
                                            <span class="text-muted">&mdash;</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (canManageBimbo)
                {
                    <form id="wmcBimboImportForm" asp-action="WmcBimboImport" method="post">
                        @Html.AntiForgeryToken()
                        <div id="wmcBimboSimulation" hidden>
                            <h4 class="wmc-bimbo-subtitle">Resultado da simula&ccedil;&atilde;o</h4>
                            <div class="table-responsive">
                                <table class="wmc-product-table">
                                    <thead><tr><th>Selecionar</th><th>C&oacute;digo WMC</th><th>Produto</th><th>EAN-13</th><th>Unidade</th><th>Estoque</th><th>Valida&ccedil;&atilde;o / motivo</th></tr></thead>
                                    <tbody id="wmcBimboSimulationRows"></tbody>
                                </table>
                            </div>
                            <button type="submit" class="btn btn-primary" id="wmcBimboImportButton" disabled>Importar selecionados</button>
                        </div>
                    </form>
                }
            </section>
            }

            @if (TempData["WmcPreviewError"] is string previewError)
            {
                <div class="alert alert-warning" role="alert">@previewError</div>
            }
            <form method="post" asp-action="WmcPreview" class="wmc-preview-form">
                @Html.AntiForgeryToken()
                <div class="wmc-brand-toolbar">
                    <label class="form-label" for="wmcBrandSearch">Pesquisar marca</label>
                    <input class="form-control" id="wmcBrandSearch" type="search" placeholder="C&oacute;digo ou descri&ccedil;&atilde;o" autocomplete="off" />
                    <button class="btn btn-outline-secondary wmc-selection-action" type="button" id="wmcSelectFiltered"><span aria-hidden="true">&#10003;</span> Selecionar filtradas</button>
                    <button class="btn btn-outline-secondary wmc-selection-action" type="button" id="wmcClearSelection"><span aria-hidden="true">&times;</span> Limpar sele&ccedil;&atilde;o</button>
                </div>
                <div class="wmc-brand-grid" id="wmcBrandGrid" role="group" aria-label="Marcas WMC">
                    @foreach (var brand in Model.Brands)
                    {
                        var isSelected = Model.SelectedBrandCodes.Contains((short)brand.Code);
                        <label class="wmc-brand-row" data-brand-search="@brand.Code @brand.Description">
                            <input type="checkbox" name="brandCodes" value="@brand.Code" checked="@(isSelected ? "checked" : null)" />
                            <span class="wmc-brand-code">@brand.Code</span>
                            <span class="wmc-brand-description">@brand.Description</span>
                            <span class="wmc-brand-count">@brand.ActiveProductCount ativos de @brand.ProductCount</span>
                        </label>
                    }
                </div>
                <div class="wmc-preview-submit"><span id="wmcSelectionCount" aria-live="polite">0 marcas selecionadas</span><button type="submit" class="btn btn-primary">Simular importa&ccedil;&atilde;o</button></div>
            </form>

            @if (Model.Preview is not null)
            {
                @if (Model.Preview.ErrorMessage is not null)
                {
                    <div class="alert alert-warning" role="alert">@Model.Preview.ErrorMessage</div>
                }
                <div class="wmc-preview-cards" aria-label="Resumo da simula&ccedil;&atilde;o">
                    <article class="wmc-preview-card"><span>Novos ativos</span><strong>@Model.Preview.NewActiveProducts</strong></article>
                    <article class="wmc-preview-card"><span>Existentes</span><strong>@Model.Preview.ExistingActiveProducts</strong></article>
                    <article class="wmc-preview-card"><span>Ignorados</span><strong>@Model.Preview.InactiveIgnoredProducts</strong></article>
                    <article class="wmc-preview-card"><span>Conflitos</span><strong>@(Model.Preview.DuplicateCodes + Model.Preview.InvalidCodes + Model.Preview.InvalidSituations + Model.Preview.StockProblems)</strong></article>
                </div>
                <details class="wmc-preview-details">
                    <summary>Detalhes da simula&ccedil;&atilde;o</summary>
                    <dl>
                        <div><dt>Produtos lidos</dt><dd>@Model.Preview.ProductsRead</dd></div>
                        <div><dt>Ativos eleg&iacute;veis</dt><dd>@Model.Preview.ActiveEligibleProducts</dd></div>
                        <div><dt>Ativos</dt><dd>@Model.Preview.ActiveProducts</dd></div>
                        <div><dt>Inativos</dt><dd>@Model.Preview.InactiveProducts</dd></div>
                        <div><dt>Situa&ccedil;&otilde;es desconhecidas</dt><dd>@Model.Preview.UnknownSituations</dd></div>
                        <div><dt>C&oacute;digos inv&aacute;lidos</dt><dd>@Model.Preview.InvalidCodes</dd></div>
                        <div><dt>C&oacute;digos duplicados</dt><dd>@Model.Preview.DuplicateCodes</dd></div>
                        <div><dt>Problemas de estoque</dt><dd>@Model.Preview.StockProblems</dd></div>
                        <div><dt>Dispon&iacute;veis projetados</dt><dd>@Model.Preview.ProjectedAvailableProducts</dd></div>
                        <div><dt>Bloqueados projetados</dt><dd>@Model.Preview.ProjectedBlockedProducts</dd></div>
                    </dl>
                </details>
                <p class="text-muted">A pr&eacute;via preserva pre&ccedil;os, fotos, categorias comerciais, publica&ccedil;&atilde;o e reservas locais.</p>
                @if (Model.BrandPreviews.Count > 0)
                {
                    <h3 class="mt-4">Resultado por marca</h3>
                    <div class="wmc-brand-results">
                        @foreach (var brandPreview in Model.BrandPreviews)
                        {
                            <article class="wmc-brand-result">
                                <h4>@brandPreview.Code - @brandPreview.Description</h4>
                                <span>@brandPreview.Preview.NewProducts novos</span>
                                <span>@brandPreview.Preview.ExistingProducts existentes</span>
                                <span>@brandPreview.Preview.InactiveIgnoredProducts ignorados</span>
                                <div class="wmc-product-filter" role="toolbar" aria-label="Filtrar produtos da marca">
                                    <button type="button" class="wmc-product-filter-button is-active" data-product-filter="Todos">Todos</button>
                                    <button type="button" class="wmc-product-filter-button" data-product-filter="Novo">Novos</button>
                                    <button type="button" class="wmc-product-filter-button" data-product-filter="Existente">Existentes</button>
                                    <button type="button" class="wmc-product-filter-button" data-product-filter="Conflito">Conflitos</button>
                                </div>
                                <div class="wmc-product-grid table-responsive">
                                    <table class="wmc-product-table">
                                        <thead><tr><th>C&oacute;digo WMC</th><th>Descri&ccedil;&atilde;o</th><th>Estoque</th><th>Situa&ccedil;&atilde;o</th></tr></thead>
                                        <tbody>
                                            @foreach (var product in brandPreview.Products)
                                            {
                                                <tr data-product-status="@product.Status">
                                                    <td>@product.WmcCode</td>
                                                    <td>@product.Description</td>
                                                    <td>@(product.Stock?.ToString("0.###") ?? "N/D")</td>
                                                    <td><span class="wmc-product-status wmc-product-status--@product.Status.ToLowerInvariant()">@product.Status</span></td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </article>
                        }
                    </div>
                }
            }
        </section>
    </div>
</section>

<script>
    (() => {
        const search = document.getElementById('wmcBrandSearch');
        const rows = [...document.querySelectorAll('.wmc-brand-row')];
        const visibleRows = () => rows.filter(row => row.hidden !== true);
        const checkboxes = () => rows.map(row => row.querySelector('input'));
        const updateCount = () => {
            const count = checkboxes().filter(input => input.checked).length;
            const label = document.getElementById('wmcSelectionCount');
            if (label) label.textContent = `${count} marca${count === 1 ? '' : 's'} selecionada${count === 1 ? '' : 's'}`;
            const clear = document.getElementById('wmcClearSelection');
            if (clear) clear.disabled = count === 0;
        };
        const updateRows = () => {
            const term = (search?.value ?? '').trim().toLocaleLowerCase();
            rows.forEach(row => row.hidden = term.length > 0 && !(row.dataset.brandSearch ?? '').toLocaleLowerCase().includes(term));
        };
        search?.addEventListener('input', updateRows);
        rows.forEach(row => row.querySelector('input')?.addEventListener('change', updateCount));
        document.getElementById('wmcSelectFiltered')?.addEventListener('click', () => { visibleRows().forEach(row => row.querySelector('input').checked = true); updateCount(); });
        document.getElementById('wmcClearSelection')?.addEventListener('click', () => { rows.forEach(row => row.querySelector('input').checked = false); updateCount(); });
        document.querySelectorAll('.wmc-product-filter').forEach(toolbar => toolbar.addEventListener('click', event => {
            const button = event.target.closest('[data-product-filter]');
            if (!button) return;
            toolbar.querySelectorAll('.wmc-product-filter-button').forEach(item => item.classList.toggle('is-active', item === button));
            const filter = button.dataset.productFilter;
            toolbar.closest('.wmc-brand-result').querySelectorAll('tbody tr').forEach(row => row.hidden = filter !== 'Todos' && row.dataset.productStatus !== filter);
        }));
        updateCount();
    })();
</script>

@if (canManageBimbo)
{
<script>
    (() => {
        const simulateForm = document.getElementById('wmcBimboSimulateForm');
        const importForm = document.getElementById('wmcBimboImportForm');
        const resultPanel = document.getElementById('wmcBimboSimulation');
        const resultRows = document.getElementById('wmcBimboSimulationRows');
        const importButton = document.getElementById('wmcBimboImportButton');
        const feedback = document.getElementById('wmcBimboFeedback');

        const showFeedback = (message, type = 'info') => {
            feedback.className = `alert alert-${type}`;
            feedback.textContent = message;
            feedback.hidden = false;
        };
        const postForm = async (form) => {
            const token = form.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
            return fetch(form.action, {
                method: 'POST',
                headers: { 'RequestVerificationToken': token, 'Accept': 'application/json' },
                body: new FormData(form),
                credentials: 'same-origin'
            });
        };
        const updateImportButton = () => {
            importButton.disabled = !resultRows.querySelector('input[name="selectedWmcCodes"]:checked');
        };
        const addCell = (row, value) => {
            const cell = document.createElement('td');
            cell.textContent = value ?? '—';
            row.appendChild(cell);
            return cell;
        };
        const renderSimulation = (products) => {
            resultRows.replaceChildren();
            for (const product of products ?? []) {
                const row = document.createElement('tr');
                const selectCell = document.createElement('td');
                const checkbox = document.createElement('input');
                checkbox.type = 'checkbox';
                checkbox.name = 'selectedWmcCodes';
                checkbox.value = product.wmcCode;
                checkbox.disabled = !product.canSelect;
                checkbox.setAttribute('aria-label', `Selecionar produto WMC ${product.wmcCode}`);
                checkbox.addEventListener('change', updateImportButton);
                selectCell.appendChild(checkbox);
                row.appendChild(selectCell);
                addCell(row, product.wmcCode);
                addCell(row, product.description);
                addCell(row, product.ean13);
                addCell(row, product.salesUnitCode);
                addCell(row, product.stock == null ? 'N/D' : Number(product.stock).toLocaleString('pt-BR'));
                const issueText = (product.issues ?? []).map(issue => issue.message).concat(product.skipReasons ?? []).join(' ');
                addCell(row, issueText || 'Validado para importação.');
                if (product.issues?.length) row.classList.add('wmc-bimbo-row--invalid');
                if (product.alreadyImported) row.classList.add('wmc-bimbo-row--existing');
                resultRows.appendChild(row);
            }
            resultPanel.hidden = false;
            updateImportButton();
        };

        simulateForm?.addEventListener('submit', async event => {
            event.preventDefault();
            const button = document.getElementById('wmcBimboSimulateButton');
            button.disabled = true;
            button.textContent = 'Validando...';
            showFeedback('Validando os 10 produtos BIMBO sem gravar dados.');
            try {
                const response = await postForm(simulateForm);
                const result = await response.json();
                renderSimulation(result.products);
                showFeedback(result.succeeded ? 'Simulação concluída. Nenhum dado foi gravado.' : 'Simulação concluída com registros que precisam de revisão.', result.succeeded ? 'success' : 'warning');
            } catch {
                showFeedback('Não foi possível concluir a simulação. Tente novamente.', 'danger');
            } finally {
                button.disabled = false;
                button.textContent = 'Simular importação';
            }
        });

        importForm?.addEventListener('submit', async event => {
            event.preventDefault();
            const selectedCount = resultRows.querySelectorAll('input[name="selectedWmcCodes"]:checked').length;
            if (selectedCount === 0 || !window.confirm(`Confirmar a importação de ${selectedCount} produto(s) selecionado(s) para o Staging?`)) return;
            importButton.disabled = true;
            importButton.textContent = 'Importando...';
            try {
                const response = await postForm(importForm);
                const result = await response.json();
                const messages = (result.products ?? []).map(product => `${product.wmcCode}: ${product.message}`);
                const summary = `Importados: ${result.importedProducts ?? 0}; ignorados: ${result.skippedProducts ?? 0}.`;
                showFeedback([result.succeeded ? 'Importação concluída com sucesso.' : `Importação recusada: ${result.errorMessage ?? result.errorCode ?? 'revise os dados selecionados'}.`, summary, ...messages].join(' '), result.succeeded ? 'success' : 'danger');
                if (result.succeeded) window.setTimeout(() => window.location.reload(), 1800);
            } catch {
                showFeedback('Não foi possível concluir a importação. Revise os registros e tente novamente.', 'danger');
            } finally {
                importButton.textContent = 'Importar selecionados';
                updateImportButton();
            }
        });

        document.querySelectorAll('.wmc-bimbo-activate-form').forEach(form => form.addEventListener('submit', async event => {
            event.preventDefault();
            const button = form.querySelector('button[type="submit"]');
            if (!window.confirm('Ativar este produto no catálogo após validar os dados comerciais?')) return;
            button.disabled = true;
            try {
                const response = await postForm(form);
                const result = await response.json();
                showFeedback(result.message, result.succeeded ? 'success' : 'warning');
                if (result.succeeded) window.setTimeout(() => window.location.reload(), 1200);
            } catch {
                showFeedback('Não foi possível ativar o produto. Revise o cadastro comercial.', 'danger');
            } finally {
                button.disabled = false;
            }
        }));
    })();
</script>
}
