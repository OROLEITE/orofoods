@using Orofoods.Web.Integrations.Erp.Wmc
@using Orofoods.Web.Models.Integrations
@model WmcPreviewPageModel
@{
    ViewData["Title"] = "Sincroniza\u00e7\u00e3o de Produtos WMC";
}

<section class="section admin-wmc-page">
    <div class="container">
        <div class="portal-top">
            <div>
                <div class="eyebrow"><span></span> Opera&ccedil;&atilde;o</div>
                <h1>Sincroniza&ccedil;&atilde;o de Produtos WMC</h1>
            </div>
            <a class="btn btn-outline-dark" asp-action="Index">Voltar &agrave;s integra&ccedil;&otilde;es</a>
        </div>

        @if (TempData["WmcSyncMessage"] is string message)
        {
            <div class="alert alert-info mt-4" role="alert">@message</div>
        }

        <section class="wmc-import-wizard mt-3" aria-labelledby="wmc-import-title">
            <h2 id="wmc-import-title">Importar produtos por marca</h2>
            <p class="text-muted">Etapa: @(Model.Step == "Brands" ? "1 · Marca" : Model.Step == "Products" ? "2 · Produtos" : Model.Step == "Confirmation" ? "3 · Confirmação" : "Resultado") · Espelho WMC somente leitura.</p>
            <small class="text-muted">Última importação de produtos Orofoods: @(Model.LastProductSyncAt is DateTime lastProductSync ? lastProductSync.ToLocalTime().ToString("g") : "ainda não registrada")</small>
            @if (!ViewData.ModelState.IsValid)
            { <div asp-validation-summary="All" class="alert alert-warning" role="alert"></div> }
            @if (Model.Step == "Brands")
            {
                <form method="post" asp-action="WmcProducts" class="wmc-import-brand-form">
                    @Html.AntiForgeryToken()
                    <label class="form-label" for="wmcImportBrand">Marca WMC</label>
                    <select class="form-select" name="brandCode" id="wmcImportBrand" required>
                        <option value="">Selecione uma marca</option>
                        @foreach (var brand in Model.Brands.OrderBy(b => b.Description))
                        { <option value="@brand.Code">@brand.Description (@brand.ProductCount)</option> }
                    </select>
                    <button class="btn admin-primary-action mt-2" type="submit">Ver produtos</button>
                </form>
            }
            @if (Model.Step == "Products" && Model.Candidates is not null)
            {
                <h3>@Model.SelectedBrandDescription</h3>
                <form method="post" asp-action="WmcConfirmSelection" id="wmcImportSelectionForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="brandCode" value="@Model.SelectedBrandCode" />
                    <div class="wmc-import-toolbar">
                        <input class="form-control" type="search" placeholder="Código WMC, descrição ou EAN" data-product-search aria-label="Pesquisar produtos" />
                        <button class="btn btn-outline-secondary btn-sm" type="button" data-select-visible>Selecionar filtrados</button>
                        <span>@(Model.Candidates.Count(c => c.Selectable)) produtos selecionáveis</span>
                    </div>
                    <div class="table-responsive wmc-import-table-wrap">
                        <table class="table table-sm align-middle wmc-import-table">
                            <thead><tr><th>Sel.</th><th>C&#243;digo / produto</th><th>Unidade de refer&#234;ncia</th><th>Unidades oficiais WMC</th><th>Status e altera&#231;&#245;es WMC</th></tr></thead>
                            <tbody>
                            @foreach (var item in Model.Candidates)
                            {
                                var searchText = $"{item.WmcCode} {item.Name} {item.Ean}";
                                <tr data-product-search-row="@searchText">
                                    <td><input type="checkbox" name="selectedProductCodes" value="@item.WmcCode" checked="@(Model.SelectedProductCodes?.Contains(item.WmcCode) == true ? "checked" : null)" disabled="@(!item.Selectable)" /></td>
                                    <td><strong>@item.WmcCode</strong><br />@item.Name@if (!string.IsNullOrWhiteSpace(item.Ean)) { <small class="text-muted d-block">EAN @item.Ean</small> }</td>
                                    <td><strong>@(item.Unit ?? "-")</strong><small class="text-muted d-block">UN do produto</small></td>
                                    <td>
                                        <div class="wmc-import-unit-list" aria-label="Unidades oficiais WMC">
                                            @foreach (var unit in item.Units)
                                            {
                                                <div class="wmc-import-unit" data-testid="WmcUnit-@item.WmcCode-@unit.UnitCode">
                                                    <strong>@unit.UnitCode</strong><span>@(string.IsNullOrWhiteSpace(unit.Description) ? "sem descricao" : unit.Description)</span>
                                                    <span>fator @(unit.Factor?.ToString() ?? "-")</span>
                                                    <span>@(string.IsNullOrWhiteSpace(unit.Barcode) ? "sem EAN/DUN" : $"EAN/DUN {unit.Barcode}")</span>
                                                    @if (unit.IsMaster) { <span class="wmc-unit-master">master</span> }
                                                </div>
                                            }
                                        </div>
                                    </td>
                                    <td>@item.Status
                                        @if (item.Changes.Count > 0)
                                        {
                                            <details class="wmc-import-change-details">
                                                <summary>Ver altera&ccedil;&otilde;es</summary>
                                                <ul>
                                                    @foreach (var change in item.Changes)
                                                    {
                                                        <li><strong>@change.Field:</strong> @(string.IsNullOrEmpty(change.CurrentValue) ? "(vazio)" : change.CurrentValue) &rarr; @(string.IsNullOrEmpty(change.WmcValue) ? "(vazio)" : change.WmcValue)</li>
                                                    }
                                                </ul>
                                            </details>
                                        }
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                    <button class="btn admin-primary-action" type="submit">Revisar seleção</button>
                    <a asp-action="Wmc" class="btn btn-outline-secondary">Cancelar</a>
                </form>
            }
            @if (Model.Step == "Confirmation" && Model.Confirmation is not null)
            {
                <h3>Confirmar importação · @Model.SelectedBrandDescription</h3>
                <p>@Model.Confirmation.Selected selecionados: @Model.Confirmation.NewProducts novos, @Model.Confirmation.ExistingProducts existentes, @Model.Confirmation.ChangedProducts com alterações.</p>
                <p>Unidades e campos cadastrais WMC ser&#227;o sincronizados. Pre&#231;os base e promocionais, tabelas de pre&#231;o, imagens e configura&#231;&#245;es comerciais Orofoods permanecem preservados.</p>
                <dialog id="wmcReimportDialog">
                    <form method="post" asp-action="WmcImportProducts">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="brandCode" value="@Model.SelectedBrandCode" />
                        @foreach (var code in Model.SelectedProductCodes ?? []) { <input type="hidden" name="selectedProductCodes" value="@code" /> }
                        @if (Model.Confirmation.ExistingProducts > 0)
                        {
                            <p>Existem @Model.Confirmation.ExistingProducts produtos já cadastrados na Orofoods e @Model.Confirmation.NewProducts produtos novos. Deseja reimportar os produtos existentes?</p>
                            <button class="btn admin-primary-action" type="submit" name="reimportExisting" value="true">Sim, atualizar e criar</button>
                            <button class="btn btn-outline-secondary" type="submit" name="reimportExisting" value="false">Não, somente novos</button>
                        }
                        else
                        {
                            <p>Confirmar criação de @Model.Confirmation.NewProducts novo(s) produto(s)?</p>
                            <button class="btn admin-primary-action" type="submit" name="reimportExisting" value="false">Confirmar criação</button>
                        }
                        <button class="btn btn-link" type="submit" name="reimportExisting" value="cancel">Cancelar</button>
                    </form>
                </dialog>
            }
            @if (Model.Step == "Result" && Model.ImportResult is not null)
            {
                <h3>Resultado: @(Model.ImportResult.Status == "Succeeded" ? "Concluído" : "Não concluído")</h3>
                <p>@Model.ImportResult.Created criados · @Model.ImportResult.Updated atualizados · @Model.ImportResult.Unchanged ignorados/inalterados · @Model.ImportResult.Errors erros</p>
                @if (Model.ImportResult.ErrorMessage is not null) { <div class="alert alert-warning" role="alert">@Model.ImportResult.ErrorMessage</div> }
                <ul class="wmc-import-result-list">
                    @foreach (var item in Model.ImportResult.Items) { <li><strong>@item.WmcCode</strong> · @item.Status @if (item.Detail is not null) { <span>— @item.Detail</span> }</li> }
                </ul>
                <a asp-action="Wmc" class="btn admin-primary-action">Nova importação</a>
            }
        </section>

        <details class="wmc-legacy-preview mt-4">
            <summary>Prévia técnica de leitura</summary>
        <section class="mt-3" aria-labelledby="wmc-preview-title">
            <h2 id="wmc-preview-title">Pr&eacute;via de produtos por marca</h2>
            <p>Consulta somente leitura. Nenhum produto, estoque, categoria ou execu&ccedil;&atilde;o ser&aacute; gravado.</p>
            @if (TempData["WmcPreviewError"] is string previewError)
            {
                <div class="alert alert-warning" role="alert">@previewError</div>
            }
            <form method="post" asp-action="WmcPreview" class="wmc-preview-form">
                @Html.AntiForgeryToken()
                <div class="wmc-brand-toolbar">
                    <label class="form-label" for="wmcBrandSearch">Pesquisar marca</label>
                    <input class="form-control" id="wmcBrandSearch" type="search" placeholder="Código ou descrição" autocomplete="off" />
                    <button class="btn btn-outline-secondary" type="button" id="wmcSelectFiltered">Selecionar todas as marcas filtradas</button>
                    <button class="btn btn-outline-secondary" type="button" id="wmcClearSelection">Limpar seleção</button>
                </div>
                <div class="wmc-brand-grid" id="wmcBrandGrid" role="group" aria-label="Marcas WMC">
                    @foreach (var brand in Model.Brands)
                    {
                        var isSelected = Model.SelectedBrandCodes.Contains((short)brand.Code);
                        <label class="wmc-brand-row" data-brand-search="@brand.Code @brand.Description">
                            <input type="checkbox" name="brandCodes" value="@brand.Code" checked="@(isSelected ? "checked" : null)" />
                            <span class="wmc-brand-code">@brand.Code</span>
                            <span class="wmc-brand-description">@brand.Description</span>
                            <span class="wmc-brand-count">@brand.ActiveProductCount ativos de @brand.ProductCount</span>
                        </label>
                    }
                </div>
                <button type="submit" class="btn admin-primary-action">Simular importa&ccedil;&atilde;o</button>
            </form>

            @if (Model.Preview is not null)
            {
                @if (Model.Preview.ErrorMessage is not null)
                {
                    <div class="alert alert-warning" role="alert">@Model.Preview.ErrorMessage</div>
                }
                <div class="table-responsive mt-4">
                    <table class="table align-middle">
                        <thead><tr><th>M&eacute;trica</th><th>Total</th></tr></thead>
                        <tbody>
                            <tr><td>Produtos lidos</td><td>@Model.Preview.ProductsRead</td></tr>
                            <tr><td>Novos</td><td>@Model.Preview.NewProducts</td></tr>
                            <tr><td>Existentes</td><td>@Model.Preview.ExistingProducts</td></tr>
                            <tr><td>Ativos</td><td>@Model.Preview.ActiveProducts</td></tr>
                            <tr><td>Inativos</td><td>@Model.Preview.InactiveProducts</td></tr>
                            <tr><td>Situa&ccedil;&otilde;es desconhecidas</td><td>@Model.Preview.UnknownSituations</td></tr>
                            <tr><td>Ativos eleg&iacute;veis para importa&ccedil;&atilde;o</td><td>@Model.Preview.ActiveEligibleProducts</td></tr>
                            <tr><td>Inativos ignorados</td><td>@Model.Preview.InactiveIgnoredProducts</td></tr>
                            <tr><td>Situa&ccedil;&otilde;es inv&aacute;lidas/desconhecidas</td><td>@Model.Preview.InvalidSituations</td></tr>
                            <tr><td>Novos ativos</td><td>@Model.Preview.NewActiveProducts</td></tr>
                            <tr><td>Existentes ativos</td><td>@Model.Preview.ExistingActiveProducts</td></tr>
                            <tr><td>C&oacute;digos inv&aacute;lidos</td><td>@Model.Preview.InvalidCodes</td></tr>
                            <tr><td>C&oacute;digos duplicados</td><td>@Model.Preview.DuplicateCodes</td></tr>
                            <tr><td>Problemas de estoque</td><td>@Model.Preview.StockProblems</td></tr>
                            <tr><td>Disponibilidade projetada</td><td>@Model.Preview.ProjectedAvailableProducts</td></tr>
                            <tr><td>Bloqueados projetados</td><td>@Model.Preview.ProjectedBlockedProducts</td></tr>
                        </tbody>
                    </table>
                </div>
                <p class="text-muted">A pr&eacute;via preserva pre&ccedil;os, fotos, categorias comerciais, publica&ccedil;&atilde;o e reservas locais.</p>
                @if (Model.BrandPreviews.Count > 0)
                {
                    <h3 class="mt-4">Resultado por marca</h3>
                    <div class="wmc-brand-results">
                        @foreach (var brandPreview in Model.BrandPreviews)
                        {
                            <article class="wmc-brand-result">
                                <h4>@brandPreview.Code - @brandPreview.Description</h4>
                                <span>@brandPreview.Preview.NewProducts novos</span>
                                <span>@brandPreview.Preview.ExistingProducts existentes</span>
                                <span>@brandPreview.Preview.InactiveIgnoredProducts ignorados</span>
                            </article>
                        }
                    </div>
                }
            }
        </section>
        </details>
    </div>
</section>

<script>
    (() => {
        const productSearch = document.querySelector('[data-product-search]');
        const confirmDialog = document.getElementById('wmcReimportDialog');
        if (confirmDialog && typeof confirmDialog.showModal === 'function') confirmDialog.showModal();
        const productRows = [...document.querySelectorAll('[data-product-search-row]')];
        const updateProducts = () => {
            const term = (productSearch?.value ?? '').trim().toLocaleLowerCase();
            productRows.forEach(row => row.hidden = term.length > 0 && !(row.dataset.productSearchRow ?? '').toLocaleLowerCase().includes(term));
        };
        productSearch?.addEventListener('input', updateProducts);
        document.querySelector('[data-select-visible]')?.addEventListener('click', () => productRows.filter(row => !row.hidden).forEach(row => {
            const box = row.querySelector('input[type="checkbox"]'); if (box && !box.disabled) box.checked = true;
        }));

        const search = document.getElementById('wmcBrandSearch');
        const rows = [...document.querySelectorAll('.wmc-brand-row')];
        const visibleRows = () => rows.filter(row => row.hidden !== true);
        const updateRows = () => {
            const term = (search?.value ?? '').trim().toLocaleLowerCase();
            rows.forEach(row => row.hidden = term.length > 0 && !(row.dataset.brandSearch ?? '').toLocaleLowerCase().includes(term));
        };
        search?.addEventListener('input', updateRows);
        document.getElementById('wmcSelectFiltered')?.addEventListener('click', () => visibleRows().forEach(row => row.querySelector('input').checked = true));
        document.getElementById('wmcClearSelection')?.addEventListener('click', () => rows.forEach(row => row.querySelector('input').checked = false));
    })();
</script>
