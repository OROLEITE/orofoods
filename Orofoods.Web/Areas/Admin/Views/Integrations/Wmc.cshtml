@using Orofoods.Web.Integrations.Erp.Wmc
@using Orofoods.Web.Models.Integrations
@model WmcPreviewPageModel
@{
    ViewData["Title"] = "Importa\u00e7\u00e3o WMC";
    var isRunning = (bool)ViewBag.IsRunning;
    var lastRun = ViewBag.LastRun as WmcSyncRunResult;
    var customerPreview = ViewBag.WmcCustomerPreview as WmcCustomerImportPreview;
    var regularizationPreview = ViewBag.WmcCustomerRegularizationPreview as WmcCustomerRegularizationPreview;
    var brandQueryState = ViewBag.WmcBrandQueryState as string ?? "not-queried";
    var loadBrandsRequested = string.Equals(Context.Request.Query["loadBrands"], "true", StringComparison.OrdinalIgnoreCase);
    var loadDiagnosticsRequested = string.Equals(Context.Request.Query["loadDiagnostics"], "true", StringComparison.OrdinalIgnoreCase)
        || !string.IsNullOrWhiteSpace(Context.Request.Query["diagnosticOrderId"]);
    var hasServerTabState = customerPreview is not null
        || regularizationPreview is not null
        || Model.Preview is not null
        || Model.Step is "Products" or "Confirmation" or "Result"
        || loadBrandsRequested
        || loadDiagnosticsRequested
        || !string.IsNullOrWhiteSpace(Context.Request.Query["diagnosticOrderId"]);
    var initialTab = !string.IsNullOrWhiteSpace(Context.Request.Query["diagnosticOrderId"])
        ? "diagnostics"
        : loadDiagnosticsRequested
            ? "diagnostics"
        : customerPreview is not null || regularizationPreview is not null
            ? "clients"
            : loadBrandsRequested || Model.Preview is not null || Model.Step is "Products" or "Confirmation" or "Result" ? "products" : "overview";
    var connectionLabel = brandQueryState switch
    {
        "available" => "Disponível",
        "unavailable" => "Indisponível",
        _ => "Não consultado"
    };
    var connectionDescription = brandQueryState switch
    {
        "available" => "Última consulta WMC concluída",
        "unavailable" => "A consulta WMC falhou nesta solicitação",
        _ => "Nenhuma consulta WMC nesta solicitação"
    };
}

<section class="section admin-wmc-page">
    <div class="container">
        <header class="wmc-page-header wmc-hero-card">
            <div class="wmc-hero-main">
                <span class="wmc-hero-icon" aria-hidden="true">
                    <svg data-icon="refresh-cw" viewBox="0 0 24 24" focusable="false"><path d="M21 12a9 9 0 0 0-15.3-6.4L3 8m0-5v5h5M3 12a9 9 0 0 0 15.3 6.4L21 16m0 5v-5h-5" /></svg>
                </span>
                <div>
                    <h1>Importa&ccedil;&atilde;o WMC</h1>
                </div>
            </div>
            <div class="wmc-hero-meta wmc-header-actions">
                <span class="wmc-status-badge @(isRunning ? "wmc-status-badge--running" : "wmc-status-badge--idle")">@(isRunning ? "Sincronizando..." : "Ocioso")</span>
                @if (lastRun is not null)
                {
                    <span class="wmc-last-sync">&Uacute;ltima sincroniza&ccedil;&atilde;o: @lastRun.FinishedAt.ToString("u") UTC</span>
                }
                <a class="btn btn-outline-dark wmc-header-back" asp-action="Index">Voltar</a>
            </div>
        </header>

        @if (TempData["WmcSyncMessage"] is string message)
        {
            <div class="alert alert-info mt-4" role="alert">@message</div>
        }
        @if (TempData["WmcCustomerImportMessage"] is string customerMessage)
        {
            <div class="alert alert-success mt-4" role="status">@customerMessage</div>
        }
        @if (TempData["WmcCustomerImportError"] is string customerError)
        {
            <div class="alert alert-warning mt-4" role="alert">@customerError</div>
        }

        <nav class="wmc-tabs" aria-label="Integrações WMC" data-wmc-tabs data-wmc-initial-tab="@initialTab" data-wmc-server-state="@hasServerTabState.ToString().ToLowerInvariant()" role="tablist">
            <button type="button" class="wmc-tab" id="wmc-tab-overview" data-wmc-tab="overview" role="tab" aria-controls="wmc-panel-overview" aria-selected="false">Visão Geral</button>
            <button type="button" class="wmc-tab" id="wmc-tab-clients" data-wmc-tab="clients" role="tab" aria-controls="wmc-panel-clients" aria-selected="false">Clientes</button>
            <button type="button" class="wmc-tab" id="wmc-tab-products" data-wmc-tab="products" role="tab" aria-controls="wmc-panel-products" aria-selected="false">Produtos</button>
            <button type="button" class="wmc-tab" id="wmc-tab-diagnostics" data-wmc-tab="diagnostics" role="tab" aria-controls="wmc-panel-diagnostics" aria-selected="false">Diagnóstico</button>
        </nav>

        <section id="wmc-panel-overview" class="wmc-tab-panel" data-wmc-tab-panel="overview" role="tabpanel" tabindex="0" aria-labelledby="wmc-tab-overview" hidden="@(initialTab == "overview" ? null : "hidden")" aria-hidden="@(initialTab == "overview" ? "false" : "true")">
            <div class="wmc-overview-grid" aria-label="Indicadores WMC">
                <article class="wmc-overview-card wmc-overview-card--connection">
                    <span class="wmc-overview-label">Conexão WMC</span>
                    <strong data-wmc-overview-connection>@connectionLabel</strong>
                    <small>@connectionDescription</small>
                </article>
                <article class="wmc-overview-card">
                    <span class="wmc-overview-label">Sincronização manual</span>
                    <strong data-wmc-overview-operation>@(isRunning ? "Em execução" : lastRun is null ? "Aguardando operação" : lastRun.Status)</strong>
                    <small>@(isRunning ? "Coordenador ocupado nesta instância" : "Sem worker automático habilitado por esta tela")</small>
                </article>
                <article class="wmc-overview-card">
                    <span class="wmc-overview-label">Última sincronização manual</span>
                    <strong>@(lastRun is null ? "Nenhuma" : lastRun.FinishedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))</strong>
                    <small>@(lastRun is null ? "Nenhuma execução registrada nesta instância" : $"Iniciada às {lastRun.StartedAt.ToLocalTime():HH:mm}")</small>
                </article>
                <article class="wmc-overview-card">
                    <span class="wmc-overview-label">Registros processados</span>
                    <strong>@(lastRun is null ? "—" : (lastRun.Customers.RecordsRead + lastRun.Products.RecordsRead + lastRun.Sellers.RecordsRead + lastRun.Stock.RecordsRead).ToString("N0"))</strong>
                    <small>@(lastRun is null ? "Sem ciclo concluído" : "Clientes, produtos, vendedores e estoque")</small>
                </article>
            </div>

            <section class="wmc-overview-card wmc-recent-operations" aria-labelledby="wmc-recent-operations-title">
                <header class="wmc-panel-heading">
                    <div><span class="wmc-step-kicker">Acompanhamento</span><h2 id="wmc-recent-operations-title">Operação recente</h2></div>
                    <span class="wmc-readonly-badge">Dados desta instância</span>
                </header>
                @if (lastRun is null)
                {
                    <p class="wmc-empty-state">Nenhuma sincronização manual foi registrada nesta instância.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table wmc-operation-table align-middle">
                            <thead><tr><th>Entidade</th><th>Lidos</th><th>Criados</th><th>Atualizados</th><th>Ignorados</th><th>Erro</th></tr></thead>
                            <tbody>
                                <tr><td>Clientes</td><td>@lastRun.Customers.RecordsRead</td><td>@lastRun.Customers.RecordsCreated</td><td>@lastRun.Customers.RecordsUpdated</td><td>@lastRun.Customers.RecordsSkipped</td><td>@(lastRun.Customers.ErrorMessage ?? "—")</td></tr>
                                <tr><td>Produtos</td><td>@lastRun.Products.RecordsRead</td><td>@lastRun.Products.RecordsCreated</td><td>@lastRun.Products.RecordsUpdated</td><td>@lastRun.Products.RecordsSkipped</td><td>@(lastRun.Products.ErrorMessage ?? "—")</td></tr>
                                <tr><td>Vendedores</td><td>@lastRun.Sellers.RecordsRead</td><td>@lastRun.Sellers.RecordsCreated</td><td>@lastRun.Sellers.RecordsUpdated</td><td>@lastRun.Sellers.RecordsSkipped</td><td>@(lastRun.Sellers.ErrorMessage ?? "—")</td></tr>
                                <tr><td>Estoque</td><td>@lastRun.Stock.RecordsRead</td><td>@lastRun.Stock.RecordsCreated</td><td>@lastRun.Stock.RecordsUpdated</td><td>@lastRun.Stock.RecordsSkipped</td><td>@(lastRun.Stock.ErrorMessage ?? "—")</td></tr>
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        </section>

        <section id="wmc-panel-clients" class="wmc-tab-panel" data-wmc-tab-panel="clients" role="tabpanel" tabindex="0" aria-labelledby="wmc-tab-clients" hidden="@(initialTab == "clients" ? null : "hidden")" aria-hidden="@(initialTab == "clients" ? "false" : "true")">

        <section class="wmc-content-card" aria-labelledby="wmc-customer-import-title">
            <h2 id="wmc-customer-import-title">Importação manual de clientes</h2>
            <p>Informe o código do vendedor WMC. Somente clientes com situação <code>A</code> e restrição <code>F</code> serão considerados.</p>
            <form method="post" asp-action="WmcCustomerPreview" class="wmc-customer-import-form" data-wmc-submit-once>
                @Html.AntiForgeryToken()
                <div class="wmc-customer-seller-field customer-search">
                    <label class="form-label" for="wmcSellerCode">CODVENDEDOR</label>
                    <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
            <input class="form-control" id="wmcSellerCode" name="sellerCode" required maxlength="30" placeholder="Código do vendedor WMC" autocomplete="off" />
                    <small class="wmc-customer-filter-help">Somente clientes ativos e sem restrição</small>
                </div>
                <button type="submit" class="btn admin-primary-action customer-filter-submit wmc-customer-preview-button">Consultar Clientes WMC</button>
            </form>

            @if (customerPreview is not null)
            {
                @if (customerPreview.ErrorMessage is not null)
                {
                    <div class="alert alert-warning mt-3" role="alert">@customerPreview.ErrorMessage</div>
                }
                @if (customerPreview.BlockingReason is not null)
                {
                    <div class="alert alert-warning mt-3" role="alert"><strong>Importação bloqueada.</strong> @customerPreview.BlockingReason</div>
                }
                else if (customerPreview.Conflicts > 0)
                {
                    <div class="alert alert-warning mt-3" role="alert"><strong>Importação bloqueada.</strong> Existem @customerPreview.Conflicts conflito(s) cadastral(is) para tratamento explícito.</div>
                }
                <div class="wmc-customer-preview-summary" aria-label="Resumo da prévia">
                    <article><span>Consultados</span><strong>@customerPreview.RecordsRead</strong></article>
                    <article class="wmc-customer-preview-summary--normal"><span>Novos</span><strong>@customerPreview.NewCustomers</strong></article>
                    <article class="wmc-customer-preview-summary--normal"><span>Existentes</span><strong>@customerPreview.ExistingCustomers</strong></article>
                    <article class="wmc-customer-preview-summary--warning"><span>Ignorados</span><strong>@customerPreview.Ignored</strong></article>
                    <article class="wmc-customer-preview-summary--critical"><span>Conflitos</span><strong>@customerPreview.Conflicts</strong></article>
                    <article class="wmc-customer-preview-summary--critical"><span>Bloqueados</span><strong>@customerPreview.Blocked</strong></article>
                </div>
                <dl class="row mt-3 wmc-customer-preview-legacy-summary">
                    <dt class="col-sm-3">Vendedor WMC</dt><dd class="col-sm-9">@customerPreview.SellerCode</dd>
                    <dt class="col-sm-3">Clientes consultados</dt><dd class="col-sm-9">@customerPreview.RecordsRead</dd>
                    <dt class="col-sm-3">Novos</dt><dd class="col-sm-9">@customerPreview.NewCustomers</dd>
                    <dt class="col-sm-3">Existentes</dt><dd class="col-sm-9">@customerPreview.ExistingCustomers</dd>
                    <dt class="col-sm-3">Ignorados</dt><dd class="col-sm-9">@customerPreview.Ignored</dd>
                    <dt class="col-sm-3">Conflitos</dt><dd class="col-sm-9">@customerPreview.Conflicts</dd>
                    <dt class="col-sm-3">Bloqueados</dt><dd class="col-sm-9">@customerPreview.Blocked</dd>
                </dl>
                @if (customerPreview.Rows.Count > 0)
                {
            <div class="wmc-customer-preview-controls mt-3">
                <button type="button" class="btn admin-secondary-action wmc-customer-preview-toggle" data-wmc-customer-preview-toggle aria-expanded="false" aria-controls="wmcCustomerPreviewTable">Visualizar Clientes (@customerPreview.Rows.Count)</button>
                <label class="wmc-customer-preview-filter" for="wmcCustomerPreviewFilter">Filtrar lista</label>
                <select class="form-select wmc-customer-preview-filter-select" id="wmcCustomerPreviewFilter" data-wmc-customer-preview-filter>
                    <option value="all">Todos (@customerPreview.Rows.Count)</option>
                    <option value="create">Novos (@customerPreview.NewCustomers)</option>
                    <option value="existing">Existentes (@customerPreview.ExistingCustomers)</option>
                    <option value="ignore">Ignorados (@customerPreview.Ignored)</option>
                    <option value="conflict">Conflitos (@customerPreview.Conflicts)</option>
                    <option value="blocked">Bloqueados (@customerPreview.Blocked)</option>
                </select>
            </div>
            <div class="table-responsive mt-2 wmc-customer-preview-table-wrap" id="wmcCustomerPreviewTable" data-wmc-customer-preview-table hidden>
                        <table class="table align-middle wmc-customer-preview-table">
                            <thead><tr><th>Código WMC</th><th>Razão social</th><th>Fantasia</th><th>CNPJ</th><th>Resultado</th><th>Motivo</th></tr></thead>
                            <tbody>
                            @foreach (var row in customerPreview.Rows)
                            {
                                var dispositionLabel = row.Disposition switch
                                {
                                    WmcCustomerImportDisposition.Create => "Novo",
                                    WmcCustomerImportDisposition.Update => "Atualizar",
                                    WmcCustomerImportDisposition.Existing => "Existente",
                                    WmcCustomerImportDisposition.Ignore => "Ignorado",
                                    WmcCustomerImportDisposition.Conflict => "Conflito",
                                    WmcCustomerImportDisposition.Blocked => "Bloqueado",
                                    _ => row.Disposition.ToString()
                                };
                        <tr data-wmc-customer-preview-row data-disposition="@row.Disposition.ToString().ToLowerInvariant()">
                                    <td>@row.WmcCode</td>
                                    <td>@row.LegalName</td>
                                    <td>@row.TradeName</td>
                                    <td>@row.Cnpj</td>
                                    <td><span class="wmc-customer-preview-status wmc-customer-preview-status--@row.Disposition.ToString().ToLowerInvariant()">@dispositionLabel</span></td>
                                    <td>@(row.Reason ?? "—")</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
                @if (customerPreview.Conflicts == 0 && customerPreview.Blocked == 0 && customerPreview.NewCustomers + customerPreview.ExistingCustomers > 0)
                {
                    <form method="post" asp-action="WmcCustomerImport" class="mt-3" data-wmc-customer-confirmation data-wmc-submit-once>
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="sellerCode" value="@customerPreview.SellerCode" />
                        <input type="hidden" name="confirm" value="true" />
                        <button type="submit" class="btn admin-primary-action">Importar Clientes Selecionados</button>
                    </form>
                }
            }
        </section>

        <section class="wmc-content-card" aria-labelledby="wmc-customer-regularization-title">
            <h2 id="wmc-customer-regularization-title">Regularização manual de clientes pendentes</h2>
            <p>Revise os clientes WMC já importados que ainda estão pendentes antes de liberá-los.</p>
            <form method="post" asp-action="WmcCustomerRegularizationPreview" data-wmc-submit-once>
                @Html.AntiForgeryToken()
            <button type="submit" class="btn admin-primary-action wmc-customer-regularization-preview-button"><i class="fa-solid fa-list-check" aria-hidden="true"></i> Consultar Clientes Pendentes</button>
            </form>
            @if (regularizationPreview is not null)
            {
                <div class="wmc-customer-regularization-summary" aria-label="Resumo da regularização">
                    <article><span>Pendentes</span><strong>@regularizationPreview.PendingCustomers</strong></article>
                    <article class="wmc-customer-regularization-summary--normal"><span>Elegíveis</span><strong>@regularizationPreview.EligibleCustomers</strong></article>
                    <article class="wmc-customer-regularization-summary--warning"><span>Bloqueados</span><strong>@regularizationPreview.BlockedCustomers</strong></article>
                </div>
                @if (regularizationPreview.BlockedCustomers == 0 && regularizationPreview.EligibleCustomers > 0)
                {
                    <form method="post" asp-action="WmcCustomerRegularization" class="mt-3" data-wmc-customer-confirmation data-wmc-submit-once>
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="confirm" value="true" />
                        <button type="submit" class="btn admin-primary-action">Confirmar regularização</button>
                    </form>
                }
                @if (regularizationPreview.Rows.Any(row => !row.Eligible))
                {
                    <details class="wmc-customer-regularization-blocked mt-3">
                        <summary>Exibir motivos dos bloqueios (@regularizationPreview.BlockedCustomers)</summary>
                        <div class="wmc-customer-regularization-blocked-list">
                            <ul>
                    @foreach (var row in regularizationPreview.Rows.Where(row => !row.Eligible))
                    {
                        <li><strong>@row.WmcCode</strong>: @row.Reason</li>
                    }
                            </ul>
                        </div>
                    </details>
                }
            }
        </section>

        </section>

        <section id="wmc-panel-products" class="wmc-tab-panel" data-wmc-tab-panel="products" role="tabpanel" tabindex="0" aria-labelledby="wmc-tab-products" hidden="@(initialTab == "products" ? null : "hidden")" aria-hidden="@(initialTab == "products" ? "false" : "true")">
        <section class="wmc-import-section" aria-labelledby="wmc-import-title">

            <section class="wmc-import-wizard" aria-labelledby="wmc-import-title">
                <header class="wmc-wizard-header">
                    <div>
                        <h2 id="wmc-import-title">Produtos e unidades oficiais</h2>
                        <p>Consulte o espelho WMC, confira os dados e confirme somente depois da simulação.</p>
                    </div>
                    <span class="wmc-readonly-badge">Somente leitura na WMC</span>
                </header>

                <ol class="wmc-stepper" aria-label="Etapas da importação">
                    <li class="@(Model.Step == "Brands" ? "is-active" : "is-complete")"><span>1</span><strong>Selecionar marcas</strong></li>
                    <li class="@(Model.Step == "Products" ? "is-active" : Model.Step is "Confirmation" or "Result" ? "is-complete" : null)"><span>2</span><strong>Conferir produtos</strong></li>
                    <li class="@(Model.Step is "Confirmation" or "Result" ? "is-active" : null)"><span>3</span><strong>Confirmar importação</strong></li>
                </ol>

                @if (Model.LastProductSyncAt is DateTime lastProductSync)
                {
                    <small class="wmc-last-import">Última importação: @lastProductSync.ToLocalTime().ToString("g")</small>
                }

                @if (TempData["WmcPreviewError"] is string previewError)
                {
                    <div class="alert alert-warning" role="alert">@previewError</div>
                }

                @if (Model.Step == "Brands" && Model.Brands.Count == 0)
                {
                    <section class="wmc-brand-load-state" data-wmc-brand-load-state aria-live="polite">
                        <span class="wmc-step-kicker">Consulta sob demanda</span>
                        <h3>Marcas WMC ainda não carregadas</h3>
                        <p>O carregamento da Central não depende do Firebird. Quando precisar importar produtos, carregue a lista de marcas nesta etapa.</p>
                        <a asp-action="Wmc" asp-route-loadBrands="true" class="btn btn-primary" data-wmc-load-brands>
                            @(brandQueryState == "unavailable" ? "Tentar novamente" : "Carregar marcas WMC")
                        </a>
                    </section>
                }
                else if (Model.Step == "Brands")
                {
                    <section class="wmc-multi-brand-preview" aria-labelledby="wmc-multi-brand-preview-title">
                        <header class="wmc-panel-heading">
                            <div><span class="wmc-step-kicker">Consulta em lote</span><h3 id="wmc-multi-brand-preview-title">Prévia de várias marcas</h3></div>
                            <span class="wmc-readonly-badge">Somente leitura</span>
                        </header>
                        <p class="wmc-stage-copy">Selecione uma ou mais marcas para comparar os dados reais do espelho WMC antes de iniciar uma importação individual.</p>
                        <form method="post" asp-action="WmcProducts" class="wmc-multi-brand-form" data-wmc-submit-once data-wmc-requires-selection>
                            @Html.AntiForgeryToken()
                            <div class="wmc-brand-toolbar">
                                <label class="form-label" for="wmcMultiBrandSearch">Pesquisar marcas</label>
                                <input class="form-control" id="wmcMultiBrandSearch" type="search" data-wmc-search="multi-brand" placeholder="Código ou descrição" autocomplete="off" />
                                <span class="wmc-brand-selection-count" id="wmcMultiBrandSelectionCount" aria-live="polite">0 marcas selecionadas</span>
                            </div>
                            <div class="wmc-brand-grid wmc-brand-grid--multi" id="wmcMultiBrandGrid" role="group" aria-label="Selecionar várias marcas WMC">
                                @foreach (var brand in Model.Brands.OrderBy(item => item.Description))
                                {
                                    <label class="wmc-brand-row" data-wmc-brand-row data-brand-search="@brand.Code @brand.Description">
                                        <input type="checkbox" name="brandCodes" value="@brand.Code" data-wmc-brand-checkbox @(Model.SelectedBrandCodes.Contains((short)brand.Code) ? "checked" : null) />
                                        <span class="wmc-brand-code">@brand.Code</span>
                                        <span class="wmc-brand-description">@brand.Description</span>
                                        <span class="wmc-brand-count">@brand.ActiveProductCount ativos de @brand.ProductCount</span>
                                    </label>
                                }
                            </div>
                            <div class="wmc-wizard-actions">
                                <span class="wmc-action-hint">A prévia não grava dados.</span>
                            <button type="submit" class="btn btn-primary" data-wmc-submit-button data-wmc-loading="Processando...">Consultar Produtos WMC</button>
                            </div>
                        </form>
                    </section>
                }

                else if (Model.Step == "Products" && Model.Candidates is not null)
                {
                    var productCounters = Model.ProductCounters ?? WmcProductImportCounters.From(Model.Candidates);
                    var eligibleCandidates = Model.Candidates.Where(item => item.Selectable).ToArray();
                    var newCandidates = eligibleCandidates.Count(item => item.ProductId is null);
                    var existingCandidates = eligibleCandidates.Count(item => item.ProductId is not null);
                    var blockedCandidates = productCounters.Blocked;
                    var selectedProductKeys = (Model.SelectedProductKeys ?? []).ToHashSet(StringComparer.Ordinal);
                    var selectedEligibleCount = eligibleCandidates.Count(item => selectedProductKeys.Contains($"{item.BrandCode}:{item.WmcCode}", StringComparer.Ordinal));
                    <header class="wmc-stage-heading">
                        <div><span class="wmc-step-kicker">Etapa 2</span><h4>Produtos consultados · @Model.SelectedBrandDescription</h4></div>
                        <a asp-action="Wmc" class="btn btn-outline-secondary btn-sm">Trocar marcas</a>
                    </header>
                    <div class="wmc-import-summary" aria-label="Resumo não sobreposto dos produtos consultados">
                        <article><span>Produtos consultados (total)</span><strong>@productCounters.Total</strong></article>
                        <article><span>Ativos</span><strong>@productCounters.Active</strong></article>
                        <article><span>Inativos</span><strong>@productCounters.Inactive</strong></article>
                        <article><span>Elegíveis</span><strong>@productCounters.Eligible</strong></article>
                        <article class="wmc-summary-new"><span>Elegíveis novos</span><strong>@newCandidates</strong></article>
                        <article class="wmc-summary-existing"><span>Elegíveis existentes</span><strong>@existingCandidates</strong></article>
                        <article class="wmc-summary-blocked"><span>Bloqueados</span><strong>@blockedCandidates</strong></article>
                    </div>
                    <p class="wmc-stage-copy">Ativos e inativos são contados pela situação WMC; somente ativos sem bloqueios compõem os elegíveis.</p>
                    @if (newCandidates == 0 && existingCandidates == 0)
                    {
                        <div class="alert alert-warning" role="alert">Nenhum produto está elegível para importação. A ação permanece indisponível até que os bloqueios sejam tratados.</div>
                    }
                    else if (newCandidates == 0)
                    {
                        <div class="alert alert-info" role="status">Não há produtos novos nesta consulta. A atualização de produtos existentes continua disponível somente mediante seleção e confirmação explícita.</div>
                    }
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                    <form method="post" asp-action="WmcConfirmSelection" id="wmcImportSelectionForm" data-wmc-submit-once>
                        @Html.AntiForgeryToken()
                        @foreach (var selectedBrand in Model.SelectedBrandCodes)
                        {
                            <input type="hidden" name="brandCodes" value="@selectedBrand" />
                        }
                        <div class="small text-muted mb-2" aria-label="Origem dos dados">
                            <span class="me-3">Dados WMC · Firebird, somente leitura</span>
                            <span>Cadastro Orofoods · local, somente leitura</span>
                        </div>
                        <div class="wmc-product-selection-toolbar" id="wmcProductSelectionToolbar">
                            <div class="wmc-product-search-field">
                                <label for="wmcProductSearch">Pesquisar produtos</label>
                                <input class="form-control" id="wmcProductSearch" type="search" placeholder="Código ou descrição" autocomplete="off" />
                            </div>
                            <div class="wmc-product-status-field">
                                <label for="wmcProductStatusFilter">Filtrar situação</label>
                                <select class="form-select" id="wmcProductStatusFilter" name="situationFilter">
                                    @if (Model.ProductSituationFilter == WmcProductSituationFilter.Active)
                                    {
                                        <option value="active" selected="selected">Ativos</option>
                                    }
                                    else
                                    {
                                        <option value="active">Ativos</option>
                                    }
                                    @if (Model.ProductSituationFilter == WmcProductSituationFilter.Inactive)
                                    {
                                        <option value="inactive" selected="selected">Inativos</option>
                                    }
                                    else
                                    {
                                        <option value="inactive">Inativos</option>
                                    }
                                    @if (Model.ProductSituationFilter == WmcProductSituationFilter.All)
                                    {
                                        <option value="all" selected="selected">Todos</option>
                                    }
                                    else
                                    {
                                        <option value="all">Todos</option>
                                    }
                                </select>
                            </div>
                            <div class="wmc-product-selection-actions" role="group" aria-label="Seleção de produtos">
                                <button type="button" class="btn btn-outline-secondary btn-sm" id="wmcSelectAll">Selecionar todos</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" id="wmcDeselectAll">Desmarcar todos</button>
                            </div>
                            <span class="wmc-product-selection-count" id="wmcProductSelectionCount" aria-live="polite">0 de 0 produtos selecionados</span>
                        </div>
                        <div class="wmc-product-table-scroll" id="wmcProductPreviewTable" data-wmc-product-preview-table>
                            <table class="wmc-import-table">
                                <caption class="visually-hidden">Produtos da marca selecionada</caption>
                                <thead><tr><th class="wmc-column--selection" data-wmc-column="selection">Sel.</th><th class="wmc-column--wmc-code" data-wmc-column="wmc-code">Código WMC</th><th class="wmc-column--product" data-wmc-column="product">Produto</th><th class="wmc-column--unit" data-wmc-column="unit">Unidade / master</th><th class="wmc-column--situation" data-wmc-column="situation">Situação</th><th class="wmc-column--status" data-wmc-column="status">Status</th><th class="wmc-column--wmc-price" data-wmc-column="wmc-price">Preço WMC</th><th class="wmc-column--orofoods-price" data-wmc-column="orofoods-price">Preço Orofoods</th><th class="wmc-column--details" data-wmc-column="details">Detalhes</th></tr></thead>
                                <tbody id="wmcProductRows">
                                @{ var renderedBrand = ""; }
                                @foreach (var item in Model.Candidates.OrderBy(item => item.BrandName).ThenBy(item => item.WmcCode))
                                {
                                    var currentBrand = $"{item.BrandCode} · {item.BrandName}";
                                    if (!string.Equals(renderedBrand, currentBrand, StringComparison.Ordinal))
                                    {
                                        <tr class="wmc-product-brand-group"><th colspan="9">@currentBrand</th></tr>
                                        renderedBrand = currentBrand;
                                    }
                                    var masterUnit = item.UnitProposal?.MasterUnitCode is { } masterCode
                                        ? item.Units.FirstOrDefault(unit => string.Equals(unit.UnitCode, masterCode, StringComparison.OrdinalIgnoreCase))
                                        : item.Units.FirstOrDefault(unit => unit.IsMaster);
                                    var primaryUnit = item.UnitProposal?.PrimaryUnitCode is { } primaryCode
                                        ? item.Units.FirstOrDefault(unit => string.Equals(unit.UnitCode, primaryCode, StringComparison.OrdinalIgnoreCase))
                                        : item.Units.FirstOrDefault(unit => !unit.IsMaster) ?? item.Units.FirstOrDefault();
                                    var statusKind = item.Selectable ? (item.ProductId is null ? "new" : "existing") : "blocked";
                                    var statusLabel = item.SituationKind == WmcProductSituationFilter.Inactive
                                        ? "Inativo (consulta)"
                                        : statusKind switch { "new" => "Novo", "existing" => "Existente", _ => "Bloqueado" };
                                    var productKey = $"{item.BrandCode}:{item.WmcCode}";
                                    var isSelected = item.Selectable && selectedProductKeys.Contains(productKey);
                                    var isVisibleBySituation = Model.ProductSituationFilter == WmcProductSituationFilter.All
                                        || item.SituationKind == Model.ProductSituationFilter;
                                    <tr class="wmc-import-row wmc-import-row--@statusKind" data-wmc-product-row data-status-kind="@statusKind" data-situation-kind="@item.SituationKind" data-product-search="@item.WmcCode @item.Name" hidden="@(isVisibleBySituation ? null : "hidden")">
                                        <td class="wmc-column--selection"><input type="checkbox" name="selectedProductKeys" value="@productKey" data-wmc-product-checkbox @(isSelected ? "checked" : null) @(item.Selectable ? null : "disabled") aria-label="Selecionar @item.WmcCode" /></td>
                                        <td class="wmc-column--wmc-code wmc-code-cell"><strong>@item.WmcCode</strong></td>
                                        <td class="wmc-column--product wmc-description-cell" title="@item.Name">@item.Name</td>
                                        <td class="wmc-column--unit wmc-unit-cell">@(primaryUnit is null ? "—" : masterUnit is null ? primaryUnit.UnitCode : $"{primaryUnit.UnitCode} / {masterUnit.UnitCode} {masterUnit.Factor?.ToString() ?? "—"}")</td>
                                        <td class="wmc-column--situation">@(item.Situation ?? "—")</td>
                                        <td class="wmc-column--status"><span class="wmc-product-status wmc-product-status--@statusKind">@statusLabel</span></td>
                                        <td class="wmc-column--wmc-price wmc-price-cell">
                                            @if (item.PrecoVenda is decimal precoVenda)
                                            {
                                                <strong class="wmc-price-value">@precoVenda.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))</strong>
                                            }
                                            else
                                            {
                                                <span>—</span>
                                            }
                                        </td>
                                        <td class="wmc-column--orofoods-price wmc-price-cell">
                                            @if (item.LocalBasePrice is decimal localBasePrice)
                                            {
                                                <strong class="wmc-price-value">@localBasePrice.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))</strong>
                                                <small class="wmc-price-label">Atual · @(item.LocalCommercialUnit ?? "unidade não definida")</small>
                                            }
                                            else
                                            {
                                                <span class="wmc-price-label">Não cadastrado</span>
                                            }
                                            @if (item.PriceProposal?.ProposedPrice is decimal proposedPrice && item.PriceProposal.SafeToApply)
                                            {
                                                <small class="wmc-price-proposed">Após confirmação: @proposedPrice.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))</small>
                                            }
                                        </td>
                                        <td class="wmc-column--details wmc-details-cell">
                                            <details class="wmc-row-details">
                                                <summary>Detalhes</summary>
                                                <div class="wmc-row-details-content">
                                                    <dl class="wmc-product-detail-grid">
                                                        <dt>Marca</dt>
                                                        <dd>@(item.BrandName ?? "—")</dd>
                                                        <dt>Status</dt>
                                                        <dd>@item.Status</dd>
                                                        <dt>Motivo do bloqueio</dt>
                                                        <dd class="wmc-detail-block-reason">@(item.BlockReason ?? (item.Selectable ? "—" : item.Status))</dd>
                                                        <dt>EAN</dt>
                                                        <dd>@(item.Ean ?? "—")</dd>
                                                        <dt>DUN</dt>
                                                        <dd>@(masterUnit?.Barcode ?? "—")</dd>
                                                        <dt>Estoque consultado</dt>
                                                        <dd>@(item.Stock?.ToString("0.###") ?? "—")</dd>
                                                        <dt>Preço WMC</dt>
                                                        <dd>
                                                            @(item.PrecoVenda?.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("pt-BR")) ?? "—")
                                                            <small class="wmc-detail-source">Origem técnica: PRODUTOS.PRECOVENDA</small>
                                                        </dd>
                                                        <dt>Preço Orofoods atual</dt>
                                                        <dd>
                                                            @(item.LocalBasePrice?.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("pt-BR")) ?? "—")
                                                            <small class="wmc-detail-source">Cadastro local · unidade @(item.LocalCommercialUnit ?? "não definida")</small>
                                                            @if (item.LocalBasePrice == 1.00m && string.Equals(item.LocalCommercialUnit, "PCT", StringComparison.OrdinalIgnoreCase))
                                                            {
                                                                <small class="text-warning wmc-detail-source">R$ 1,00/PCT é placeholder local de homologação.</small>
                                                            }
                                                        </dd>
                                                        @if (item.PriceProposal?.CurrentTargetPrice is decimal currentTargetPrice)
                                                        {
                                                            <dt>Preço da tabela atual</dt>
                                                            <dd>@item.PriceProposal.TargetPriceTableName: @currentTargetPrice.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))</dd>
                                                        }
                                                        @if (item.PriceProposal?.ProposedPrice is decimal detailProposedPrice)
                                                        {
                                                            <dt>Preço proposto</dt>
                                                            <dd>
                                                                @detailProposedPrice.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))
                                                                @if (!item.PriceProposal.SafeToApply)
                                                                {
                                                                    <small class="text-warning wmc-detail-source">Bloqueado: @item.PriceProposal.BlockReason</small>
                                                                }
                                                                else
                                                                {
                                                                    <small class="text-success wmc-detail-source">Será gravado no preço base</small>
                                                                }
                                                            </dd>
                                                        }
                                                    </dl>
                                                    @if (item.UnitProposal is { } proposal)
                                                    {
                                                        <dl class="wmc-unit-proposal">
                                                            <dt>Unidade principal</dt>
                                                            <dd>@(proposal.PrimaryUnitCode ?? "—")</dd>
                                                            <dt>Unidade master</dt>
                                                            <dd>@(proposal.MasterUnitCode ?? "—")</dd>
                                                            <dt>EAN atual</dt>
                                                            <dd>@(proposal.CurrentEan13 ?? "—") &rarr; @(proposal.ProposedEan13 ?? "—")</dd>
                                                            <dt>DUN atual</dt>
                                                            <dd>@(proposal.CurrentDun14 ?? "—")</dd>
                                                            <dt>DUN proposto</dt>
                                                            <dd>@(proposal.ProposedDun14 ?? "—")</dd>
                                                            <dt>Fator unidade principal atual</dt>
                                                            <dd>@(proposal.CurrentPrimaryFactor?.ToString() ?? "—")</dd>
                                                            <dt>Fator unidade principal proposto</dt>
                                                            <dd>@(proposal.ProposedPrimaryFactor?.ToString() ?? "—")</dd>
                                                            <dt>Fator unidade master atual</dt>
                                                            <dd>@(proposal.CurrentMasterFactor?.ToString() ?? "—")</dd>
                                                            <dt>Fator unidade master proposto</dt>
                                                            <dd>@(proposal.ProposedMasterFactor?.ToString() ?? "—")</dd>
                                                            <dt>QTDE_EMB atual</dt>
                                                            <dd>@(proposal.CurrentPackageQuantity?.ToString() ?? "—")</dd>
                                                            <dt>QTDE_EMB proposto</dt>
                                                            <dd>@(proposal.ProposedPackageQuantity?.ToString() ?? "—")</dd>
                                                            <dt>QTDE_CONV atual</dt>
                                                            <dd>@(proposal.CurrentConversionQuantity?.ToString() ?? "—")</dd>
                                                            <dt>QTDE_CONV proposto</dt>
                                                            <dd>@(proposal.ProposedConversionQuantity?.ToString() ?? "—")</dd>
                                                        </dl>
                                                        @if (!proposal.SafeToApply)
                                                        {
                                                            <small class="text-warning">Bloqueado: @proposal.BlockReason</small>
                                                        }
                                                    }
                                                    @if (item.Units.Count > 0)
                                                    {
                                                        <ul class="wmc-unit-list">
                                                            @foreach (var unit in item.Units)
                                                            {
                                                                var unitCode = unit.UnitCode.Trim().ToUpperInvariant();
                                                                var barcodeLabel = unit.IsMaster
                                                                    ? "Código da master"
                                                                    : string.Equals(unitCode, item.UnitProposal?.PrimaryUnitCode, StringComparison.OrdinalIgnoreCase)
                                                                        ? "EAN unidade principal"
                                                                        : "CODBARRAS";
                                                                <li><strong>@unitCode</strong> · FATOR @(unit.Factor?.ToString() ?? "—") · @barcodeLabel: @(unit.Barcode ?? "—") · UNMASTER=@(unit.IsMaster ? "true" : "false")</li>
                                                            }
                                                        </ul>
                                                    }
                                                    @if (item.Changes.Count > 0)
                                                    {
                                                        <ul class="wmc-change-list">
                                                            @foreach (var change in item.Changes)
                                                            {
                                                                <li><strong>@change.Field:</strong> @change.CurrentValue &rarr; @change.WmcValue</li>
                                                            }
                                                        </ul>
                                                    }
                                                </div>
                                            </details>
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                        <div class="wmc-product-pagination" id="wmcProductPagination" aria-label="Paginação de produtos">
                            <span id="wmcProductPageStatus" aria-live="polite"></span>
                            <div class="wmc-product-pagination-actions">
                                <button type="button" class="btn btn-outline-secondary btn-sm" id="wmcProductPreviousPage">Anterior</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" id="wmcProductNextPage">Próxima</button>
                            </div>
                        </div>
                        <div class="wmc-wizard-actions">
                            <a asp-action="Wmc" class="btn btn-outline-secondary">Voltar</a>
                            <span class="wmc-action-hint">Selecione apenas produtos liberados para continuar.</span>
                            <button type="submit" class="btn btn-primary" id="wmcReviewSelection" @(eligibleCandidates.Length == 0 || selectedEligibleCount == 0 ? "disabled" : null)>Revisar Produtos Selecionados</button>
                        </div>
                    </form>
                }
                else if (Model.Step == "Confirmation" && Model.Confirmation is not null)
                {
                    var blockedCount = Model.Confirmation.Blocked;
                    var confirmationPresentations = Model.ConfirmationPresentations ?? [];
                    <header class="wmc-stage-heading"><div><span class="wmc-step-kicker">Etapa 3</span><h4>Confirmar importação · @Model.SelectedBrandDescription</h4></div></header>
                    <p class="wmc-stage-copy">Revise o resumo antes de gravar os produtos selecionados no catálogo local.</p>
                    <div class="wmc-import-summary" aria-label="Resumo da seleção">
                        <article class="admin-dashboard-indicator admin-dashboard-indicator--normal"><span>Consultados</span><strong>@Model.Confirmation.Consulted</strong></article>
                        <article class="admin-dashboard-indicator admin-dashboard-indicator--normal"><span>Selecionados</span><strong>@Model.Confirmation.Selected</strong></article>
                        <article class="wmc-summary-new admin-dashboard-indicator admin-dashboard-indicator--normal"><span>Novos</span><strong>@Model.Confirmation.NewProducts</strong></article>
                        <article class="wmc-summary-existing admin-dashboard-indicator admin-dashboard-indicator--normal"><span>Existentes com alterações</span><strong>@Model.Confirmation.ExistingWithChanges</strong></article>
                        <article class="admin-dashboard-indicator admin-dashboard-indicator--normal"><span>Existentes sem alterações</span><strong>@Model.Confirmation.ExistingWithoutChanges</strong></article>
                        <article class="wmc-summary-blocked admin-dashboard-indicator admin-dashboard-indicator--warning"><span>Bloqueados</span><strong>@blockedCount</strong></article>
                    </div>
                    <details class="wmc-confirmation-details" open>
                        <summary>Ver dados WMC, diferenças e propostas de importação</summary>
                        <p class="wmc-confirmation-persistence-note">Produtos novos elegíveis serão importados após a confirmação; dados de produtos existentes só serão aplicados se a autorização abaixo estiver marcada.</p>
                        <ul>
                            @foreach (var item in (Model.Candidates ?? []).Where(item => (Model.SelectedProductKeys ?? []).Contains($"{item.BrandCode}:{item.WmcCode}", StringComparer.Ordinal)))
                            {
                                var unitProposal = item.UnitProposal;
                                var presentation = confirmationPresentations.FirstOrDefault(candidate =>
                                    string.Equals(candidate.Candidate.BrandCode, item.BrandCode, StringComparison.Ordinal)
                                    && string.Equals(candidate.Candidate.WmcCode, item.WmcCode, StringComparison.Ordinal));
                                <li class="wmc-confirmation-product">
                                    <div class="wmc-confirmation-product-heading"><strong>@item.WmcCode</strong> · @item.Name · @(item.BrandName ?? item.BrandCode ?? "Marca não informada") · @item.Status</div>
                                    @if (item.PriceProposal is { } pricePreview)
                                    {
                                        <dl class="wmc-confirmation-data-grid">
                                            <dt>Preço Orofoods atual</dt>
                                            <dd>@(pricePreview.CurrentBasePrice?.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("pt-BR")) ?? "—")</dd>
                                            <dt>Preço WMC proposto</dt>
                                            <dd>@(pricePreview.ProposedPrice?.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("pt-BR")) ?? "—")</dd>
                                            <dt>Unidade do preço WMC</dt>
                                            <dd>@(pricePreview.SourceUnitCode ?? "—")</dd>
                                        </dl>
                                    }
                                    @if (unitProposal is { } proposal)
                                    {
                                        <dl class="wmc-confirmation-data-grid">
                                            <dt>Unidade principal</dt>
                                            <dd>@(proposal.PrimaryUnitCode ?? "—")</dd>
                                            <dt>Unidade master</dt>
                                            <dd>@(proposal.MasterUnitCode ?? "—")</dd>
                                            <dt>EAN oficial (atual → WMC)</dt>
                                            <dd>@(proposal.CurrentEan13 ?? proposal.CurrentEan ?? "—") → @(proposal.ProposedEan13 ?? proposal.ProposedEan ?? "—")</dd>
                                            <dt>DUN oficial (atual → WMC)</dt>
                                            <dd>@(proposal.CurrentDun14 ?? "—") → @(proposal.ProposedDun14 ?? "—")</dd>
                                            <dt>Fator oficial principal (atual → WMC)</dt>
                                            <dd>@(proposal.CurrentPrimaryFactor?.ToString() ?? "—") → @(proposal.ProposedPrimaryFactor?.ToString() ?? "—")</dd>
                                            <dt>Fator oficial master (atual → WMC)</dt>
                                            <dd>@(proposal.CurrentMasterFactor?.ToString() ?? "—") → @(proposal.ProposedMasterFactor?.ToString() ?? "—")</dd>
                                            <dt>QTDE_EMB (atual → WMC)</dt>
                                            <dd>@(proposal.CurrentPackageQuantity?.ToString() ?? "—") → @(proposal.ProposedPackageQuantity?.ToString() ?? "—")</dd>
                                            <dt>QTDE_CONV (atual → WMC)</dt>
                                            <dd>@(proposal.CurrentConversionQuantity?.ToString() ?? "—") → @(proposal.ProposedConversionQuantity?.ToString() ?? "—")</dd>
                                        </dl>
                                        @if (!proposal.SafeToApply)
                                        {
                                            <small class="text-warning d-block">Unidades bloqueadas: @proposal.BlockReason</small>
                                        }
                                    }
                                    @if (item.Units.Count > 0)
                                    {
                                        <div class="wmc-confirmation-unit-heading">Unidades alternativas e master oficiais</div>
                                        <ul class="wmc-confirmation-unit-list">
                                            @foreach (var unit in item.Units)
                                            {
                                                <li><strong>@unit.UnitCode</strong> · @(string.IsNullOrWhiteSpace(unit.Description) ? "—" : unit.Description) · FATOR @(unit.Factor?.ToString() ?? "—") · @if (unit.IsMaster) { <span>master</span> } else { <span>alternativa</span> } · CÓDIGO @(unit.Barcode ?? "—")</li>
                                            }
                                        </ul>
                                    }
                                    @if (item.ProductId is not null)
                                    {
                                        <div class="wmc-confirmation-differences">
                                            <strong>Diferenças detectadas pelo serviço</strong>
                                            @if (item.Changes.Count > 0)
                                            {
                                                <ul class="wmc-change-list">@foreach (var change in item.Changes) { <li><strong>@change.Field:</strong> @change.CurrentValue &rarr; @change.WmcValue</li> }</ul>
                                            }
                                            else
                                            {
                                                <small>Nenhuma diferença detectada entre o cadastro Orofoods e o snapshot WMC.</small>
                                            }
                                        </div>
                                    }
                                    @if (item.PriceProposal is { SafeToApply: false } priceProposal) { <small class="text-warning d-block">Preço bloqueado: @priceProposal.BlockReason</small> }
                                    @if (presentation is not null)
                                    {
                                        var wmcStock = presentation.WmcStock;
                                        var localState = presentation.LocalState;
                                        <section class="wmc-confirmation-diagnostic-sections" aria-label="Diagnóstico somente leitura de @item.WmcCode">
                                            <article class="wmc-confirmation-diagnostic-section wmc-confirmation-diagnostic-section--wmc">
                                                <h5>Dados oficiais WMC</h5>
                                                <dl class="wmc-confirmation-diagnostic-grid">
                                                    <dt>Situação WMC</dt>
                                                    <dd>@(item.Situation ?? "—")</dd>
                                                    <dt>Unidade principal</dt>
                                                    <dd>@(item.Unit ?? unitProposal?.PrimaryUnitCode ?? "—")</dd>
                                                    <dt>Unidade master</dt>
                                                    <dd>@(unitProposal?.MasterUnitCode ?? "—")</dd>
                                                    <dt>Preço oficial (PRECOVENDA)</dt>
                                                    <dd>@(item.PrecoVenda?.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("pt-BR")) ?? "—")</dd>
                                                    <dt>EAN</dt>
                                                    <dd>@(unitProposal?.ProposedEan13 ?? unitProposal?.ProposedEan ?? item.Ean ?? "—")</dd>
                                                    <dt>DUN</dt>
                                                    <dd>@(unitProposal?.ProposedDun14 ?? "—")</dd>
                                                    <dt>Fator principal</dt>
                                                    <dd>@(unitProposal?.ProposedPrimaryFactor?.ToString() ?? "—")</dd>
                                                    <dt>Fator master</dt>
                                                    <dd>@(unitProposal?.ProposedMasterFactor?.ToString() ?? "—")</dd>
                                                    <dt>QTDE_EMB</dt>
                                                    <dd>@(unitProposal?.ProposedPackageQuantity?.ToString() ?? "—")</dd>
                                                    <dt>QTDE_CONV</dt>
                                                    <dd>@(unitProposal?.ProposedConversionQuantity?.ToString() ?? "—")</dd>
                                                </dl>
                                                <div class="wmc-confirmation-diagnostic-subheading">Unidades alternativas oficiais</div>
                                                @if (item.Units.Count > 0)
                                                {
                                                    <ul class="wmc-confirmation-diagnostic-list">
                                                        @foreach (var unit in item.Units)
                                                        {
                                                            <li><strong>@unit.UnitCode</strong> · fator @(unit.Factor?.ToString() ?? "—") · @(unit.IsMaster ? "master" : "alternativa") · EAN/DUN @(unit.Barcode ?? "—")</li>
                                                        }
                                                    </ul>
                                                }
                                                else
                                                {
                                                    <p class="wmc-confirmation-diagnostic-muted">Não informado pelo WMC.</p>
                                                }
                                                <div class="wmc-confirmation-stock-block">
                                                    <strong>Estoque WMC</strong>
                                                    @if (wmcStock is null)
                                                    {
                                                        <p class="wmc-confirmation-diagnostic-muted">Indisponível: consulta WMC não retornou este produto (@presentation.WmcReadStatus).</p>
                                                    }
                                                    else
                                                    {
                                                        <dl class="wmc-confirmation-diagnostic-grid">
                                                            <dt>Disponível</dt>
                                                            <dd>@(wmcStock.EstoqueDisponivel?.ToString() ?? "indisponível")</dd>
                                                            <dt>Atual</dt>
                                                            <dd>@(wmcStock.EstoqueAtual?.ToString() ?? "indisponível")</dd>
                                                            <dt>Reservado</dt>
                                                            <dd>@(wmcStock.EstoqueReservado?.ToString() ?? "indisponível")</dd>
                                                            <dt>Semântica da unidade</dt>
                                                            <dd>@(wmcStock.UnitSemantics ?? "não confirmada")</dd>
                                                        </dl>
                                                        <small class="wmc-confirmation-diagnostic-source">Fonte: Consulta WMC somente leitura · @wmcStock.ConsultedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss zzz")</small>
                                                    }
                                                </div>
                                            </article>
                                            <article class="wmc-confirmation-diagnostic-section wmc-confirmation-diagnostic-section--local">
                                                <h5>Cadastro Orofoods</h5>
                                                @if (localState is null)
                                                {
                                                    <p class="wmc-confirmation-diagnostic-muted">Ainda não cadastrado no catálogo Orofoods.</p>
                                                    <p class="wmc-confirmation-diagnostic-source">Leitura local: @presentation.LocalReadStatus.</p>
                                                }
                                                else
                                                {
                                                    <dl class="wmc-confirmation-diagnostic-grid">
                                                        <dt>Produto</dt>
                                                        <dd>#@localState.ProductId · @(localState.Name ?? localState.Sku ?? "—")</dd>
                                                        <dt>Unidade local</dt>
                                                        <dd>@(localState.Unit ?? "—")</dd>
                                                        <dt>Unidade comercial</dt>
                                                        <dd>@(localState.CommercialUnitCode ?? "—")</dd>
                                                        <dt>Unidade logística</dt>
                                                        <dd>@(localState.LogisticsUnitCode ?? "—")</dd>
                                                        <dt>EAN / EAN13</dt>
                                                        <dd>@(localState.Ean13 ?? localState.Ean ?? "—")</dd>
                                                        <dt>DUN14</dt>
                                                        <dd>@(localState.Dun14 ?? "—")</dd>
                                                        <dt>Unidade WMC alternativa</dt>
                                                        <dd>@(localState.WmcAlternateUnit ?? "—")</dd>
                                                        <dt>QTDE_EMB / QTDE_CONV</dt>
                                                        <dd>@(localState.WmcPackageQuantity?.ToString() ?? "—") / @(localState.WmcConversionQuantity?.ToString() ?? "—")</dd>
                                                    </dl>
                                                    <small class="wmc-confirmation-diagnostic-source">Leitura local: @presentation.LocalReadStatus · sem alterações persistidas por esta consulta.</small>
                                                }
                                            </article>
                                            <article class="wmc-confirmation-diagnostic-section wmc-confirmation-diagnostic-section--commercial">
                                                <h5>Disponibilidade comercial</h5>
                                                @if (localState is null)
                                                {
                                                    <p class="wmc-confirmation-diagnostic-muted">Estado atual: novo produto, ainda não cadastrado.</p>
                                                    <p>@(presentation.NewProductExpectedState ?? "Após a importação manual, o estado cadastral será reavaliado pelo fluxo autorizado.")</p>
                                                }
                                                else
                                                {
                                                    <dl class="wmc-confirmation-diagnostic-grid">
                                                        <dt data-field="IsWmcActive">Situação WMC (IsWmcActive)</dt>
                                                        <dd>@(localState.IsWmcActive ? "Ativo" : "Inativo")</dd>
                                                        <dt data-field="IsActive">Situação Orofoods (IsActive)</dt>
                                                        <dd>@(localState.IsActive ? "Ativo" : "Inativo")</dd>
                                                        <dt data-field="IsAvailable">Disponibilidade para venda (IsAvailable)</dt>
                                                        <dd>@(localState.IsAvailable ? "Disponível" : "Indisponível")</dd>
                                                        <dt data-field="WmcInitialLoadReady">Carga inicial pronta (WmcInitialLoadReady)</dt>
                                                        <dd>@(localState.WmcInitialLoadReady ? "Pronta" : "Pendente")</dd>
                                                        <dt>Estoque local</dt>
                                                        <dd>
                                                            @if (localState.QuantityOnHand is null)
                                                            {
                                                                <span>Indisponível (@localState.InventoryReadStatus)</span>
                                                            }
                                                            else
                                                            {
                                                                <span>Físico @localState.QuantityOnHand · reservado @(localState.QuantityReserved?.ToString() ?? "indisponível") · disponível @(localState.AvailableQuantity?.ToString() ?? "indisponível")</span>
                                                            }
                                                        </dd>
                                                    </dl>
                                                }
                                                <div class="wmc-confirmation-diagnostic-subheading">Motivos conhecidos</div>
                                                @if (presentation.KnownBlockers.Count > 0)
                                                {
                                                    <ul class="wmc-confirmation-diagnostic-list wmc-confirmation-diagnostic-list--warning">
                                                        @foreach (var blocker in presentation.KnownBlockers)
                                                        {
                                                            <li>@blocker</li>
                                                        }
                                                    </ul>
                                                }
                                                else
                                                {
                                                    <p class="wmc-confirmation-diagnostic-muted">Nenhum bloqueio conhecido nesta consulta.</p>
                                                }
                                            </article>
                                        </section>
                                    }
                                </li>
                            }
                        </ul>
                    </details>
                    <form method="post" asp-action="WmcImportProducts" id="wmcImportConfirmationForm" class="wmc-wizard-actions wmc-confirmation-actions" data-wmc-submit-once>
                        @Html.AntiForgeryToken()
                        @foreach (var selectedBrand in Model.SelectedBrandCodes) { <input type="hidden" name="brandCodes" value="@selectedBrand" /> }
                        @foreach (var key in Model.SelectedProductKeys ?? []) { <input type="hidden" name="selectedProductKeys" value="@key" /> }
                        <input type="hidden" name="situationFilter" value="@Model.ProductSituationFilter" />
                        <input type="hidden" name="simulationValidated" value="true" />
                        <a asp-action="Wmc" class="btn btn-outline-secondary">Cancelar</a>
                        <div class="wmc-reimport-choice" data-wmc-reimport-state="disabled" aria-live="polite">
                            Atualização de existentes desativada: produtos já cadastrados serão mantidos sem alteração.
                        </div>
                        <label class="wmc-reimport-choice">
                            <input type="checkbox" name="reimportExisting" value="true" data-wmc-reimport-toggle />
                            <span>
                                <strong>Atualizar produtos já cadastrados conforme WMC</strong>
                                <small>Se marcado, preços e dados cadastrais autorizados poderão ser alterados.</small>
                            </span>
                        </label>
                        <div class="wmc-reimport-choice" data-wmc-reimport-authorization aria-live="polite">
                            Autorização para existentes desativada antes do envio.
                        </div>
                        <button class="btn btn-primary" type="submit" data-wmc-confirm-submit>Importar Produtos Selecionados</button>
                    </form>
                }
                else if (Model.Step == "Result" && Model.ImportResult is not null)
                {
                    <header class="wmc-stage-heading"><div><span class="wmc-step-kicker">Resultado</span><h4>Importação @(Model.ImportResult.Status == "Succeeded" ? "concluída" : "não concluída")</h4></div></header>
                    <div class="wmc-import-summary">
                        <article class="wmc-summary-new admin-dashboard-indicator admin-dashboard-indicator--normal"><span>Criados</span><strong>@Model.ImportResult.Created</strong></article>
                        <article class="wmc-summary-existing admin-dashboard-indicator admin-dashboard-indicator--normal"><span>Atualizados</span><strong>@Model.ImportResult.Updated</strong></article>
                        <article class="admin-dashboard-indicator admin-dashboard-indicator--normal"><span>Inalterados</span><strong>@Model.ImportResult.Unchanged</strong></article>
                        <article class="wmc-summary-blocked admin-dashboard-indicator admin-dashboard-indicator--warning"><span>Bloqueados</span><strong>@Model.ImportResult.Blocked</strong></article>
                        <article class="wmc-summary-blocked admin-dashboard-indicator admin-dashboard-indicator--critical"><span>Erros</span><strong>@Model.ImportResult.Errors</strong></article>
                    </div>
                    @if (Model.ImportResult.ErrorMessage is not null)
                    {
                        <div class="alert alert-warning" role="alert">@Model.ImportResult.ErrorMessage</div>
                    }
                    @if (Model.ImportResult.Items.Any(item => item.Detail is not null))
                    {
                        <details class="wmc-confirmation-details"><summary>Ver detalhes do resultado</summary><ul>@foreach (var item in Model.ImportResult.Items.Where(item => item.Detail is not null)) { <li><strong>@item.WmcCode</strong> · @item.Status · @item.Detail</li> }</ul></details>
                    }
                    @if (Model.Candidates is { Count: > 0 })
                    {
                        <details class="wmc-confirmation-details"><summary>Ver preços recarregados após a gravação</summary><ul>
                            @foreach (var item in Model.Candidates.Where(item => (Model.SelectedProductCodes ?? []).Contains(item.WmcCode, StringComparer.Ordinal)))
                            {
                                <li><strong>@item.WmcCode</strong> · WMC: @(item.PrecoVenda?.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("pt-BR")) ?? "—") · BasePrice persistido: @(item.LocalBasePrice?.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("pt-BR")) ?? "—")</li>
                            }
                        </ul></details>
                    }
                    <div class="wmc-wizard-actions"><a asp-action="Wmc" class="btn btn-primary">Nova importação</a></div>
                }
            </section>

        </section>
        <section id="wmc-panel-diagnostics" class="wmc-tab-panel" data-wmc-tab-panel="diagnostics" role="tabpanel" tabindex="0" aria-labelledby="wmc-tab-diagnostics" hidden="@(initialTab == "diagnostics" ? null : "hidden")" aria-hidden="@(initialTab == "diagnostics" ? "false" : "true")">
            <details class="wmc-diagnostics-disclosure" data-wmc-diagnostic-panel open="@(initialTab == "diagnostics" ? "open" : null)">
                <summary><span><span class="wmc-step-kicker">Consulta técnica</span><strong>Diagnóstico de automação e elegibilidade</strong></span><span class="wmc-disclosure-hint">Expandir painel</span></summary>
                @if (loadDiagnosticsRequested)
                {
                    @await Component.InvokeAsync("WmcActivationDiagnostics")
                }
                else
                {
                    <div class="wmc-diagnostics-load-state" data-wmc-diagnostics-load-state aria-live="polite">
                        <span class="wmc-step-kicker">Consulta sob demanda</span>
                        <p>O diagnóstico consulta o PostgreSQL somente quando solicitado.</p>
                        <a asp-action="Wmc" asp-route-loadDiagnostics="true" class="btn btn-primary" data-wmc-load-diagnostics>Carregar diagnóstico</a>
                    </div>
                }
            </details>
        </section>

        <p class="text-muted mt-4">A sincronização automática/global de clientes está desativada. As demais integrações permanecem separadas.</p>
    </div>
</section>

<script>
    (() => {
        const toggle = document.querySelector('[data-wmc-customer-preview-toggle]');
        const table = document.querySelector('[data-wmc-customer-preview-table]');
        const filter = document.querySelector('[data-wmc-customer-preview-filter]');
        const rows = [...document.querySelectorAll('[data-wmc-customer-preview-row]')];
        if (!toggle || !table) return;
        const updateFilter = () => {
            const selected = filter?.value ?? 'all';
            const accepted = selected === 'existing' ? ['existing', 'update'] : [selected];
            rows.forEach(row => row.hidden = selected !== 'all' && !accepted.includes(row.dataset.disposition ?? ''));
        };
        toggle.addEventListener('click', () => {
            const expanded = toggle.getAttribute('aria-expanded') === 'true';
            toggle.setAttribute('aria-expanded', (!expanded).toString());
            table.hidden = expanded;
            toggle.textContent = expanded ? `Visualizar Clientes (${rows.length})` : 'Recolher clientes';
            if (!expanded) updateFilter();
        });
        filter?.addEventListener('change', updateFilter);
    })();

    (() => {
        const form = document.getElementById('wmcImportSelectionForm');
        if (!form) return;

        const rows = [...form.querySelectorAll('[data-wmc-product-row]')];
        const checkboxes = [...form.querySelectorAll('[data-wmc-product-checkbox]')];
        const search = document.getElementById('wmcProductSearch');
        const statusFilter = document.getElementById('wmcProductStatusFilter');
        const count = document.getElementById('wmcProductSelectionCount');
        const pageStatus = document.getElementById('wmcProductPageStatus');
        const previousPage = document.getElementById('wmcProductPreviousPage');
        const nextPage = document.getElementById('wmcProductNextPage');
        const selectAll = document.getElementById('wmcSelectAll');
        const deselectAll = document.getElementById('wmcDeselectAll');
        const review = document.getElementById('wmcReviewSelection');
        const pageSize = 25;
        let page = 1;

        const filteredRows = () => {
            const term = (search?.value ?? '').trim().toLocaleLowerCase();
            const selectedSituation = statusFilter?.value ?? 'active';
            return rows.filter(row => {
                const matchesText = term.length === 0 || (row.dataset.productSearch ?? '').toLocaleLowerCase().includes(term);
                const matchesSituation = selectedSituation === 'all' || row.dataset.situationKind === selectedSituation;
                return matchesText && matchesSituation;
            });
        };
        const filteredCheckboxes = () => filteredRows()
            .map(row => row.querySelector('[data-wmc-product-checkbox]'))
            .filter(input => input);

        const update = () => {
            const filtered = filteredRows();
            const pageCount = Math.max(1, Math.ceil(filtered.length / pageSize));
            page = Math.min(page, pageCount);
            const first = (page - 1) * pageSize;
            const visible = new Set(filtered.slice(first, first + pageSize));
            rows.forEach(row => { row.hidden = !visible.has(row); });

            const selectedCount = checkboxes.filter(input => input.checked).length;
            const eligibleCount = checkboxes.filter(input => !input.disabled).length;
            const filteredEligibleCount = filteredCheckboxes().filter(input => !input.disabled).length;
            const filteredSelectedCount = filteredCheckboxes().filter(input => input.checked).length;
            if (count) count.textContent = `${selectedCount} de ${eligibleCount} produtos selecionados`;
            if (pageStatus) pageStatus.textContent = `${filtered.length === 0 ? 0 : first + 1}–${Math.min(first + pageSize, filtered.length)} de ${filtered.length} produtos`;
            if (previousPage) previousPage.disabled = page <= 1;
            if (nextPage) nextPage.disabled = page >= pageCount;
            if (selectAll) selectAll.disabled = filteredEligibleCount === 0;
            if (deselectAll) deselectAll.disabled = filteredSelectedCount === 0;
            if (review) review.disabled = selectedCount === 0;
        };

        checkboxes.forEach(input => input.addEventListener('change', update));
        selectAll?.addEventListener('click', () => {
            filteredCheckboxes().filter(input => !input.disabled).forEach(input => { input.checked = true; });
            update();
        });
        deselectAll?.addEventListener('click', () => {
            filteredCheckboxes().forEach(input => { input.checked = false; });
            update();
        });
        search?.addEventListener('input', () => { page = 1; update(); });
        statusFilter?.addEventListener('change', () => { page = 1; update(); });
        previousPage?.addEventListener('click', () => { page = Math.max(1, page - 1); update(); });
        nextPage?.addEventListener('click', () => { page += 1; update(); });
        update();
    })();

    (() => {
        const form = document.getElementById('wmcImportConfirmationForm');
        if (!form) return;
        const toggle = form.querySelector('[data-wmc-reimport-toggle]');
        const state = form.querySelector('[data-wmc-reimport-state]');
        const authorization = form.querySelector('[data-wmc-reimport-authorization]');
        const updateAuthorizationState = () => {
            const enabled = toggle?.checked === true;
            if (state) {
                state.dataset.wmcReimportState = enabled ? 'enabled' : 'disabled';
                state.textContent = enabled
                    ? 'Atualização de existentes ativada: preços e dados cadastrais autorizados poderão ser alterados.'
                    : 'Atualização de existentes desativada: produtos já cadastrados serão mantidos sem alteração.';
            }
            if (authorization) {
                authorization.dataset.wmcAuthorization = enabled ? 'enabled' : 'disabled';
                authorization.textContent = enabled
                    ? 'Autorização para existentes ativada antes do envio.'
                    : 'Autorização para existentes desativada antes do envio.';
            }
        };
        toggle?.addEventListener('change', updateAuthorizationState);
        updateAuthorizationState();
        let submitted = false;
        form.addEventListener('submit', event => {
            if (submitted) {
                event.preventDefault();
                return;
            }
            submitted = true;
            const button = form.querySelector('[data-wmc-confirm-submit]');
            if (button) {
                button.disabled = true;
                button.textContent = 'Importando...';
                button.setAttribute('aria-busy', 'true');
            }
        });
    })();
</script>

@section Scripts {
    <script src="~/js/wmc-integration-center.js" asp-append-version="true"></script>
}
