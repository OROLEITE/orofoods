@using Orofoods.Web.Integrations.Erp.Wmc
@using Orofoods.Web.Models.Integrations
@model WmcPreviewPageModel
@{
    ViewData["Title"] = "Sincroniza\u00e7\u00e3o WMC";
    var isRunning = (bool)ViewBag.IsRunning;
    var lastRun = ViewBag.LastRun as WmcSyncRunResult;
}

<section class="section admin-wmc-page">
    <div class="container">
        <div class="portal-top">
            <div>
                <div class="eyebrow"><span></span> Opera&ccedil;&atilde;o</div>
                <h1>Sincroniza&ccedil;&atilde;o WMC</h1>
                <p>Espelho Firebird somente leitura. Clientes, produtos e estoque s&atilde;o refletidos aqui; nada &eacute; escrito de volta na WMC.</p>
            </div>
            <a class="btn btn-outline-dark" asp-action="Index">Voltar &agrave;s integra&ccedil;&otilde;es</a>
        </div>

        @if (TempData["WmcSyncMessage"] is string message)
        {
            <div class="alert alert-info mt-4" role="alert">@message</div>
        }

        <p class="mt-4">Status atual: <strong>@(isRunning ? "Sincronizando..." : "Ocioso")</strong></p>

        @if (lastRun is not null)
        {
            <table class="table mt-3">
                <thead>
                    <tr>
                        <th>Entidade</th>
                        <th>Lidos</th>
                        <th>Criados</th>
                        <th>Atualizados</th>
                        <th>Ignorados</th>
                        <th>Erro</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td>Clientes</td><td>@lastRun.Customers.RecordsRead</td><td>@lastRun.Customers.RecordsCreated</td><td>@lastRun.Customers.RecordsUpdated</td><td>@lastRun.Customers.RecordsSkipped</td><td>@lastRun.Customers.ErrorMessage</td></tr>
                    <tr><td>Produtos</td><td>@lastRun.Products.RecordsRead</td><td>@lastRun.Products.RecordsCreated</td><td>@lastRun.Products.RecordsUpdated</td><td>@lastRun.Products.RecordsSkipped</td><td>@lastRun.Products.ErrorMessage</td></tr>
                    <tr><td>Vendedores</td><td>@lastRun.Sellers.RecordsRead</td><td>@lastRun.Sellers.RecordsCreated</td><td>@lastRun.Sellers.RecordsUpdated</td><td>@lastRun.Sellers.RecordsSkipped</td><td>@lastRun.Sellers.ErrorMessage</td></tr>
                    <tr><td>Estoque</td><td>@lastRun.Stock.RecordsRead</td><td>@lastRun.Stock.RecordsCreated</td><td>@lastRun.Stock.RecordsUpdated</td><td>@lastRun.Stock.RecordsSkipped</td><td>@lastRun.Stock.ErrorMessage</td></tr>
                </tbody>
            </table>
            <p>&Uacute;ltima execu&ccedil;&atilde;o: @lastRun.StartedAt.ToString("u") &rarr; @lastRun.FinishedAt.ToString("u") (UTC)</p>
        }
        else
        {
            <p class="mt-3">Nenhuma sincroniza&ccedil;&atilde;o executada ainda nesta inst&acirc;ncia.</p>
        }

        <section class="mt-5" aria-labelledby="wmc-preview-title">
            <h2 id="wmc-preview-title">Pr&eacute;via de produtos por marca</h2>
            <p>Consulta somente leitura. Nenhum produto, estoque, categoria ou execu&ccedil;&atilde;o ser&aacute; gravado.</p>
            @if (TempData["WmcPreviewError"] is string previewError)
            {
                <div class="alert alert-warning" role="alert">@previewError</div>
            }
            <form method="post" asp-action="WmcPreview" class="row g-3 align-items-end">
                @Html.AntiForgeryToken()
                <div class="col-md-8">
                    <label class="form-label" for="wmcBrandCode">Marca</label>
                    <select class="form-select" id="wmcBrandCode" name="brandCode">
                        <option value="">Todas as marcas</option>
                        @foreach (var brand in Model.Brands)
                        {
                            <option value="@brand.Code" selected="@(Model.SelectedBrandCode == brand.Code)">@brand.Code - @brand.Description (@brand.ProductCount produtos)</option>
                        }
                    </select>
                </div>
                <div class="col-md-4"><button type="submit" class="btn admin-primary-action">Simular importa&ccedil;&atilde;o</button></div>
            </form>

            @if (Model.Preview is not null)
            {
                @if (Model.Preview.ErrorMessage is not null)
                {
                    <div class="alert alert-warning" role="alert">@Model.Preview.ErrorMessage</div>
                }
                <div class="table-responsive mt-4">
                    <table class="table align-middle">
                        <thead><tr><th>M&eacute;trica</th><th>Total</th></tr></thead>
                        <tbody>
                            <tr><td>Produtos lidos</td><td>@Model.Preview.ProductsRead</td></tr>
                            <tr><td>Novos</td><td>@Model.Preview.NewProducts</td></tr>
                            <tr><td>Existentes</td><td>@Model.Preview.ExistingProducts</td></tr>
                            <tr><td>Ativos</td><td>@Model.Preview.ActiveProducts</td></tr>
                            <tr><td>Inativos</td><td>@Model.Preview.InactiveProducts</td></tr>
                            <tr><td>Situa&ccedil;&otilde;es desconhecidas</td><td>@Model.Preview.UnknownSituations</td></tr>
                            <tr><td>Ativos eleg&iacute;veis para importa&ccedil;&atilde;o</td><td>@Model.Preview.ActiveEligibleProducts</td></tr>
                            <tr><td>Inativos ignorados</td><td>@Model.Preview.InactiveIgnoredProducts</td></tr>
                            <tr><td>Situa&ccedil;&otilde;es inv&aacute;lidas/desconhecidas</td><td>@Model.Preview.InvalidSituations</td></tr>
                            <tr><td>Novos ativos</td><td>@Model.Preview.NewActiveProducts</td></tr>
                            <tr><td>Existentes ativos</td><td>@Model.Preview.ExistingActiveProducts</td></tr>
                            <tr><td>C&oacute;digos inv&aacute;lidos</td><td>@Model.Preview.InvalidCodes</td></tr>
                            <tr><td>C&oacute;digos duplicados</td><td>@Model.Preview.DuplicateCodes</td></tr>
                            <tr><td>Problemas de estoque</td><td>@Model.Preview.StockProblems</td></tr>
                            <tr><td>Disponibilidade projetada</td><td>@Model.Preview.ProjectedAvailableProducts</td></tr>
                            <tr><td>Bloqueados projetados</td><td>@Model.Preview.ProjectedBlockedProducts</td></tr>
                        </tbody>
                    </table>
                </div>
                <p class="text-muted">A pr&eacute;via preserva pre&ccedil;os, fotos, categorias comerciais, publica&ccedil;&atilde;o e reservas locais.</p>
            }
        </section>

        <form method="post" asp-action="WmcSyncNow" class="mt-4">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn admin-primary-action" @(isRunning ? "disabled" : "")>Sincronizar agora</button>
        </form>
    </div>
</section>
