@model Orofoods.Web.Areas.Admin.Controllers.WhatsAppInboxViewModel
@{ ViewData["Title"] = "WhatsApp"; }
<section class="section whatsapp-inbox-page"><div class="container"><div class="portal-top"><div><div class="eyebrow"><span></span> CRM comercial</div><h1>WhatsApp</h1><p>Conversas oficiais da Cloud API, com atendimento humano.</p></div></div><div class="whatsapp-inbox"><aside class="whatsapp-conversations"><h2>Conversas</h2>@foreach (var conversation in Model.Conversations) { <a class="whatsapp-conversation @(Model.Selected?.Id == conversation.Id ? "is-active" : "")" asp-route-id="@conversation.Id"><strong>@(conversation.Customer?.TradeName ?? conversation.PhoneNumber)</strong><small>@(conversation.UnreadCount > 0 ? $"{conversation.UnreadCount} não lidas" : "Sem novas mensagens")</small></a> } @if (!Model.Conversations.Any()) { <p class="text-muted">Nenhuma conversa recebida.</p> }</aside><section class="whatsapp-thread"><header><strong>@(Model.Selected?.Customer?.TradeName ?? Model.Selected?.PhoneNumber ?? "Selecione uma conversa")</strong></header>@if (Model.Selected is null) { <p class="whatsapp-empty">Selecione uma conversa para começar.</p> } else { <div class="whatsapp-messages">@foreach (var message in Model.Messages) { <article class="whatsapp-message whatsapp-message--@message.Direction.ToString().ToLowerInvariant()"><p>@message.TextBody</p><small>@message.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm") · @message.Status</small></article> }</div><form asp-action="Send" method="post" class="whatsapp-compose"><input type="hidden" name="conversationId" value="@Model.Selected.Id" /><label for="whatsappText">Mensagem</label><textarea id="whatsappText" name="text" rows="2" required maxlength="4096"></textarea><button class="btn btn-gold">Enviar</button></form> }</section><aside class="whatsapp-customer-panel"><h2>Cliente</h2><p>@(Model.Selected?.Customer?.TradeName ?? "Não identificado")</p>@if (Model.Selected?.CustomerId is not null) { <a class="btn btn-outline-dark" asp-controller="Customers" asp-action="Details" asp-route-id="@Model.Selected.CustomerId">Ver Cliente 360°</a> }</aside></div></div></section>
