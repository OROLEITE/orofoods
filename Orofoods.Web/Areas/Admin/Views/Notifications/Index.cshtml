@model IReadOnlyList<Orofoods.Web.Models.Commercial.UserNotification>
@{ ViewData["Title"] = "Notificações"; }
<section class="section"><div class="container"><div class="portal-top"><div><div class="eyebrow"><span></span> CRM comercial</div><h1>Notificações <small>(@ViewBag.UnreadCount não lidas)</small></h1></div><form asp-action="ReadAll" method="post"><button class="btn btn-outline-dark">Marcar todas como lidas</button></form></div><div class="notification-list mt-4">@foreach (var item in Model) { <article class="@(item.ReadAt is null ? "is-unread" : "")"><div><strong>@item.Title</strong><p>@item.Message</p><small>@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm") @(item.Customer is null ? "" : $"· {item.Customer.TradeName}")</small></div>@if (item.ReadAt is null) { <form asp-action="Read" method="post"><input type="hidden" name="id" value="@item.Id" /><button class="btn btn-sm btn-outline-dark">Marcar como lida</button></form> }</article> }</div></div></section>
