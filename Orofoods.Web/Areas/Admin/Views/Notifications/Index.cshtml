@model IReadOnlyList<Orofoods.Web.Models.Commercial.UserNotification>
@{ ViewData["Title"] = "Notifica\u00e7\u00f5es"; }

<section class="section admin-notifications-page">
    <div class="container">
        <div class="portal-top">
            <div>
                <div class="eyebrow"><span></span> CRM comercial</div>
                <h1>Notifica&ccedil;&otilde;es <small>(@ViewBag.UnreadCount n&atilde;o lidas)</small></h1>
            </div>
            <form asp-action="ReadAll" method="post">
                <button class="btn btn-outline-dark">Marcar todas como lidas</button>
            </form>
        </div>

        <div class="notification-list mt-4">
            @if (Model.Count == 0)
            {
                <div class="admin-empty-state" role="status">
                    <i class="fa-solid fa-bell-slash" aria-hidden="true"></i>
                    <h2>Nenhuma notifica&ccedil;&atilde;o</h2>
                    <p>N&atilde;o h&aacute; notifica&ccedil;&otilde;es para exibir no momento.</p>
                </div>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <article class="@(item.ReadAt is null ? "is-unread" : "")">
                        <div>
                            <strong>@item.Title</strong>
                            <p>@item.Message</p>
                            <small>@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm") @(item.Customer is null ? "" : $"&middot; {item.Customer.TradeName}")</small>
                        </div>
                        @if (item.ReadAt is null)
                        {
                            <form asp-action="Read" method="post">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button class="btn btn-sm btn-outline-dark">Marcar como lida</button>
                            </form>
                        }
                    </article>
                }
            }
        </div>
    </div>
</section>

@section Head {
    <link rel="stylesheet" href="~/css/admin-notifications.css" asp-append-version="true" />
}
