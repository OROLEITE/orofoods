@model Orofoods.Web.ViewModels.CommercialDashboardViewModel
@using Orofoods.Web.Models.Commercial
@{
    ViewData["Title"] = "Dashboard Comercial";
    string TypeLabel(CommercialActivityType type) => type switch
    {
        CommercialActivityType.WhatsApp => "WhatsApp",
        CommercialActivityType.Visit => "Visita",
        CommercialActivityType.Return => "Retorno",
        CommercialActivityType.Order => "Pedido",
        _ => "Ligar"
    };
    string StatusLabel(CommercialActivityStatus status) => status switch
    {
        CommercialActivityStatus.InProgress => "Em negociação",
        CommercialActivityStatus.Completed => "Concluído",
        CommercialActivityStatus.Cancelled => "Cancelado",
        _ => "Aguardando"
    };
}

<section class="commercial-dashboard-page">
    <div class="container">
        <header class="commercial-dashboard-hero">
            <div><p class="eyebrow"><span></span> Operação comercial</p><h1>Dashboard Comercial</h1><p>Organize os atendimentos, retornos e oportunidades da sua equipe.</p></div>
            <a class="btn btn-gold" asp-action="Create"><i class="fa-solid fa-plus"></i> Nova atividade</a>
        </header>

        <div class="commercial-metric-grid">
            <article><i class="fa-solid fa-users"></i><small>CLIENTES DO DIA</small><strong>@Model.CustomersToday</strong><span>com atendimento programado</span></article>
            <article><i class="fa-solid fa-clock"></i><small>RETORNOS PENDENTES</small><strong>@Model.PendingReturns</strong><span>precisam de atenção</span></article>
            <article><i class="fa-solid fa-file-invoice"></i><small>PEDIDOS DO DIA</small><strong>@Model.OrdersToday</strong><span>registrados no portal</span></article>
            <article><i class="fa-solid fa-chart-line"></i><small>FATURAMENTO DO DIA</small><strong>@Model.TodayRevenue.ToString("C")</strong><span>pedidos não cancelados</span></article>
        </div>

        <div class="commercial-dashboard-layout">
            <section class="commercial-kanban-panel">
                <header class="commercial-panel-heading"><div><p class="eyebrow"><span></span> Acompanhamento</p><h2>Kanban de atendimentos</h2></div><a asp-action="Index" asp-route-date="@Model.ReferenceDate.AddDays(-1).ToString("yyyy-MM-dd")" aria-label="Dia anterior"><i class="fa-solid fa-chevron-left"></i></a><strong>@Model.ReferenceDate.ToString("dd/MM/yyyy")</strong><a asp-action="Index" asp-route-date="@Model.ReferenceDate.AddDays(1).ToString("yyyy-MM-dd")" aria-label="Próximo dia"><i class="fa-solid fa-chevron-right"></i></a></header>
                <div class="commercial-kanban-grid">
                    @foreach (var status in new[] { CommercialActivityStatus.Scheduled, CommercialActivityStatus.InProgress, CommercialActivityStatus.Completed })
                    {
                        <div class="commercial-kanban-column"><header><span>@StatusLabel(status)</span><strong>@Model.Activities.Count(x => x.Status == status)</strong></header>
                            @foreach (var activity in Model.Activities.Where(x => x.Status == status))
                            {
                                <a class="commercial-activity-card @(activity.IsPriority ? "is-priority" : "")" asp-area="Admin" asp-controller="Customers" asp-action="Details" asp-route-id="@activity.CustomerId"><small>@activity.ScheduledAt.ToString("HH:mm") · @TypeLabel(activity.Type)</small><strong>@activity.Customer.TradeName</strong><span>@activity.Title</span><footer><span>@(activity.SalesRepresentative?.Name ?? "Sem vendedor")</span><i class="fa-solid @(activity.Type == CommercialActivityType.WhatsApp ? "fa-whatsapp" : activity.Type == CommercialActivityType.Visit ? "fa-location-dot" : "fa-phone")"></i></footer></a>
                            }
                            @if (!Model.Activities.Any(x => x.Status == status)) { <p class="commercial-empty-column">Nenhum atendimento</p> }
                        </div>
                    }
                </div>
            </section>

            <aside class="commercial-agenda-panel"><header class="commercial-panel-heading"><div><p class="eyebrow"><span></span> Agenda</p><h2>Próximos atendimentos</h2></div><a asp-action="Calendar" aria-label="Abrir agenda semanal"><i class="fa-solid fa-calendar-day"></i></a></header>
                @foreach (var activity in Model.UpcomingActivities)
                {
                    <article class="commercial-agenda-item"><time>@activity.ScheduledAt.ToString("HH:mm")</time><div><strong>@activity.Customer.TradeName</strong><span>@TypeLabel(activity.Type) · @activity.Title</span></div><i class="fa-solid @(activity.Type == CommercialActivityType.WhatsApp ? "fa-whatsapp" : activity.Type == CommercialActivityType.Visit ? "fa-location-dot" : "fa-phone")"></i></article>
                }
                @if (!Model.UpcomingActivities.Any()) { <p class="commercial-empty-column">Nenhum atendimento futuro.</p> }
            </aside>
        </div>
    </div>
</section>