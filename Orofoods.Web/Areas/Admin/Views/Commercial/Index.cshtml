@model Orofoods.Web.ViewModels.CommercialDashboardViewModel
@using Orofoods.Web.Models.Commercial
@{
    ViewData["Title"] = "Dashboard Comercial";
    string TypeLabel(CommercialActivityType type) => type switch
    {
        CommercialActivityType.WhatsApp => "WhatsApp",
        CommercialActivityType.Visit => "Visita",
        CommercialActivityType.Return => "Retorno",
        CommercialActivityType.Order => "Pedido",
        _ => "Ligar"
    };
    string StatusLabel(CommercialActivityStatus status) => status switch
    {
        CommercialActivityStatus.InProgress => "Em negociação",
        CommercialActivityStatus.Completed => "Concluído",
        CommercialActivityStatus.Cancelled => "Cancelado",
        _ => "Aguardando"
    };
}

<section class="commercial-dashboard-page">
    <div class="container">
        <header class="commercial-dashboard-hero">
            <div><p class="eyebrow"><span></span> CRM comercial</p><h1>Visão geral</h1><p>Bom dia, @(User.Identity?.Name ?? "equipe comercial").</p></div>
            <a class="btn btn-gold" asp-action="Create"><i class="fa-solid fa-plus"></i> Nova atividade</a>
        </header>

        <section class="commercial-overview-today">
            <div class="commercial-section-kicker"><span></span> Hoje</div>
            <div class="commercial-metric-grid">
                <article><i class="fa-solid fa-calendar-day"></i><small>ATENDIMENTOS</small><strong>@Model.Attention.TodayAppointments</strong><span>compromissos do dia</span></article>
                <article><i class="fa-solid fa-clock"></i><small>RETORNOS VENCIDOS</small><strong>@Model.Attention.OverdueReturns</strong><span>precisam de atenção</span></article>
                <article><i class="fa-solid fa-rotate"></i><small>POSSÍVEIS RECOMPRAS</small><strong>@Model.Attention.RepurchasesDue</strong><span>no momento de contato</span></article>
                <article><i class="fa-solid fa-hourglass-half"></i><small>SEM COMPRAR HÁ +30 DIAS</small><strong>@Model.Attention.CustomersWithoutPurchase</strong><span>clientes para acompanhar</span></article>
            </div>
        </section>

        <section class="commercial-routine-panel">
            <header class="commercial-panel-heading"><div><p class="eyebrow"><span></span> Operação comercial</p><h2>Minha rotina</h2></div><span>Fila de atenção do dia</span></header>
            <div class="commercial-routine-list commercial-routine-list--overview">
                @foreach (var item in Model.Attention.Routine.Where(x => x.ScheduledAt.Date == Model.ReferenceDate.Date || x.ActivityId is null))
                {
                    <article class="commercial-routine-item commercial-routine-item--@item.Priority.ToLowerInvariant()"><time>@(item.ActivityId is null ? "--:--" : item.ScheduledAt.ToLocalTime().ToString("HH:mm"))</time><div><small>@item.Kind</small><strong>@item.CustomerName</strong><span>@item.Title</span></div><a asp-controller="Customers" asp-action="Details" asp-route-id="@item.CustomerId" aria-label="Ver @item.CustomerName"><i class="fa-solid fa-arrow-up-right-from-square"></i></a></article>
                }
                @if (!Model.Attention.Routine.Any(x => x.ScheduledAt.Date == Model.ReferenceDate.Date || x.ActivityId is null)) { <p class="commercial-empty-column">Nenhum item na rotina de hoje.</p> }
            </div>
        </section>

        <section class="commercial-priority-legend" aria-label="Prioridades comerciais">
            <div><i class="fa-solid fa-circle priority-dot priority-dot--urgent"></i><span>Retornos vencidos</span></div>
            <div><i class="fa-solid fa-circle priority-dot priority-dot--repurchase"></i><span>Recompra provável</span></div>
            <div><i class="fa-solid fa-circle priority-dot priority-dot--no-purchase"></i><span>Clientes sem comprar</span></div>
            <div><i class="fa-solid fa-circle priority-dot priority-dot--first-contact"></i><span>Primeiro contato</span></div>
        </section>

        <div class="commercial-metric-grid commercial-metric-grid--secondary">
            <article><i class="fa-solid fa-file-invoice"></i><small>PEDIDOS DO DIA</small><strong>@Model.OrdersToday</strong><span>registrados no portal</span></article>
            <article><i class="fa-solid fa-chart-line"></i><small>FATURAMENTO DO DIA</small><strong>@Model.TodayRevenue.ToString("C")</strong><span>pedidos não cancelados</span></article>
        </div>

        <section class="commercial-attention-panel">
            <header class="commercial-panel-heading"><div><p class="eyebrow"><span></span> Fila operacional</p><h2>Atenção comercial</h2></div><span>Indicadores calculados com pedidos válidos e agenda local.</span></header>
            <div class="commercial-attention-grid">
                <a asp-action="Index" class="commercial-attention-card"><small>ATENDIMENTOS DE HOJE</small><strong>@Model.Attention.TodayAppointments</strong></a>
                <a asp-action="Index" class="commercial-attention-card commercial-attention-card--urgent"><small>RETORNOS VENCIDOS</small><strong>@Model.Attention.OverdueReturns</strong></a>
                <a asp-action="Index" class="commercial-attention-card"><small>CLIENTES SEM COMPRAR</small><strong>@Model.Attention.CustomersWithoutPurchase</strong></a>
                <a asp-action="Index" class="commercial-attention-card"><small>POSSÍVEIS RECOMPRAS</small><strong>@Model.Attention.RepurchasesDue</strong></a>
                <a asp-action="Index" class="commercial-attention-card"><small>PRIMEIRO CONTATO</small><strong>@Model.Attention.NewCustomers</strong></a>
            </div>
            <div class="commercial-routine-list">
                @foreach (var item in Model.Attention.Routine)
                {
                    <article class="commercial-routine-item"><div><small>@item.Kind · @item.Priority</small><strong>@item.CustomerName</strong><span>@item.Title</span></div><a asp-controller="Customers" asp-action="Details" asp-route-id="@item.CustomerId">Ver cliente</a></article>
                }
                @if (!Model.Attention.Routine.Any()) { <p class="commercial-empty-column">Nenhuma atenção pendente.</p> }
            </div>
        </section>

        <div class="commercial-dashboard-layout">
            <section class="commercial-kanban-panel">
                <header class="commercial-panel-heading"><div><p class="eyebrow"><span></span> Acompanhamento</p><h2>Kanban de atendimentos</h2></div><a asp-action="Index" asp-route-date="@Model.ReferenceDate.AddDays(-1).ToString("yyyy-MM-dd")" aria-label="Dia anterior"><i class="fa-solid fa-chevron-left"></i></a><strong>@Model.ReferenceDate.ToString("dd/MM/yyyy")</strong><a asp-action="Index" asp-route-date="@Model.ReferenceDate.AddDays(1).ToString("yyyy-MM-dd")" aria-label="Próximo dia"><i class="fa-solid fa-chevron-right"></i></a></header>
                <div class="commercial-kanban-grid">
                    @foreach (var status in new[] { CommercialActivityStatus.Scheduled, CommercialActivityStatus.InProgress, CommercialActivityStatus.Completed })
                    {
                        <div class="commercial-kanban-column"><header><span>@StatusLabel(status)</span><strong>@Model.Activities.Count(x => x.Status == status)</strong></header>
                            @foreach (var activity in Model.Activities.Where(x => x.Status == status))
                            {
                                <a class="commercial-activity-card @(activity.IsPriority ? "is-priority" : "")" asp-area="Admin" asp-controller="Customers" asp-action="Details" asp-route-id="@activity.CustomerId"><small>@activity.ScheduledAt.ToString("HH:mm") · @TypeLabel(activity.Type)</small><strong>@activity.Customer.TradeName</strong><span>@activity.Title</span><footer><span>Vendedor: @(activity.SalesRepresentative?.Name ?? "Sem vendedor")<br />Atendimento: @(activity.AssignedUser?.Email ?? "Não atribuído")</span><i class="fa-solid @(activity.Type == CommercialActivityType.WhatsApp ? "fa-whatsapp" : activity.Type == CommercialActivityType.Visit ? "fa-location-dot" : "fa-phone")"></i></footer></a>
                            }
                            @if (!Model.Activities.Any(x => x.Status == status)) { <p class="commercial-empty-column">Nenhum atendimento</p> }
                        </div>
                    }
                </div>
            </section>

            <aside class="commercial-agenda-panel"><header class="commercial-panel-heading"><div><p class="eyebrow"><span></span> Agenda</p><h2>Próximos atendimentos</h2></div><a asp-action="Calendar" aria-label="Abrir agenda semanal"><i class="fa-solid fa-calendar-day"></i></a></header>
                @foreach (var activity in Model.UpcomingActivities)
                {
                    <article class="commercial-agenda-item"><time>@activity.ScheduledAt.ToString("HH:mm")</time><div><strong>@activity.Customer.TradeName</strong><span>@TypeLabel(activity.Type) · @activity.Title</span></div><i class="fa-solid @(activity.Type == CommercialActivityType.WhatsApp ? "fa-whatsapp" : activity.Type == CommercialActivityType.Visit ? "fa-location-dot" : "fa-phone")"></i></article>
                }
                @if (!Model.UpcomingActivities.Any()) { <p class="commercial-empty-column">Nenhum atendimento futuro.</p> }
            </aside>
        </div>
    </div>
</section>