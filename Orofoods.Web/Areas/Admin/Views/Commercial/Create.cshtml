@model Orofoods.Web.ViewModels.CommercialActivityFormViewModel
@using Orofoods.Web.Models.Commercial
@{ ViewData["Title"] = "Nova atividade comercial"; }

<section class="section"><div class="container commercial-form-page"><div class="portal-top"><div><small>Operação comercial</small><h1>Nova atividade</h1></div><a asp-action="Index" class="btn btn-outline-dark"><i class="fa-solid fa-arrow-left"></i> Voltar</a></div>
    <form method="post" class="registration-card commercial-form-card"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3">
        <div class="col-md-6"><label asp-for="CustomerId" class="form-label">Cliente</label><select asp-for="CustomerId" asp-items="Model.Customers" class="form-select"><option value="">Selecione um cliente</option></select></div>
        <div class="col-md-6"><label asp-for="SalesRepresentativeId" class="form-label">Vendedor comercial</label><select asp-for="SalesRepresentativeId" asp-items="Model.SalesRepresentatives" class="form-select"><option value="">Sem vendedor definido</option></select></div>
        <div class="col-md-6"><label asp-for="AssignedUserId" class="form-label">Atendimento interno</label><select asp-for="AssignedUserId" asp-items="Model.InternalSalesUsers" class="form-select"><option value="">Sem atendimento interno</option></select></div>
        <div class="col-md-4"><label asp-for="Type" class="form-label">Tipo</label><select asp-for="Type" asp-items="Html.GetEnumSelectList<CommercialActivityType>()" class="form-select"></select></div>
        <div class="col-md-4"><label asp-for="Status" class="form-label">Status</label><select asp-for="Status" asp-items="Html.GetEnumSelectList<CommercialActivityStatus>()" class="form-select"></select></div>
        <div class="col-md-4"><label asp-for="ScheduledAt" class="form-label">Data e hora</label><input asp-for="ScheduledAt" type="datetime-local" class="form-control" /></div>
        <div class="col-12"><label asp-for="Title" class="form-label">Título</label><input asp-for="Title" class="form-control" placeholder="Ex.: Retorno sobre tabela de preços" /></div>
        <div class="col-12"><label asp-for="Notes" class="form-label">Observações</label><textarea asp-for="Notes" class="form-control" rows="4"></textarea></div>
        <div class="col-12"><label class="form-check"><input asp-for="IsPriority" class="form-check-input" /> <span class="form-check-label">Marcar como prioridade</span></label></div>
    </div><footer class="registration-actions"><a asp-action="Index" class="btn btn-outline-dark">Cancelar</a><button type="submit" class="btn btn-gold"><i class="fa-solid fa-calendar-plus"></i> Agendar atividade</button></footer></form>
</div></section>