@model Orofoods.Web.ViewModels.PaymentTerminalIndexViewModel
@{
    ViewData["Title"] = "Terminais Point";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div><h1>Terminais de pagamento</h1><p>Cadastro interno. Esta tela não realiza cobranças.</p></div>
    <a class="btn btn-primary" asp-action="Edit">Novo terminal</a>
</div>

@if (TempData["MercadoPagoPointTerminalMessage"] is string terminalMessage)
{
    var success = terminalMessage.StartsWith("Terminal configurado", StringComparison.Ordinal);
    <div class="alert @(success ? "alert-success" : "alert-warning")" role="status">@terminalMessage</div>
}

@if (Model.IsStaging && User.IsInRole("Administrador"))
{
    <section class="card mb-4" aria-labelledby="mercado-pago-terminals-title">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h2 class="h5 mb-0" id="mercado-pago-terminals-title">Terminais Mercado Pago</h2>
            <a class="btn btn-sm btn-outline-secondary" asp-action="Index">Atualizar descoberta</a>
        </div>
        <div class="card-body">
            @if (Model.DiscoveryFailed)
            {
                <div class="alert alert-warning mb-0" role="status">Não foi possível atualizar a descoberta. Recarregue a tela para conferir o estado atual.</div>
            }
            else if (Model.MercadoPagoTerminals.Count == 0)
            {
                <p class="text-muted mb-0">Nenhum terminal foi retornado pela descoberta.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead><tr><th>Terminal ID</th><th>Store ID</th><th>POS ID</th><th>Modo</th><th>Ação</th></tr></thead>
                        <tbody>
                        @foreach (var terminal in Model.MercadoPagoTerminals)
                        {
                            var isAuthorizedTerminal = string.Equals(terminal.Id, Orofoods.Web.Services.Payments.MercadoPagoPointTerminalDiscovery.AuthorizedStagingTerminalId, StringComparison.Ordinal);
                            <tr>
                                <td>@terminal.Id</td>
                                <td>@(terminal.StoreId ?? "—")</td>
                                <td>@(terminal.PosId ?? "—")</td>
                                <td>@terminal.OperatingMode</td>
                                <td>
                                @if (isAuthorizedTerminal && terminal.OperatingMode == "PDV")
                                {
                                    <span class="badge text-bg-success">Terminal em modo PDV</span>
                                }
                                else if (isAuthorizedTerminal && terminal.OperatingMode == "STANDALONE" && User.IsInRole("Administrador"))
                                {
                                    <form asp-area="Admin" asp-action="SetMercadoPagoTerminalOperatingModeToPdv" method="post" asp-antiforgery="true" onsubmit="return confirm('Deseja alterar a maquininha NEWLAND_N950__N950NCD600484709 de STANDALONE para PDV?');">
                                        <button class="btn btn-sm btn-primary" type="submit">Configurar como PDV</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>
}

<div class="table-responsive"><table class="table align-middle">
    <thead><tr><th>Provedor</th><th>Device ID</th><th>Store ID</th><th>POS ID</th><th>Status</th><th></th></tr></thead>
    <tbody>
    @foreach (var terminal in Model.ConfiguredTerminals)
    {
        <tr>
            <td>@terminal.Provider</td><td>@(terminal.DeviceId ?? "Não configurado")</td><td>@(terminal.StoreId ?? "—")</td><td>@(terminal.PosId ?? "—")</td><td>@(terminal.IsActive ? "Ativo" : "Inativo")</td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@terminal.Id">Editar</a>
                @if (terminal.IsActive)
                {
                    <form asp-action="Deactivate" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@terminal.Id" />
                        <button class="btn btn-sm btn-outline-danger" type="submit">Desativar</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table></div>
@section Head { <link rel="stylesheet" href="~/css/admin-payment-terminals.css" asp-append-version="true" /> }