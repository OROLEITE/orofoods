@model Orofoods.Web.ViewModels.CustomerCommercialViewModel
@using Orofoods.Web.Models.Customers
@using Orofoods.Web.Models.Commercial
@{ ViewData["Title"] = Model.Customer.TradeName; }

<section class="customer-commercial-page"><div class="container">
    <nav class="customer-approval-breadcrumb" aria-label="Navegação administrativa"><a asp-controller="Dashboard" asp-action="Index"><i class="fa-solid fa-house"></i> Administração</a><i class="fa-solid fa-chevron-right"></i><a asp-action="Index">Clientes</a><i class="fa-solid fa-chevron-right"></i><span>@Model.Customer.TradeName</span></nav>
    <header class="customer-commercial-hero"><div><p class="eyebrow"><span></span> Cliente B2B</p><h1>@Model.Customer.TradeName</h1><p>@Model.Customer.LegalName <span>&bull;</span> @Model.Customer.Cnpj</p></div><div><span class="customer-commercial-status"><i class="fa-solid fa-circle-check"></i> @(Model.Customer.Status == CustomerStatus.Approved ? "Ativo" : "Pendente")</span><a asp-action="Edit" asp-route-id="@Model.Customer.Id" class="btn btn-outline-dark"><i class="fa-solid fa-gear"></i> Configurar</a></div></header>
    <div class="customer-commercial-actions"><a href="tel:@Model.Customer.Phone" class="btn btn-outline-dark"><i class="fa-solid fa-phone"></i> Ligar</a><a href="https://wa.me/@string.Concat(Model.Customer.WhatsApp.Where(char.IsDigit))" class="btn btn-whatsapp"><i class="fa-brands fa-whatsapp"></i> WhatsApp</a><a asp-controller="Commercial" asp-action="Create" class="btn btn-gold"><i class="fa-solid fa-calendar-plus"></i> Nova atividade</a></div>
    <div class="customer-commercial-metrics"><article><small>ÚLTIMA COMPRA</small><strong>@(Model.LastPurchaseAt?.ToLocalTime().ToString("dd/MM/yyyy") ?? "Nenhuma")</strong></article><article><small>COMPRAS REGISTRADAS</small><strong>@Model.Orders.Count</strong></article><article><small>TOTAL COMPRADO</small><strong>@Model.TotalPurchased.ToString("C")</strong></article><article><small>PRÓXIMO ATENDIMENTO</small><strong>@(Model.NextActivity?.ScheduledAt.ToString("dd/MM HH:mm") ?? "Nenhum")</strong></article></div>
    <div class="customer-commercial-layout"><main><section class="customer-commercial-panel"><header><div><p class="eyebrow"><span></span> Histórico</p><h2>Atividades comerciais</h2></div></header>@if (!Model.Activities.Any()) { <p class="customer-commercial-empty">Nenhuma atividade registrada para este cliente.</p> } else { <div class="customer-activity-list">@foreach (var activity in Model.Activities) { <article><div class="customer-activity-icon"><i class="fa-solid @(activity.Type == CommercialActivityType.WhatsApp ? "fa-whatsapp" : activity.Type == CommercialActivityType.Visit ? "fa-location-dot" : "fa-phone")"></i></div><div><strong>@activity.Title</strong><span>@activity.ScheduledAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · @Model.Customer.TradeName · @(activity.SalesRepresentative?.Name ?? "Sem vendedor")</span>@if (!string.IsNullOrWhiteSpace(activity.Notes)) { <p>@activity.Notes</p> }</div><div class="customer-activity-state">@(activity.Status == CommercialActivityStatus.Completed ? "Concluído" : activity.Status == CommercialActivityStatus.Cancelled ? "Cancelado" : "Pendente")@if (activity.Status != CommercialActivityStatus.Completed && activity.Status != CommercialActivityStatus.Cancelled) { <form asp-action="CompleteActivity" method="post"><input type="hidden" name="id" value="@activity.Id" /><input type="hidden" name="customerId" value="@Model.Customer.Id" /><button type="submit" aria-label="Concluir atividade"><i class="fa-solid fa-check"></i></button></form> }</div></article> }</div> }</section><section class="customer-commercial-panel"><header><div><p class="eyebrow"><span></span> Histórico financeiro</p><h2>Pedidos recentes</h2></div></header>@if (!Model.Orders.Any()) { <p class="customer-commercial-empty">Nenhum pedido registrado.</p> } else { <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Pedido</th><th>Data</th><th>Status</th><th class="text-end">Total</th></tr></thead><tbody>@foreach (var order in Model.Orders) { <tr><td><a asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id"><strong>@order.Number</strong></a></td><td>@order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td><td>@order.Status.ToDisplayName()</td><td class="text-end"><strong>@order.Total.ToString("C")</strong></td></tr> }</tbody></table></div> }</section></main><aside><section class="customer-commercial-panel"><p class="eyebrow"><span></span> Dados comerciais</p><dl><dt>Vendedor</dt><dd>@(Model.Customer.SalesRepresentative?.Name ?? "Não definido")</dd><dt>Tabela de preços</dt><dd>@Model.Customer.PriceTableName</dd><dt>Pedido mínimo</dt><dd>@Model.Customer.MinimumOrder.ToString("C")</dd><dt>Limite de crédito</dt><dd>@Model.Customer.CreditLimit.ToString("C")</dd><dt>Telefone</dt><dd>@Model.Customer.Phone</dd><dt>WhatsApp</dt><dd>@Model.Customer.WhatsApp</dd></dl></section><section class="customer-commercial-panel"><p class="eyebrow"><span></span> Endereço principal</p>@{ var address = Model.Customer.Addresses.FirstOrDefault(x => x.IsPrimary) ?? Model.Customer.Addresses.FirstOrDefault(); }<p class="customer-address">@(address is null ? "Nenhum endereço cadastrado." : $"{address.Street}, {address.Number} - {address.District}, {address.City}/{address.State}")</p></section></aside></div>
</div></section>