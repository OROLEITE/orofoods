@model Orofoods.Web.ViewModels.CustomerCommercialViewModel
@using Orofoods.Web.Models
@using Orofoods.Web.Models.Customers
@{ ViewData["Title"] = Model.Customer.TradeName; }

<section class="customer-commercial-page">
    <div class="container">
        <nav class="customer-approval-breadcrumb" aria-label="Navegação administrativa">
            <a asp-controller="Dashboard" asp-action="Index"><i class="fa-solid fa-house" aria-hidden="true"></i> Administração</a>
            <i class="fa-solid fa-chevron-right" aria-hidden="true"></i><a asp-action="Index">Clientes</a>
            <i class="fa-solid fa-chevron-right" aria-hidden="true"></i><span>@Model.Customer.TradeName</span>
        </nav>
        <header class="customer-commercial-hero">
            <div><p class="eyebrow"><span></span> Cliente B2B</p><h1>@Model.Customer.TradeName</h1><p>@Model.Customer.LegalName <span>&bull;</span> @Model.Customer.Cnpj</p></div>
            <div><span class="customer-commercial-status"><i class="fa-solid fa-circle-check" aria-hidden="true"></i> @(Model.Customer.Status == CustomerStatus.Approved ? "Ativo" : Model.Customer.Status == CustomerStatus.Pending ? "Pendente" : Model.Customer.Status == CustomerStatus.Blocked ? "Bloqueado" : "Inativo")</span><a asp-action="Edit" asp-route-id="@Model.Customer.Id" class="btn btn-outline-dark"><i class="fa-solid fa-gear" aria-hidden="true"></i> Configurar</a><a asp-action="NewOrder" asp-route-id="@Model.Customer.Id" class="btn btn-gold"><i class="fa-solid fa-cart-plus" aria-hidden="true"></i> Novo pedido</a></div>
        </header>
        <div class="customer-commercial-actions"><a href="tel:@Model.Customer.Phone" class="btn btn-outline-dark"><i class="fa-solid fa-phone" aria-hidden="true"></i> Ligar</a><a href="https://wa.me/@string.Concat(Model.Customer.WhatsApp.Where(char.IsDigit))" class="btn btn-whatsapp"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i> WhatsApp</a><a asp-controller="Commercial" asp-action="Create" asp-route-customerId="@Model.Customer.Id" class="btn btn-gold"><i class="fa-solid fa-calendar-plus" aria-hidden="true"></i> Nova atividade</a></div>
        <div class="customer-commercial-metrics"><article><small>ÚLTIMA COMPRA</small><strong>@(Model.LastPurchaseAt?.ToLocalTime().ToString("dd/MM/yyyy") ?? "Nenhuma")</strong></article><article><small>PEDIDOS</small><strong>@Model.OrderCount</strong></article><article><small>TOTAL COMPRADO</small><strong>@Model.TotalPurchased.ToString("C")</strong></article><article><small>TÍQUETE MÉDIO</small><strong>@Model.AverageTicket.ToString("C")</strong></article></div>
        @if (Model.Attention is not null)
        {
            <section class="customer-commercial-attention"><div><p class="eyebrow"><span></span> Atenção comercial</p><h2>@Model.Attention.Situation</h2></div><dl><div><dt>Última compra</dt><dd>@(Model.Attention.LastPurchaseAt?.ToLocalTime().ToString("dd/MM/yyyy") ?? "Nenhuma")</dd></div><div><dt>Dias sem comprar</dt><dd>@(Model.Attention.DaysSinceLastPurchase?.ToString() ?? "Sem histórico")</dd></div><div><dt>Média de recompra</dt><dd>@(Model.Attention.AveragePurchaseIntervalDays is null ? "Histórico insuficiente" : $"{Model.Attention.AveragePurchaseIntervalDays} dias")</dd></div><div><dt>Prioridade</dt><dd>@Model.Attention.Priority</dd></div></dl></section>
        }
        <section class="customer-opportunities-panel"><header><div><p class="eyebrow"><span></span> Pipeline</p><h2>Oportunidades</h2></div><a class="btn btn-gold btn-sm" asp-area="Admin" asp-controller="Opportunities" asp-action="Create" asp-route-customerId="@Model.Customer.Id">Nova oportunidade</a></header>@if (!Model.Opportunities.Any()) { <p class="customer-commercial-empty">Nenhuma oportunidade cadastrada.</p> } else { <div class="customer-opportunity-list">@foreach (var opportunity in Model.Opportunities) { <article><div><strong>@opportunity.Title</strong><small>@opportunity.Type · @opportunity.Stage</small></div><span>@(opportunity.EstimatedValue?.ToString("C") ?? "Valor não informado")</span><form asp-area="Admin" asp-controller="Opportunities" asp-action="ChangeStage" method="post"><input type="hidden" name="id" value="@opportunity.Id" /><select name="stage" aria-label="Etapa de @opportunity.Title"><option value="@opportunity.Stage">@opportunity.Stage</option><option value="Won">Ganha</option><option value="Lost">Perdida</option></select><button class="btn btn-sm btn-outline-dark">Salvar</button></form></article> }</div>}</section>

        <div class="customer-detail-tabs-shell">
            <nav class="nav nav-tabs customer-detail-tabs" role="tablist" aria-label="Detalhes do cliente">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#overview" type="button" role="tab">Visão geral</button><button class="nav-link" data-bs-toggle="tab" data-bs-target="#orders" type="button" role="tab">Pedidos</button><button class="nav-link" data-bs-toggle="tab" data-bs-target="#products" type="button" role="tab">Produtos comprados</button><button class="nav-link" data-bs-toggle="tab" data-bs-target="#finance" type="button" role="tab">Financeiro</button><button class="nav-link" data-bs-toggle="tab" data-bs-target="#prices" type="button" role="tab">Preços</button><button class="nav-link" data-bs-toggle="tab" data-bs-target="#addresses" type="button" role="tab">Endereços</button><button class="nav-link" data-bs-toggle="tab" data-bs-target="#users" type="button" role="tab">Usuários</button><button class="nav-link" data-bs-toggle="tab" data-bs-target="#seller" type="button" role="tab">Vendedor</button><button class="nav-link" data-bs-toggle="tab" data-bs-target="#history" type="button" role="tab">Histórico</button>
            </nav>
            <div class="tab-content customer-detail-content">
                <section class="tab-pane fade show active" id="overview" role="tabpanel"><div class="customer-detail-grid"><article class="customer-detail-panel"><h2>Cadastro</h2><dl><div><dt>Razão social</dt><dd>@Model.Customer.LegalName</dd></div><div><dt>CNPJ</dt><dd>@Model.Customer.Cnpj</dd></div><div><dt>E-mail</dt><dd>@Model.Customer.Email</dd></div><div><dt>Telefone</dt><dd>@Model.Customer.Phone</dd></div><div><dt>WhatsApp</dt><dd>@Model.Customer.WhatsApp</dd></div><div><dt>Cidade</dt><dd>@Model.Customer.Addresses.FirstOrDefault(address => address.IsPrimary)?.City</dd></div></dl></article><article class="customer-detail-panel"><h2>Configuração comercial</h2><dl><div><dt>Vendedor responsável</dt><dd>@(Model.Customer.SalesRepresentative?.Name ?? "Não atribuído")</dd></div><div><dt>Atendimento interno</dt><dd>@(Model.Customer.InternalSalesUser?.Email ?? "Não atribuído")</dd></div><div><dt>Tabela de preços</dt><dd>@(Model.Customer.PriceTable?.Name ?? "Não atribuída")</dd></div><div><dt>Pagamento</dt><dd>@Model.Customer.PaymentTerms</dd></div><div><dt>Crédito</dt><dd>@(Model.Customer.CreditBlocked ? "Bloqueado" : Model.Customer.CreditLimit.ToString("C"))</dd></div><div><dt>Cadastro</dt><dd>@Model.Customer.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</dd></div><div><dt>Status</dt><dd>@(Model.Customer.Status == CustomerStatus.Approved ? "Aprovado" : Model.Customer.Status == CustomerStatus.Pending ? "Pendente" : Model.Customer.Status == CustomerStatus.Blocked ? "Bloqueado" : "Inativo")</dd></div></dl></article></div></section>

                <section class="tab-pane fade" id="orders" role="tabpanel"><div class="customer-detail-panel"><div class="customer-detail-panel-heading"><div><p class="eyebrow"><span></span> Histórico</p><h2>Pedidos</h2></div><span>Últimos @Model.Orders.Count registros</span></div><div class="table-responsive"><table class="table customer-detail-table align-middle"><thead><tr><th>Pedido</th><th>Data</th><th>Pagamento</th><th>Vendedor</th><th>Status</th><th class="text-end">Valor</th></tr></thead><tbody>@foreach (var order in Model.Orders) { <tr><td><a asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id"><strong>@order.Number</strong></a></td><td>@order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td><td>@(order.PaymentTerm?.Name ?? order.PaymentMethod)</td><td>@(Model.Customer.SalesRepresentative?.Name ?? "Não atribuído")</td><td><span class="admin-order-status">@order.Status.ToDisplayName()</span></td><td class="text-end"><strong>@order.Total.ToString("C")</strong></td></tr> }</tbody></table></div></div></section>

                <section class="tab-pane fade" id="products" role="tabpanel"><div class="customer-detail-panel"><div class="customer-detail-panel-heading"><div><p class="eyebrow"><span></span> Consumo</p><h2>Produtos comprados</h2></div><span>Ordenado por quantidade</span></div><div class="table-responsive"><table class="table customer-detail-table align-middle"><thead><tr><th>Produto</th><th class="text-end">Quantidade</th><th class="text-end">Pedidos</th><th>Última compra</th><th class="text-end">Total</th><th class="text-end">Preço médio</th></tr></thead><tbody>@foreach (var product in Model.PurchasedProducts) { <tr><td><small>@product.Sku</small><strong class="d-block">@product.Name</strong></td><td class="text-end">@product.TotalQuantity</td><td class="text-end">@product.OrderCount</td><td>@product.LastPurchaseAt.ToLocalTime().ToString("dd/MM/yyyy")</td><td class="text-end"><strong>@product.TotalAmount.ToString("C")</strong></td><td class="text-end">@product.AverageUnitPrice.ToString("C")</td></tr> }</tbody></table></div></div></section>

                <section class="tab-pane fade" id="finance" role="tabpanel"><div class="customer-finance-metrics"><article><small>EM ABERTO</small><strong>@Model.OutstandingAmount.ToString("C")</strong></article><article><small>VENCIDO</small><strong>@Model.OverdueAmount.ToString("C")</strong></article><article><small>CRÉDITO</small><strong>@(Model.Customer.CreditBlocked ? "Bloqueado" : "Disponível")</strong></article><article><small>PRAZO</small><strong>@(Model.Customer.MaximumPaymentTermDays ?? 0) dias</strong></article></div><div class="customer-detail-panel mt-3"><div class="customer-detail-panel-heading"><div><p class="eyebrow"><span></span> Recebíveis</p><h2>Histórico de pagamentos</h2></div></div>@if (!Model.Payments.Any()) { <p class="customer-commercial-empty">Nenhuma cobrança registrada.</p> } else { <div class="table-responsive"><table class="table customer-detail-table align-middle"><thead><tr><th>Pedido</th><th>Meio</th><th>Vencimento</th><th>Status</th><th class="text-end">Valor</th></tr></thead><tbody>@foreach (var payment in Model.Payments) { <tr><td><a asp-controller="Orders" asp-action="Details" asp-route-id="@payment.OrderId">#@payment.OrderId</a></td><td>@payment.PaymentMethod</td><td>@(payment.DueDate?.ToLocalTime().ToString("dd/MM/yyyy") ?? "À vista")</td><td>@payment.Status</td><td class="text-end"><strong>@payment.Amount.ToString("C")</strong></td></tr> }</tbody></table></div> }</div></section>

                <section class="tab-pane fade" id="prices" role="tabpanel"><div class="customer-detail-panel"><div class="customer-detail-panel-heading"><div><p class="eyebrow"><span></span> Comercial</p><h2>@(Model.Customer.PriceTable?.Name ?? "Tabela não atribuída")</h2></div><a asp-controller="PriceTables" asp-action="Items" asp-route-id="@Model.Customer.PriceTableId">Editar tabela</a></div><div class="table-responsive"><table class="table customer-detail-table align-middle"><thead><tr><th>Produto</th><th class="text-end">Preço da tabela</th><th class="text-end">Promocional</th></tr></thead><tbody>@foreach (var item in Model.PriceTableItems) { <tr><td>@item.Product?.Name</td><td class="text-end">@item.Price.ToString("C")</td><td class="text-end">@(item.PromotionalPrice?.ToString("C") ?? "-")</td></tr> }</tbody></table></div></div></section>

                <section class="tab-pane fade" id="addresses" role="tabpanel"><div class="customer-detail-grid">@foreach (var address in Model.Customer.Addresses) { <article class="customer-detail-panel"><p class="eyebrow"><span></span> @(address.IsPrimary ? "Principal" : address.Label)</p><h2>@address.Label</h2><p class="mb-0">@address.Street, @address.Number<br />@address.District - @address.City/@address.State<br />CEP @address.ZipCode</p></article> }</div></section>
                <section class="tab-pane fade" id="users" role="tabpanel"><div class="customer-detail-panel"><div class="customer-detail-panel-heading"><div><p class="eyebrow"><span></span> Identity</p><h2>Usuários vinculados</h2></div><a asp-controller="Users" asp-action="Index">Gerenciar usuários</a></div><div class="table-responsive"><table class="table customer-detail-table align-middle"><thead><tr><th>E-mail</th><th>Telefone</th><th>Perfil</th><th>Status</th></tr></thead><tbody>@foreach (var user in Model.Users) { <tr><td>@user.Email</td><td>@user.PhoneNumber</td><td>@user.Roles</td><td>@(user.IsActive ? "Ativo" : "Bloqueado")</td></tr> }</tbody></table></div></div></section>
                <section class="tab-pane fade" id="seller" role="tabpanel"><div class="customer-detail-panel"><p class="eyebrow"><span></span> Carteira</p><h2>@(Model.Customer.SalesRepresentative?.Name ?? "Vendedor não atribuído")</h2>@if (Model.Customer.SalesRepresentative is not null) { <dl><div><dt>E-mail</dt><dd>@Model.Customer.SalesRepresentative.Email</dd></div><div><dt>Telefone</dt><dd>@Model.Customer.SalesRepresentative.Phone</dd></div><div><dt>Região</dt><dd>@Model.Customer.SalesRepresentative.Region</dd></div><div><dt>Status</dt><dd>@(Model.Customer.SalesRepresentative.IsActive ? "Ativo" : "Inativo")</dd></div></dl> }</div></section>
                <section class="tab-pane fade" id="history" role="tabpanel"><div class="customer-detail-panel"><div class="customer-detail-panel-heading"><div><p class="eyebrow"><span></span> Auditoria operacional</p><h2>Histórico</h2></div></div><div class="customer-history-timeline">@foreach (var item in Model.Timeline) { <article><i class="fa-solid @item.Icon" aria-hidden="true"></i><div><strong>@item.Title</strong><span>@item.Description</span></div><time>@item.OccurredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</time></article> }</div></div></section>
            </div>
        </div>
    </div>
</section>