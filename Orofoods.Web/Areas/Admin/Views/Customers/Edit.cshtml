@model Orofoods.Web.ViewModels.AdminCustomerApprovalViewModel
@using Orofoods.Web.Models.Customers
@{
    var isPending = Model.Status == CustomerStatus.Pending;
    var pageTitle = isPending ? "Aprovar cadastro" : "Configurações comerciais";
    var statusLabel = Model.Status switch
    {
        CustomerStatus.Pending => "Aguardando aprovação",
        CustomerStatus.Approved => "Aprovado",
        CustomerStatus.Blocked => "Bloqueado",
        _ => "Inativo"
    };
    var statusIcon = Model.Status switch
    {
        CustomerStatus.Pending => "fa-clock",
        CustomerStatus.Approved => "fa-circle-check",
        _ => "fa-circle-exclamation"
    };
    ViewData["Title"] = pageTitle;
}

<section class="customer-approval-page">
    <div class="container customer-approval-container">
        <nav class="customer-approval-breadcrumb" aria-label="Navegação administrativa">
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="fa-solid fa-house" aria-hidden="true"></i> Administração</a>
            <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
            <a asp-action="Index">Clientes</a>
            <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
            <span>@pageTitle</span>
        </nav>

        <header class="customer-approval-hero">
            <div>
                <div class="eyebrow"><span></span> @(isPending ? "Aprovação de cadastro" : "Gestão comercial")</div>
                <h1>@pageTitle</h1>
                <p>@Model.TradeName <span>&bull;</span> @Model.LegalName <span>&bull;</span> @Model.Cnpj</p>
            </div>
            <div class="customer-status-panel">
                <small>Status atual</small>
                <strong class="@(isPending ? "is-pending" : "")"><i class="fa-solid @statusIcon" aria-hidden="true"></i> @statusLabel</strong>
            </div>
        </header>

        <form method="post" class="customer-approval-layout">
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>

            <div class="customer-approval-form">
                <section class="registration-card registration-card--full">
                    <header class="registration-card-heading"><span><i class="fa-solid fa-id-card" aria-hidden="true"></i></span><div><small>01. Identificação fiscal</small><h2>Cadastro do cliente</h2></div></header>
                    <div class="row g-3">
                        <div class="col-md-6">
                            @if (User.IsInRole("Administrador"))
                            {
                                <label asp-for="Cnpj" class="form-label">CNPJ</label>
                                <input asp-for="Cnpj" class="form-control" maxlength="18" autocomplete="off" aria-describedby="customer-cnpj-help" />
                                <span asp-validation-for="Cnpj" class="text-danger"></span>
                                <small id="customer-cnpj-help" class="customer-field-help">Aceita CNPJ numérico ou alfanumérico; a alteração exige justificativa.</small>
                            }
                            else
                            {
                                <label class="form-label">CNPJ</label>
                                <p class="form-control-plaintext mb-0">@Model.Cnpj</p>
                            }
                        </div>
                        @if (User.IsInRole("Administrador"))
                        {
                            <div class="col-md-6">
                                <label asp-for="CnpjChangeReason" class="form-label">Justificativa da alteração</label>
                                <textarea asp-for="CnpjChangeReason" class="form-control" rows="2" maxlength="1000"></textarea>
                                <span asp-validation-for="CnpjChangeReason" class="text-danger"></span>
                            </div>
                        }
                    </div>
                </section>

                <section class="registration-card">
                    <header class="registration-card-heading"><span><i class="fa-solid fa-circle-check" aria-hidden="true"></i></span><div><small>02. Situação comercial</small><h2>Acesso do cliente</h2></div></header>
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Status" class="form-label">Situação do cliente</label>
                            <select asp-for="Status" class="form-select"><option value="Pending">Pendente de aprovação</option><option value="Approved">Aprovado</option><option value="Blocked">Bloqueado</option><option value="Inactive">Inativo</option></select>
                        </div>
                    </div>
                    <p class="customer-approval-hint"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> @(isPending ? "Ao aprovar, o cliente passa a acessar o catálogo conforme as regras comerciais configuradas." : "A situação selecionada será aplicada ao salvar as configurações comerciais.")</p>
                </section>

                <section class="registration-card">
                    <header class="registration-card-heading"><span><i class="fa-solid fa-wallet" aria-hidden="true"></i></span><div><small>03. Limites comerciais</small><h2>Pedido e crédito</h2></div></header>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="MinimumOrder" class="form-label">Pedido mínimo</label>
                            <div class="input-group"><span class="input-group-text">R$</span><input asp-for="MinimumOrder" asp-format="{0:N2}" class="form-control" inputmode="decimal" /></div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CreditLimit" class="form-label">Limite de crédito</label>
                            <div class="input-group"><span class="input-group-text">R$</span><input asp-for="CreditLimit" asp-format="{0:N2}" class="form-control" inputmode="decimal" /></div>
                        </div>
                    </div>
                </section>

                <section class="registration-card registration-card--full">
                    <header class="registration-card-heading"><span><i class="fa-solid fa-tags" aria-hidden="true"></i></span><div><small>04. Tabela de preços e vendedor</small><h2>Condições comerciais</h2></div></header>
                    <div class="row g-3">
                        <div class="col-md-3"><label asp-for="PriceTableId" class="form-label">Tabela de preços</label><select asp-for="PriceTableId" class="form-select" asp-items="Model.PriceTables"><option value="">Selecione uma tabela</option></select></div>
                        <div class="col-md-3"><label asp-for="SalesRepresentativeId" class="form-label">Vendedor responsável</label><select asp-for="SalesRepresentativeId" class="form-select" asp-items="Model.SalesRepresentatives"><option value="">Selecione um vendedor</option></select></div>
                        <div class="col-md-3"><label asp-for="InternalSalesUserId" class="form-label">Atendimento interno</label><select asp-for="InternalSalesUserId" class="form-select" asp-items="Model.InternalSalesUsers"><option value="">Não atribuído</option></select></div>
                        <div class="col-md-3"><label asp-for="WmcCode" class="form-label">Código do cliente no WMC <em>Opcional</em></label><input asp-for="WmcCode" class="form-control" inputmode="numeric" placeholder="Ex.: 755066" /></div>
                    </div>
                </section>

                <section class="registration-card registration-card--full">
                    <header class="registration-card-heading"><span><i class="fa-solid fa-credit-card" aria-hidden="true"></i></span><div><small>05. Condições de pagamento</small><h2>Elegibilidade e prazos</h2></div></header>
                    <div class="customer-payment-layout">
                        <div class="customer-payment-indicators" aria-label="Indicadores de elegibilidade de pagamento">
                            <div class="customer-payment-indicator"><small>Compras válidas</small><strong>@Model.ValidPurchaseCount</strong></div>
                            <div class="customer-payment-indicator"><small>Condição atual</small><strong>@(Model.InvoiceCreditEnabled ? "Até 14 dias" : "À vista")</strong></div>
                            <div class="customer-payment-indicator"><small>Prazo máximo</small><strong>@Model.EffectiveMaximumPaymentTermDays dias</strong></div>
                            <div class="customer-payment-indicator"><small>Liberação</small><strong>@(Model.EffectiveCreditReleaseDate?.ToString("dd/MM/yyyy") ?? "Não liberado")</strong></div>
                        </div>
                        <div class="customer-payment-controls">
                            <div class="form-check"><input asp-for="CreditBlocked" class="form-check-input" /><label asp-for="CreditBlocked" class="form-check-label">Bloquear boleto a prazo</label></div>
                            <div class="form-check"><input asp-for="CreditOverrideEnabled" class="form-check-input" /><label asp-for="CreditOverrideEnabled" class="form-check-label">Definir prazo manualmente</label></div>
                            <div><label asp-for="MaximumPaymentTermDays" class="form-label">Prazo manual (dias)</label><input asp-for="MaximumPaymentTermDays" class="form-control" inputmode="numeric" max="14" /></div>
                        </div>
                        <div>
                            <fieldset class="customer-payment-terms">
                                <legend>Condições de pagamento</legend>
                                <div class="customer-payment-terms-grid">
                                    @foreach (var term in Model.PaymentTerms)
                                    {
                                        var termId = $"payment-term-{term.Value}";
                                        <label class="customer-payment-term" for="@termId">
                                            <input id="@termId" type="checkbox" name="PaymentTermIds" value="@term.Value" checked="@(term.Selected ? "checked" : null)" />
                                            <span>@term.Text</span>
                                        </label>
                                    }
                                </div>
                            </fieldset>
                            <small class="customer-field-help">Selecione uma ou mais condições disponíveis para este cliente.</small>
                        </div>
                        <div><label asp-for="CreditNotes" class="form-label">Observações de crédito</label><textarea asp-for="CreditNotes" class="form-control" rows="3"></textarea></div>
                    </div>
                </section>

                @if (isPending)
                {
                    <aside class="customer-approval-aside">
                        <div class="customer-approval-summary">
                            <span class="registration-aside-icon"><i class="fa-solid fa-user-check" aria-hidden="true"></i></span>
                            <p class="eyebrow"><span></span> Checklist</p>
                            <h2>Antes de liberar</h2>
                            <ul>
                                <li><i class="fa-solid fa-check" aria-hidden="true"></i> Cadastro conferido</li>
                                <li><i class="fa-solid fa-check" aria-hidden="true"></i> Tabela de preços definida</li>
                                <li><i class="fa-solid fa-check" aria-hidden="true"></i> Pagamento selecionado</li>
                            </ul>
                            <p>O código WMC pode ser informado depois, quando o cadastro for integrado ao ERP.</p>
                        </div>
                    </aside>
                }

                <footer class="registration-actions">
                    <a asp-action="Index" class="btn btn-outline-dark"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Voltar para clientes</a>
                    @if (isPending)
                    {
                        <button type="submit" name="approve" value="true" class="btn btn-gold"><i class="fa-solid fa-user-check" aria-hidden="true"></i> Aprovar cadastro</button>
                    }
                    else
                    {
                        <button type="submit" class="btn btn-gold"><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> Salvar alterações</button>
                    }
                </footer>
            </div>
        </form>
    </div>
</section>
