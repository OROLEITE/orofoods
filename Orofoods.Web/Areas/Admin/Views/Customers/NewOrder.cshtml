@model Orofoods.Web.ViewModels.AssistedOrderViewModel
@{ ViewData["Title"] = "Novo pedido"; }
<section class="section assisted-order-page admin-customer-new-order"><div class="container">
    <div class="portal-top assisted-order-header"><div><div class="eyebrow"><span></span> CRM comercial</div><h1>Novo pedido</h1><p>Cliente: <strong>@Model.CustomerName</strong> · Vendedor responsável: <strong>@Model.SalesRepresentativeName</strong> · <small>Atendido por: @User.Identity?.Name</small></p></div><a class="btn btn-sm btn-outline-dark" asp-action="Details" asp-route-id="@Model.CustomerId">Voltar ao cliente</a></div>
    <form method="get" class="catalog-tools assisted-order-search"><input type="hidden" name="id" value="@Model.CustomerId" /><input name="q" value="@Model.Query" placeholder="Código, nome ou marca" /><button class="btn admin-primary-action btn-search">Buscar</button></form>
    <form asp-action="NewOrder" method="post" class="assisted-order-form"><input type="hidden" asp-for="CustomerId" /><input type="hidden" asp-for="AttemptKey" /><input type="hidden" asp-for="Query" />@for (var i = 0; i < Math.Min(Model.ProductIds.Count, Model.Quantities.Count); i++) { <input type="hidden" name="ProductIds" value="@Model.ProductIds[i]" /><input type="hidden" name="Quantities" value="@Model.Quantities[i]" /> }<div asp-validation-summary="All" class="text-danger"></div><div id="assisted-client-error" class="text-danger" role="alert" tabindex="-1" hidden></div>@if (!Model.PaymentTerms.Any()) { <p class="text-danger" role="alert">Nenhuma condição de pagamento está disponível para este cliente.</p> }
        <div class="assisted-order-layout"><section class="admin-form-card"><h2>Produtos</h2><div class="assisted-product-list">@foreach (var product in Model.Products) { <article data-product-id="@product.Id" data-product-name="@product.Name" data-product-price="@product.UnitPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"><div class="assisted-product-info"><strong>@product.Name</strong><small>@product.Sku · @product.Unit · @product.UnitPrice.ToString("C") / @product.PriceUnitLabel</small></div><input type="number" min="@product.MinimumCases" value="@product.MinimumCases" aria-label="Quantidade de @product.Name" /><button type="button" class="btn btn-sm btn-outline-dark assisted-add-product">Adicionar</button></article> }</div><div id="assisted-order-lines" class="assisted-order-lines"><p class="text-muted">Nenhum produto adicionado.</p></div></section>
        <aside class="checkout-summary"><div class="summary-label">PEDIDO</div><h2>@Model.CustomerName</h2><div id="assisted-summary-items"></div><div class="summary-total"><span>Total</span><strong id="assisted-total">R$ 0,00</strong></div><div id="assisted-minimum-order" data-minimum-order="@Model.MinimumOrder.ToString(System.Globalization.CultureInfo.InvariantCulture)"><span>Pedido mínimo</span><strong>@Model.MinimumOrder.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))</strong><small id="assisted-minimum-gap" role="status" aria-live="polite">Faltam @Model.MinimumOrder.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("pt-BR")) para atingir o mínimo.</small></div><div class="assisted-order-fields"><label asp-for="AddressId">Endereço<select asp-for="AddressId">@foreach (var address in Model.Addresses) { <option value="@address.Id">@address.Label - @address.City</option> }</select></label><label asp-for="PaymentTermId">Condição de pagamento<select asp-for="PaymentTermId">@foreach (var term in Model.PaymentTerms) { <option value="@term.Id">@term.Name</option> }</select></label><label asp-for="RequestedDeliveryDate">Data de entrega<input asp-for="RequestedDeliveryDate" /></label><label asp-for="Notes">Observações<textarea asp-for="Notes" rows="3"></textarea></label></div><button type="submit" class="btn btn-gold w-100" id="assisted-submit">Confirmar pedido</button></aside></div>
    </form></div>
</section>
@section Scripts { <script src="~/js/assisted-order.js" asp-append-version="true"></script> }
