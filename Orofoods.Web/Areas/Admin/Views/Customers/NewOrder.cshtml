@model Orofoods.Web.ViewModels.AssistedOrderViewModel
@{
    ViewData["Title"] = "Novo pedido";
    var hasCustomer = Model.CustomerId > 0;
    var orderUrlTemplate = Url.Action("NewOrder", "Customers", new { area = "Admin", id = "__id__" });
    var searchUrl = Url.Action("SearchOrderCustomers", "Customers", new { area = "Admin" });
}

<section class="section assisted-order-page admin-customer-new-order">
    <div class="container">
        <header class="portal-top assisted-order-header">
            <div>
                <div class="eyebrow"><span></span> CRM comercial</div>
                <h1>Novo pedido</h1>
                @if (hasCustomer)
                {
                    <p>Cliente: <strong>@Model.CustomerName</strong> · Vendedor responsável: <strong>@Model.SalesRepresentativeName</strong> · Tabela: <strong>@Model.PriceTableName</strong> · <small>Atendido por: @User.Identity?.Name</small></p>
                }
                else
                {
                    <p>Selecione o cliente para carregar as condições comerciais autorizadas e iniciar a digitação.</p>
                }
            </div>
            @if (hasCustomer)
            {
                <a class="btn btn-sm btn-outline-dark" asp-action="Details" asp-route-id="@Model.CustomerId">Voltar ao cliente</a>
            }
        </header>

        <section class="assisted-customer-picker" data-assisted-customer-search
                 data-search-url="@searchUrl"
                 data-order-url-template="@orderUrlTemplate"
                 data-selected-customer-id="@Model.CustomerId"
                 data-selected-customer-name="@Model.CustomerName"
                 data-focus-product-search="@(hasCustomer && Model.ProductIds.Count == 0 ? "true" : "false")">
            <label for="assisted-customer-query">Cliente</label>
            <input id="assisted-customer-query" class="form-control"
                   value="@Model.CustomerName" autocomplete="off" spellcheck="false"
                   role="combobox" aria-autocomplete="list" aria-expanded="false"
                   aria-controls="assisted-customer-results" aria-describedby="assisted-customer-status"
                   placeholder="Nome, razão social, CNPJ ou código WMC"
                   data-assisted-customer-query />
            <div id="assisted-customer-results" class="assisted-customer-results" role="listbox"
                 aria-label="Clientes autorizados" data-assisted-customer-results></div>
            <button type="button" class="btn btn-sm btn-outline-dark assisted-customer-more"
                    data-assisted-customer-more hidden>Mostrar mais clientes</button>
            <div id="assisted-customer-status" class="assisted-customer-status" role="status" aria-live="polite"
                 data-assisted-customer-status>Digite pelo menos dois caracteres para pesquisar.</div>
        </section>

        @if (hasCustomer)
        {
            <form method="get" action="@Url.Action("NewOrder", "Customers", new { area = "Admin" })" class="catalog-tools assisted-order-search">
                <input type="hidden" name="id" value="@Model.CustomerId" />
                <label class="visually-hidden" for="assisted-product-search">Buscar produto por código WMC, código ou nome</label>
                <input id="assisted-product-search" name="q" value="@Model.Query" placeholder="Código WMC, código ou nome do produto" />
                <button class="btn admin-primary-action btn-search">Buscar produtos</button>
            </form>

            <form asp-action="NewOrder" method="post" class="assisted-order-form">
                <input type="hidden" asp-for="CustomerId" />
                <input type="hidden" asp-for="AttemptKey" />
                <input type="hidden" asp-for="Query" />
                @for (var i = 0; i < Math.Min(Model.ProductIds.Count, Model.Quantities.Count); i++)
                {
                    <input type="hidden" name="ProductIds" value="@Model.ProductIds[i]" />
                    <input type="hidden" name="Quantities" value="@Model.Quantities[i]" />
                }
                <div asp-validation-summary="All" class="text-danger"></div>
                <div id="assisted-client-error" class="text-danger" role="alert" tabindex="-1" hidden></div>
                @if (!Model.PaymentTerms.Any())
                {
                    <p class="text-danger" role="alert">Nenhuma condição de pagamento está disponível para este cliente.</p>
                }

                <div class="assisted-order-layout">
                    <section class="admin-form-card">
                        <h2>Produtos</h2>
                        <div class="assisted-product-list">
                            @foreach (var product in Model.Products)
                            {
                                <article data-product-id="@product.Id" data-product-name="@product.Name" data-product-price="@product.UnitPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                    <div class="assisted-product-info">
                                        <strong>@product.Name</strong>
                                        <small>@product.Sku · @product.Unit · @product.UnitPrice.ToString("C") / @product.PriceUnitLabel</small>
                                    </div>
                                    <input type="number" min="@product.MinimumCases" value="@product.MinimumCases" aria-label="Quantidade de @product.Name" />
                                    <button type="button" class="btn btn-sm btn-outline-dark assisted-add-product">Adicionar</button>
                                </article>
                            }
                        </div>
                        <div id="assisted-order-lines" class="assisted-order-lines"><p class="text-muted">Nenhum produto adicionado.</p></div>
                    </section>

                    <aside class="checkout-summary">
                        <div class="summary-label">PEDIDO</div>
                        <h2>@Model.CustomerName</h2>
                        <div id="assisted-summary-items"></div>
                        <div class="summary-total"><span>Total</span><strong id="assisted-total">R$ 0,00</strong></div>
                        <div id="assisted-minimum-order" data-minimum-order="@Model.MinimumOrder.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                            <span>Pedido mínimo</span>
                            <strong>@Model.MinimumOrder.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))</strong>
                            <small id="assisted-minimum-gap" role="status" aria-live="polite">Faltam @Model.MinimumOrder.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("pt-BR")) para atingir o mínimo.</small>
                        </div>
                        <div class="assisted-order-fields">
                            <label asp-for="AddressId">Endereço<select asp-for="AddressId">@foreach (var address in Model.Addresses) { <option value="@address.Id">@address.Label - @address.City</option> }</select></label>
                            <label asp-for="PaymentTermId">Condição de pagamento<select asp-for="PaymentTermId">@foreach (var term in Model.PaymentTerms) { <option value="@term.Id">@term.Name</option> }</select></label>
                            <label asp-for="RequestedDeliveryDate">Data de entrega<input asp-for="RequestedDeliveryDate" /></label>
                            <label asp-for="Notes">Observações<textarea asp-for="Notes" rows="3"></textarea></label>
                        </div>
                        <button type="submit" class="btn btn-gold w-100" id="assisted-submit">Confirmar pedido</button>
                    </aside>
                </div>
            </form>
        }
    </div>
</section>

@section Scripts {
    <script src="~/js/assisted-order-customer-search.js" asp-append-version="true"></script>
    @if (hasCustomer)
    {
        <script src="~/js/assisted-order.js" asp-append-version="true"></script>
    }
}
