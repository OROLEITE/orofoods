@model IReadOnlyList<Orofoods.Web.Models.Customers.Customer>
@using Orofoods.Web.Models.Customers
@{ ViewData["Title"] = "Clientes"; var pendingCustomers = Model.Count(customer => customer.Status == CustomerStatus.Pending); }
<section class="customer-list-page"><div class="container customer-list-container">
    <nav class="customer-approval-breadcrumb" aria-label="Navega&ccedil;&atilde;o administrativa"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="fa-solid fa-house" aria-hidden="true"></i> Administra&ccedil;&atilde;o</a><i class="fa-solid fa-chevron-right" aria-hidden="true"></i><span>Clientes</span></nav>
    <header class="customer-list-hero"><div><div class="eyebrow"><span></span> Gest&atilde;o comercial</div><h1>Clientes B2B</h1><p>Analise os novos cadastros e mantenha as condi&ccedil;&otilde;es comerciais de cada empresa.</p></div><div class="customer-list-pending"><i class="fa-solid fa-user-clock" aria-hidden="true"></i><div><small>Aguardando an&aacute;lise</small><strong>@pendingCustomers cadastro@(pendingCustomers == 1 ? string.Empty : "s")</strong></div></div></header>
    <section class="customer-list-panel"><header><div><small>BASE DE CLIENTES</small><h2>@Model.Count empresa@(Model.Count == 1 ? string.Empty : "s") cadastrada@(Model.Count == 1 ? string.Empty : "s")</h2></div><span><i class="fa-solid fa-circle-info" aria-hidden="true"></i> Abra o cliente para acompanhar a operação comercial.</span></header><div class="table-responsive"><table class="table customer-list-table align-middle"><thead><tr><th>Empresa</th><th>CNPJ</th><th>Situa&ccedil;&atilde;o</th><th>Tabela de pre&ccedil;os</th><th>Vendedor</th><th class="text-end">A&ccedil;&atilde;o</th></tr></thead><tbody>@foreach (var customer in Model) { var status = customer.Status switch { CustomerStatus.Pending => "Pendente", CustomerStatus.Approved => "Aprovado", CustomerStatus.Blocked => "Bloqueado", _ => "Inativo" }; <tr><td><strong>@customer.TradeName</strong><small>@customer.LegalName</small></td><td>@customer.Cnpj</td><td><span class="customer-status customer-status--@customer.Status.ToString().ToLowerInvariant()"><i class="fa-solid @(customer.Status == CustomerStatus.Pending ? "fa-clock" : customer.Status == CustomerStatus.Approved ? "fa-circle-check" : "fa-circle-minus")" aria-hidden="true"></i> @status</span></td><td>@customer.PriceTableName</td><td>@(customer.SalesRepresentative?.Name ?? "Não definido")</td><td class="text-end"><a asp-action="Details" asp-route-id="@customer.Id" class="btn btn-sm btn-gold">Abrir cliente</a> <a asp-action="Edit" asp-route-id="@customer.Id" class="btn btn-sm btn-outline-dark">Configurar</a></td></tr> }</tbody></table></div></section>
</div></section>
