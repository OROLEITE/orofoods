@model IReadOnlyList<Orofoods.Web.Models.Customers.Customer>
@using Orofoods.Web.Models.Customers
@using Orofoods.Web.Api
@{ ViewData["Title"] = "Clientes"; var pendingCustomers = (int)ViewBag.PendingCustomers; var paged = (PagedResult<Orofoods.Web.Models.Customers.Customer>)ViewBag.PagedResult; var sort = (string)ViewBag.Sort; var direction = (string)ViewBag.Direction; string NextDirection(string column) => sort == column && direction == "asc" ? "desc" : "asc"; }
<section class="customer-list-page"><div class="container customer-list-container">
    <nav class="customer-approval-breadcrumb" aria-label="Navega&ccedil;&atilde;o administrativa"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="fa-solid fa-house" aria-hidden="true"></i> Administra&ccedil;&atilde;o</a><i class="fa-solid fa-chevron-right" aria-hidden="true"></i><span>Clientes</span></nav>
    <header class="customer-list-hero"><div><div class="eyebrow"><span></span> Gest&atilde;o comercial</div><h1>Clientes B2B</h1><p>Analise novos cadastros e gerencie as condi&ccedil;&otilde;es comerciais de cada empresa.</p></div><div class="customer-list-pending"><i class="fa-solid fa-user-clock" aria-hidden="true"></i><div><small>Aguardando an&aacute;lise</small><strong>@pendingCustomers cadastro@(pendingCustomers == 1 ? string.Empty : "s")</strong></div></div></header>
    <form class="customer-list-tools"><input type="hidden" name="sort" value="@sort" /><input type="hidden" name="direction" value="@direction" /><div><label for="customerQuery">Empresa, CNPJ ou e-mail</label><div class="customer-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input id="customerQuery" name="q" value="@ViewBag.Query" class="form-control" placeholder="Empresa, CNPJ ou e-mail"/></div></div><div><label for="customerStatus">Situa&ccedil;&atilde;o</label><select id="customerStatus" name="status" class="form-select"><option value="">Todos os status</option>@foreach (var customerStatus in Enum.GetValues<CustomerStatus>()) { <option value="@customerStatus" selected="@(ViewBag.Status == customerStatus.ToString())">@customerStatus</option> }</select></div><button class="btn admin-primary-action customer-filter-submit">Filtrar</button></form>
    <section class="customer-list-panel"><header><div><small>BASE DE CLIENTES</small><h2>@paged.TotalItems empresa@(paged.TotalItems == 1 ? string.Empty : "s") cadastrada@(paged.TotalItems == 1 ? string.Empty : "s")</h2></div><span><i class="fa-solid fa-circle-info" aria-hidden="true"></i> Página @paged.Page de @paged.TotalPages</span></header><div class="table-responsive"><table class="table customer-list-table align-middle admin-mobile-table"><thead><tr><th><a asp-route-q="@ViewBag.Query" asp-route-status="@ViewBag.Status" asp-route-sort="customer" asp-route-direction="@NextDirection("customer")">Empresa</a></th><th><a asp-route-q="@ViewBag.Query" asp-route-status="@ViewBag.Status" asp-route-sort="cnpj" asp-route-direction="@NextDirection("cnpj")">CNPJ</a></th><th><a asp-route-q="@ViewBag.Query" asp-route-status="@ViewBag.Status" asp-route-sort="status" asp-route-direction="@NextDirection("status")">Situação</a></th><th>Tabela de preços</th><th><a asp-route-q="@ViewBag.Query" asp-route-status="@ViewBag.Status" asp-route-sort="seller" asp-route-direction="@NextDirection("seller")">Vendedor</a></th><th class="text-end">Ação</th></tr></thead><tbody>@foreach (var customer in Model) { var customerStatus = customer.Status switch { CustomerStatus.Pending => "Pendente", CustomerStatus.Approved => "Aprovado", CustomerStatus.Blocked => "Bloqueado", _ => "Inativo" }; <tr><td data-label="Empresa"><strong>@customer.TradeName</strong><small>@customer.LegalName</small></td><td data-label="CNPJ">@customer.Cnpj</td><td data-label="Situação"><span class="customer-status customer-status--@customer.Status.ToString().ToLowerInvariant()"><i class="fa-solid @(customer.Status == CustomerStatus.Pending ? "fa-clock" : customer.Status == CustomerStatus.Approved ? "fa-circle-check" : "fa-circle-minus")" aria-hidden="true"></i> @customerStatus</span></td><td data-label="Tabela de preços">@customer.PriceTableName</td><td data-label="Vendedor">@(customer.SalesRepresentative?.Name ?? "Não definido")</td><td data-label="Ação" class="text-end"><a asp-action="Details" asp-route-id="@customer.Id" class="btn btn-sm btn-gold">Abrir cliente</a> <a asp-action="Edit" asp-route-id="@customer.Id" class="btn btn-sm btn-outline-dark">Configurar</a></td></tr> }</tbody></table></div>@if (paged.TotalPages > 1) { <nav class="p-3" aria-label="Paginação dos clientes"><ul class="pagination justify-content-center mb-0"><li class="page-item @(paged.Page == 1 ? "disabled" : "")"><a class="page-link" asp-route-q="@ViewBag.Query" asp-route-status="@ViewBag.Status" asp-route-sort="@sort" asp-route-direction="@direction" asp-route-page="@(paged.Page - 1)">Anterior</a></li>@for (var currentPage = Math.Max(1, paged.Page - 2); currentPage <= Math.Min(paged.TotalPages, paged.Page + 2); currentPage++) { <li class="page-item @(currentPage == paged.Page ? "active" : "")"><a class="page-link" asp-route-q="@ViewBag.Query" asp-route-status="@ViewBag.Status" asp-route-sort="@sort" asp-route-direction="@direction" asp-route-page="@currentPage">@currentPage</a></li> }<li class="page-item @(paged.Page == paged.TotalPages ? "disabled" : "")"><a class="page-link" asp-route-q="@ViewBag.Query" asp-route-status="@ViewBag.Status" asp-route-sort="@sort" asp-route-direction="@direction" asp-route-page="@(paged.Page + 1)">Próxima</a></li></ul></nav> }</section>
</div></section>
