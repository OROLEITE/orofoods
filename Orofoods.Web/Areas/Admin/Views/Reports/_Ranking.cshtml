@model (string Title, List<Orofoods.Web.Services.Reports.ReportRankingRow> Rows, decimal Total)
@{
	var detail = Model.Title switch
	{
		"Produtos mais vendidos" => "PRODUTOS",
		"Clientes que mais compram" => "CLIENTES",
		"Vendas por vendedor" => "EQUIPE",
		_ => "DISTRIBUI&Ccedil;&Atilde;O"
	};
	var maximum = Model.Rows.Count == 0 ? 0 : Model.Rows.Max(row => row.Total);
	var quantityLabel = Model.Title == "Produtos mais vendidos" ? "itens" : "pedidos";
}
<article class="reports-panel report-ranking-card">
	<header><div><small>@Html.Raw(detail)</small><h2>@Model.Title</h2></div><span>Top @Model.Rows.Count</span></header>
	@if (!Model.Rows.Any())
	{
		<div class="reports-empty">Nenhum dado no per&iacute;odo.</div>
	}
	else
	{
		<ol class="report-ranking-list">
			@for (var index = 0; index < Model.Rows.Count; index++)
			{
				var row = Model.Rows[index];
				var width = maximum == 0 ? 0 : row.Total / maximum * 100;
				var share = Model.Total == 0 ? 0 : row.Total / Model.Total * 100;
				<li>
					<span class="report-ranking-position">@(index + 1)</span>
					<div class="report-ranking-data">
						<div><strong title="@row.Name">@row.Name</strong><span>@row.Total.ToString("C")</span></div>
						<div class="report-ranking-track" role="img" aria-label="@row.Name: @share.ToString("N1")% do total"><i class="report-ranking-bar" style="--ranking-width: @width.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></i></div>
						<small>@row.Quantity @quantityLabel &middot; @share.ToString("N1")%</small>
					</div>
				</li>
			}
		</ol>
	}
</article>
