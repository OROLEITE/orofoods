@model (string Title, List<Orofoods.Web.Services.Reports.ReportRankingRow> Rows)
@{ var detail = Model.Title switch { "Produtos mais vendidos" => ("fa-box", "Ranking por faturamento"), "Clientes que mais compram" => ("fa-building", "Clientes com maior volume de compras"), "Vendas por categoria" => ("fa-tags", "Resultado consolidado por categoria"), "Vendas por vendedor" => ("fa-user-tie", "Desempenho comercial por vendedor"), _ => ("fa-chart-column", "Resultado consolidado da opera&ccedil;&atilde;o") }; }
<div class="summary-card report-card"><header class="report-card-heading"><span class="report-card-icon"><i class="fa-solid @detail.Item1" aria-hidden="true"></i></span><div><h2>@Model.Title</h2><p>@Html.Raw(detail.Item2)</p></div></header>@if(!Model.Rows.Any()){<p>Nenhum dado no periodo.</p>}else{<table class="table"><thead><tr><th>Nome</th><th>Qtd.</th><th>Total</th></tr></thead><tbody>@foreach(var row in Model.Rows){<tr><td>@row.Name</td><td>@row.Quantity</td><td>@row.Total.ToString("C")</td></tr>}</tbody></table>}</div>
