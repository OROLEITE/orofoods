@model Orofoods.Web.ViewModels.AdminReportViewModel
@{ ViewData["Title"] = "Relatorios"; }
<section class="page-hero admin-page-hero admin-reports-hero"><div class="container"><div class="eyebrow light"><span></span> Intelig&ecirc;ncia comercial</div><h1>Relat&oacute;rios de vendas</h1><p>Acompanhe o desempenho comercial da Orofoods e identifique os principais resultados da opera&ccedil;&atilde;o.</p></div></section>
<section class="section admin-reports-page"><div class="container"><form method="get" class="row g-3 summary-card"><div class="col-md-2"><label>Data inicial</label><input type="date" name="dateFrom" value="@Model.Filter.DateFrom?.ToString("yyyy-MM-dd")" class="form-control"/></div><div class="col-md-2"><label>Data final</label><input type="date" name="dateTo" value="@Model.Filter.DateTo?.ToString("yyyy-MM-dd")" class="form-control"/></div><div class="col-md-2"><label>Cliente</label><select name="customerId" asp-items="ViewBag.Customers" class="form-select"><option value="">Todos</option></select></div><div class="col-md-2"><label>Produto</label><select name="productId" asp-items="ViewBag.Products" class="form-select"><option value="">Todos</option></select></div><div class="col-md-2"><label>Categoria</label><select name="categoryId" asp-items="ViewBag.Categories" class="form-select"><option value="">Todas</option></select></div><div class="col-md-2"><label>Vendedor</label><select name="salesRepresentativeId" asp-items="ViewBag.SalesRepresentatives" class="form-select"><option value="">Todos</option></select></div><div class="col-12"><button class="btn btn-gold">Aplicar filtros</button> <a class="btn btn-outline-dark" asp-action="Index">Limpar</a></div></form><div class="metric-grid mt-4"><article><small>PEDIDOS</small><strong>@Model.Report.OrderCount</strong></article><article><small>FATURAMENTO</small><strong>@Model.Report.Revenue.ToString("C")</strong></article><article><small>TICKET MEDIO</small><strong>@Model.Report.AverageTicket.ToString("C")</strong></article></div><div class="row g-4 mt-4 report-grid"><div class="col-lg-6">@await Html.PartialAsync("_Ranking", ("Produtos mais vendidos", Model.Report.TopProducts))</div><div class="col-lg-6">@await Html.PartialAsync("_Ranking", ("Clientes que mais compram", Model.Report.TopCustomers))</div><div class="col-lg-6">@await Html.PartialAsync("_Ranking", ("Vendas por categoria", Model.Report.ByCategory))</div><div class="col-lg-6">@await Html.PartialAsync("_Ranking", ("Vendas por vendedor", Model.Report.BySalesRepresentative))</div><div class="col-lg-6">@await Html.PartialAsync("_Ranking", ("Vendas por cidade", Model.Report.ByCity))</div><div class="col-lg-6"><div class="summary-card report-card"><header class="report-card-heading"><span class="report-card-icon"><i class="fa-solid fa-chart-pie" aria-hidden="true"></i></span><div><h2>Pedidos por status</h2><p>Distribui&ccedil;&atilde;o por etapa do pedido</p></div></header><table class="table"><thead><tr><th>Status</th><th>Pedidos</th><th>Total</th></tr></thead><tbody>@foreach(var row in Model.Report.ByStatus){<tr><td>@row.Status</td><td>@row.Orders</td><td>@row.Total.ToString("C")</td></tr>}</tbody></table></div></div></div></div></section>
