@model Orofoods.Web.Models.Pricing.PaymentTerm
@{ ViewData["Title"] = Model.Id == 0 ? "Nova condição" : "Editar condição"; }
<section class="admin-form-page admin-registration-form-page"><div class="container admin-form-container"><nav class="customer-approval-breadcrumb"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Administra&ccedil;&atilde;o</a><i class="fa-solid fa-chevron-right"></i><a asp-action="Index">Pagamentos</a></nav><header class="admin-form-hero"><div><div class="eyebrow"><span></span> Comercial</div><h1>@ViewData["Title"]</h1><p>Defina as condi&ccedil;&otilde;es liberadas aos clientes aprovados.</p></div><i class="fa-solid fa-credit-card"></i></header><form method="post" class="admin-form-card row g-3"><input asp-for="Id" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="col-md-8"><label asp-for="Name">Nome da condi&ccedil;&atilde;o</label><input asp-for="Name" class="form-control" placeholder="Ex.: PIX ou 14 dias"/></div><div class="col-md-4"><label asp-for="SortOrder">Ordem</label><input asp-for="SortOrder" class="form-control"/></div><div class="col-12 admin-check"><label><input asp-for="IsActive"/> Condi&ccedil;&atilde;o ativa</label></div><footer class="col-12 admin-form-actions"><a asp-action="Index" class="btn admin-secondary-action"><i class="fa-solid fa-arrow-left"></i> Voltar</a><button class="btn admin-primary-action"><i class="fa-solid fa-floppy-disk"></i> Salvar condi&ccedil;&atilde;o</button></footer></form></div></section>
