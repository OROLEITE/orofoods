@model IReadOnlyList<Orofoods.Web.Models.Pricing.PaymentTerm>
@{ ViewData["Title"] = "Pagamentos"; }
<section class="admin-registration-page"><header class="admin-page-header"><div><p class="eyebrow"><span></span> Comercial</p><h1>Condi&#231;&otilde;es de pagamento</h1><p>Defina as condi&#231;&otilde;es dispon&iacute;veis para negocia&#231;&atilde;o.</p></div><a class="btn admin-primary-action" asp-action="Edit"><i class="fa-solid fa-plus" aria-hidden="true"></i> Nova condi&#231;&atilde;o</a></header><div class="admin-table-card"><div class="table-responsive"><table class="table admin-table align-middle"><thead><tr><th>Ordem</th><th>Condi&#231;&atilde;o</th><th>Clientes</th><th>Status</th><th>A&#231;&otilde;es</th></tr></thead><tbody>@foreach(var item in Model){<tr><td class="admin-table-secondary" data-label="Ordem">@item.SortOrder</td><td class="admin-table-name" data-label="Condi&#231;&atilde;o"><strong>@item.Name</strong></td><td class="admin-table-products" data-label="Clientes"><span class="admin-count-badge">@item.CustomerPaymentTerms.Count</span></td><td class="admin-table-status" data-label="Status"><span class="status-badge @(item.IsActive ? "status-badge--active" : "status-badge--inactive")"><i aria-hidden="true"></i>@(item.IsActive ? "Ativa" : "Inativa")</span></td><td class="admin-table-actions" data-label="A&#231;&otilde;es"><a class="btn admin-edit-action" asp-action="Edit" asp-route-id="@item.Id"><i class="fa-solid fa-pen" aria-hidden="true"></i> Editar</a>@if(item.IsActive){<form asp-action="Deactivate" method="post"><input type="hidden" name="id" value="@item.Id"/><button class="btn admin-secondary-action admin-deactivate-action" type="submit">Desativar</button></form>}</td></tr>}</tbody></table></div></div></section>
