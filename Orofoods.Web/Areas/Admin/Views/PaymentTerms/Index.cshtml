@model IReadOnlyList<Orofoods.Web.Models.Pricing.PaymentTerm>
@{ ViewData["Title"] = "Pagamentos"; }
<section class="section"><div class="container"><div class="portal-top"><h1>Condi&#231;&otilde;es de pagamento</h1><a class="btn btn-gold" asp-action="Edit">Nova condi&#231;&atilde;o</a></div><div class="table-responsive mt-4"><table class="table table-dark table-striped"><thead><tr><th>Ordem</th><th>Condi&#231;&atilde;o</th><th>Clientes</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.SortOrder</td><td>@item.Name</td><td>@item.CustomerPaymentTerms.Count</td><td>@(item.IsActive ? "Ativa" : "Inativa")</td><td><a class="btn btn-sm btn-gold" asp-action="Edit" asp-route-id="@item.Id">Editar</a>@if(item.IsActive){<form asp-action="Deactivate" method="post" class="d-inline"><input type="hidden" name="id" value="@item.Id"/><button class="btn btn-sm btn-outline-light">Desativar</button></form>}</td></tr>}</tbody></table></div></div></section>
