@model IReadOnlyList<Orofoods.Web.Models.Customers.SalesRepresentative>
@{ ViewData["Title"] = "Vendedores"; }
<section class="section"><div class="container"><div class="portal-top"><h1>Vendedores</h1><a class="btn btn-gold" asp-action="Edit">Novo vendedor</a></div><div class="table-responsive mt-4"><table class="table table-dark table-striped admin-mobile-table"><thead><tr><th>Nome</th><th>Email</th><th>Telefone</th><th>Clientes</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var item in Model){<tr><td data-label="Nome">@item.Name</td><td data-label="Email">@item.Email</td><td data-label="Telefone">@item.Phone</td><td data-label="Clientes">@item.Customers.Count</td><td data-label="Status">@(item.IsActive ? "Ativo" : "Inativo")</td><td data-label="Ações"><a class="btn btn-sm btn-gold" asp-action="Edit" asp-route-id="@item.Id">Editar</a>@if(item.IsActive){<form asp-action="Deactivate" method="post" class="d-inline"><input type="hidden" name="id" value="@item.Id"/><button class="btn btn-sm btn-outline-light">Desativar</button></form>}</td></tr>}</tbody></table></div></div></section>
