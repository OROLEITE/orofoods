@model IReadOnlyList<Orofoods.Web.Models.Customers.SalesRepresentative>
@{ ViewData["Title"] = "Vendedores"; }
<section class="admin-registration-page"><header class="admin-page-header"><div><p class="eyebrow"><span></span> Equipe</p><h1>Vendedores</h1><p>Gerencie a equipe comercial e suas carteiras de clientes.</p></div><a class="btn admin-primary-action" asp-action="Edit"><i class="fa-solid fa-plus" aria-hidden="true"></i> Novo vendedor</a></header><div class="admin-table-card"><div class="table-responsive"><table class="table admin-table align-middle"><thead><tr><th>Nome</th><th>Email</th><th>Telefone</th><th>Clientes</th><th>Status</th><th>A&#231;&otilde;es</th></tr></thead><tbody>@foreach(var item in Model){<tr><td class="admin-table-name" data-label="Nome"><strong>@item.Name</strong></td><td data-label="Email">@item.Email</td><td data-label="Telefone">@item.Phone</td><td class="admin-table-products" data-label="Clientes"><span class="admin-count-badge">@item.Customers.Count</span></td><td class="admin-table-status" data-label="Status"><span class="status-badge @(item.IsActive ? "status-badge--active" : "status-badge--inactive")"><i aria-hidden="true"></i>@(item.IsActive ? "Ativo" : "Inativo")</span></td><td class="admin-table-actions" data-label="A&#231;&otilde;es"><a class="btn admin-edit-action" asp-action="Edit" asp-route-id="@item.Id"><i class="fa-solid fa-pen" aria-hidden="true"></i> Editar</a>@if(item.IsActive){<form asp-action="Deactivate" method="post"><input type="hidden" name="id" value="@item.Id"/><button class="btn admin-secondary-action admin-deactivate-action" type="submit">Desativar</button></form>}</td></tr>}</tbody></table></div></div></section>
