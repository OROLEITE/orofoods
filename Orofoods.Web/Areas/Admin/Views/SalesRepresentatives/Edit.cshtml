@model Orofoods.Web.Models.Customers.SalesRepresentative
@{ ViewData["Title"] = Model.Id == 0 ? "Novo vendedor" : "Editar vendedor"; }
<section class="admin-form-page"><div class="container admin-form-container"><nav class="customer-approval-breadcrumb"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Administra&ccedil;&atilde;o</a><i class="fa-solid fa-chevron-right"></i><a asp-action="Index">Vendedores</a></nav><header class="admin-form-hero"><div><div class="eyebrow"><span></span> Comercial</div><h1>@ViewData["Title"]</h1><p>Vincule o respons&aacute;vel comercial aos clientes da sua carteira.</p></div><i class="fa-solid fa-user-tie"></i></header><form method="post" class="admin-form-card row g-3"><input asp-for="Id" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="col-12"><label asp-for="Name">Nome completo</label><input asp-for="Name" class="form-control"/></div><div class="col-md-7"><label asp-for="Email">E-mail corporativo</label><input asp-for="Email" class="form-control" autocomplete="email"/></div><div class="col-md-5"><label asp-for="Phone">Telefone</label><input asp-for="Phone" class="form-control" inputmode="tel"/></div><div class="col-md-8"><label asp-for="Region">Regi&atilde;o de atendimento</label><input asp-for="Region" class="form-control" placeholder="Ex.: Campinas/SP"/><small class="form-text">Clientes da carteira ser&atilde;o exibidos somente quando estiverem nesta regi&atilde;o.</small></div><div class="col-md-4 admin-check"><label><input asp-for="IsActive"/> Vendedor ativo</label></div><footer class="col-12 admin-form-actions"><a asp-action="Index" class="btn btn-outline-dark"><i class="fa-solid fa-arrow-left"></i> Voltar</a><button class="btn btn-gold"><i class="fa-solid fa-floppy-disk"></i> Salvar vendedor</button></footer></form></div></section>
