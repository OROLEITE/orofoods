@model Orofoods.Web.Models.Catalog.ProductCategory
@{ ViewData["Title"] = Model.Id == 0 ? "Nova categoria" : "Editar categoria"; }
<section class="admin-form-page admin-registration-form-page"><div class="container admin-form-container"><nav class="customer-approval-breadcrumb"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Administra&ccedil;&atilde;o</a><i class="fa-solid fa-chevron-right"></i><a asp-action="Index">Categorias</a></nav><header class="admin-form-hero"><div><div class="eyebrow"><span></span> Cat&aacute;logo</div><h1>@ViewData["Title"]</h1><p>Organize os produtos do cat&aacute;logo por categorias comerciais.</p></div><i class="fa-solid fa-folder-tree"></i></header><form method="post" class="admin-form-card row g-3"><input asp-for="Id" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="col-md-7"><label asp-for="Name">Nome da categoria</label><input asp-for="Name" class="form-control"/></div><div class="col-md-5"><label asp-for="Slug">Identificador</label><input asp-for="Slug" class="form-control"/></div><div class="col-md-6"><label asp-for="SortOrder">Ordem de exibi&ccedil;&atilde;o</label><input asp-for="SortOrder" class="form-control"/></div><div class="col-md-6 admin-check"><label><input asp-for="IsActive"/> Categoria ativa</label></div><footer class="col-12 admin-form-actions"><a asp-action="Index" class="btn admin-secondary-action"><i class="fa-solid fa-arrow-left"></i> Voltar</a><button class="btn admin-primary-action"><i class="fa-solid fa-floppy-disk"></i> Salvar categoria</button></footer></form></div></section>
