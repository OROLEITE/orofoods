@model IReadOnlyList<Orofoods.Web.Models.Catalog.ProductCategory>
@{ ViewData["Title"] = "Categorias"; }
<section class="section"><div class="container"><div class="portal-top"><h1>Categorias</h1><a class="btn btn-gold" asp-action="Edit">Nova categoria</a></div><div class="table-responsive mt-4"><table class="table table-dark table-striped admin-mobile-table"><thead><tr><th>Ordem</th><th>Nome</th><th>Slug</th><th>Produtos</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var item in Model) { <tr><td data-label="Ordem">@item.SortOrder</td><td data-label="Nome">@item.Name</td><td data-label="Slug">@item.Slug</td><td data-label="Produtos">@item.Products.Count</td><td data-label="Status">@(item.IsActive ? "Ativa" : "Inativa")</td><td data-label="Ações" class="text-end"><a class="btn btn-sm btn-gold" asp-action="Edit" asp-route-id="@item.Id">Editar</a>@if(item.IsActive){<form asp-action="Deactivate" method="post" class="d-inline"><input type="hidden" name="id" value="@item.Id"/><button class="btn btn-sm btn-outline-light">Desativar</button></form>}</td></tr> }</tbody></table></div></div></section>
