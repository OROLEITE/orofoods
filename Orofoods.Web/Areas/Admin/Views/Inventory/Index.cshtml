@model IReadOnlyList<Orofoods.Web.Areas.Admin.Controllers.InventoryRow>
@{ ViewData["Title"] = "Estoque"; }
<section class="admin-registration-page admin-inventory-page"><div class="container"><div class="admin-page-header"><div><div class="eyebrow"><span></span> Opera&ccedil;&atilde;o</div><h1>Estoque</h1><p>Controle o saldo em caixas e mantenha as reservas de pedidos protegidas.</p></div><a class="btn admin-secondary-action" asp-controller="Dashboard"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Voltar ao painel</a></div>
@if (TempData["InventoryError"] is string error) { <div class="alert alert-danger mt-4">@error</div> }
<div class="admin-table-card"><div class="table-responsive"><table class="table admin-table admin-inventory-table align-middle"><thead><tr><th>SKU</th><th>Produto</th><th>F&iacute;sico</th><th>Reservado</th><th>Dispon&iacute;vel</th><th>Ajustar saldo</th></tr></thead><tbody>@foreach (var row in Model) { <tr><td class="admin-table-secondary" data-label="SKU">@row.Sku</td><td class="admin-table-name" data-label="Produto"><strong>@row.ProductName</strong></td><td data-label="F&iacute;sico">@row.QuantityOnHand</td><td data-label="Reservado">@row.QuantityReserved</td><td data-label="Dispon&iacute;vel"><span class="admin-count-badge">@row.AvailableQuantity</span></td><td class="admin-table-actions" data-label="Ajustar saldo"><form asp-action="Adjust" method="post" class="admin-inventory-adjustment"><input type="hidden" name="productId" value="@row.ProductId"/><input class="form-control form-control-sm" type="number" min="@row.QuantityReserved" name="quantityOnHand" value="@row.QuantityOnHand" aria-label="Saldo fisico"/><input class="form-control form-control-sm" name="reason" maxlength="300" placeholder="Motivo" required aria-label="Motivo do ajuste"/><button class="btn admin-edit-action" type="submit"><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> Salvar</button></form></td></tr> }</tbody></table></div></div></div></section>
