@model IReadOnlyList<Orofoods.Web.Areas.Admin.Controllers.InventoryRow>
@{ ViewData["Title"] = "Estoque"; }
<section class="section"><div class="container"><div class="portal-top"><div><div class="eyebrow"><span></span> Operacao</div><h1>Estoque</h1><p>Controle o saldo em caixas e mantenha as reservas de pedidos protegidas.</p></div><a class="btn btn-outline-dark" asp-controller="Dashboard">Voltar ao painel</a></div>
@if (TempData["InventoryError"] is string error) { <div class="alert alert-danger mt-4">@error</div> }
<div class="table-responsive mt-4"><table class="table table-dark table-striped align-middle admin-mobile-table"><thead><tr><th>SKU</th><th>Produto</th><th>Fisico</th><th>Reservado</th><th>Disponivel</th><th>Ajustar saldo</th></tr></thead><tbody>@foreach (var row in Model) { <tr><td data-label="SKU">@row.Sku</td><td data-label="Produto">@row.ProductName</td><td data-label="Físico">@row.QuantityOnHand</td><td data-label="Reservado">@row.QuantityReserved</td><td data-label="Disponível">@row.AvailableQuantity</td><td data-label="Ajustar saldo"><form asp-action="Adjust" method="post" class="d-flex gap-2"><input type="hidden" name="productId" value="@row.ProductId"/><input class="form-control form-control-sm" type="number" min="@row.QuantityReserved" name="quantityOnHand" value="@row.QuantityOnHand" aria-label="Saldo fisico"/><input class="form-control form-control-sm" name="reason" maxlength="300" placeholder="Motivo" required aria-label="Motivo do ajuste"/><button class="btn btn-sm btn-gold" type="submit">Salvar</button></form></td></tr> }</tbody></table></div></div></section>
