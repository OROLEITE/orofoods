@model IReadOnlyList<Orofoods.Web.Models.Catalog.Product>
@{ ViewData["Title"] = "Produtos"; }
<section class="admin-registration-page admin-products-page"><div class="container"><div class="admin-page-header"><div><div class="eyebrow"><span></span> Cat&aacute;logo</div><h1>Produtos</h1><p>Gerencie o cat&aacute;logo, pre&ccedil;os e disponibilidade dos produtos.</p></div><a class="btn admin-primary-action" asp-action="Edit"><i class="fa-solid fa-plus" aria-hidden="true"></i> Novo produto</a></div><form class="catalog-tools admin-list-tools"><input name="q" value="@ViewBag.Query" placeholder="Nome, SKU ou marca"/><label><input type="checkbox" name="includeInactive" value="true" checked="@ViewBag.IncludeInactive"/> Mostrar inativos</label><button class="btn admin-secondary-action">Filtrar</button></form><div class="admin-table-card"><div class="table-responsive"><table class="table admin-table admin-products-table align-middle"><thead><tr><th></th><th>SKU</th><th>Produto</th><th>Categoria</th><th>Pre&#231;o base</th><th>Estoque</th><th>A&#231;&otilde;es</th></tr></thead><tbody>@foreach (var product in Model) { var image = product.Images.OrderByDescending(item => item.IsPrimary).ThenBy(item => item.SortOrder).FirstOrDefault(); <tr><td data-label="Imagem">@if(image is not null){<img class="admin-product-thumb" src="@Url.RouteUrl("ProductMedia", new { imageId = image.Id })" alt="@image.AltText"/>}</td><td class="admin-table-secondary" data-label="SKU">@product.Sku</td><td class="admin-table-name" data-label="Produto"><strong>@product.Name</strong><br/><small>@product.Brand</small></td><td data-label="Categoria">@product.ProductCategory?.Name</td><td data-label="Pre&#231;o base">@product.BasePrice.ToString("C")</td><td class="admin-table-status" data-label="Estoque"><span class="status-badge @(product.IsAvailable ? "status-badge--active" : "status-badge--inactive")"><i aria-hidden="true"></i>@(product.IsAvailable ? "Dispon&iacute;vel" : "Indispon&iacute;vel")</span></td><td class="admin-table-actions" data-label="A&#231;&otilde;es"><a class="btn admin-edit-action" asp-action="Edit" asp-route-id="@product.Id"><i class="fa-solid fa-pen" aria-hidden="true"></i> Editar</a>@if (product.IsActive) { <form asp-action="Deactivate" method="post"><input type="hidden" name="id" value="@product.Id"/><button class="btn admin-secondary-action admin-deactivate-action" type="submit">Desativar</button></form> }</td></tr> }</tbody></table></div></div></div></section>
