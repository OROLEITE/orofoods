@model IReadOnlyList<Orofoods.Web.Models.Catalog.Product>
@{ ViewData["Title"] = "Produtos"; }
<section class="section"><div class="container"><div class="portal-top"><div><div class="eyebrow"><span></span> Administra&ccedil;&atilde;o</div><h1>Produtos</h1></div><a class="btn btn-gold" asp-action="Edit">Novo produto</a></div><form class="catalog-tools admin-list-tools mt-4"><input name="q" value="@ViewBag.Query" placeholder="Nome, SKU ou marca"/><label><input type="checkbox" name="includeInactive" value="true" checked="@ViewBag.IncludeInactive"/> Mostrar inativos</label><button class="btn btn-dark">Filtrar</button></form><div class="table-responsive"><table class="table table-dark table-striped align-middle admin-mobile-table"><thead><tr><th></th><th>SKU</th><th>Produto</th><th>Categoria</th><th>Pre&ccedil;o base</th><th>Estoque</th><th></th></tr></thead><tbody>@foreach (var product in Model) { var image = product.Images.OrderByDescending(item => item.IsPrimary).ThenBy(item => item.SortOrder).FirstOrDefault(); <tr><td data-label="Imagem">@if(image is not null){<img class="admin-product-thumb" src="@image.Url" alt="@image.AltText"/>}</td><td data-label="SKU">@product.Sku</td><td data-label="Produto">@product.Name<br/><small>@product.Brand</small></td><td data-label="Categoria">@product.ProductCategory?.Name</td><td data-label="Preço base">@product.BasePrice.ToString("C")</td><td data-label="Estoque">@(product.IsAvailable ? "Disponível" : "Indisponível")</td><td data-label="Ações" class="text-end"><a class="btn btn-sm btn-gold" asp-action="Edit" asp-route-id="@product.Id">Editar</a>@if (product.IsActive) { <form asp-action="Deactivate" method="post" class="d-inline"><input type="hidden" name="id" value="@product.Id"/><button class="btn btn-sm btn-outline-light">Desativar</button></form> }</td></tr> }</tbody></table></div></div></section>
