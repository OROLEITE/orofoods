@model IReadOnlyList<Orofoods.Web.Models.Catalog.Product>
@{
    ViewData["Title"] = "Produtos";
    var stockByProductId = ViewData["StockByProductId"] as IReadOnlyDictionary<int, int> ?? new Dictionary<int, int>();
}

<section class="admin-registration-page admin-products-page">
    <div class="container">
        @if (TempData["ProductSuccess"] is string success)
        {
            <div class="alert alert-success admin-product-feedback" role="status">@success</div>
        }
        @if (TempData["ProductError"] is string error)
        {
            <div class="alert alert-danger admin-product-feedback" role="alert">@error</div>
        }

        <div class="admin-page-header">
            <div>
                <div class="eyebrow"><span></span> Catálogo</div>
                <h1>Produtos</h1>
                <p>Gerencie o catálogo, preços e disponibilidade dos produtos.</p>
            </div>
            <a class="btn admin-primary-action" asp-action="Edit"
               asp-route-q="@ViewBag.Query" asp-route-includeInactive="@ViewBag.IncludeInactive" asp-route-page="@ViewBag.Page">
                <i class="fa-solid fa-plus" aria-hidden="true"></i> Novo produto
            </a>
        </div>

        <form class="catalog-tools admin-list-tools" asp-action="Index" method="get">
            <input name="q" value="@ViewBag.Query" placeholder="Nome, SKU ou marca" />
            <label><input type="checkbox" name="includeInactive" value="true" checked="@(ViewBag.IncludeInactive == true)" /> Mostrar inativos</label>
            <button class="btn admin-secondary-action btn-search" type="submit">Filtrar</button>
        </form>

        <div class="admin-table-card">
            <div class="table-responsive">
                <table class="table table-sm admin-table admin-products-table admin-mobile-table align-middle">
                    <thead>
                        <tr>
                            <th></th>
                            <th>SKU</th>
                            <th>Produto</th>
                            <th>Categoria</th>
                            <th>Preço base</th>
                            <th>Estoque</th>
                            <th>Disponibilidade</th>
                            <th>Status</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Model)
                        {
                            var image = product.Images.OrderByDescending(item => item.IsPrimary).ThenBy(item => item.SortOrder).FirstOrDefault();
                            var stockQuantity = stockByProductId.TryGetValue(product.Id, out var quantity) ? quantity : 0;
                            <tr>
                                <td data-label="Imagem">
                                    @if (image is not null)
                                    {
                                        <img class="admin-product-thumb" src="@Url.RouteUrl("ProductMedia", new { imageId = image.Id })" alt="@image.AltText" />
                                    }
                                </td>
                                <td class="admin-table-secondary" data-label="SKU">@product.Sku</td>
                                <td class="admin-table-name" data-label="Produto"><strong>@product.Name</strong><br /><small>@product.Brand</small></td>
                                <td data-label="Categoria">@product.ProductCategory?.Name</td>
                                <td data-label="Preço base">@product.BasePrice.ToString("C")</td>
                                <td class="admin-product-stock" data-label="Estoque"><span class="admin-product-stock-quantity">@stockQuantity</span> <span class="admin-product-stock-unit">@product.PriceUnitLabel</span></td>
                                <td class="admin-table-status" data-label="Disponibilidade">
                                    <span class="status-badge @(product.IsAvailable ? "status-badge--active" : "status-badge--inactive")"><i aria-hidden="true"></i>@(product.IsAvailable ? "Disponível" : "Indisponível")</span>
                                </td>
                                <td class="admin-table-status" data-label="Status">
                                    <span class="status-badge @(product.IsActive ? "status-badge--active" : "status-badge--inactive")"><i aria-hidden="true"></i>@(product.IsActive ? "Ativo" : "Inativo")</span>
                                </td>
                                <td class="admin-table-actions" data-label="Ações">
                                    <div class="admin-product-actions">
                                    <a class="btn admin-edit-action" asp-action="Edit" asp-route-id="@product.Id"
                                       asp-route-q="@ViewBag.Query" asp-route-includeInactive="@ViewBag.IncludeInactive" asp-route-page="@ViewBag.Page">
                                        <i class="fa-solid fa-pen" aria-hidden="true"></i> Editar
                                    </a>
                                    @if (product.IsActive)
                                    {
                                        <form asp-action="Deactivate" method="post">
                                            <input type="hidden" name="id" value="@product.Id" />
                                            <input type="hidden" name="q" value="@ViewBag.Query" />
                                            <input type="hidden" name="includeInactive" value="@ViewBag.IncludeInactive" />
                                            <input type="hidden" name="page" value="@ViewBag.Page" />
                                            <button class="btn admin-secondary-action admin-deactivate-action" type="submit">Desativar</button>
                                        </form>
                                    }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
