@model Orofoods.Web.Models.Catalog.Product
@{ ViewData["Title"] = Model.Id == 0 ? "Novo produto" : "Editar produto"; }
<section class="admin-form-page admin-products-edit-page admin-registration-form-page"><div class="container admin-products-edit-container">
    <nav class="customer-approval-breadcrumb"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Administra&ccedil;&atilde;o</a><i class="fa-solid fa-chevron-right"></i><a asp-action="Index" asp-route-q="@ViewBag.Query" asp-route-includeInactive="@ViewBag.IncludeInactive" asp-route-page="@ViewBag.Page">Produtos</a></nav>
    <header class="admin-form-hero"><div><div class="eyebrow"><span></span> Cat&aacute;logo</div><h1>@ViewData["Title"]</h1><p>Cadastre a apresenta&ccedil;&atilde;o comercial e a disponibilidade do produto.</p></div><i class="fa-solid fa-box-open"></i></header>
    @if (Model.Id != 0) { <section class="admin-image-manager mb-4"><div class="eyebrow"><span></span> Galeria do produto</div><h2>Fotos e imagem de capa</h2>@if(TempData["ImageError"] is string error){<p class="text-danger">@error</p>}<form asp-action="UploadImage" method="post" enctype="multipart/form-data" class="row g-3 mt-2"><input type="hidden" name="productId" value="@Model.Id"/><div class="col-md-5"><label class="visually-hidden" for="image">Arquivo da foto</label><input id="image" class="form-control" name="image" type="file" accept="image/png,image/jpeg,image/webp" required/></div><div class="col-md-5"><label class="visually-hidden" for="altText">Descri&ccedil;&atilde;o da foto</label><input id="altText" class="form-control" name="altText" placeholder="Descri&ccedil;&atilde;o da foto"/></div><div class="col-md-2"><button class="btn admin-primary-action w-100">Enviar foto</button></div></form><div class="admin-image-grid mt-4">@foreach(var image in Model.Images.OrderByDescending(item => item.IsPrimary).ThenBy(item => item.SortOrder)){<article><img src="@Url.RouteUrl("ProductMedia", new { imageId = image.Id })" alt="@image.AltText"/><div><small>@(image.IsPrimary ? "CAPA" : "GALERIA")</small><form asp-action="SetPrimaryImage" method="post"><input type="hidden" name="productId" value="@Model.Id"/><input type="hidden" name="imageId" value="@image.Id"/><button class="btn btn-sm btn-outline-dark" disabled="@image.IsPrimary">Usar como capa</button></form><form asp-action="RemoveImage" method="post"><input type="hidden" name="productId" value="@Model.Id"/><input type="hidden" name="imageId" value="@image.Id"/><button class="btn btn-sm btn-outline-danger">Remover</button></form></div></article>}</div></section> }
    <form method="post" class="admin-form-card row g-3"><input asp-for="Id" type="hidden"/><input type="hidden" name="q" value="@ViewBag.Query"/><input type="hidden" name="includeInactive" value="@ViewBag.IncludeInactive"/><input type="hidden" name="page" value="@ViewBag.Page"/><div asp-validation-summary="All" class="text-danger"></div><div class="col-md-4"><label asp-for="Sku">SKU</label><input asp-for="Sku" class="form-control"/></div><div class="col-md-4"><label asp-for="WmcCode">C&oacute;digo WMC <em>Opcional</em></label><input asp-for="WmcCode" class="form-control" inputmode="numeric" placeholder="C&oacute;digo no WMC"/></div><div class="col-md-4"><label asp-for="Brand">Marca</label><input asp-for="Brand" class="form-control"/></div><div class="col-md-8"><label asp-for="Name">Nome do produto</label><input asp-for="Name" class="form-control"/></div><div class="col-md-4"><label asp-for="ProductCategoryId">Categoria</label><select asp-for="ProductCategoryId" asp-items="ViewBag.Categories" class="form-select"></select></div><div class="col-12"><label asp-for="Description">Descri&ccedil;&atilde;o comercial</label><textarea asp-for="Description" class="form-control" rows="4"></textarea></div><div class="col-md-3"><label asp-for="BasePrice">Pre&ccedil;o base</label><input asp-for="BasePrice" class="form-control" inputmode="decimal"/></div><div class="col-md-3"><label asp-for="PromotionalPrice">Pre&ccedil;o promocional</label><input asp-for="PromotionalPrice" class="form-control" inputmode="decimal"/></div><div class="col-md-3"><label asp-for="UnitsPerCase">Unidades por caixa (cadastro legado)</label><input asp-for="UnitsPerCase" class="form-control" inputmode="numeric"/></div><div class="col-md-3"><label asp-for="MinimumCases">M&iacute;nimo legado de caixas</label><input asp-for="MinimumCases" class="form-control" inputmode="numeric"/></div><div class="col-12"><h2 class="h5 mb-0">Unidade comercial e identifica&ccedil;&atilde;o de pacotes</h2><p class="text-muted small mb-0">Campos vazios preservam o cadastro legado. Preencha PCT/CX e o fator apenas com dados confirmados.</p></div><div class="col-md-3"><label asp-for="Ean13">EAN-13 do pacote</label><input asp-for="Ean13" class="form-control" inputmode="numeric" maxlength="13"/></div><div class="col-md-3"><label asp-for="Dun14">DUN-14 da caixa</label><input asp-for="Dun14" class="form-control" inputmode="numeric" maxlength="14"/></div><div class="col-md-2"><label asp-for="CommercialUnitCode">Unidade comercial</label><select asp-for="CommercialUnitCode" class="form-select"><option value="">Legado / não definido</option><option value="PCT">PCT</option></select></div><div class="col-md-2"><label asp-for="LogisticsUnitCode">Unidade log&iacute;stica</label><select asp-for="LogisticsUnitCode" class="form-select"><option value="">N&atilde;o definida</option><option value="CX">CX</option></select></div><div class="col-md-2"><label asp-for="PackagesPerCase">Pacotes por caixa</label><input asp-for="PackagesPerCase" class="form-control" inputmode="numeric" min="1"/></div><div class="col-md-8"><label asp-for="SubstituteProductId">Produto substituto <em>Opcional</em></label><select asp-for="SubstituteProductId" asp-items="ViewBag.Substitutes" class="form-select"><option value="">Nenhum</option></select></div><div class="col-md-4"><label asp-for="Accent">Cor de destaque</label><input asp-for="Accent" type="color" class="form-control form-control-color"/></div><div class="col-12 admin-check flex-wrap gap-4"><label><input asp-for="IsActive"/> Produto ativo</label><label><input asp-for="IsAvailable"/> Dispon&iacute;vel para venda</label><label><input asp-for="IsFeatured"/> Produto em destaque</label><label><input asp-for="IsPromotional"/> Em promo&ccedil;&atilde;o</label></div><footer class="col-12 admin-form-actions"><a asp-action="Index" asp-route-q="@ViewBag.Query" asp-route-includeInactive="@ViewBag.IncludeInactive" asp-route-page="@ViewBag.Page" class="btn admin-secondary-action"><i class="fa-solid fa-arrow-left"></i> Voltar</a><button class="btn admin-primary-action"><i class="fa-solid fa-floppy-disk"></i> Salvar produto</button></footer></form>
</div></section>
