@model Orofoods.Web.Models.Catalog.Product
@{ ViewData["Title"] = Model.Id == 0 ? "Novo produto" : "Editar produto"; }
<section class="admin-form-page"><div class="container" style="max-width:900px">
    <nav class="customer-approval-breadcrumb"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Administra&ccedil;&atilde;o</a><i class="fa-solid fa-chevron-right"></i><a asp-action="Index">Produtos</a></nav>
    <header class="admin-form-hero"><div><div class="eyebrow"><span></span> Cat&aacute;logo</div><h1>@ViewData["Title"]</h1><p>Cadastre a apresenta&ccedil;&atilde;o comercial e a disponibilidade do produto.</p></div><i class="fa-solid fa-box-open"></i></header>
    @if (Model.Id != 0) { <section class="admin-image-manager mb-4"><div class="eyebrow"><span></span> Galeria do produto</div><h2>Fotos e imagem de capa</h2>@if(TempData["ImageError"] is string error){<p class="text-danger">@error</p>}<form asp-action="UploadImage" method="post" enctype="multipart/form-data" class="row g-3 mt-2"><input type="hidden" name="productId" value="@Model.Id"/><div class="col-md-5"><label class="visually-hidden" for="image">Arquivo da foto</label><input id="image" class="form-control" name="image" type="file" accept="image/png,image/jpeg,image/webp" required/></div><div class="col-md-5"><label class="visually-hidden" for="altText">Descri&ccedil;&atilde;o da foto</label><input id="altText" class="form-control" name="altText" placeholder="Descri&ccedil;&atilde;o da foto"/></div><div class="col-md-2"><button class="btn admin-primary-action w-100">Enviar foto</button></div></form><div class="admin-image-grid mt-4">@foreach(var image in Model.Images.OrderByDescending(item => item.IsPrimary).ThenBy(item => item.SortOrder)){<article><img src="@Url.RouteUrl("ProductMedia", new { imageId = image.Id })" alt="@image.AltText"/><div><small>@(image.IsPrimary ? "CAPA" : "GALERIA")</small><form asp-action="SetPrimaryImage" method="post"><input type="hidden" name="productId" value="@Model.Id"/><input type="hidden" name="imageId" value="@image.Id"/><button class="btn btn-sm btn-outline-dark" disabled="@image.IsPrimary">Usar como capa</button></form><form asp-action="RemoveImage" method="post"><input type="hidden" name="productId" value="@Model.Id"/><input type="hidden" name="imageId" value="@image.Id"/><button class="btn btn-sm btn-outline-danger">Remover</button></form></div></article>}</div></section> }
    <form method="post" class="admin-form-card row g-3"><input asp-for="Id" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="col-md-4"><label asp-for="Sku">SKU</label><input asp-for="Sku" class="form-control"/></div><div class="col-md-4"><label asp-for="WmcCode">C&oacute;digo WMC <em>Opcional</em></label><input asp-for="WmcCode" class="form-control" inputmode="numeric" placeholder="C&oacute;digo no WMC"/></div><div class="col-md-4"><label asp-for="Brand">Marca</label><input asp-for="Brand" class="form-control"/></div><div class="col-md-8"><label asp-for="Name">Nome do produto</label><input asp-for="Name" class="form-control"/></div><div class="col-md-4"><label asp-for="ProductCategoryId">Categoria</label><select asp-for="ProductCategoryId" asp-items="ViewBag.Categories" class="form-select"></select></div><div class="col-12"><label asp-for="Description">Descri&ccedil;&atilde;o comercial</label><textarea asp-for="Description" class="form-control" rows="4"></textarea></div><div class="col-md-3"><label asp-for="BasePrice">Pre&ccedil;o base</label><input asp-for="BasePrice" class="form-control" inputmode="decimal"/></div><div class="col-md-3"><label asp-for="PromotionalPrice">Pre&ccedil;o promocional</label><input asp-for="PromotionalPrice" class="form-control" inputmode="decimal"/></div><div class="col-md-3"><label asp-for="UnitsPerCase">Unidades por caixa</label><input asp-for="UnitsPerCase" class="form-control" inputmode="numeric"/></div><div class="col-md-3"><label asp-for="MinimumCases">M&iacute;nimo de caixas</label><input asp-for="MinimumCases" class="form-control" inputmode="numeric"/></div><div class="col-md-8"><label asp-for="SubstituteProductId">Produto substituto <em>Opcional</em></label><select asp-for="SubstituteProductId" asp-items="ViewBag.Substitutes" class="form-select"><option value="">Nenhum</option></select></div><div class="col-md-4"><label asp-for="Accent">Cor de destaque</label><input asp-for="Accent" type="color" class="form-control form-control-color"/></div><div class="col-12 admin-check flex-wrap gap-4"><label><input asp-for="IsActive"/> Produto ativo</label><label><input asp-for="IsAvailable"/> Dispon&iacute;vel para venda</label><label><input asp-for="IsFeatured"/> Produto em destaque</label><label><input asp-for="IsPromotional"/> Em promo&ccedil;&atilde;o</label></div><footer class="col-12 admin-form-actions"><a asp-action="Index" class="btn btn-outline-dark"><i class="fa-solid fa-arrow-left"></i> Voltar</a><button class="btn btn-gold"><i class="fa-solid fa-floppy-disk"></i> Salvar produto</button></footer></form>
</div></section>
