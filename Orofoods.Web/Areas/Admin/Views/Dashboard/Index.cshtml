@model Orofoods.Web.ViewModels.AdminDashboardViewModel
@using Orofoods.Web.Models
@* Administra&#231;&#227;o Orofoods *@
@{ ViewData["Title"] = "Administra&ccedil;&atilde;o Orofoods"; }
<section class="admin-dashboard-page">
    <header class="admin-dashboard-hero"><div class="container"><div><div class="eyebrow light"><span></span> Gest&atilde;o interna</div><h1>Central de controle<br />Orofoods</h1><p>Priorize cadastros, pedidos, estoque e integra&ccedil;&otilde;es em uma &uacute;nica vis&atilde;o.</p><div class="admin-dashboard-actions"><a class="btn btn-gold" asp-area="Admin" asp-controller="Commercial"><i class="fa-solid fa-headset"></i> Dashboard comercial</a><a class="btn btn-outline-light" asp-controller="Customers"><i class="fa-solid fa-user-check"></i> Aprovar clientes <b>@Model.PendingCustomers</b></a><a class="btn btn-outline-light" asp-controller="Orders"><i class="fa-solid fa-receipt"></i> Ver pedidos</a></div></div><aside><small>RESUMO DO DIA</small><strong>@Model.OrdersToday pedidos</strong><span>@Model.PendingOrders aguardando tratamento</span></aside></div></header>
    <div class="container admin-dashboard-content">
        <section><header class="admin-dashboard-section-head"><div><p class="eyebrow"><span></span> Prioridades</p><h2>O que exige aten&ccedil;&atilde;o agora</h2></div><span>Atualiza conforme as opera&ccedil;&otilde;es s&atilde;o registradas.</span></header><div class="admin-priority-grid"><a asp-controller="Customers" class="admin-priority-card admin-priority-card--gold"><i class="fa-solid fa-user-clock"></i><small>CADASTROS PENDENTES</small><strong>@Model.PendingCustomers</strong><span>Revisar e liberar acesso <i class="fa-solid fa-arrow-right"></i></span></a><a asp-controller="Orders" class="admin-priority-card"><i class="fa-solid fa-box-open"></i><small>PEDIDOS PENDENTES</small><strong>@Model.PendingOrders</strong><span>Conferir separa&ccedil;&atilde;o e entrega <i class="fa-solid fa-arrow-right"></i></span></a><a asp-controller="Inventory" class="admin-priority-card"><i class="fa-solid fa-triangle-exclamation"></i><small>ESTOQUE CR&Iacute;TICO</small><strong>@Model.LowStockProducts</strong><span>Ajustar saldo dispon&iacute;vel <i class="fa-solid fa-arrow-right"></i></span></a><a asp-controller="Integrations" asp-route-status="Failed" class="admin-priority-card"><i class="fa-solid fa-arrows-rotate"></i><small>FALHAS DE INTEGRA&Ccedil;&Atilde;O</small><strong>@(Model.FailedIntegrations + Model.FailedWmcExports)</strong><span>Consultar fila do ERP <i class="fa-solid fa-arrow-right"></i></span></a></div></section>
        <section class="admin-dashboard-split"><div><header class="admin-dashboard-section-head"><div><p class="eyebrow"><span></span> Vis&atilde;o comercial</p><h2>Resultado e base ativa</h2></div><a asp-controller="Reports">Abrir relat&oacute;rios <i class="fa-solid fa-arrow-up-right-from-square"></i></a></header><div class="admin-commercial-metrics"><article><i class="fa-solid fa-chart-line"></i><small>FATURAMENTO DO M&Ecirc;S</small><strong>@Model.MonthRevenue.ToString("C")</strong><span>Pedidos n&atilde;o cancelados</span></article><article><i class="fa-solid fa-receipt"></i><small>T&Iacute;QUETE M&Eacute;DIO</small><strong>@Model.AverageTicket.ToString("C")</strong><span>Base hist&oacute;rica de pedidos</span></article><article><i class="fa-solid fa-building"></i><small>CLIENTES ATIVOS</small><strong>@Model.ActiveCustomers</strong><span>Empresas com acesso liberado</span></article></div></div><aside class="admin-shortcuts"><p class="eyebrow"><span></span> Atalhos de gest&atilde;o</p><a asp-controller="Products"><i class="fa-solid fa-box"></i><span><b>Produtos</b><small>Cat&aacute;logo e fotos</small></span><i class="fa-solid fa-chevron-right"></i></a><a asp-controller="PriceTables"><i class="fa-solid fa-tags"></i><span><b>Tabelas de pre&ccedil;o</b><small>Condi&ccedil;&otilde;es comerciais</small></span><i class="fa-solid fa-chevron-right"></i></a><a asp-controller="SalesRepresentatives"><i class="fa-solid fa-user-tie"></i><span><b>Vendedores</b><small>Carteira de clientes</small></span><i class="fa-solid fa-chevron-right"></i></a><a asp-controller="Users"><i class="fa-solid fa-users-gear"></i><span><b>Usu&aacute;rios</b><small>Acessos e perfis</small></span><i class="fa-solid fa-chevron-right"></i></a></aside></section>
        <section class="admin-recent-orders"><header class="admin-dashboard-section-head"><div><p class="eyebrow"><span></span> Acompanhamento</p><h2>Pedidos recentes</h2></div><a class="btn btn-outline-dark" asp-controller="Orders">Todos os pedidos <i class="fa-solid fa-arrow-right"></i></a></header>@if (!Model.RecentOrders.Any()) { <div class="empty-state"><h3>Nenhum pedido registrado.</h3></div> } else { <div class="table-responsive"><table class="table admin-orders-table align-middle"><thead><tr><th>Pedido</th><th>Cliente</th><th>Situa&ccedil;&atilde;o</th><th>Total</th><th>Registrado em</th><th></th></tr></thead><tbody>@foreach (var order in Model.RecentOrders) { <tr><td><strong>@order.Number</strong></td><td>@order.Customer?.TradeName</td><td><span class="admin-order-status">@order.Status.ToDisplayName()</span></td><td><strong>@order.Total.ToString("C")</strong></td><td>@order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td class="text-end"><a asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id" aria-label="Abrir @order.Number"><i class="fa-solid fa-arrow-right"></i></a></td></tr> }</tbody></table></div> }</section>
    </div>
</section>
