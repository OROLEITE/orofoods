@model Orofoods.Web.Areas.Admin.Controllers.CrmOpportunityFormViewModel
@{ ViewData["Title"] = "Nova oportunidade"; }
<section class="section"><div class="container admin-form-container"><div class="portal-top"><div><div class="eyebrow"><span></span> CRM comercial</div><h1>Nova oportunidade</h1></div></div><form method="post" class="admin-form-card row g-3"><input asp-for="CustomerId" type="hidden" /><input asp-for="Source" type="hidden" /><div class="col-12"><label asp-for="Title" class="form-label">Título</label><input asp-for="Title" class="form-control" required /></div><div class="col-md-6"><label asp-for="Type" class="form-label">Tipo</label><select asp-for="Type" asp-items="Html.GetEnumSelectList<Orofoods.Web.Models.Commercial.CrmOpportunityType>()" class="form-select"></select></div><div class="col-md-6"><label asp-for="EstimatedValue" class="form-label">Valor estimado</label><input asp-for="EstimatedValue" class="form-control" inputmode="decimal" /></div><div class="col-md-6"><label asp-for="ExpectedCloseAt" class="form-label">Data prevista</label><input asp-for="ExpectedCloseAt" class="form-control" type="date" /></div><div class="col-12"><label asp-for="Notes" class="form-label">Observações</label><textarea asp-for="Notes" class="form-control" rows="4"></textarea></div><footer class="registration-actions"><a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId" class="btn btn-outline-dark">Cancelar</a><button class="btn btn-gold">Criar oportunidade</button></footer></form></div></section>
