@model IReadOnlyList<Orofoods.Web.Models.Commercial.CrmOpportunity>
@{ ViewData["Title"] = "Oportunidades"; }
<section class="section"><div class="container"><div class="portal-top"><div><div class="eyebrow"><span></span> CRM comercial</div><h1>Oportunidades</h1></div><a class="btn btn-gold" asp-action="Create" asp-route-customerId="@(Context.Request.Query["customerId"])">Nova oportunidade</a></div><div class="customer-opportunity-list mt-4">@foreach (var opportunity in Model) { <article><div><strong>@opportunity.Customer.TradeName</strong><small>@opportunity.Title · @opportunity.Type</small></div><span>@opportunity.Stage</span><strong>@(opportunity.EstimatedValue?.ToString("C") ?? "-")</strong><form asp-action="ChangeStage" method="post"><input type="hidden" name="id" value="@opportunity.Id" /><select name="stage"><option value="@opportunity.Stage">@opportunity.Stage</option><option value="Won">Ganha</option><option value="Lost">Perdida</option></select><button class="btn btn-sm btn-outline-dark">Atualizar</button></form></article> }</div></div></section>
