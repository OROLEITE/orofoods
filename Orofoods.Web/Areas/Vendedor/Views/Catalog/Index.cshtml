@model SellerCatalogViewModel
@{
    ViewData["Title"] = $"Catálogo · {Model.CustomerName}";
    ViewData["BodyClass"] = "seller-area-page";
}

<section class="section">
    <div class="container seller-catalog-container">
        <nav class="mb-3" aria-label="Navegação do vendedor"><a asp-area="Vendedor" asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId">Workspace</a><span class="text-muted"> / Catálogo</span></nav>
        <header class="seller-catalog-header">
            <div class="seller-catalog-heading">
                <span class="eyebrow"><span></span> Venda assistida</span>
                <h1>Catálogo</h1>
                <div class="seller-catalog-customer">@Model.CustomerName</div>
            </div>
        </header>

        <form method="get" class="seller-catalog-search" role="search">
            <div><label class="visually-hidden" for="catalog-search">Buscar produto</label><input id="catalog-search" class="form-control" name="q" value="@Model.Query" placeholder="Buscar por nome, descrição ou código" /></div>
            <button class="btn btn-outline-dark btn-search" type="submit"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> Buscar</button>
        </form>

        <div class="row g-4 seller-product-grid">
            @foreach (var product in Model.Products)
            {
                var catalogImage = Orofoods.Web.Services.Catalog.BimboProductImageCatalog.Find(product.WmcCode);
                <div class="col-sm-6 col-xl-4">
                    <article class="summary-card seller-product-card h-100 d-flex flex-column">
                        @if (product.ImageId is not null || catalogImage is not null)
                        {
                            <div class="seller-product-image-wrapper" style="--bimbo-image-scale:@(product.ImageId is null ? catalogImage?.VisualScale ?? 1m : 1m)"><img class="seller-product-image" data-product-image="true" data-fallback-stage="@(product.ImageId is null ? "catalog" : "manual")" data-catalog-fallback="@(catalogImage?.ImageUrl ?? string.Empty)" data-catalog-scale="@(catalogImage?.VisualScale ?? 1m)" data-placeholder-src="@Url.Content("~/images/products/product-photo-unavailable.svg")" src="@(product.ImageId is int selectedImageId ? $"/media/products/{selectedImageId}" : catalogImage!.ImageUrl)" alt="@product.Name" loading="lazy" /></div>
                        }
                        else { <div class="seller-product-image-wrapper seller-product-image-wrapper--empty"><img class="seller-product-image" src="~/images/products/product-photo-unavailable.svg" alt="Foto do produto indispon&iacute;vel" loading="lazy" /></div> }
                        <small>@product.Sku</small>
                        <h2 class="h5 seller-product-name">@product.Name</h2>
                        <p class="text-muted small seller-product-description">@product.Description</p>
                        @if (product.UnitPrice > 0m)
                        {
                            <p class="seller-product-price mb-0">@product.UnitPrice.ToString("C") / @product.PriceUnitLabel</p>
                        }
                        else
                        {
                            <p class="alert alert-warning" role="status">Pre&ccedil;o indispon&iacute;vel para este cliente.</p>
                        }
                        <p class="seller-product-unit">@product.UnitDescription</p>
                        @if (product.UnitPrice > 0m)
                        {
                            <a class="btn btn-gold seller-add-button" asp-area="Vendedor" asp-controller="OrderDrafts" asp-action="New" asp-route-customerId="@Model.CustomerId" asp-route-productId="@product.Id">Comprar</a>
                        }
                    </article>
                </div>
            }
        </div>
        @if (Model.Products.Count == 0)
        {
            <p class="text-muted mt-4">Nenhum produto disponível para este cliente.</p>
        }
    </div>
</section>
@section Scripts { <script src="~/js/product-image-fallback.js" asp-append-version="true"></script> }
