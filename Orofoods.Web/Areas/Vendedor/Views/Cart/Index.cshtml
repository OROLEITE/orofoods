@model Orofoods.Web.ViewModels.CartViewModel
@{
    var customerId = (int)ViewBag.CustomerId;
    ViewData["Title"] = "Carrinho";
    ViewData["BodyClass"] = "seller-area-page";
}

<section class="section">
    <div class="container">
        <nav class="mb-3" aria-label="Navegação do vendedor"><a asp-area="Vendedor" asp-controller="Catalog" asp-action="Index" asp-route-customerId="@customerId">Catálogo</a><span class="text-muted"> / Carrinho</span></nav>
        <header class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
            <div><span class="eyebrow"><span></span> Venda assistida</span><h1>Carrinho</h1><p class="text-muted mb-0">Itens isolados para o cliente selecionado.</p></div>
            <a class="btn btn-outline-dark" asp-area="Vendedor" asp-controller="Catalog" asp-action="Index" asp-route-customerId="@customerId"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Continuar catálogo</a>
        </header>

        @if (TempData["SellerCartError"] is string error)
        {
            <div class="alert alert-warning" role="alert">@error</div>
        }
        @if (Model.Items.Count == 0)
        {
            <div class="summary-card"><p class="mb-3">Seu carrinho está vazio.</p><a class="btn btn-gold" asp-area="Vendedor" asp-controller="Catalog" asp-action="Index" asp-route-customerId="@customerId">Ver catálogo</a></div>
        }
        else
        {
            <div class="row g-4">
                <div class="col-lg-8">
                    @foreach (var item in Model.Items)
                    {
                        <article class="summary-card seller-cart-line mb-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
                            <div><small>@item.Sku</small><h2 class="h5 mb-1">@item.Name</h2><span class="text-muted">@item.UnitPrice.ToString("C") · @item.UnitDescription</span></div>
                            <div class="d-flex align-items-end gap-2"><form asp-area="Vendedor" asp-controller="Cart" asp-action="Update" asp-route-customerId="@customerId" method="post" class="d-flex gap-2 align-items-end">@Html.AntiForgeryToken()<input type="hidden" name="productId" value="@item.ProductId" /><div><label class="form-label small mb-1" for="cart-quantity-@item.ProductId">Qtd.</label><div class="seller-stepper"><button type="button" class="btn btn-outline-dark" data-stepper="decrease" aria-label="Diminuir quantidade">−</button><input id="cart-quantity-@item.ProductId" class="form-control" type="number" name="quantity" min="@item.MinimumCases" value="@item.Quantity" /><button type="button" class="btn btn-outline-dark" data-stepper="increase" aria-label="Aumentar quantidade">+</button></div></div><button class="btn btn-outline-dark" type="submit" aria-label="Atualizar @item.Name"><i class="fa-solid fa-rotate" aria-hidden="true"></i></button></form><form asp-area="Vendedor" asp-controller="Cart" asp-action="Remove" asp-route-customerId="@customerId" method="post">@Html.AntiForgeryToken()<input type="hidden" name="productId" value="@item.ProductId" /><button class="btn btn-outline-danger" type="submit" aria-label="Remover @item.Name"><i class="fa-solid fa-trash" aria-hidden="true"></i></button></form></div>
                        </article>
                    }
                </div>
                <div class="col-lg-4"><aside class="summary-card"><small>RESUMO</small><div class="d-flex justify-content-between mt-3"><span>Subtotal</span><strong>@Model.Subtotal.ToString("C")</strong></div><div class="d-flex justify-content-between mt-2"><span>Total</span><strong>@Model.Total.ToString("C")</strong></div><p class="text-muted small mt-3 mb-0">A finalização do pedido será adicionada em uma próxima etapa.</p></aside></div>
            </div>
        }
    </div>
</section>
@section Scripts { <script src="~/js/seller-cart.js" asp-append-version="true"></script> }