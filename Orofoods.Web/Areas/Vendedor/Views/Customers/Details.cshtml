@model SellerCustomerWorkspaceViewModel
@{
    ViewData["Title"] = Model.Customer.Name;
    ViewData["BodyClass"] = "seller-area-page";
}

<section class="section">
    <div class="container">
        <nav class="mb-3" aria-label="Navegação do vendedor"><a asp-area="Vendedor" asp-controller="Customers" asp-action="Index">Minha carteira</a><span class="text-muted"> / Workspace</span></nav>
        <header class="seller-customer-header d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
            <div>
                <span class="eyebrow"><span></span> Cliente selecionado</span>
                <h1>@Model.Customer.Name</h1>
                <p class="text-muted mb-0">@Model.Customer.Code · @Model.Customer.City</p>
            </div>
            <span class="seller-customer-status">@Model.Customer.Status</span>
        </header>

        <div class="row g-3">
            <div class="col-md-6">
                <article class="summary-card seller-customer-card h-100">
                    <small>VENDEDOR RESPONSÁVEL</small>
                    <h2 class="h5 mt-2">@Model.SalesRepresentativeName</h2>
                    <p class="seller-customer-card__status mb-0">Situação: @Model.Customer.Status</p>
                </article>
            </div>
            <div class="col-md-6">
                <article class="summary-card seller-customer-card h-100">
                    <small>CONDIÇÕES DISPONÍVEIS</small>
                    @if (Model.PaymentTerms.Count == 0)
                    {
                        <p class="text-muted mt-2 mb-0">Condições a definir.</p>
                    }
                    else
                    {
                        <ul class="mb-0 mt-2">@foreach (var term in Model.PaymentTerms) { <li>@term</li> }</ul>
                    }
                </article>
            </div>
        </div>

        <div class="seller-customer-actions d-flex flex-wrap gap-2 mt-4">
            <a class="seller-button seller-button--primary" asp-area="Vendedor" asp-controller="OrderDrafts" asp-action="New" asp-route-customerId="@Model.Customer.Id"><i class="fa-solid fa-pen-to-square" aria-hidden="true"></i> Digitar pedido</a>
            <a class="seller-button seller-button--secondary" asp-area="Vendedor" asp-controller="OrderDrafts" asp-action="Index"><i class="fa-regular fa-file-lines" aria-hidden="true"></i> Meus rascunhos</a>
            <a class="seller-button seller-button--secondary" asp-area="Vendedor" asp-controller="Orders" asp-action="Index" asp-route-customerId="@Model.Customer.Id"><i class="fa-solid fa-receipt" aria-hidden="true"></i> Pedidos</a>
        </div>
    </div>
</section>
