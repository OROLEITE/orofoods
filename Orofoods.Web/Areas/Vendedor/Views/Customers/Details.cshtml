@model SellerCustomerWorkspaceViewModel
@{
    ViewData["Title"] = Model.Customer.Name;
    ViewData["BodyClass"] = "seller-area-page";
}

<section class="section">
    <div class="container">
        <nav class="mb-3" aria-label="Navegação do vendedor"><a asp-area="Vendedor" asp-controller="Customers" asp-action="Index">Minha carteira</a><span class="text-muted"> / Workspace</span></nav>
        <header class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
            <div>
                <span class="eyebrow"><span></span> Cliente selecionado</span>
                <h1>@Model.Customer.Name</h1>
                <p class="text-muted mb-0">@Model.Customer.Code · @Model.Customer.City</p>
            </div>
            <span class="badge text-bg-success">@Model.Customer.Status</span>
        </header>

        <div class="row g-3">
            <div class="col-md-6">
                <article class="summary-card h-100">
                    <small>VENDEDOR RESPONSÁVEL</small>
                    <h2 class="h5 mt-2">@Model.SalesRepresentativeName</h2>
                    <p class="text-muted mb-0">Cliente ativo e aprovado.</p>
                </article>
            </div>
            <div class="col-md-6">
                <article class="summary-card h-100">
                    <small>CONDIÇÕES DISPONÍVEIS</small>
                    @if (Model.PaymentTerms.Count == 0)
                    {
                        <p class="text-muted mt-2 mb-0">Condições a definir.</p>
                    }
                    else
                    {
                        <ul class="mb-0 mt-2">@foreach (var term in Model.PaymentTerms) { <li>@term</li> }</ul>
                    }
                </article>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2 mt-4">
            <a class="btn btn-gold" asp-area="Vendedor" asp-controller="Catalog" asp-action="Index" asp-route-customerId="@Model.Customer.Id"><i class="fa-solid fa-box-open" aria-hidden="true"></i> Ver catálogo</a>
            <a class="btn btn-outline-dark" asp-area="Vendedor" asp-controller="Cart" asp-action="Index" asp-route-customerId="@Model.Customer.Id"><i class="fa-solid fa-cart-shopping" aria-hidden="true"></i> Carrinho</a>
            <a class="btn btn-outline-dark" asp-area="Vendedor" asp-controller="Orders" asp-action="Index" asp-route-customerId="@Model.Customer.Id"><i class="fa-solid fa-receipt" aria-hidden="true"></i> Pedidos</a>
        </div>
    </div>
</section>