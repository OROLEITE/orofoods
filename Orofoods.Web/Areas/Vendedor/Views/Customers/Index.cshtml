@model SellerCustomerListViewModel
@{
    ViewData["Title"] = "Minha carteira";
    ViewData["BodyClass"] = "seller-area-page";
}

<section class="section">
    <div class="container">
        <header class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
            <div>
                <span class="eyebrow"><span></span> Operação comercial</span>
                <h1>Minha carteira</h1>
                <p class="text-muted mb-0">Clientes ativos e aprovados vinculados a você.</p>
            </div>
            <a class="btn btn-outline-dark" asp-area="Vendedor" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
        </header>

        <form method="get" class="customer-search customer-search--wallet mb-4" role="search"
              data-customer-search data-search-url="/Vendedor/Clientes/Buscar" data-search-mode="cards"
              data-link-url-template="/Vendedor/Clientes/__id__" data-server-rendered-query="@Model.Query">
            <label for="customer-search">Buscar por nome, razão social, CNPJ ou código WMC</label>
            <div class="customer-search__form-row">
                <input id="customer-search" class="form-control seller-customer-search" type="search" name="q" value="@Model.Query"
                       maxlength="100" autocomplete="organization" placeholder="Buscar por nome, razão social, CNPJ ou código WMC"
                       aria-autocomplete="list" aria-controls="customer-search-results" data-customer-search-input />
                <button class="btn btn-gold btn-search" type="submit"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> Buscar</button>
            </div>
            <div class="customer-search__results customer-search__cards row g-3" id="customer-search-results" role="list"
                 aria-label="Clientes da carteira" data-customer-search-results>
                @foreach (var customer in Model.Customers)
                {
                    <article class="col-md-6 col-xl-4">
                        <a class="customer-search__card summary-card h-100" asp-area="Vendedor" asp-controller="Customers" asp-action="Details" asp-route-id="@customer.Id">
                            <small>@customer.Code</small>
                            <h2 class="h5 mt-2">@customer.Name</h2>
                            <p class="mb-0">@customer.City · @customer.Status</p>
                            <span class="customer-search__card-action">Abrir workspace <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
                        </a>
                    </article>
                }
            </div>
            <div class="customer-search__status" role="status" aria-live="polite" data-customer-search-status>
                @if (string.IsNullOrWhiteSpace(Model.Query))
                {
                    <span>Digite pelo menos um caractere para pesquisar sua carteira.</span>
                }
                else if (Model.Customers.Count == 0)
                {
                    <span>Nenhum cliente autorizado encontrado.</span>
                }
                else
                {
                    <span>@Model.Customers.Count cliente(s) encontrado(s).</span>
                }
            </div>
        </form>
    </div>
</section>

@section Head {
    <link rel="stylesheet" href="~/css/customer-search.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/customer-search.js" asp-append-version="true"></script>
}
