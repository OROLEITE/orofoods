@model Orofoods.Web.ViewModels.SellerCheckoutViewModel
@{
    ViewData["Title"] = "Checkout · " + Model.CustomerName;
    ViewData["BodyClass"] = "seller-area-page seller-checkout-page";
}

<section class="section">
    <div class="container seller-checkout-container">
        <nav class="mb-3" aria-label="Navegação do vendedor"><a asp-area="Vendedor" asp-controller="Cart" asp-action="Index" asp-route-customerId="@Model.CustomerId">Carrinho</a><span class="text-muted"> / Checkout</span></nav>
        <header class="seller-checkout-header mb-4">
            <div><span class="eyebrow"><span></span> Venda assistida</span><h1>Confirmar pedido</h1><p class="text-muted mb-0">Revise o pedido antes de confirmar.</p></div>
            <div class="seller-checkout-customer"><small>CLIENTE</small><strong>@Model.CustomerName</strong><span>@Model.CustomerCode</span></div>
        </header>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-warning" role="alert">@Model.ErrorMessage</div>
        }
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <form asp-area="Vendedor" asp-controller="Checkout" asp-action="Index" asp-route-customerId="@Model.CustomerId" method="post" id="checkoutForm" data-cart-total="@Model.Cart.Total.ToString(System.Globalization.CultureInfo.InvariantCulture)">
            @Html.AntiForgeryToken()
            <input asp-for="AttemptKey" type="hidden" />
            <input asp-for="CardToken" type="hidden" id="CardToken" />
            <input asp-for="CardPaymentMethodId" type="hidden" id="CardPaymentMethodId" />
            <input asp-for="CardInstallments" type="hidden" id="CardInstallments" />
            <div class="row g-4">
                <div class="col-lg-7">
                    <article class="summary-card seller-checkout-panel">
                        <div class="seller-checkout-panel-heading"><div><small>PEDIDO</small><h2>Itens selecionados</h2></div><span>@Model.Cart.Items.Sum(item => item.Quantity) itens</span></div>
                        @foreach (var item in Model.Cart.Items)
                        {
                            <div class="seller-checkout-item"><div><strong>@item.Name</strong><small>@item.Quantity × @item.UnitPrice.ToString("C")</small></div><strong>@item.Subtotal.ToString("C")</strong></div>
                        }
                        <div class="seller-checkout-total"><span>Total</span><strong>@Model.Cart.Total.ToString("C")</strong></div>
                    </article>
                </div>
                <div class="col-lg-5">
                    <article class="summary-card seller-checkout-panel">
                        <small>ENTREGA E PAGAMENTO</small>
                        <div class="mt-3"><label asp-for="AddressId" class="form-label">Endereço de entrega</label><select asp-for="AddressId" class="form-select" asp-items="@(new SelectList(Model.Addresses, "Id", "Label"))"><option value="">Selecione</option></select></div>
                        <div class="mt-3"><label asp-for="PaymentTermId" class="form-label">Condição de pagamento</label><select asp-for="PaymentTermId" id="paymentTermSelect" class="form-select"><option value="">Selecione</option>@foreach (var term in Model.PaymentTerms) { <option value="@term.Id" data-code="@term.Code">@term.Name</option> }</select></div>
                        <fieldset id="creditCardForm" class="seller-card-fields mt-3" hidden><legend class="form-label">Dados do cartão</legend><div id="cardUnavailableNotice" class="text-danger" role="alert" hidden>O pagamento por cartão está indisponível no momento.</div><div class="mt-2"><label for="cardNumberInput" class="form-label">Número do cartão</label><input id="cardNumberInput" class="form-control" inputmode="numeric" autocomplete="cc-number" maxlength="19" /></div><div class="row g-2 mt-1"><div class="col-md-6"><label for="cardHolderInput" class="form-label">Nome do titular</label><input id="cardHolderInput" class="form-control" autocomplete="cc-name" /></div><div class="col-md-3"><label for="cardExpiryInput" class="form-label">Validade</label><input id="cardExpiryInput" class="form-control" inputmode="numeric" autocomplete="cc-exp" maxlength="5" placeholder="MM/AA" /></div><div class="col-md-3"><label for="cardCvvInput" class="form-label">CVV</label><input id="cardCvvInput" class="form-control" type="password" inputmode="numeric" autocomplete="cc-csc" maxlength="4" /></div></div><div class="mt-2"><label for="cardInstallmentsSelect" class="form-label">Parcelas</label><select id="cardInstallmentsSelect" class="form-select" disabled><option value="1">1x sem juros</option></select></div><div id="cardTokenError" class="text-danger mt-2" role="alert"></div></fieldset>
                        <div class="mt-3"><label asp-for="RequestedDeliveryDate" class="form-label">Data de entrega</label><input class="form-control seller-date-input" name="RequestedDeliveryDate" value="@Model.RequestedDeliveryDate.ToString("dd/MM/yyyy")" inputmode="numeric" placeholder="dd/mm/aaaa" /></div>
                        <div class="mt-3"><label asp-for="Notes" class="form-label">Observações</label><textarea asp-for="Notes" class="form-control" rows="3"></textarea></div>
                        <button class="btn btn-gold seller-checkout-submit mt-4" type="submit"><i class="fa-solid fa-check" aria-hidden="true"></i> Confirmar pedido</button>
                    </article>
                </div>
            </div>
        </form>
    </div>
</section>
@section Scripts {
    <script src="https://sdk.mercadopago.com/js/v2"></script>
    <script>window.__mercadoPagoPublicKey = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MercadoPagoPublicKey));</script>
    <script src="~/js/checkout.js" asp-append-version="true"></script>
}
