@model SellerDashboardViewModel
@{
    ViewData["Title"] = "Área do vendedor";
    ViewData["BodyClass"] = "seller-area-page";
}

<section class="seller-dashboard" aria-labelledby="seller-dashboard-title">
    <header class="seller-dashboard__header">
        <div class="seller-dashboard__intro">
            <p class="seller-dashboard__eyebrow">OPERAÇÃO COMERCIAL</p>
            <h1 id="seller-dashboard-title">Olá, @Model.SellerName</h1>
            <p class="seller-dashboard__subtitle">Acompanhe sua carteira e continue suas vendas.</p>
@if (User.IsInRole("Administrador"))
{
    <span class="seller-dashboard__admin-context">Acesso administrativo · @Model.SellerName</span>
}
        </div>
        <nav class="seller-dashboard__actions" aria-label="Atalhos comerciais">
            <a class="seller-button seller-button--primary" asp-area="Vendedor" asp-controller="OrderDrafts" asp-action="New">
                <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i><span>Digitar pedido</span>
            </a>
            <a class="seller-button seller-button--gold" asp-area="Vendedor" asp-controller="Customers" asp-action="Index">
                <i class="fa-solid fa-building" aria-hidden="true"></i><span>Minha carteira</span>
            </a>
            <a class="seller-button seller-button--secondary" asp-area="Vendedor" asp-controller="OrderDrafts" asp-action="Index">
                <i class="fa-regular fa-file-lines" aria-hidden="true"></i><span>Meus rascunhos</span>
            </a>
        </nav>
    </header>

    <div class="seller-dashboard__metrics" aria-label="Indicadores da carteira">
        <article class="seller-dashboard__metric">
            <span class="seller-dashboard__metric-icon" aria-hidden="true"><i class="fa-solid fa-users"></i></span>
            <div><span>Clientes ativos</span><strong>@Model.ActiveCustomerCount</strong><small>Na sua carteira</small></div>
        </article>
        <article class="seller-dashboard__metric">
            <span class="seller-dashboard__metric-icon" aria-hidden="true"><i class="fa-solid fa-address-card"></i></span>
            <div><span>Clientes em destaque</span><strong>@Model.Customers.Take(6).Count()</strong><small>Acessos rápidos neste painel</small></div>
        </article>
    </div>

    <section class="seller-dashboard__portfolio" aria-labelledby="seller-portfolio-title">
        <div class="seller-dashboard__section-heading">
            <div>
                <p class="seller-dashboard__eyebrow">RELACIONAMENTO</p>
                <h2 id="seller-portfolio-title">Clientes em destaque</h2>
            </div>
            <a class="seller-dashboard__text-link" asp-area="Vendedor" asp-controller="Customers" asp-action="Index">
                Ver carteira <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
            </a>
        </div>

        @if (Model.Customers.Count == 0)
        {
            <div class="seller-dashboard__empty" role="status">Nenhum cliente disponível para exibição no painel.</div>
        }
        else
        {
            <div class="seller-dashboard__customer-grid">
                @foreach (var customer in Model.Customers.Take(6))
                {
                    <a class="seller-dashboard__customer-card" asp-area="Vendedor" asp-controller="Customers" asp-action="Details" asp-route-id="@customer.Id" aria-label="Abrir workspace de @customer.Name">
                        <span class="seller-dashboard__customer-icon" aria-hidden="true"><i class="fa-solid fa-building"></i></span>
                        <span class="seller-dashboard__customer-info">
                            <small>@customer.Code</small>
                            <strong>@customer.Name</strong>
                            <span>@customer.City</span>
                        </span>
                        <i class="seller-dashboard__customer-arrow fa-solid fa-arrow-right" aria-hidden="true"></i>
                    </a>
                }
            </div>
        }
    </section>
</section>
